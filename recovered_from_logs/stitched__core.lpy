(defn pick-netbank-sub-top-k
  "Sub-keys retained per K_a/K_b half before re-rank. Reads
   MMLLM_NET_SUB_TOP_K (default 64). Capped to sqrt_n inside NetBank."
  []
  (python/int (.get (.- os environ) "MMLLM_NET_SUB_TOP_K" "64")))

(defn pick-netbank-router?
  "Build the learned two-level skill router on the ModularNetBank. Reads
   ('a,b,c') via the backend-agnostic contract in mmllm.skill_modules.
   Empty/unset → [] = single monolithic NetBank (pre-fork; zero behavior
   change when unset). Genesis-3: gutenberg-prose,amps-math,stackexchange-dialogue."
  []
  (skm/parse-modules))

(defn pick-net-cooled-modules
  "Set of skill-module names whose NetBank is FROZEN/cooled this round (lr→0
   on opt-sparse-net's per-module group). Reads MMLLM_NET_COOL_MODULES ('a,b').
   Empty = all hot (genesis phase 0). Staged cooling: as new modules are added,
   list the mastered ones here so their banks stop moving (structural isolation)."
  []
  (python/set (skm/parse-modules (.get (.- os environ) "MMLLM_NET_COOL_MODULES" ""))))

(defn net-module-lrs
  "Per-module lr list in pick-netbank-modules order (matching opt-sparse-net's
   per-module groups built by netbank-sparse-parameter-groups): `base` for hot
   modules, 0.0 for cooled ones."
  [base]
  (let [cooled (pick-net-cooled-modules)]
    (python/list
      (map (fn [mname] (if (.__contains__ cooled mname) 0.0 base))
           (pick-netbank-modules)))))

(defn pick-local-bank-layers
  "Set of transformer-layer indices that get a Local Bank attached.
