<|user|>
Can you create an HTML page that includes a word scramble game related to astronomy? The game should include the letters "R V T E I A L U B R E" that can be rearranged to form a word related to astronomy. The user should be able to click and drag the letters to their desired location to form the correct word. Once the word is formed, the user should receive a congratulatory message.
<|end|>
<|asst|>
Sure, here's a sample HTML code for a word scramble game related to astronomy:
```

Astronomy Word Scramble Game

 #container {
 display: flex;
 flex-wrap: wrap;
 justify-content: center;
 align-items: center;
 height: 300px;
 background-color: #f2f2f2;
 }
 #letters {
 display: flex;
 flex-wrap: wrap;
 justify-content: center;
 align-items: center;
 height: 150px;
 padding: 20px;
 background-color: #fff;
 border: 2px solid #333;
 border-radius: 5px;
 box-shadow: 5px 5px 5px #ccc;
 cursor: move;
 }
 #word {
 display: flex;
 flex-wrap: wrap;
 justify-content: center;
 align-items: center;
 height: 100px;
 padding: 20px;
 background-color: #fff;
 border: 2px solid #333;
 border-radius: 5px;
 box-shadow: 5px 5px 5px #ccc;
 cursor: pointer;
 }
 .correct {
 background-color: #4CAF50;
 color: #fff;
 border: none;
 font-size: 20px;
 padding: 10px;
 border-radius: 5px;
 box-shadow: 5px 5px 5px #ccc;
 cursor: default;
 }
 

 var word = "starburvelite"; // the correct word
 var scrambled = "R V T E I A L U B R E".split(" ").sort(() => Math.random() - 0.5); // the scrambled letters
 var wordDiv = document.getElementById("word");
 var lettersDiv = document.getElementById("letters");
 var correctDiv = document.createElement("div");
 correctDiv.innerHTML = "Congratulations! You got it right!";
 correctDiv.classList.add("correct");
 correctDiv.style.display = "none";
 wordDiv.appendChild(correctDiv);
 function allowDrop(event) {
 event.preventDefault();
 }
 function drag(event) {
 event.dataTransfer.setData("text", event.target.id);
 }
 function drop(event) {
 event.preventDefault();
 var data = event.dataTransfer.getData("text");
 var target = event.target;
 if (target.classList.contains("letter")) {
 target.parentNode.insertBefore(document.getElementById(data), target);
 } else if (target.id == "word") {
 target.appendChild(document.getElementById(data));
 }
 checkWord();
 }
 function checkWord() {
 var currentWord = "";
 var letters = lettersDiv.querySelectorAll(".letter");
 letters.forEach(function(letter) {
 currentWord += letter.innerHTML;
 });
 if (currentWord == word) {
 correctDiv.style.display = "block";
 } else {
 correctDiv.style.display = "none";
 }
 }
 window.onload = function() {
 scrambled.forEach(function(letter) {
 var letterDiv = document.createElement("div");
 letterDiv.innerHTML = letter;
 letterDiv.classList.add("letter");
 letterDiv.setAttribute("draggable", "true");
 letterDiv.setAttribute("ondragstart", "drag(event)");
 lettersDiv.appendChild(letterDiv);
 });
 };
 
Astronomy Word Scramble Game
============================
Drag and drop the letters to form a word related to astronomy.



```
