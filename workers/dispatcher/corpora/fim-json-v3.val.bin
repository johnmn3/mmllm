2. Tracking and evaluating sources of information:
```
struct Article {
 var title: String
 var author: String
 var publicationDate: Date
 var citations: Int
}
func evaluateSource(article: Article) -> String {
 if article.author.contains("Dr.") && article.publicationDate > Date(timeIntervalSinceNow: -31536000) && article.citations > 10 {
 return "This source is highly credible and reliable."
 } else if article.publicationDate < Date(timeIntervalSinceNow: -31536000) {
 return "This source is outdated and may not be reliable."
 } else {
 return "This source may be credible, but more information is needed to determine its reliability."
 }
}
let exampleArticle = Article(title: "The Importance of Epistemic Vigilance", author: "Dr. Jane Smith", publicationDate: Date(timeIntervalSinceNow: -15768000), citations: 5)
let evaluation = evaluateSource(article: exampleArticle)
print(evaluation)
// Output: "This source is outdated and may not be reliable."
```
