<|asst|>
double sumArray(int arr[], int n) {
 double sum = 0;
 for (int i = 0; i < n; i++) {
 sum += arr[i];
 }
 return sum;
}

int main() {
 int arr[] = {5, 10, 2, 12, 9};
 int n = sizeof(arr)/sizeof(arr[0]);
 double sum = sumArray(arr, n);
 printf("The sum of the array's elements is: %.2f", sum);
 return 0;
} 

// Output: The sum of the array's elements is: 38.00 <|endoftext|>
