using System;

class Program
{
 static int CalculateSeverity(int timeElapsed)
 {
 if (timeElapsed <= 10)
 {
 return 1;
 }
 else if (timeElapsed <= 20)
 {
 return 2;
 }
 else if (timeElapsed <= 30)
 {
 return 3;
 }
 else if (timeElapsed <= 40)
 {
 return 4;
 }
 else
 {
 return 5;
 }
 }

 static void Main(string[] args)
 {
 Console.WriteLine("Time ElapsedtEncoded Severity Level");
 for (int i = 10; i <= 60; i += 10)
 {
 int severity = CalculateSeverity(i);
 if (i == timeElapsed)
 {
 Console.WriteLine(i + "t" + EncodeSeverity(severity));
 }
 else
 {
 Console.WriteLine(i + "t?");
 }
 }
 }

 static int EncodeSeverity(int severity)
 {
 switch (severity)
 {
 case 1:
 return 1;
 case 2:
 return 2;
 case 3:
 return 3;
 case 4:
 return 4;
 default:
 return 0;
 }
 }
}
