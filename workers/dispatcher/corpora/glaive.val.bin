```
package main
import (
 "fmt"
)
type Animal struct {
 name string
 size float64
 diet string
 teethLength float64
 clawLength float64
 runningSpeed float64
}
func main() {
 animals := []Animal{
 {name: "Lion", size: 2.6, diet: "Carnivore", teethLength: 2.5, clawLength: 3.0, runningSpeed: 50},
 {name: "Rabbit", size: 0.4, diet: "Herbivore", teethLength: 0.2, clawLength: 0.0, runningSpeed: 20},
 {name: "Tiger", size: 2.8, diet: "Carnivore", teethLength: 2.8, clawLength: 3.5, runningSpeed: 60},
 {name: "Elephant", size: 3.3, diet: "Herbivore", teethLength: 0.5, clawLength: 0.0, runningSpeed: 30},
 }
 for _, animal := range animals {
 classification := classifyAnimal(animal)
 fmt.Printf("%s is a %s because %s.n", animal.name, classification, getReason(classification, animal))
 }
}
func classifyAnimal(animal Animal) string {
 if animal.diet == "Carnivore" && animal.teethLength > 1.5 && animal.clawLength > 2.5 && animal.runningSpeed > 40 {
 return "Large Predator"
 } else if animal.diet == "Carnivore" && animal.teethLength <= 1.5 && animal.clawLength <= 2.5 && animal.runningSpeed <= 40 {
 return "Small Predator"
 } else if animal.diet == "Herbivore" && animal.size > 2 && animal.runningSpeed <= 40 {
 return "Large Herbivore"
 } else {
 return "Small Herbivore"
 }
}
func getReason(classification string, animal Animal) string {
 switch classification {
 case "Large Predator":
 return fmt.Sprintf("it is a carnivore with large teeth, long claws, and a fast running speed of %.0f km/h.", animal.runningSpeed)
 case "Small Predator":
 return fmt.Sprintf("it is a carnivore with small teeth, short claws, and a running speed of %.0f km/h.", animal.runningSpeed)
 case "Large Herbivore":
 return fmt.Sprintf("it is a herbivore with a large size of %.1f meters and a running speed of %.0f km/h.", animal.size, animal.runningSpeed)
 case "Small Herbivore":
 return fmt.Sprintf("it is a herbivore with a small size of %.1f meters and a running speed of %.0f km/h.", animal.size, animal.runningSpeed)
 default:
 return ""
 }
}
```
