php
$passage = "The snow-capped peaks dotted the horizon, and the chill from the wind cut through my jacket. I was transported back to a time when I stood on these very mountains with my grandfather, and felt the weight of his love and wisdom."
$words = explode(" ", $passage);
$sensory_imagery = array();
foreach($words as $word) {
 if(strpos($word, "-") !== false) {
 $sensory_imagery[] = "visual image of " . $word;
 }
 elseif(strpos($word, "chill") !== false) {
 $sensory_imagery[] = "tactile sensation of " . $word;
 }
}
echo "The sensory imagery in this passage includes: " . implode(", ", $sensory_imagery);
?
