```go
package main
import (
 "fmt"
 "net/http"
)
func main() {
 http.HandleFunc("/", homeHandler)
 http.HandleFunc("/demo", demoHandler)
 http.ListenAndServe(":8080", nil)
}
func homeHandler(w http.ResponseWriter, r *http.Request) {
 fmt.Fprintf(w, "Product Name - Value Proposition")
 fmt.Fprintf(w, "Product Name
============

")
 fmt.Fprintf(w, "Value Proposition: Describe the unique value that your product provides to customers.

")
 fmt.Fprintf(w, "Target Market: Describe the specific audience that your product is designed for.

")
 fmt.Fprintf(w, "Unique Features and Benefits: List the key features of your product and the benefits they provide to customers.

")
