 System.out.println("- " + cardioExercise1 + " (1 minute)");
 System.out.println("- " + coreExercise1 + " (2 sets of 15 reps)");
 System.out.println("- " + agilityDrill1 + " (30 seconds)");
 System.out.println("- " + strengthExercise2 + " (3 sets of 10 reps)");
 System.out.println("- " + cardioExercise2 + " (1 minute)");
 System.out.println("- " + coreExercise2 + " (2 sets of 15 reps)");
 System.out.println("- " + agilityDrill2 + " (30 seconds)");
 }
