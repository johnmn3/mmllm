```swift
func getDanceStyleDetails(danceStyle: String) -> (characteristics: String, notableFeatures: String) {
 switch danceStyle {
 case "Contemporary Dance":
 return ("A fusion of ballet, modern, and jazz styles that emphasizes versatility and improvisation.", "Use of floorwork, athletic movements, and emotional expressiveness.")
 case "Hip Hop Dance":
 return ("An urban dance style that originated in African American and Latino communities and is characterized by rhythmic movements and a focus on individual style.", "Breakdancing, popping and locking, and freestyle improvisation.")
 default:
 return ("", "")
 }
}
```
