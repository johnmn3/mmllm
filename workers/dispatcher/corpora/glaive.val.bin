$fauna = array("Lion", "Elephant", "Giraffe", "Leopard", "Cheetah", "Hippo", "Rhino", "Zebra", "Gorilla", "Chimpanzee", "Gazelle", "Wildebeest", "Hyena", "Crocodile", "Hornbill Bird", "Ostrich");
$random_culture = $cultures[array_rand($cultures)];
$random_language = $languages[array_rand($languages)];
$random_geography = $geography[array_rand($geography)];
$random_flora = $flora[array_rand($flora)];
$random_fauna = $fauna[array_rand($fauna)];
$epithet = "The land of " . $random_culture . " " . $random_language . ", " . $random_geography . " with its " . $random_flora . " and " . $random_fauna;
echo $epithet;
?
```
