```
using System;
using System.Collections.Generic;
class Program
{
 static void Main(string[] args)
 {
 // Define lists of ingredients
 List fruits = new List { "banana", "apple", "orange", "strawberry", "blueberry" };
 List grains = new List { "oatmeal", "quinoa", "brown rice", "whole wheat bread" };
 List proteins = new List { "eggs", "tofu", "greek yogurt", "almond butter" };
 // Choose random ingredients
 Random rand = new Random();
 string fruit = fruits[rand.Next(fruits.Count)];
 string grain = grains[rand.Next(grains.Count)];
 string protein = proteins[rand.Next(proteins.Count)];
 // Generate recipe
 Console.WriteLine("Here's a recipe for a healthy breakfast:");
 Console.WriteLine($"- {fruit} and {grain} bowl with {protein}");
 Console.WriteLine("Instructions:");
 Console.WriteLine($"1. Cook {grain} according to package instructions.");
 Console.WriteLine($"2. Slice up {fruit} and add it to the bowl with the {grain}.");
 Console.WriteLine($"3. Cook {protein} and add it to the bowl.");
 Console.WriteLine($"4. Enjoy your healthy breakfast!");
 Console.ReadLine();
 }
}
```
This code defines three lists of ingredients (fruits, grains, and proteins) and randomly selects one ingredient from each list. It then generates a recipe for a breakfast bowl that includes all three ingredients, along with instructions on how to prepare the dish. 
You can customize the lists of ingredients to include your preferred options. <|endoftext|>
