$flora = array("Baobab Tree", "Acacia Tree", "Mangrove Tree", "Teak Tree", "Mahogany Tree", "Coconut Tree", "Date Palm Tree", "Bamboo Tree", "Rubber Tree", "Vanilla Plant", "Coffee Plant", "Cocoa Plant", "Khat Plant", "Eucalyptus Tree", "Aloe Vera Plant", "Baobab Fruit");
