let hiddenMessage = "VGTCPG"
let tips = ["Take a deep breath and count to 10 before reacting.", "Write down your thoughts and feelings in a journal.", "Practice mindfulness meditation for 10 minutes a day.", "Engage in regular physical exercise.", "Connect with friends and family for emotional support.", "Prioritize your tasks and break them into smaller, manageable steps.", "Treat yourself to a relaxing activity, such as a bubble bath or massage.", "Challenge negative thoughts with positive affirmations.", "Get plenty of restful sleep each night.", "Express gratitude by writing down three things you are thankful for each day."]
var unscrambledMessage = ""
for i in hiddenMessage {
 let index = tips.firstIndex(where: { $0.hasPrefix(String(i)) })!
 unscrambledMessage += String(tips[index].prefix(1))
 tips.remove(at: index)
}
print("The unscrambled message is: (unscrambledMessage)")
