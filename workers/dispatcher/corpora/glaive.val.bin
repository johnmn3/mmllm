 text += line + " ";
 }
 
 // Preprocess the text
 text = preprocess(text);
 
 // Build the vocabulary
 unordered_map vocab;
 istringstream iss(text);
 string word;
 while (iss >> word) {
 if (vocab.find(word) == vocab.end()) { // new word
 vocab[word] = vocab.size();
 }
 }
 
 // Extract the bag-of-words features
 vector features(vocab.size(), 0);
 istringstream iss2(text);
 while (iss2 >> word) {
 features[vocab[word]]++;
 }
 
 // Print the features
 for (auto feature : features) {
 cout << feature << " ";
 }
 cout << endl;
 
 return 0;
}
```
