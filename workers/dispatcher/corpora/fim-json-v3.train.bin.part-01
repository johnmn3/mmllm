```c++
class Calculator {
 public:
 double add(double num1, double num2) {
 return num1 + num2;
 }
 double subtract(double num1, double num2) {
 return num1 - num2;
 }
 double multiply(double num1, double num2) {
 return num1 * num2;
 }
 double divide(double num1, double num2) {
 if (num2 == 0) {
 throw "Cannot divide by zero";
 }
 return num1 / num2;
 }
};
```
This class contains four methods that perform the basic mathematical operations of addition, subtraction, <|fim_mid|>multiplication<|fim_eom|>

