<|fim_suf|>, n):
 if n == 1:
 print(''.join(arr))
 else:
 for i in range(n):
 generate_permutations(arr, n-1)
 if n % 2 == 0:
 arr[i], arr[n-1] = arr[n-1], arr[i]
 else:
 arr[0], arr[n-1] = arr[n-1], arr[0]
# Example usage
word = "tehcno"
generate_permutations(list(word), len(word))
```
