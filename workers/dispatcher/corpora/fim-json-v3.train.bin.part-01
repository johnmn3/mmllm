using namespace std;
double gaussian(double x, double mu, double sigma) {
 double norm = 1.0/(sqrt(2.0*M_PI)*sigma);
 double power = -1.0*pow(x-mu, 2.0)/(2.0*pow(sigma, 2.0));
 return norm*exp(power);
}
