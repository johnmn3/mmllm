Here's an example code using CsvHelper:
[C# code]
using CsvHelper;
using System.Globalization;
using System.IO;
public class Product
{
 public string ProductCode { get; set; }
 public string ProductName { get; set; }
 public decimal ProductPrice { get; set; }
}
public void UpdateProductPrices(string csvFilePath)
{
 using var reader = new StreamReader(csvFilePath);
 using var csv = new CsvReader(reader, CultureInfo.InvariantCulture);
 csv.Configuration.HeaderValidated = null;
 csv.Configuration.MissingFieldFound = null;
 var products = csv.GetRecords();
 foreach (var product in products)
 {
 UpdateProductPrice(product.ProductCode, product.ProductPrice);
 }
}
void UpdateProductPrice(string productCode, decimal productPrice)
{
 // code to update product price on e-commerce website
}
