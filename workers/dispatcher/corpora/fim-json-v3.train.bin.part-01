 max_num = arr[0]
 for num in arr:
 if num > max_num:
 max_num = num
 print("The largest number in the array is: ", max_num)

array = [1, 3, 10, 4]
largest_number(array) # prints "The largest number in the array is: 10" <|endoftext|>
