 CURLcode res = curl_easy_perform(curl);
 // Check for CURL errors
 if (res != CURLE_OK) {
 cerr << "CURL error: " << curl_easy_strerror(res) << endl;
 return 1;
 }
 // Parse JSON response using JsonCpp
 Json::Value root;
 Json::Reader reader;
 bool success = reader.parse(response, root);
 if (!success) {
 cerr << "JSON parsing error: " << reader.getFormattedErrorMessages() << endl;
 return 1;
 }
 // Extract restaurant information from JSON response
 for (int i = 0; i < root["businesses"].size(); i++) {
 string name = root["businesses"][i]["name"].asString();
 string address = root["businesses"][i]["location"]["address1"].asString();
 string phone = root["businesses"][i]["phone"].asString();
 double rating = root["businesses"][i]["rating"].asDouble();
 cout << "Name: " << name << endl;
 cout << "Address: " << address << endl;
 cout << "Phone: " << phone << endl;
 cout << "Rating: " << rating << endl;
 cout << endl;
 }
 // Cleanup CURL
 curl_easy_cleanup(curl);
 } else {
 cerr << "CURL initialization error" << endl;
 return 1;
 }
 return 0;
}
```
Note that you need to replace `YOUR_API_KEY_HERE` with your actual Yelp API key. Also, make sure to install the required dependencies (CURL and JsonCpp) and link them properly when compiling the code. <|endoftext|>
<|end|>
<|user|>
Can this code be modified to search for restaurants in a different city or location?
<|end|>
<|asst|>
Yes, you can modify the API_PARAMS string to change the search parameters. For example, if you want to search for Italian restaurants in Los Angeles instead of Manhattan, you can change the "location" parameter to "Los Angeles". Here's an updated API_PARAMS string:
```c++
const string API_PARAMS = "?term=italian&location=Los+Angeles&categories=restaurants&sort_by=rating&price=2,3&limit=5";
```
You can also adjust other parameters such as the price range and sort order by modifying the API_PARAMS string accordingly. <|endoftext|>
<|end|>


