```python
import re
# List of words and punctuation to match
words = ['hello', 'world', ',', '!', '?']
# Generate all possible combinations of the words and punctuation
patterns = []
for i in range(1, len(words) + 1):
 for combo in itertools.permutations(words, i):
 patterns.append(' '.join(combo))
# Create the regular expression
regex = re.compile('(' + '|'.join(patterns) + ')')
# Sample input
text = 'hello world!'
# Find all matches
matches = re.findall(regex, <|fim_mid|>text)
# Join the matches to form a sentence
sentence = ' '.join(matches).capitalize() + '.'
# Output the sentence
print(sentence)
```
