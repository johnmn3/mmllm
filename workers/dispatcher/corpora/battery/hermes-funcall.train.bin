    {"id": "P001", "name": "Organic Apples", "quantity": 1200, "turnover_rate": "monthly", "shelf_life": 14},
    {"id": "P002", "name": "Whole Grain Bread", "quantity": 800, "turnover_rate": "weekly", "shelf_life": 7},
