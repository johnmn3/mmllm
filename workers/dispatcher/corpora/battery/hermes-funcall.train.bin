{"tool_calls": [{"name": "send_email_with_attachment", "args": {"from_account": "mygmailaccount@gmail.com", "to_recipients": ["clientemail@example.com", "manager@example.com", "teamlead@example.com"], "subject": "Exclusive Proposal for Partnership Expansion", "body": "Dear Valued Partner,\n\nI am pleased to present to you our detailed proposal document outlining our new services and the benefits they hold for our esteemed clients like yourselves. We trust this proposal will uphold our commitment to excellence and reinforce our continued partnership. We look forward to discussing this exciting opportunity with you further.\n\nBest regards,\n[Your Name]", "attachment_paths": ["Partnership_Proposal_Document.pdf"], "importance": "high", "mail_client": "Outlook"}}]}
