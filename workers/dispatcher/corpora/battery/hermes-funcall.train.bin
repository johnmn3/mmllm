[{"type": "function", "function": {"name": "get_social_media_statistics", "description": "Retrieve social media usage statistics for specified year, demographics, and platforms.", "parameters": {"type": "object", "properties": {"year": {"type": "integer", "description": "The year for which social media statistics are requested."}, "demographics": {"type": "array", "description": "List of demographic categories to include in the statistics.", "items": {"type": "string", "enum": ["age", "gender", "location"]}}, "platforms": {"type": "array", "description": "List of social media platforms to include in the statistics.", "items": {"type": "string", "enum": ["Facebook", "Instagram", "Twitter", "TikTok", "Snapchat", "LinkedIn", "Pinterest", "Reddit", "YouTube"]}}}, "required": ["year", "demographics", "platforms"]}}}]
