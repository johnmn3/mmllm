ated amounts.", "parameters": {"type": "object", "properties": {"project_id": {"type": "string", "description": "The unique identifier of the construction project."}, "budget_items": {"type": "array", "description": "A list of budget items with their details.", "items": {"type": "object", "properties": {"item_id": {"type": "string", "description": "The unique identifier of the budget item."}, "description": {"type": "string", "description": "A brief description of the budget item."}, "allocated_amount": {"type": "number", "description": "The amount of money allocated to the budget item."}}, "required": ["item_id", "description", "allocated_amount"]}}}, "required": ["project_id", "budget_items"]}}}, {"type": "function", "function": {"name": "ensure_safety_compliance", "description": "Ensures that a construction project complies with specified safety standards.", "parameters": {"type": "object", "properties": {"project_id": {"type": "string", "description": "The unique identifier of the construction project."}, "safety_standards": {"type": "array", "description": "A list of safety standards to comply with.", "items": {"type": "string"}}}, "required": ["project_id", "safety_standards"]}}}]
