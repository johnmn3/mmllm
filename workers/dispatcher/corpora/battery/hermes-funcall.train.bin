<|end|>
<|asst|>
{"tool_calls": [{"name": "update_employee_contact_info", "args": {"employee_id": "SF20231408", "new_address": "254 Sunrise Avenue, Marina District, San Francisco, CA 94123", "new_phone_number": "(415) 555-0264", "new_emergency_contact": {"name": "Jamie Smith", "phone": "(415) 555-0198", "relationship": "Sibling"}}}]}
<|end|>


