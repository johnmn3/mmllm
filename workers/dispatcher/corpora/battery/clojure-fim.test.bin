[progeny\n      #{[\"father\" \"son\"] [\"uncle\" \"cousin\"] [\"son\" \"grandson\"]}]\n  (= (gtc progeny)\n     #{[\"father\" \"son\"] [\"father\" \"grandson\"]\n       [\"uncle\" \"cousin\"] [\"son\" \"grandson\"]})))", "new_str": "\n;; Transitive Closure\n\n;; Write a function which generates the transitive closure of a binary relation. The relation will be represented as a set of 2 item vectors.\n\n(defn gtc [s]\n  (let [find-relations  (fn [p s]\n                          (filter \n                            (fn [x]\n                              (or (= (x 0) (p 1))\n                                (= (x 1) (p 0))))\n                            s))\n        ctc (fn [p1 p2]\n              (if (=( p1 0) (p2 1))\n                [(p2 0) (p1 1)]\n                [(p1 0) (p2 1)]))\n        tc  (fn [p s]\n              (loop [s1 s result []]\n                (if (not-empty s1)\n                  (recur \n                    (rest s1) \n                    (conj result (ctc p (first s1)))\n                  )\n                  result)))\n        rtc (fn [s]\n              (loop [p (first s) r (rest s) result #{}]\n                  (if (not-empty r)\n                    (let [rels (find-relations p r)\n                          tcr  (tc p rels)]\n                      (recur\n                        (first r)\n                        (rest r)\n                        (if (empty? tcr) \n                          (conj result p) \n                          (into (conj result p) tcr)\n                        )))\n                    (conj result p))))]\n    (loop [n 0, result (rtc s)]\n      (if (= n (-> s count dec))\n        result\n        (recur (inc n) (into result (rtc result)))\n      ))))\n\n;; Tests\n\n(println (let [divides #{[8 4] [9 3] [4 2] [27 9]}]\n  (= (gtc divides) #{[4 2] [8 4] [8 2] [9 3] [27 9] [27 3]})))\n\n(println (let [more-legs\n      #{[\"cat\" \"man\"] [\"man\" \"snake\"] [\"spider\" \"cat\"]}]\n  (= (gtc more-legs)\n     #{[\"cat\" \"man\"] [\"cat\" \"snake\"] [\"man\" \"snake\"]\n       [\"spider\" \"cat\"] [\"spider\" \"man\"] [\"spider\" \"<NAME>\"]})))  \n\n(println (let [progeny\n      #{[\"father\" \"<NAME>\"] [\"<NAME>\" \"<NAME>\"] [\"<NAME>\" \"<NAME>\"]}]\n  (= (gtc progeny)\n     #{[\"father\" \"<NAME>\"] [\"<NAME>\" \"<NAME>\"]\n       [\"<NAME>\" \"<NAME>\"] [\"<NAME>\" \"<NAME>\"]})))"}}]}
