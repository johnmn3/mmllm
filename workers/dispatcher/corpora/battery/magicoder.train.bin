Construct a class for maintaining pupils' full names, chronological ages, academic performance scores and a log of their attendance records. Implement methods not just to add and modify these data points, but also to calculate and return the average age, the top performer (based on score), the most frequently absent pupil and generate a report card for a specific pupil with attendance and performance metrics. Also ensure that the class provides functionality to handle invalid data inputs or updates for age, score and attendance parameters.
<|end|>
<|asst|>
Here is a Python solution implementing a class with the functionalities. 

```Python
class Pupil:
    def __init__(self, name, age, score, attendance):
        self.name = name
        self.age = age
        self.score = score
        self.attendance = attendance
        self.pupils = []

    def add_pupil(self, name, age, score, attendance):
        if not isinstance(name, str) or not isinstance(age, int) or not isinstance(score, int) or not isinstance(attendance, int):
            raise ValueError("Invalid inputs, check the data types.")
        if age < 0 or score < 0 or attendance < 0:
            raise ValueError("Age, score, and attendance cannot be negative.")
        self.pupils.append({'name' : name, 'age' : age, 'score' : score, 'attendance' : attendance})

    def update_pupil(self, name, age=None, score=None, attendance=None):
        for pupil in self.pupils:
            if pupil['name'] == name:
                if age: 
                    if not isinstance(age, int) or age < 0:
                        raise ValueError("Invalid age input.")
                    pupil['age'] = age
                if score: 
                    if not isinstance(score, int) or score < 0:
                        raise ValueError("Invalid score input.")
                    pupil['score'] = score
                if attendance: 
                    if not isinstance(attendance, int) or attendance < 0:
                        raise ValueError("Invalid attendance input.")
                    pupil['attendance'] = attendance
                return
        print("Pupil not found.")

    def average_age(self):
        if not self.pupils: return "No pupils."
        total = sum(pupil['age'] for pupil in self.pupils)
        return total / len(self.pupils)

    def top_performer(self):
        if not self.pupils: return "No pupils."
        topscore = max(pupil['score'] for pupil in self.pupils)
        for pupil in self.pupils:
            if pupil['score'] == topscore:
                return pupil['name']

    def most_absent(self):
        if not self.pupils: return "No pupils."
        least_attendance = min(pupil['attendance'] for pupil in self.pupils)
        for pupil in self.pupils:
            if pupil['attendance'] == least_attendance:
                return pupil['name']

    def report_card(self, name):
        for pupil in self.pupils:
            if pupil['name'] == name:
                report_card = 'Name: {}\nAge: {}\nScore: {}\nAttendance: {}'.format(name, pupil['age'], pupil['score'], pupil['attendance'])
                return report_card
        return 'Pupil not found.'
```
This class provides a way to maintain pupils' data and gives several functionalities for handling and displaying them. Note that necessary error checks are made to ensure the validity of the input data.
<|end|>


