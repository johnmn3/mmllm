Add complexity to this code problem by requiring specific algorithm application and increased data manipulation. 

Modify the function to implement both a binary search tree and a minimum heap:

def is_elated(s):
    """
    Given a string s of length between 5 and 100, determine if it can be rearranged to meet the elated criteria or not.
    A string can be considered elated if it can be rearranged to a length of exactly 5, each sequence of characters are unique and non-sequential, and each unique character appears a prime number of times. 
    """
#Example code:
"""
class Node:
    ...
class MinHeap:
    ...
<|end|>
<|asst|>
#Python solution:

# Implementation of a binary search tree
class Node:
    def __init__(self, key):
        self.left = None
        self.right = None
        self.val = key

def insert(root, key):
    if root is None:
        return Node(key)
    else:
        if root.val < key:
            root.right = insert(root.right, key)
        else:
            root.left = insert(root.left, key)
    return root

# Implementation of a min heap
class MinHeap:
    def __init__(self):
        self.heap = []

    def parent(self, i):
        return (i-1)/2

    def insertKey(self, k):
        self.heap.append(k)
        i = len(self.heap) - 1
        while i != 0 and self.heap[self.parent(i)] > self.heap[i]:
            self.heap[i], self.heap[self.parent(i)] = (self.heap[self.parent(i)], self.heap[i])

# Function to check if a number is prime
def is_prime(n):
    if n<=1: return False
    if n==2: return True
    if n%2==0: return False
    for i in range(3, int(n**0.5)+1, 2):
        if n%i == 0: return False
    return True

# Function to check if a string is elated
def is_elated(s):
    s = s.lower()
    if len(s) != 5: return False
    
    hash_map = {}
    for word in s:
        hash_map[word] = hash_map.get(word, 0) + 1
    
    bst = None
    heap = MinHeap()
    for key, value in hash_map.items():
        bst = insert(bst, key)
        heap.insertKey(value)
    
    for i in range(len(heap.heap)):
        if not is_prime(heap.heap[i]): return False
    
    return True

# Driver Code
if __name__ == "__main__":
    test_str = "happy"
    print("Is '" + test_str + "' an elated string? " + str(is_elated(test_str)))
<|end|>


