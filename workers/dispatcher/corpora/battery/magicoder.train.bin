Please re-write the following in C++:
def optimized_prime_factor(n: int):
    # Take absolute value for negative inputs
    n = abs(n)
    
    # Handle edge cases
    assert n > 1, "The input number must be greater than 1"
    
    # Divide by 2 as long as possible
    while n % 2 == 0:
        n /= 2
    if n == 1:
        return 2
    
    # If no further division is possible, initialize divisor to 3
    divisor = 3

    while divisor * divisor <= n:
        if n % divisor:
            divisor += 2
        else:
            n /= divisor
    return int(n if n > 1 else divisor)

# Test cases    
print(optimized_prime_factor(13195))  # 29
print(optimized_prime_factor(2048))  # 2
print(optimized_prime_factor(-13195))  # 29
<|end|>
<|asst|>
In C++, the function might look like:

```cpp
#include <iostream>
#include <cmath>

int optimized_prime_factor(int n) {
    // Take absolute value for negative inputs
    n = std::abs(n);
    
    // Handle edge cases
    if (n <= 1) {
        throw std::runtime_error("The input number must be greater than 1");
    }
    
    // Divide by 2 as long as possible
    while (n % 2 == 0) {
        n /= 2;
    }
    if (n == 1) {
        return 2;
    }
    
    // If no further division is possible, initialize divisor to 3
    int divisor = 3;

    while (divisor * divisor <= n) {
        if (n % divisor) {
            divisor += 2;
        } else {
            n /= divisor;
        }
    }
    return (n > 1) ? n : divisor;
}

int main() {
    // Test cases    
    std::cout << optimized_prime_factor(13195) << std::endl;  // 29
    std::cout << optimized_prime_factor(2048) << std::endl;   // 2
    std::cout << optimized_prime_factor(-13195) << std::endl;  // 29

    return 0;
}
```

Note: In Python `assert` is used for debugging purposes to throw an AssertionError if a condition is not met. In C++, exceptions are generally handled with `try-catch-throw`. Here `std::runtime_error():` is used to throw an exception if `n <= 1`.
