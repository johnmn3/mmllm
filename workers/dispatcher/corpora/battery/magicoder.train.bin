help me turn this into swift code:
def encode_cyclic(s: str):
    groups = [s[(3 * i):min((3 * i + 3), len(s))] for i in range((len(s) + 2) // 3)]
    groups = [(group[1:] + group[0]) if len(group) == 3 else group for group in groups]
    return "".join(groups)

def decode_cyclic(s: str):
    groups = [s[(3 * i):min((3 * i + 3), len(s))] for i in range((len(s) + 2) // 3)]
    groups = [(group[-1] + group[:-1]) if len(group) == 3 else group for group in groups]
    return "".join(groups)
please annotate the swift code to make it easier for me to grasp.
<|end|>
<|asst|>
Sure! Here it is:

```swift
// Define a function to encode the cycle with a string parameter
func encode_cyclic(s: String) -> String {
    let length = s.count

    // Create an array of string groups by slicing the string into parts of 3 characters
    // We use stride to iterate through the string in steps of 3.
    var groups: [String] = stride(from: 0, to: length, by: 3).map {
        let start = s.index(s.startIndex, offsetBy: $0)
        let end = s.index(start, offsetBy: min(3, length - $0))
        return String(s[start..<end])
    }

    // Apply the cyclic rotation to each group (if the group's length is 3)
    for (index, group) in groups.enumerated() {
        if group.count == 3 {
            var chars = Array(group)
            let first = chars.removeFirst()
            chars.append(first)
            groups[index] = String(chars)
        }
    }

    // Join all groups into a single string
    return groups.joined()
}

// Define a function to decode the cycle with a string parameter
func decode_cyclic(s: String) -> String {
    let length = s.count

    // Create an array of string groups by slicing the string into parts of 3 characters
    var groups: [String] = stride(from: 0, to: length, by: 3).map {
        let start = s.index(s.startIndex, offsetBy: $0)
        let end = s.index(start, offsetBy: min(3, length - $0))
        return String(s[start..<end])
    }

    // Apply the reverse cyclic rotation to each group (if the group's length is 3)
    for (index, group) in groups.enumerated() {
        if group.count == 3 {
            var chars = Array(group)
            let last = chars.removeLast()
            chars.insert(last, at: 0)
            groups[index] = String(chars)
        }
    }

    // Join all groups into a single string
    return groups.joined()
}
```
The `stride(from:to:by:)` function is equivalent to the range() functionality in Python which is used to step through and get increments of 3 characters from the string.

The `enumerated()` function works like enumerate in python and provides a tuple where element 0 is the index and element 1 is the item of the array.
<|end|>


