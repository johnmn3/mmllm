def minimumDistance(word: str) -> int:
    def get_cost(pos1: int, pos2: int) -> int:
        x1, y1 = divmod(pos1, 6)
        x2, y2 = divmod(pos2, 6)
        return abs(x1 - x2) + abs(y1 - y2)

    dp1, dp2, dp0 = ([0]*26, [0]*26, [0]*26)
    for i in range(len(word) - 1, -1, -1):
        pos = ord(word[i]) - 65
        for b in range(26):
            dp2[b] = min(get_cost(pos, b) + dp0[pos], get_cost(pos, b) + dp1[b])
        dp1, dp0 = dp2, dp1
    return min(dp0)

word = 'CAKE'
print(minimumDistance(word))  # Output: 3

word = 'HAPPY'
print(minimumDistance(word))  # Output: 6

word = 'REW'
print(minimumDistance(word))  # Output: 3

word = 'YEAR'
print(minimumDistance(word))  # Output: 7
