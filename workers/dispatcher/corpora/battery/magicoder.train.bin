There were a lot of OCR errors in your script so I fixed them and this is how your Python script should look:

```Python
class SudokuSolve:
    def __init__(self, board):
        self.board = board

    def is_valid(self, row, col, num):
        for r in range(9):
            if self.board[r][col] == str(num):
                return False
        for c in range(9):
            if self.board[row][c] == str(num):
                return False
        start_row, start_col = row - row % 3, col - col % 3
        for r in range(3):
            for c in range(3):
                if self.board[r + start_row][c + start_col] == str(num):
                    return False
        return True

    def solve_sudoku(self):
        for r in range(9):
            for c in range(9):
                if self.board[r][c] == '.':
                    for num in range(1, 10):
                        if self.is_valid(r,c, num):
                            self.board[r][c] = str(num)
                            if self.solve_sudoku():
                                return True
                            else:
                                self.board[r][c] = '.'
                    return False
        return True

if __name__ == "__main__":
    board = [
        ["5","3",".",".","7",".",".",".","."],
        ["6",".",".","1","9","5",".",".","."],
        [".","9","8",".",".",".",".","6","."],
        ["8",".",".",".","6",".",".",".","3"],
        ["4",".",".","8",".","3",".",".","1"],
        ["7",".",".",".","2",".",".",".","6"],
        [".","6",".",".",".",".","2","8","."],
        [".",".",".","4","1","9",".",".","5"],
        [".",".",".",".","8",".",".","7","9"]
    ]
    solver = SudokuSolve(board)
    if solver.solve_sudoku():
        print(solver.board)
    else:
        print("No solution!")
```

