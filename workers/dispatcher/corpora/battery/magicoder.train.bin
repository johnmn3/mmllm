, Engineer: from django.db import models
from django.contrib.auth import get_user_model

User = get_user_model()

class Product(models.Model):
    """
    Product model representing an item for auction.
    """
    title = models.CharField(max_length=255)
    description = models.TextField()
    starting_bid = models.FloatField()
    deadline = models.DateTimeField()
    owner = models.ForeignKey(User, on_delete=models.CASCADE)

    def create_product(self, title: str, description: str, starting_bid: float, deadline: datetime, owner: User):
        """
        Create a new product with the given title, description, starting bid, deadline, and owner.
        """
        product = self.create(title=title, description=description, starting_bid=starting_bid, deadline=deadline, owner=owner)
        return product


class Bid(models.Model):
    """
    Bid model representing a bid on a product.
    """
    amount = models.FloatField()
    bidder = models.ForeignKey(User, on_delete=models.CASCADE)
    product = models.ForeignKey(Product, on_delete=models.CASCADE)

    def create_bid(self, amount: float, bidder: User, product: Product):
        """
        Create a new bid with the given amount, bidder, and product.
        """
        bid = self.create(amount=amount, bidder=bidder, product=product)
        return bid

    def is_highest_bid(self):
        """
        Check if this bid is the highest bid on the product.
        """
        highest_bid = self.product.bid_set.order_by('-amount').first()
        return self == highest_bid
, Engineer: from django.shortcuts import get_object_or_404
from rest_framework import status
from rest_framework.response import Response
from rest_framework.views import APIView
from .models import Product, Bid

class ProductView(APIView):
    """
    View for creating and managing products.
    """

    def post(self, request):
        title = request.data.get('title')
        description = request.data.get('description')
        starting_bid = request.data.get('starting_bid')
        deadline = request.data.get('deadline')
        owner = request.user

        if not all([title, description, starting_bid, deadline]):
            return Response({"error": "All fields are required."}, status=status.HTTP_400_BAD_REQUEST)

        product = Product.objects.create_product(title=title, description=description, starting_bid=starting_bid, deadline=deadline, owner=owner)
        return Response({"message": f"Product {product.title} created successfully."}, status=status.HTTP_201_CREATED)


class BidView(APIView):
    """
    View for creating and managing bids.
    """

    def post(self, request):
        amount = request.data.get('amount')
        product_id = request.data.get('product')
        bidder = request.user

        if not all([amount, product_id]):
            return Response({"error": "Both amount and product are required."}, status=status.HTTP_400_BAD_REQUEST)

        product = get_object_or_404(Product, id=product_id)

        if product.deadline < timezone.now():
            return Response({"error": "The auction for this product has ended."}, status=status.HTTP_400_BAD_REQUEST)

        if product.starting_bid > amount:
            return Response({"error": "Your bid must be higher than the starting bid."}, status=status.HTTP_400_BAD_REQUEST)

        highest_bid = Bid.objects.filter(product=product).order_by('-amount').first()

        if highest_bid and highest_bid.amount >= amount:
            return Response({"error": "Your bid must be higher than the current highest bid."}, status=status.HTTP_400_BAD_REQUEST)

        bid = Bid.objects.create_bid(amount=amount, bidder=bidder, product=product)
        return Response({"message": f"Bid placed successfully on product {product.title}."}, status=status.HTTP_201_CREATED)
