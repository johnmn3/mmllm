def find_bad_values(d, bad_vals=[], bad_keys=[], keys_visited=[], parent=None):
    if id(d) in keys_visited: # prevent infinite loops
        return
    keys_visited.append(id(d))

    if isinstance(d, dict):
        for k, v in d.items():
            if v is None or v == 0 or v == '' or is_null(v) or is_empty(v):
                bad_keys.append(keys_visited + [k])
                bad_vals.append(v)
            elif isinstance(v, (dict, list, tuple, set)):
