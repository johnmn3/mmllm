Refine the code below:

def multiply(lst):
    """Given a non-empty list of integers lst, multiply the odd elements that are at even indices and divisible by 3.

    Examples:
        multiply([3, 5, 7, 8, 9]) ==> 27 
    """
<|end|>
<|asst|>
def multiply(lst):
    product = 1
    for i in range(len(lst)):
        if i % 2 == 0 and lst[i] % 2 == 1 and lst[i] % 3 == 0:
            product *= lst[i]
    return product

# Test cases
print(multiply([3, 5, 7, 8, 9])) # should return 27
print(multiply([3, 5, 6, 7])) # should return 3
print(multiply([2, 3, 5, 8, 9, 12])) # should return 1
print(multiply([1, 1, 1, 3, 3, 3])) # should return 9
print(multiply([2, 2, 2])) # should return 1
