def odd_sum_prime_index_elements(x):
    def check_prime(n):
        """Check if a number is prime or not"""
        if n == 1 or (n % 2 == 0 and n > 2): 
            return False
        return all([(n % i) for i in range(3, int(n**0.5) + 1, 2)])
    
    def odd_sum(n): 
        """Check if the sum of digits in a number is odd"""
        return sum(int(i) for i in str(n)) % 2 != 0
        
    if not isinstance(x, list):
        return "Error: Please input a list"
    if not all(isinstance(n, int) for n in x):
        return "Error: List must contain only integers"

    primes = [i for i in range(len(x)) if check_prime(i)]
    digits_odds = [x[i] for i in primes if odd_sum(x[i])]

    return sorted(list(set(digits_odds)))
