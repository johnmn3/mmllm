def get_positive_and_sort(l: list):
    def swap_elements(n: list, index1: int, index2: int) -> None:
        """
        Swap two elements in the list n at positions index1 and index2.
        """
        n[index1], n[index2] = n[index2], n[index1]

    non_negative = [num for num in l if num >= 0]
    for i in range(len(non_negative)):
        for j in range(len(non_negative) - 1):
            if non_negative[j] > non_negative[j + 1]:
                swap_elements(non_negative, j, j + 1)
    return non_negative


print(get_positive_and_sort([-1, 2, -4, 5, 6])) # Expected: [2, 5, 6]
print(get_positive_and_sort([5, 3, -5, 2, -3, 3, 9, 0, 123, 1, -10])) # Expected: [0, 1, 2, 3, 3, 5, 9, 123]
<|end|>
<|asst|>
Here's the C++ equivalent of your Python code:

```cpp
#include <vector>
#include <iostream>
#include <algorithm>

std::vector<int> get_positive_and_sort(std::vector<int> input) {
    std::vector<int> non_negative;
    for (int i = 0; i < input.size(); i++) {
        if (input[i] >= 0) {
            non_negative.push_back(input[i]);
        }
    }
  
    sort(non_negative.begin(), non_negative.end());
    return non_negative;
}

int main() {
    std::vector<int> test = get_positive_and_sort({-1, 2, -4, 5, 6});
    for(int i = 0; i < test.size(); i++) {
        std::cout << test[i] << " ";
    }
  
    std::cout << std::endl;

    std::vector<int> test2 = get_positive_and_sort({5, 3, -5, 2, -3, 3, 9, 0, 123, 1, -10});
    for(int i = 0; i < test2.size(); i++) {
        std::cout << test2[i] << " ";
    }
    return 0;
}
```

It first filters all positive elements (inclusive of 0) into a new vector named `non_negative`. It then sorts the vector in ascending order using the `std::sort` function.

Note that `.push_back()` function from `std::vector` in C++ is equivalent to appending elements to a list in Python, and `std::sort()` function is equivalent to the built-in sort in Python which does not require manually swapping elements.
