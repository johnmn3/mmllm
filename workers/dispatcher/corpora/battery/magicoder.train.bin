\u5e6b\u6211\u5beb\u4e00\u4efd\u7c21\u55ae\u7684\u5f9e cloud storage\u4e0b\u8f09\u8cc7\u6599\u5f8c\u532f\u5165\u5230big query\u7684 Python \u7a0b\u5f0f
<|end|>
<|asst|>
这是一个从云端存储下载数据，然后导入到BigQuery的Python程序的示例。

```python
from google.cloud import bigquery
from google.cloud import storage
import os

# Initialize a BigQuery client.
bq_client = bigquery.Client("your_project_id")

# Initialize a Cloud Storage client.
storage_client = storage.Client("your_project_id")

# Define the name of your Cloud Storage bucket.
bucket_name = "your_bucket_name"

# Define the name of your BigQuery dataset.
dataset_name = 'your_dataset_name'

# Define the name of your BigQuery table.
table_name = 'your_table_name'

def download_blob(bucket_name, source_blob_name, destination_file_name):
    bucket = storage_client.get_bucket(bucket_name)
    blob = bucket.blob(source_blob_name)

    blob.download_to_filename(destination_file_name)

    print(f'Blob {source_blob_name} downloaded to {destination_file_name}.')

def load_data_from_file(dataset_name, table_name, source_file_name):
    dataset_ref = bq_client.dataset(dataset_name)
    table_ref = dataset_ref.table(table_name)

    job_config = bigquery.LoadJobConfig()
    job_config.source_format = bigquery.SourceFormat.CSV
    job_config.autodetect = True

    with open(source_file_name, "rb") as source_file:
        job = bq_client.load_table_from_file(source_file, table_ref, job_config=job_config)

    job.result()  # Waits for the job to complete.

    print(f'Loaded {job.output_rows} rows into {dataset_name}:{table_name}.')

def main():
    # Download file from Cloud Storage
    download_blob(bucket_name, 'source_blob_name', 'destination_file_name')

    # Load data from downloaded file to BigQuery
    load_data_from_file(dataset_name, table_name, 'destination_file_name')

if __name__ == "__main__":
    main()

```

请确保修改上述代码中的以下变量以匹配你的环境：

1. 'your_project_id'：你的 GCP 项目ID
2. 'your_bucket_name'：存储数据的 GCS 存储桶名称
3. 'your_dataset_name'：你的 BigQuery 数据集名称
4. 'your_table_name'：你的 BigQuery 表名称
5. 'source_blob_name'：在 GCS 存储桶中的文件（或 blob）名称
6. 'destination_file_name'： 你希望在本地文件系统下载文件的名称或路径

请确保你的环境已安装 google-cloud-storage 和 google-cloud-bigquery 库。如果没有，请在你的环境中安装这些库，使用如下命令：

```sh
pip install google-cloud-storage google-cloud-bigquery
```
