Implement a linked list data structure from scratch in a programming language of your choice. The linked list should support methods for adding and removing elements, and retrieving elements by index. Additionally, create a method that reverses the order of elements in the linked list and another one that sorts elements in increasing order. Demonstrate your implemented functions work as expected using relevant test cases.
<|end|>
<|asst|>
Below is an implementation of the problem using Python. Python is high-level, easy-to-read, interpreted language. Python's data structures provide significant speed-ups for the development of the implementation and optimization of the code.

```python
class Node:
    def __init__(self, data=None):
        self.data = data
        self.next = None


class LinkedList:
    def __init__(self):
        self.head = None

    def addElement(self, data):
        if not self.head:
            self.head = Node(data)
        else:
            node = self.head
            while node.next:
                node = node.next
            node.next = Node(data)

    def removeElement(self, data):
        if self.head is None:
            return

        if self.head.data == data:
            self.head = self.head.next
            return

        node = self.head
        while node.next:
            if node.next.data == data:
                node.next = node.next.next
                return
            node = node.next

    def getElementByIndex(self, index):
        node = self.head
        for i in range(index):
            if node is None:
                return None
            node = node.next

        if node is not None:
            return node.data
        else:
            return None

    def reverseList(self):
        prev = None
        current = self.head
        while current is not None:
            next_node = current.next
            current.next = prev
            prev = current
            current = next_node
        self.head = prev

    def sortList(self):
        if self.head is None:
            return

        current = self.head
        while current.next:
            next_node = current.next
            while next_node:
                if current.data > next_node.data:
                    current.data, next_node.data = next_node.data, current.data
                next_node = next_node.next
            current = current.next


# Test cases
linked_list = LinkedList()

# Add elements
linked_list.addElement(10)
linked_list.addElement(2)
linked_list.addElement(8)
linked_list.addElement(6)

# Retrieve elements
print("0th element", linked_list.getElementByIndex(0))  # Should print 10
print("2nd element", linked_list.getElementByIndex(2))  # Should print 8

# Remove element
linked_list.removeElement(8)
# Test to check if 8 is removed
print("2nd element after removing 8", linked_list.getElementByIndex(2))  # Should print 6

# Reverse list
linked_list.reverseList()
print("0th element after reversing", linked_list.getElementByIndex(0))  # Should print 6

# Sort list
linked_list.sortList()
print("0th element after sorting", linked_list.getElementByIndex(0))  # Should print 2
```

Please note in practice we would typically use Python's in-built data structures such as lists or libraries which provide optimized and efficient implementations of linked lists. However, for educational purposes and to demonstrate an understanding of how linked lists work under the hood, one may implement linked lists from scratch as we have done here.
<|end|>


