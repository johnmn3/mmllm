def atmospheric_ascent(q, w, n, p):
    def is_palindrome(q):
        return q == q[::-1]

    def is_prime(num):
        if num > 1:
            for i in range(2, num):
                if (num % i) == 0:
                    return False
            else:
                return True
        return False

    sum_q = sum(q)
    distinct_min_nums = len(set(q))
    prime_count = sum(is_prime(i) for i in q)

    if sum_q <= w and is_palindrome(q) and distinct_min_nums == n and prime_count >= p:
        return True
    else:
