Below is the corrected, compilable version of the provided Python code.

```python
import statistics
from collections.abc import Iterable
from numbers import Number

def compute_mean(tup):
    numeric_elements = [el for el in tup if isinstance(el, Number)]
    if not numeric_elements:
        raise ValueError("The tuple should contain at least one numeric value")
    return statistics.mean(numeric_elements)

def compute_median(tup):
    numeric_elements = [el for el in tup if isinstance(el, Number)]
    if not numeric_elements:
        raise ValueError("The tuple should contain at least one numeric value")
    return statistics.median(numeric_elements)

def convert_nested(el):
    if isinstance(el, list):
        el = tuple(el)
    elif isinstance(el, dict):
        el = tuple(el.values())
    return el

def verify_and_compute_disparity(tup1, tup2):
    if not isinstance(tup1, Iterable) or not isinstance(tup2, Iterable):
        raise TypeError("Both inputs must be iterable")
    tup1, tup2 = map(tuple, (tup1, tup2))  # ensure inputs are tuples

    tup1 = tuple(convert_nested(el) or compute_mean(tup1) for el in tup1)
    tup2 = tuple(convert_nested(el) or compute_mean(tup2) for el in tup2)

    len_diff = len(tup1) - len(tup2)
    if len_diff > 0:  # if tup1 is longer
        median_tup2 = compute_median(tup2)
        for _ in range(len_diff):
            tup2 += (median_tup2,)
    elif len_diff < 0: 
        median_tup1 = compute_median(tup1)
        for _ in range(abs(len_diff)):
            tup1 += (median_tup1,)

    for t1, t2 in zip(tup1, tup2):
        if isinstance(t1, Iterable) and isinstance(t2, Iterable):
            yield from verify_and_compute_disparity(t1, t2)
        else:
            if t1 <= t2: #Verify if element in first tuple is equal or greater than corresponding element in second tuple
                yield t1 - t2 #Compute disparity
            #Raise exception if t1 is less than t2
            else:
                raise ValueError('Element in first tuple is less than corresponding element in second tuple')
```
Note that the above code does not handle nested lists or dictionaries in the input tuples when calculating the mean or median. It simply converts these to tuples with `convert_nested`, and in case of dictionaries, it does not take keys into account. If nested structures should be handled differently, you would need to modify the `convert_nested` function or the list comprehensions where it's used.
