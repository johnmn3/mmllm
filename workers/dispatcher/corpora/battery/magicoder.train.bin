<|asst|>
Sure, Below is a simple Vue.js component for a tri-state switch named "TriStateSwitch.vue":

```javascript
<template>
  <div @click="cyclingState">
    <p v-show="state == 'activated'">Activated</p>
    <p v-show="state == 'standby'">Standby</p>
    <p v-show="state == 'deactivated'">Deactivated</p>
  </div>
</template>

<script>
export default {
  data() {
    return {
      state: 'activated' // default state
    };
  },

  methods: {
    // Function to cycle between states
    cyclingState() {
      if(this.state == 'activated') {
        this.state = 'standby';
        // animation for activating standby
      } else if(this.state == 'standby') {
        this.state = 'deactivated';
        // animation for activating deactivated
      } else {
        this.state = 'activated';
        // animation for activating activated
      }
    }
  }
};
</script>
```

Here is a test suite using the Vue Test Utils:
```javascript
import { mount } from '@vue/test-utils';
import TriStateSwitch from '@/components/TriStateSwitch.vue';

describe('TriStateSwitch.vue', () => {
  test('initial state is "activated"', () => {
    const wrapper = mount(TriStateSwitch);
    expect(wrapper.vm.$data.state).toBe('activated');
  });

  test('cycles state correctly', async () => {
    const wrapper = mount(TriStateSwitch);
    // simulate click event
    await wrapper.trigger('click');
    expect(wrapper.vm.$data.state).toBe('standby');
    await wrapper.trigger('click');
    expect(wrapper.vm.$data.state).toBe('deactivated');
    await wrapper.trigger('click');
    expect(wrapper.vm.$data.state).toBe('activated');
  });
});
```
Vue Test Utils enable us to mount our component and interact with it, simulating the cyclingState method by triggering click events and then asserting that the state has correctly cycled. 

Kindly note that this is a very basic implementation. You would probably want to introduce a comprehensive set of states, events, and animations based on your specific requirements. Also Vue transitions and animations are not depicted in this example.
