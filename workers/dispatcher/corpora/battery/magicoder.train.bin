Here's the corrected version of your code.

```python
def decode_cipher(cipher):
    n = len(cipher)
    min_arr = [0] * (n + 1) # initializing the minimum array with zeros
    max_arr = [0] * (n + 1) # initializing the maximum array with zeros
    min_current, max_current = 1, n + 1 # variables for tracking current minimum and maximum values

    for i in range(n):
        if cipher[i] == 'D': 
            # when the character is 'D', we need to go downwards
            min_arr[i] = min_current # the current minimum goes to current index
            min_current += 1 # increment current minimum
        else: 
            # when the character is 'I', we need to go upwards
            max_arr[i] = max_current # the current maximum goes to current index
            max_current -= 1 # decrement current maximum

    # fill the rest of values in arrays
    for i in range(n, -1, -1):
        if min_arr[i] == 0:
            min_arr[i] = min_current
            min_current += 1
        if max_arr[i] == 0:
            max_arr[i] = max_current 
            max_current -= 1

