        Input: <input type="text" id="inputField" required minlength="3">
        <button type="submit">Submit</button>
    </form>

    <div id="status"></div>

    <script>
    $(document).ready(function(){
        $('#dataForm').on('submit', function(e){
            e.preventDefault();

            // Input validation
            var input = $('#inputField').val();
            if(!input || input.length < 3) {
                alert("Input must be at least 3 characters long");
                return;
            }

            // AJAX request
            $.ajax({
                url: 'your_server_url', 
                type: 'POST',
                dataType: 'json',
                data: JSON.stringify({ data: input }),
                contentType: 'application/json; charset=utf-8',
                success: function(data) {
                    $('#status').text("Data submitted successfully");
                },
                error: function(jqXHR, textStatus, errorThrown){
                    $('#status').text("Failed to submit data: " + errorThrown);
                }
            });
        });
    });
    </script>
</body>
</html>
```

