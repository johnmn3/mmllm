<|asst|>
Here is a code that design a custom class in Python programming to store integers, insert integers, delete integers, and check for perfect square.

```python
class IntegerStorage:
    def __init__(self):
        self.storage = []

    def insert_integer(self, num):
        if isinstance(num, int):
            self.storage.append(num)
        else:
            print(f"{num} is not an integer")

    def delete_integer(self, num):
        if num in self.storage:
            self.storage.remove(num)
        else:
            print(f"{num} is not in the storage")
    def is_perfect_square(self, num):
        if num in self.storage:
            if num**0.5 == int(num**0.5):
                return True
            else:
                return False
        else:
            return f"{num} is not in the storage"
```
