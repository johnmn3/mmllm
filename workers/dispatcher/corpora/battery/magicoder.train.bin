&lt;code&gt;
<|end|>
<|asst|>
# Get min and max of each row, while keeping dimensions with np.newaxis
min_val = np.min(arr, axis=1)[:, np.newaxis]
max_val = np.max(arr, axis=1)[:, np.newaxis]

# Rescale each row
result = (arr - min_val) / (max_val - min_val)
# So we finally get:
print(result)
&lt;/code&gt;
