<|asst|>
Sorry for confusion, but the direct translation of Python code to C isn't possible like other higher-level languages (ex. JavaScript). It requires a complete rethinking and reimplementation because Python and C are significantly different. Python is a high-level, interpreted language with a strong emphasis on readability and simplicity. It has high-level data structures and supports operations like list and dictionary comprehensions, multiple types of sorting, etc.

C, on the other hand, is a low-level, compiled language. It lacks built-in high-level data structures and algorithms like heaps, lists, dictionaries, etc. You'd need to implement these data structures and algorithms yourself in C or use a library that provides them.

Therefore, below is the conceptual code in C which you may find helpful:

```C
#include <stdio.h>
#include <stdlib.h>

void push_heap (int *arr, int heap_size, int num) {
    int i, temp;
    arr[heap_size] = num;

    i = heap_size;
    while (i > 0 && arr[(i - 1) / 2] < arr[i]) {
        temp = arr[i];
        arr[i] = arr[(i - 1) / 2];
        arr[(i - 1) / 2] = temp;

        i = (i - 1) / 2;
    }
}

int pop_heap (int *arr, int heap_size) {
    int ret = arr[0], i = 0, temp;
    arr[0] = arr[heap_size - 1];

    while (1) {
        int left_child = 2 * i + 1, right_child = 2 * i + 2;

        if (left_child >= heap_size)
            break;
        else if (right_child >= heap_size) {
            if (arr[i] < arr[left_child]) {
                temp = arr[i];
                arr[i] = arr[left_child];
                arr[left_child] = temp;
            }
            break;
        } else {
            temp = (arr[left_child] > arr[right_child'])? left_child: right_child;
            if (arr[temp] > arr[i]) {
                temp = arr[i];
                arr[i] = arr[temp];
                arr[temp] = temp;
            } else
                break;
        }
    }

    return ret;
}

double getMedian(int num, int *minorHeap, int *majorHeap, int *m, int *n) {
    if (*m > *n) {
        if (num < minorHeap[0]) {
            push_heap(majorHeap, (*n)++, pop_heap(minorHeap, (*m)--));
            push_heap(minorHeap, (*m)++, num);
        } else
            push_heap(majorHeap, (*n)++, num);
        return (minorHeap[0] + majorHeap[0]) / 2.0;
    } else {
        if (num > minorHeap[0]) {
            push_heap(minorHeap, (*m)++, num);
            return (double) minorHeap[0];
        } else {
            push_heap(majorHeap, (*n)++, num);
            if (*n > *m)
                return (double) majorHeap[0];
            else
                return (minorHeap[0] + majorHeap[0]) / 2.0;
        }
    }
}

void print_median(int *arr, int size) {
    int *minorHeap = (int*) calloc(size, sizeof(int));
    int *majorHeap = (int*) calloc(size, sizeof(int));
    int m = 0, n = 0, i;
    double median = 0.0;

    for (i = 0; i < size; i++) {
        median = getMedian(arr[i], minorHeap, majorHeap, &m, &n);
        printf("The median is %f\n", median);
    }

    free(minorHeap);
    free(majorHeap);
}

int main() {
    int arr[] = {5, 15, 10, 20, 30};
    int size = sizeof(arr) / sizeof(arr[0]);
    print_median(arr, size);
    return 0;
}
```

In this provided code we are making a heap and maintaining it to get median while adding a new number.
