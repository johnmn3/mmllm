Formulate a C++ code:

An irregularly shaped array named 'data' is given. This two-dimensional array is comprised of various sub-arrays of random lengths. Also, it is important to note the presence of a string value 'x'. Your assignation is to craft a function that unveils the occurrences of 'x' inside the irregularly shaped array. The operation must yield an array of pairs each reflecting the coordinates {row, index} pinpointing the position of 'x'. Your counter should initiate from 0. In case 'x' is found multiple times within a single sub-array, prioritize the pairs by the ascending order of index.

For your reference, observe the following:
locate_str({
  {"apple","banana"},
  {"orange","apple","kiwi"},
  {"apple","grape"}
}, "apple") == {{0, 0}, {1, 1}, {2, 0}}
locate_str({}, "apple") == {}
locate_str({{}, {"apple"}, {"banana", "apple", "kiwi"}}, "kiwi") == {{2, 2}}
*/
#include<iostream>
#include<vector>
using namespace std;

vector<pair<int, int>> locate_str(vector<vector<string>> data, string x){
<|end|>
<|asst|>
// Defining required variables
vector<pair<int, int>> occurences;

// Iterating over the outer vector's elements
for(int i = 0; i < data.size(); i++){

    // Iterating over inner vector's elements
    for(int j = 0; j < data[i].size(); j++){

        // Check if 'x' is the current element
        if(data[i][j] == x){
            // Add a pair consisting of current indices as a coordinate
            occurences.push_back({i, j});
        }
    }
}

// Return array of pairs
return occurences;
}

int main(){

vector<vector<string>> data = { {"apple","banana"}, {"orange","apple","kiwi"}, {"apple","grape"} };
string x = "apple";

for(auto i : locate_str(data, x)){
    printf("{%d, %d} ", i.first, i.second);
}

return 0;
}
