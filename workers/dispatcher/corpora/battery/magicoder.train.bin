def is_multiply_prime(a):
    def is_prime(n):
        if n < 2:
            return False
        for i in range(2, n):
            if n % i == 0:
                return False
        return True

    factors = []
    for i in range(2, a):
        if a % i == 0 and is_prime(i):
            factors.append(i)
            a //= i
            if len(factors) > 3:
                return False
    return len(factors) == 3 and is_prime(a)

# Test cases
print(is_multiply_prime(30)) # True: 30 = 2 * 3 * 5
print(is_multiply_prime(60)) # False: 60 = 2 * 2 * 3 * 5
