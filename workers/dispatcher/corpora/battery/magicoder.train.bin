To write the equivalent of this Python code in Golang, you'll need to use different libraries such as `database/sql`, `godror` for Oracle database connection, and `gonum`, `plot` for plotting the graphs. Here's the equivalent Go code for the above Python code:

```Go
package main

import (
	"database/sql"
	"fmt"
	"log"

	"github.com/godror/godror"
	"gonum.org/v1/plot"
	"gonum.org/v1/plot/plotter"
	"gonum.org/v1/plot/vg"
)

func connectToDB(user, password, host string, port int, sid string) *sql.DB {
	connStr := fmt.Sprintf("%s/%s@%s:%d/%s", user, password, host, port, sid)
	db, err := sql.Open("godror", connStr)
	if err != nil {
		fmt.Println("Error connecting to the database: ", err)
		return nil
	}
	return db
}

func fetchData(db *sql.DB, query string) (*sql.Rows, error) {
	rows, err := db.Query(query)
	if err != nil {
		fmt.Println("Error fetching data from the database: ", err)
		return nil, err
	}
	return rows, nil
}

func visualizeData(rows *sql.Rows) {
	var col1, col3 []float64
	var col2 []string

	for rows.Next() {
		var v1 float64
		var v2 string
		var v3 float64
		err := rows.Scan(&v1, &v2, &v3)
		if err != nil {
			log.Fatal(err)
		}

		col1 = append(col1, v1)
		col2 = append(col2, v2)
		col3 = append(col3, v3)
	}


	p, err := plot.New()
	if err != nil {
		log.Fatal(err)
	}

	pts := make(plotter.XYs, len(col1))
	for i := range pts {
		pts[i].X = col1[i]
		pts[i].Y = col3[i]
	}
	p.Add(plotter.NewGrid())

	line, err := plotter.NewLine(pts)
	if err != nil {
		log.Fatal(err)
	}
	p.Add(line)
	p.Save(10*vg.Inch, 4*vg.Inch, "points.png")
}

func main() {
	db := connectToDB("my_user", "my_password", "my_host", 1521, "XE")
	defer db.Close()
	rows, _ := fetchData(db, "SELECT * FROM MY_TABLE")
	visualizeData(rows)
}
```

Please make sure to handle errors accordingly in your production level code.

Important note: The `visualizeData` function assumes that the columns are of type float64 and string. You may need to modify it to meet your exact business needs. Also, Go doesn't have a direct equivalent library to pandas. Therefore, the created plot may not look the same as in Python. You may need some additional work to make the plot looks exactly as in the Python plot.
