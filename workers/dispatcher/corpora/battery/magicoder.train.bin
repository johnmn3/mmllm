Could you port this to Go?
def special_rounding(value, low, high):
    # check if the value is a valid number
    try:
        val = float(value)
        l_bound = int(low)
        h_bound = int(high)
    except ValueError:
        return "Error: Invalid input."
    
    # check if the value is within the defined range
    if val < l_bound or val > h_bound:
        return "Error: Out of range."
    
    # special rounding to the nearest integer
    if val >= 0:
        if val - int(val) < 0.5 or int(val) + 1 > h_bound:
            rounded_val = int(val)
        else:
            rounded_val = int(val) + 1   
    else:
        if int(val) - val < 0.5 or int(val) - 1 < l_bound:
            rounded_val = int(val)
        else:
            rounded_val = int(val) - 1
            
    return rounded_val
<|end|>
<|asst|>
You can port this function to Go as follows:

```go
package main

import (
	"errors"
	"fmt"
	"strconv"
)

func specialRounding(value string, low string, high string) (int, error) {
	// check if the value is a valid number
	val, err := strconv.ParseFloat(value, 64)
	if err != nil {
		return 0, errors.New("Error: Invalid input.")
	}

	lBound, err := strconv.Atoi(low)
	if err != nil {
		return 0, errors.New("Error: Invalid input.")
	}

	hBound, err := strconv.Atoi(high)
	if err != nil {
		return 0, errors.New("Error: Invalid input.")
	}

	// check if the value is within the defined range
	if val < float64(lBound) || val > float64(hBound) {
		return 0, errors.New("Error: Out of range.")
	}

	// special rounding to the nearest integer
	var roundedVal int
	if val >= 0 {
		if val-float64(int(val)) < 0.5 || int(val)+1 > hBound {
			roundedVal = int(val)
		} else {
			roundedVal = int(val) + 1
		}
	} else {
		if float64(int(val))-val < 0.5 || int(val)-1 < lBound {
			roundedVal = int(val)
		} else {
			roundedVal = int(val) - 1
		}
	}

	return roundedVal, nil
}

func main() {
	result, err := specialRounding("3.6", "2", "5")
	if err != nil {
		fmt.Println(err)
	} else {
		fmt.Println(result)
	}
}
```
Be aware that Go is strongly typed and does not automatically convert types like Python does, so you need to explicitly convert variables to the required type. Errors are also handled differently in Go; instead of try/except blocks, you should check for errors after each operation that may fail and return the error if one occurred. This code includes a main function to demonstrate how to use the special_rounding function and handle potential errors. The inputs are string because Go doesn't directly provide a way of accepting an unknown datatype. The conversion of string inputs to the relevant datatypes is done within the function.
<|end|>


