Create a basic JavaScript game in which players move through a maze and collect items to reach the end.
<|end|>
<|asst|>
Below is a very basic implementation of a game in JavaScript. This game simply lets a user move a character '@' in a 2D map through the arrow keys and collect items '$'. The game ends when player reaches 'E'.

```javascript
//Define the map
let map = [
  ['#', '#', '#', '#', '#', 'E'],
  ['#', '$', ' ', ' ', '#', '#'],
  ['#', '@', '#', ' ', '#', '#'],
  ['#', ' ', '#', ' ', ' ', '#'],
  ['#', '#', '#', '#', '$', '#'],
];
let xpos = 2, ypos = 1; // start position for '@'

// Function to print the game map
function print_map() {
    return map.map(row => row.join(' ')).join('\n');
}

// Function to handle movement
function move(dir) {
  map[ypos][xpos] = ' ';
  switch(dir) {
    case 'up':
      if (map[ypos - 1][xpos] !== '#') ypos--;
      break;
    case 'down':
      if (map[ypos + 1][xpos] !== '#') ypos++;
      break;
    case 'left':
      if (map[ypos][xpos - 1] !== '#') xpos--;
      break;
    case 'right':
      if (map[ypos][xpos + 1] !== '#') xpos++;
      break;
  }
  switch(map[ypos][xpos]) {
    case '$':
      console.log('You found an item!');
      break;
    case 'E':
      console.log('You reached the end!');
      return true;
  }
  map[ypos][xpos] = '@';
  return false;
}

// Function to start the game
function startGame() {
  console.log(print_map());
  var rl = require('readline').createInterface({
      input: process.stdin,
      output: process.stdout});
  rl.on('line', function(line){
      if(move(line)) rl.close();
      console.log(print_map());
  })
}
startGame();
```

To run the game on your local machine, you need to install node.js and readline package. Save the code into a javascript file, e.g., game.js, and run it with node. Use up, down, left, right keys to move around.

Please note that this is very basic implementation, in reality one might want to use more structured approach and also use a real graphics library to make the game more visually appealing. This game operates completely in console with text commands.
<|end|>


