Split a string into a binary tree of characters in JavaScript, where each node of the tree should contain one character from the string. The order of characters in the tree should follow the same sequence as in the original string. Include functions to traverse the tree in both pre-order and post-order sequences.
<|end|>
<|asst|>
We can define a Binary tree node that will hold a character and link to left and right nodes. For this binary tree, left child will be the next character in the string, and right child will be the character after that:

```javascript
function createCharacterNode(character) {
  return {
    character,
    left: null,
    right: null
  };
}

function constructBinaryTree(string) {
  if (string.length === 0) {
    return null;
  }

  var root = createCharacterNode(string[0]);
  var queue = [root];
  var index = 1;

  while(index < string.length) {
    var currentNode = queue.shift();
    if(index < string.length) {
      currentNode.left = createCharacterNode(string[index++]);
      queue.push(currentNode.left);
    }
    if(index < string.length) {
      currentNode.right = createCharacterNode(string[index++]);
      queue.push(currentNode.right);
    }
  }

  return root;
}
```

The `constructBinaryTree` function takes string as parameter and constructs a binary tree where each node is a character from the string.

For tree traversal in pre-order sequence (root, left, right):

```javascript
function preOrder(node) {
  if (node !== null) {
    console.log(node.character);
    preOrder(node.left);
    preOrder(node.right);
  }
}
```

For post-order sequence traversal (left, right, root):

```javascript
function postOrder(node) {
  if (node !== null) {
    postOrder(node.left);
    postOrder(node.right);
    console.log(node.character);
  }
}
```

Then we can create the binary tree and traverse it like this:

```javascript
var root = constructBinaryTree("HelloWorld");
console.log("PreOrder Traversal:");
preOrder(root);
console.log("PostOrder Traversal:");
postOrder(root);
```

Note that the way tree is constructed, it becomes more of a binary heap where each node's left and right children are filled first before we move to next level. This makes it a complete binary tree and fits with the requirement of character sequence from the string.
<|end|>


