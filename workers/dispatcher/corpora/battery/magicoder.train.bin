<|asst|>
Yes, it is possible to write a similar function in C#. Here's how you could do it:

```csharp
using System;
using System.Linq;
using System.Text.RegularExpressions;

public class Program
{
    public static string UserPasswordCheck(string password, string username, string[] previousPasswords)
    {
        // Check length of password
        if (password.Length < 12 || password.Length > 50)
        {
            return "Invalid";
        }

        // Check if password contains any part of the username
        if (password.Contains(username))
        {
            return "Invalid";
        }

        // Check if password contains more than 3 consecutive identical characters
        if (Regex.IsMatch(password, @"(.)\1{3,}"))
        {
            return "Invalid";
        }

        // Check if password contains special character ('@', '#', '$', '%', '&', '*')
        if (!Regex.IsMatch(password, @"[@#$%&*]"))
        {
            return "Invalid";
        }

        // Check if password contains more than 2 consecutive digits
        if (Regex.IsMatch(password, @"\d{3,}"))
        {
            return "Invalid";
        }

        // Check if password has more than 1 uppercase letter
        if (password.Count(char.IsUpper) <= 1)
        {
            return "Invalid";
        }

        // Check if password has more than 1 lowercase letter
        if (password.Count(char.IsLower) <= 1)
        {
            return "Invalid";
        }

        // Check if password has more than 2 digits
        if (password.Count(char.IsDigit) <= 2)
        {
            return "Invalid";
        }

        // Check if password exists in recent 5 used passwords
        if (previousPasswords.TakeLast(5).Contains(password))
        {
            return "Invalid";
        }

        return "Valid";
    }

    static void Main()
    {
        // Test the function
        string[] prevPasswords = {"password1", "password2", "password3", "password4", "password5"};
        Console.WriteLine(UserPasswordCheck("password123@", "username", prevPasswords));
    }
}
```

Please note that `TakeLast` is a LINQ method available from .NET Core 2.0 and .NET Standard 2.1 onwards.
