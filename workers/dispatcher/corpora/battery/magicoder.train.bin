Write an equivalent for the following in C:
from collections import namedtuple
from typing import List, Tuple

Car = namedtuple("Car", ["index", "entry_time", "exit_time"])

def advanced_ordered_collision_detector(n: int, left_lane_autos: List[Tuple[float, float]], 
                                        right_lane_autos: List[Tuple[float, float]], 
                                        p: List[Tuple[int, int]]) -> List[Tuple[int, ...]]:

    # Create Car tuples for each car in each lane
    left_cars = [Car(i, *times) for i, times in enumerate(left_lane_autos)]
    right_cars = [Car(i, *times) for i, times in enumerate(right_lane_autos)]
    
    collisions = []
    
    # Check for three-car collisions
    for i in range(n):
        for j in range(i + 1, n):
            for k in range(j + 1, n):
                
                # Cars on the left lane
                if are_colliding(left_cars[i], left_cars[j], p) and are_colliding(left_cars[i], left_cars[k], p):
                    collisions.append((i, j, k))
                
                if are_colliding(right_cars[i], right_cars[j], p) and are_colliding(right_cars[i], right_cars[k], p):
                    collisions.append((i, j, k))
    
    # Check for four-car collisions
    if n > 3:
        for i in range(n):
            for j in range(i + 1, n):
                for k in range(j + 1, n):
                    for l in range(k + 1, n):
                        
                        if are_colliding(left_cars[i], left_cars[j], p) and are_colliding(left_cars[i], left_cars[k], p) and are_colliding(left_cars[i], left_cars[l], p):
                            collisions.append((i, j, k, l))

                        if are_colliding(right_cars[i], right_cars[j], p) and are_colliding(right_cars[i], right_cars[k], p) and are_colliding(right_cars[i], right_cars[l], p):
                            collisions.append((i, j, k, l))

                        
    return collisions
  
def are_colliding(car1, car2, p):
    car_distance = p[car2.index][0] - p[car1.index][0]
    
    # Calculate the times when both cars are in the same lane
    joint_entry = max(car1.entry_time, car2.entry_time)
    joint_exit = min(car1.exit_time, car2.exit_time)
    
    if joint_entry >= joint_exit:  # No overlap
        return False

    # Calculate the time it takes for car1 to reach car2's starting position
    car1_time = car_distance / car_speed

    # If car1 reaches car2's starting position within the joint travelling time, they collide
    return joint_entry <= car1_time < joint_exit
<|end|>
<|asst|>
There is no direct analog to Python's namedtuple in C, but structures can be used. Here is your Python code rewritten in C:

```c
// Defining the Car Struct
typedef struct Car {
    int index;
    float entry_time;
    float exit_time;
} Car;

// Defining the function "are_colliding"
int are_colliding(Car car1, Car car2, float car_speed, int p[][2]) {
    float car_distance = p[car2.index][0] - p[car1.index][0];
    
    float joint_entry = fmax(car1.entry_time, car2.entry_time);
    float joint_exit = fmin(car1.exit_time, car2.exit_time);
    
    if (joint_entry >= joint_exit) 
        return 0;
   
    float car1_time = car_distance / car_speed;
  
    return joint_entry <= car1_time && car1_time < joint_exit;
}

void advanced_ordered_collision_detector(int n, Car left_lane_autos[], Car right_lane_autos[], int p[][2], int **collisions) {
    // The variable to store the size of collisions array
    int s = 0;
    
    // Check for three-car collisions
    for(int i = 0; i < n; i++) {
        for(int j = i + 1; j < n; j++) {
            for(int k = j + 1; k < n; k++) {
                 
                // Cars on the left lane
                if (are_colliding(left_lane_autos[i], left_lane_autos[j], p) && are_colliding(left_lane_autos[i], left_lane_autos[k], p)) {
                    collisions[s][0] = i;
                    collisions[s][1] = j;
                    collisions[s][2] = k;
                    s++;
                }
                
                if (are_colliding(right_lane_autos[i], right_lane_autos[j], p) && are_colliding(right_lane_autos[i], right_lane_autos[k], p)) {
                    collisions[s][0] = i;
                    collisions[s][1] = j;
                    collisions[s][2] = k;
                    s++;
                }
            }
        }
    }
    
    // Check for four-car collisions
    if(n > 3) {
        for(int i = 0; i < n; i++) {
            for(int j = i + 1; j < n; j++) {
                for(int k = j + 1; k < n; k++) {
                    for(int l = k + 1; l < n; l++) {
                        if (are_colliding(left_lane_autos[i], left_lane_autos[j], p) && are_colliding(left_lane_autos[i], left_lane_autos[k], p) && are_colliding(left_lane_autos[i], left_lane_autos[l], p)) {
                            collisions[s][0] = i;
                            collisions[s][1] = j;
                            collisions[s][2] = k;
                            collisions[s][3] = l;
                            s++;
                        }
                        if (are_colliding(right_lane_autos[i], right_lane_autos[j], p) && are_colliding(right_lane_autos[i], right_lane_autos[k], p) && are_colliding(right_lane_autos[i], right_lane_autos[l], p)) {
                            collisions[s][0] = i;
                            collisions[s][1] = j;
                            collisions[s][2] = k;
                            collisions[s][3] = l;
                            s++;
                        }
                    }
                }
            }
        }
    }
    
    // Reallocating the size of collisions array to the correct size
    collisions = (int **)realloc(collisions, s * sizeof(int *));
}
```
Note: Given that C does not have support for dynamic-size arrays, arrays must be passed into the `advanced_ordered_collision_detector` function with a known size large enough to handle the predictable maximum amount of collisions, and then later be resized with `realloc` based on the actual number of collisions found. This resizing allows for memory efficiency.
<|end|>


