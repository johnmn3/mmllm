The Python script you posted is full of errors due to poor OCR recognition. Here's what it might look like if those errors are corrected:

```python
import collections
from typing import List

# Find all distinct balanced bracket sequences of given length:
def balanced_bracket_sequences(n: int) -> int:
    if n % 2 != 0:
        return 0

    dp = [0 for _ in range(n+1)]
    dp[0] = 1

    for i in range(2, n+1, 2):
        for j in range(0, i-1, 2):
            dp[i] += dp[j] * dp[i-2-j]

    return dp[n]

# Count unique subsequences of a specified substring in the main string, using Trie data structure:
def unique_subsequences(string: str, substring: str) -> int:
    dp = [0] * (len(string)+1)
    dp[0] = 1
    last_occurrence = collections.defaultdict(int)

    for i, char in enumerate(string, start=1):
        dp[i] = 2 * dp[i-1]
        if char in last_occurrence:
            dp[i] -= dp[last_occurrence[char] - 1]
        last_occurrence[char] = i

    return dp[-1] - sum(unique_subsequences(string[i+1:], substring) for i, char in enumerate(string) if char == substring[0])

# Identify all substrings of a given string where frequency of each character in substring is a prime number:
def find_substrings_with_prime_freq_chars(string: str) -> List[str]:
    def is_prime(n):
        if n < 2:
            return False
        for i in range(2, int(n**0.5) + 1):
            if n % i == 0:
                return False
        return True

    def find_substrings(string, freq):
        substrings = []
        for i in range(len(string)):
            for j in range(i+1, len(string)+1):
                prime_freq = True
                for k, v in collections.Counter(string[i:j]).items():
                    if not is_prime(v):
                        prime_freq = False
                        break
                if prime_freq:
                    substrings.append(string[i:j])
        return substrings

    return find_substrings(string, collections.Counter(string))
```

Note: This code seems to be correct logically, but its performance may not be optimal for large inputs, especially for the `unique_subsequences` and `find_substrings_with_prime_freq_chars` functions, which have some inherent time complexity due to the nature of the problems they are trying to solve.
