    for c in s:
        if 'A' <= c <= 'Z':
            count_upper += 1
            lower_str += chr(ord(c) + 32)
        else:
            lower_str += c
    return lower_str, count_upper

input_str = "HeLLo WoRLD"
lower_str, count_upper = to_lower(input_str)

print("Lowercase String: ", lower_str)
print("Number of uppercase letters: ", count_upper)
