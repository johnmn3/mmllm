<|asst|>
Here is the C++ implementation for the above Python function:

```cpp
#include <vector>
#include <utility>
#include <algorithm>

std::pair<std::vector<int>, std::vector<int>> rolling_max(std::vector<int> numbers1, std::vector<int> numbers2) {
    std::vector<int> maxNumbers1, maxNumbers2;
    
    if(!numbers1.empty()){
        maxNumbers1.push_back(numbers1[0]);
    
        for(int i=1;i<numbers1.size();++i){
            maxNumbers1.push_back(std::max(maxNumbers1[i-1], numbers1[i]));
        }
    }

    if(!numbers2.empty()){
        maxNumbers2.push_back(numbers2[0]);

        for(int i=1;i<numbers2.size();++i){
            maxNumbers2.push_back(std::max(maxNumbers2[i-1], numbers2[i]));
        }
    }
    return std::make_pair(maxNumbers1, maxNumbers2);
}
```

