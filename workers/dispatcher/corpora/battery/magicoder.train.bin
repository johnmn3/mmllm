def identify_palindrome_segments(string: str) -> List[str]:
    """
    This function accepts a string as an input, isolates and returns all distinctive palindromic segments and also calculates their collective quantity. The result should be a tuple encompassing the array of palindromic segments and the count of these segments.

    >>> identify_palindrome_segments('abba')
    (['a', 'b', 'bb', 'abba'], 4)
    >>> identify_palindrome_segments('racecar')
    (['r', 'aceca', 'c', 'e', 'cecec', 'a', 'racecar'], 9)
