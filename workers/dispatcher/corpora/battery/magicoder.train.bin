how would this be implemented in go?
import java.util.*;

class Solution {
    static Map<Integer, Integer> cache = new HashMap<>();

    public static int trifib(int n) {
        if (n == 0) {
            return 0;
        }
        if (n == 1) {
            return 0;
        }
        if (n == 2) {
            return 1;
        }
        if (cache.containsKey(n)) {
            return cache.get(n);
        }

        int res = trifib(n - 1) + trifib(n - 2) + 2 * trifib(n - 3);
        cache.put(n, res);
        return res;
    }

    public static void main(String args[]) {
        int n = 20; // Element of the sequence to compute
        long startTime = System.currentTimeMillis();
        int result = trifib(n);
        long endTime = System.currentTimeMillis();

        System.out.println("The " + n + "th number in the tri-fibonacci sequence is: " + result);
        System.out.println("Computation time: " + (endTime - startTime) + "ms");
    }
}
<|end|>
<|asst|>
In Go, you would use a map for caching, and recursion to compute the trifibonacci sequence:

```go
package main

import (
	"fmt"
	"time"
)

var cache = make(map[int]int)

func trifib(n int) int {
	if n == 0 {
		return 0
	}
	if n == 1 {
		return 0
	}
	if n == 2 {
		return 1
	}
	val, ok := cache[n]
	if ok {
		return val
	}

	res := trifib(n-1) + trifib(n-2) + 2*trifib(n-3)
	cache[n] = res
	return res
}

func main() {
	n := 20 // Element of the sequence to compute
	startTime := time.Now()
	result := trifib(n)
	endTime := time.Now()

	fmt.Printf("The %dth number in the tri-fibonacci sequence is: %d\n", n, result)
	fmt.Printf("Computation time: %dms\n", endTime.Sub(startTime).Milliseconds())
}
```
The Go version behaves functionally the same as the Java version, using a cache to improve performance when computing the nth element of the trifibonacci sequence.
<|end|>


