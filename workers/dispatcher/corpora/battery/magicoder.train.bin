```python
from typing import Tuple

def is_palindrome(s: str) -> bool:
    return s == s[::-1]

def custom_mix_strings_advanced(s1: str, s2: str, s3: str) -> Tuple[str, bool]:
    mixed_string = ""
    s1_palindrome = is_palindrome(s1)

    if s1_palindrome:
        mixed_string += s1
    else:
        s1, s2, s3 = map(list, [s1, s2, s3])

    while s1 or s2 or s3:
        for s in (s1, s2, s3):
            while s:
                c = s.pop(0)
                if c.isalpha():
                    mixed_string += c
                    break

    return mixed_string[::-1], is_palindrome(mixed_string)


if __name__ == "__main__":
