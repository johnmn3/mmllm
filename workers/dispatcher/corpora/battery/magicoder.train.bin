import re

def extract_data(str):
    if ' ' in str or ';' in str:
        return re.split(' |;', str)
    else:
        upper_case_count = sum(1 for i in range(len(str)) if str[i].isupper() and i%2==0)
        digits_sum = sum(int(i) for i in str if i.isdigit() and int(i)%2!=0)
        return upper_case_count + digits_sum
