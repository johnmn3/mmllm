Create a JavaScript function `evaluateExpression()` which takes an arithmetic expression string as input, and evaluates the expression considering the operator precedence: multiplication (*) and division (/) have higher precedence than addition (+) and subtraction (-). This function should be able to handle floating-point numbers and multiple digits in the expression.

For example, the input for the function should be a string like this: "7 + 4 * 3 - 6 / 2".
The output should be the result of the expression and in this case, it should be 13.

Note: Do not use JavaScript's `eval()` function to solve this problem.
<|end|>
<|asst|>
Here is a JavaScript solution using stacks to solve this problem. It avoids the usage of eval() function. The function interpretOperator() is used to perform the appropriate arithmetic operation based on the operator.

```javascript
function evaluateExpression(expression) {
  let tokens = expression.split(' ');
  let operandStack = [];
  let operatorStack = [];

  const precedence = {
    '+': 1,
    '-': 1,
    '*': 2,
    '/': 2
  };

  const interpretOperator = (operator, leftOperand, rightOperand) => {
    switch (operator) {
      case '+':
        return leftOperand + rightOperand;
      case '-':
        return leftOperand - rightOperand;
      case '*':
        return leftOperand * rightOperand;
      case '/':
        return leftOperand / rightOperand;
      default:
        return rightOperand;
    }
  };

  for (let token of tokens) {
    if (!precedence.hasOwnProperty(token)) {
      operandStack.push(Number(token));
      continue;
    }

    while (operatorStack.length 
           && precedence[token] <= precedence[operatorStack[operatorStack.length - 1]]) {

      let operator = operatorStack.pop();
      let rightOperand = operandStack.pop();
      let leftOperand = operandStack.pop();

      let result = interpretOperator(operator, leftOperand, rightOperand);
      operandStack.push(result);
    }

    operatorStack.push(token);
  }

  while (operatorStack.length) {
    let operator = operatorStack.pop();
    let rightOperand = operandStack.pop();
    let leftOperand = operandStack.pop();

    let result = interpretOperator(operator, leftOperand, rightOperand);
    operandStack.push(result);
  }

  return operandStack[0];
}

console.log(evaluateExpression("7 + 4 * 3 - 6 / 2")); // Outputs: 13
```

Please note that this solution assumes that the input will be a valid arithmetic expression.
