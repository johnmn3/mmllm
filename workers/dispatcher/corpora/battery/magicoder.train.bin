<path d="M15.945 8.03264C16.8413 5.82252 19.0792 4.46426 21.7397 4.5007C23.94 4.53084 25.9098 5.43738 27.0266 6.90497C27.535 6.71434 27.9123 6.2557 27.9866 5.7011C26.5176 3.98434 24.1681 3.03383 21.7603 3.00085C18.5808 2.95729 15.7187 4.59909 14.555 7.46896C14.3993 7.85281 14.5843 8.29017 14.9682 8.44583C15.352 8.60149 15.7894 8.4165 15.945 8.03264Z" fill="#5092FF"/>
