Your OCR converted code has a lot of character recognition errors. I have corrected the code as per Python syntax and correct function definitions. Here is the corrected version of your code:

```python
import colorsys
from skimage import color

# Function to convert color model from RGB to HSV
def RGB_to_HSV(r, g, b):

    if ((r<0 or r>255) or (g<0 or g>255) or (b<0 or b>255)):
        return("Invalid R6B input. Values should be between 0 and 255.")

    r, g, b = r / 255.0, g / 255.0, b / 255.0
    h, s, v = colorsys.rgb_to_hsv(r, g, b)
    return(h * 360, s, v)

# Function to convert color model from HSV to RGB
def HSV_to_RGB(h, s, v):

    if ((h<0 or h>360) or (s<0 or s>1) or (v<0 or v>1)):
        return("Invalid HSV input. For H, values should be between 0 and 360. For S and V, values should be between 0 and 1.")

    r, g, b = colorsys.hsv_to_rgb(h / 360, s, v)
    return(int(r * 255), int(g * 255), int(b * 255))

# Function to convert RGB to CIELAB
def RGB_to_CIELAB(r, g, b):
    
    if (r<0 or r>255) or (g<0 or g>255) or (b<0 or b>255):
        return("Invalid RGB input. Values should be between 0 and 255.")

    r, g, b = r / 255.0, g / 255.0, b / 255.0
    lab = color.rgb2lab([[[r, g, b]]])
    return(lab[0][0][0], lab[0][0][1], lab[0][0][2])

# Function to convert CIELAB to RGB
def CIELAB_to_RGB(l, a, b):

    if ((l<0 or l>100) or (a<-128 or a>127) or (b<-128 or b>127)):
        return("Invalid CIELAB input. For L*, values should be between 0 and 100. For a* and b*, values should be between -128 and 127.")

    rgb = color.lab2rgb([[[l, a, b]]])
    return(int(rgb[0][0][0]*255), int(rgb[0][0][1]*255), int(rgb[0][0][2]*255))

# Function to convert HSV to CIELAB
def HSV_to_CIELAB(h, s, v):

    r, g, b = HSV_to_RGB(h, s, v)
    return RGB_to_CIELAB(r, g, b)

print(RGB_to_HSV(123, 45, 67))
print(HSV_to_RGB(206.91, 0.64, 0.48))
print(RGB_to_CIELAB(123, 45, 67))
print(CIELAB_to_RGB(29.66, 19.79, -10.18))
print(HSV_to_CIELAB(206.91, 0.64, 0.48))
```
In the line `r, g, b = n / 2S5,0, g / 255.0, b / 255.0` there was no 'n' defined before, so we cannot use it here and moreover, the code won't make any sense here so I replaced 'n' with 'r'. I made similar corrections based on the context and made sure that sense of the code is still retained. Please check the functionality of the program to ensure correct implementation as per your requirements.
