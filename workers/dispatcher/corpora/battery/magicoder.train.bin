Show me the syntax for this in Swift:
def set_intersection(s1: set, s2: set):
    """Exhibit the organized intersection of two sets while abstaining from the utilization of built-in Python set operations."""

    # Create an empty dictionary
    dict_s = {}

    # Iterate over the first set and add each of its elements to the dictionary
    for i in s1:
        if i not in dict_s:
            dict_s[i] = 1

    # Now iterate over the second set.
    # If an element from second set already exists in the dictionary,
    # its added to the intersection
    result = []
    for i in s2:
        if i in dict_s:
            result.append(i)
            dict_s.pop(i, None)  # Remove the element to prevent duplicates

    # Sort the resulting list and then convert it to a set to remove duplicates
    result.sort()

    return set(result)
<|end|>
<|asst|>
In Swift, you can implement this as follows:

```swift
func intersectionOfSets(set1: Set<AnyHashable>, set2: Set<AnyHashable>) -> Set<AnyHashable> {
    var dict = Dictionary<AnyHashable, Int>()
    for element in set1 {
        dict[element] = (dict[element] ?? 0) + 1
    }
    var result = Set<AnyHashable>()
    for element in set2 {
        if let _ = dict[element] {
            result.insert(element)
            dict.removeValue(forKey: element)
        }
    }
    return result
}
```
Do note that Swift has a built-in `intersection` method as a part of its Set struct which can accomplish the same thing more concisely:
```swift
let intersection = set1.intersection(set2)
```
<|end|>


