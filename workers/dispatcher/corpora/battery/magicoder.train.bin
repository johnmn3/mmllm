    n = len(arr)
    if n == 0:
        return True

    values_count = 0
    values_sum = 0
    start_value = arr[0]
    for i in range(1, n):
        if arr[i] != start_value:
            values_count += 1
            values_sum += arr[i]

    # Check operation times, here I used bubble sort, it will count how many numbers are smaller than the previous one.
    swap_count = 0
    for i in range(n):
        for j in range(0, n-i-1):
            if arr[j] > arr[j+1]:
                arr[j], arr[j+1] = arr[j+1], arr[j]
                swap_count += 1
    if swap_count < n:
        return False

    # Check if it meets other number counts and prime sum requirements
    if values_count % 2 == 1 or is_prime(values_sum):
        return True

    return False
