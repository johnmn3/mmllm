```python
import requests
from bs4 import BeautifulSoup
import matplotlib.pyplot as plt
import nltk
from collections import Counter
from nltk.corpus import stopwords
nltk.download('punkt')
nltk.download('stopwords')

# Step 1 : Fetching the content from the URL
url = "https://www.gutenberg.org/files/1342/1342-0.txt"
content = requests.get(url).text

# Step 2 : Cleaning the text data and breaking it into words
soup = BeautifulSoup(content)
for script in soup(["script", "style"]):
    script.extract()
text = soup.get_text()
tokens = nltk.word_tokenize(text)
words = [word for word in tokens if word.isalpha()]
stop_words = set(stopwords.words('english'))
words = [word.lower() for word in words if word.lower() not in stop_words]

# Step 3 : Counting word occurrences
wordcount = Counter(words)

# Step 4: Visualizing the occurrences
common = wordcount.most_common(10)
labels = [_[0] for _ in common]
counts = [_[1] for _ in common]
plt.figure(figsize=(15,5))
plt.bar(labels,counts)
plt.show()

# Step 5: Calculating and identifying the most common word
most_common = wordcount.most_common(1)
print(f'The most common word is "{most_common[0][0]}" and it occurs {most_common[0][1]} times.')

# Step 6: Searching for specific words ("love" in this case)
print(f'The word "love" is mentioned {wordcount["love"]} times.')
```

This code fetches the document from the specified URL, cleans it by removing all non-textual elements, tokenizes it into words, and calculates the frequency of each word. It then creates a bar graph to visualize the frequencies of the top 10 most occurring words, identifies the most frequent word, and counts the occurrences of the word "love".

