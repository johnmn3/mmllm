Help me turn this into C# code:
from google.cloud import pubsub_v1
from google.cloud import storage
import pandas as pd
from io import BytesIO

# The name of the Cloud Pub/Sub topic.
topic_name = 'your-topic-name'

# Google Cloud Storage Bucket Name
bucket_name = 'your-bucket-name'

def receive_messages(project, subscription_name):
    """Receives messages from a Pub/Sub topic."""
    subscriber = pubsub_v1.SubscriberClient()
    subscription_path = subscriber.subscription_path(project, subscription_name)

    def callback(message):
        print(f'Received {message}.')
        data = message.data
        store_data_in_gcs(data)
        message.ack()

    subscriber.subscribe(subscription_path, callback=callback)
    print(f'Listening for messages on {subscription_path}..\n')

def store_data_in_gcs(data):
    """Stores data into a Google Cloud Storage."""
    storage_client = storage.Client()
    bucket = storage_client.get_bucket(bucket_name)
    blob = bucket.blob('datafile.txt')
    blob.upload_from_string(data)
    print(f'Successfully stored data into {bucket_name} bucket.\n')
   
def convert_to_parquet():
    """Reads from the GCS bucket and convert the data to parquet format."""
    storage_client = storage.Client()
    bucket = storage_client.get_bucket(bucket_name)
    blob = storage.Blob('datafile.txt', bucket)
    content = blob.download_as_text()
    
    # here we suppose the content is CSV formatted
    df = pd.read_csv(BytesIO(content))
    df.to_parquet('datafile.parquet')
    print('Successfully converted data to parquet format.\n')

def main():
    project_id = "your-project-id"
    subscription_name = "your-subscription-name"
    receive_messages(project_id, subscription_name)
    convert_to_parquet()

if __name__ == "__main__":
    main()
I'm new to C#, could you include explanations in the code?
