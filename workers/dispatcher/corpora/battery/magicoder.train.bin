Translate this to C# while keeping the logic the same:
def search(lst):
    freq = {}
    for num in lst:
        if num in freq:
            freq[num] += 1
        else:
            freq[num] = 1
    greatest = -1
    for num, count in freq.items():
        if count >= num*num:
            greatest = max(greatest, num)
    return greatest
It would be helpful if you could annotate the C# code.
<|end|>
<|asst|>
Absolutely, here's how you could translate the given Python code to C#. I've included comments in the C# code for documentation:

```csharp
using System;
using System.Collections.Generic;

public class Program
{
    public static void Main()
    {

        List<int> lst = new List<int> {1, 2, 3, 4, 4, 4, 5, 5, 5, 5, 5};
        Console.WriteLine(Search(lst));
    }

    // Method equivalent to the given Python function
    static int Search(List<int> lst)
    {
        // Dictionary to store frequency of numbers
        Dictionary<int, int> freq = new Dictionary<int, int>();

        // Loop to calculate frequency of each number in list
        foreach (var num in lst)
        {
            if (freq.ContainsKey(num))
            {
                freq[num] += 1; // increment count if key already exists
            }
            else
            {
                freq[num] = 1; // add key with value 1 if it doesn't exist
            }
        }

        // Variable to store the greatest number
        int greatest = -1;

        // Loop through each item in frequency dictionary
        foreach(KeyValuePair<int, int> entry in freq)
        {
            // Check if count >= num * num
            if (entry.Value >= entry.Key * entry.Key)
            {
                // Update greatest with the maximum value between current greatest and num
                greatest = Math.Max(greatest, entry.Key);
            }
        }

        // Return the greatest number
        return greatest;
    }
}
```

