  <head>
    <title>Assignment</title>
    <style>
        .column {
            float: left;
            width: 50%;
            padding: 10px;
        }
        /* Clear style applied to: */
        .row::after {
            content: "";
            clear: both;
            display: table;
        }
    </style>
  </head>
  <body>
    <div class="row">
      <div class="column">
