for i, row in df.iterrows():
    if np.isnan(row["Y"]):
        df.at[i, "Y"] = interpolate(df["X"].values, df["Y"].values, row["X"])

# Detect outliers using Z-scores    
df["Z_Scores"] = zscore(df["X"])
df_outliers = df[np.abs(df["Z_Scores"]) >= 3]

print("Outliers: ")
print(df_outliers)
