Here's the Go version of your Python code. Please check the comments for detailed explanations:

```go
package main

import (
	"fmt"
	"strconv"
)

func atmospheric_ascent(q []int, w int, n int, p int) bool {

    // Function to check if array values combined form a palindrome
    is_palindrome := func(q []int) bool {
        s := ""
        for _, v := range q {
            s += strconv.Itoa(v)
        }
        r := reverse(s)
        return s == r
    }

    // Function to check if a number is prime
    is_prime := func(num int) bool {
        if num > 1 {
            for i := 2; i < num; i++ {
                if num%i == 0 {
                    return false
                }
            }
            return true
        }
        return false
    }

    sum_q := 0 // Calculating sum of all elements in array q
    for _, v := range q {
        sum_q += v
    }

    distinct := make(map[int]bool) // Creating a map to track distinct numbers in array q
    for _, v := range q {
        distinct[v] = true
    }
    distinct_min_nums := len(distinct)

    prime_count := 0 // Counter for prime numbers in array q
    for _, v := range q {
        if is_prime(v) {
            prime_count++
        }
    }

    // Returning true if all conditions are satisfied, otherwise false
    if sum_q <= w && is_palindrome(q) && distinct_min_nums == n && prime_count >= p {
        return true
    } else {
        return false
    }
}

func reverse(s string) string {
    runes := []rune(s)
    for i, j := 0, len(runes)-1; i < j; i, j = i+1, j-1 {
        runes[i], runes[j] = runes[j], runes[i]
    }
    return string(runes)
}

func main() {
    fmt.Println(atmospheric_ascent([]int{1, 2}, 5, 2, 0)) // ➞ False 
    fmt.Println(atmospheric_ascent([]int{3, 2, 3}, 1, 2, 1)) // ➞ False
    fmt.Println(atmospheric_ascent([]int{3, 2, 3}, 9, 2, 1)) // ➞ True
    fmt.Println(atmospheric_ascent([]int{3}, 5, 1, 1)) // ➞ True
}

``` 
