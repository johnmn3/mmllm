ddf = dd.from_pandas(bq_client.query(sql).to_dataframe(), npartitions=2)

# calculate average and standard deviation
mean = ddf.mean().compute()
stddev = ddf.std().compute()

# detect outliers based on threshold
outliers = ddf[(ddf - mean).abs() > outlier_threshold * stddev]

# convert outliers to pandas for plotting
outliers_pd = outliers.compute()

# create a plot using plotly
fig = px.scatter(outliers_pd, x=outliers_pd.index, y=outliers_pd.values)

# show the plot
fig.show()
<|end|>
