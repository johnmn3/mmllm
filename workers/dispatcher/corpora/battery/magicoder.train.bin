Adapt this snippet to Rust syntax:
def maxPath(grid, k):
    n = len(grid)
    directions = [[-1, 0], [1, 0], [0, -1], [0, 1]] 
    visited = [[False for _ in range(n)] for __ in range(n)]
    maxPathValue = 0
    maxPathList = []

    def DFS(i, j, path):
        nonlocal maxPathValue, maxPathList
        if len(path) > maxPathValue:
            maxPathValue = len(path)
            maxPathList = path[:]

        visited[i][j] = True
        for direction in directions:
            x, y = i + direction[0], j + direction[1]
            if 0 <= x < n and 0 <= y < n and not visited[x][y] and grid[x][y] not in path:
                path.append(grid[x][y])
                DFS(x, y, path)
                path.pop()
        visited[i][j] = False

    for i in range(n):
        for j in range(n):
            DFS(i, j, [grid[i][j]])

    return maxPathValue, maxPathList
<|end|>
<|asst|>
Here is the adapted snippet for Rust:

```rust
fn max_path(grid: &Vec<Vec<i32>>, k: i32) -> (usize, Vec<i32>) {
    let n = grid.len();
    let directions = vec![vec![-1, 0], vec![1, 0], vec![0, -1], vec![0, 1]];
    let mut visited: Vec<Vec<bool>> = vec![vec![false; n]; n];
    let mut max_path_value: usize = 0;
    let mut max_path_list: Vec<i32> = Vec::new();

    fn dfs(i: usize, j: usize, path: &mut Vec<i32>, visited: &mut Vec<Vec<bool>>, directions: &Vec<Vec<i32>>, grid: &Vec<Vec<i32>>, max_path_value: &mut usize, max_path_list: &mut Vec<i32>){
        if path.len() > *max_path_value {
            *max_path_value = path.len();
            *max_path_list = path.clone();
        }
        visited[i][j] = true;
        for direction in directions {
            let x: isize = i as isize + direction[0];
            let y: isize = j as isize + direction[1];
            if x >= 0 && y >= 0 && x < n as isize && y < n as isize && !visited[x as usize][y as usize] && !path.contains(&grid[x as usize][y as usize]) {
                path.push(grid[x as usize][y as usize]);
                dfs(x as usize, y as usize, path, visited, directions, grid, max_path_value, max_path_list);
                path.pop();
            }
        }
        visited[i][j] = false;
    }

    for i in 0..n {
        for j in 0..n {
            dfs(i, j, &mut vec![grid[i][j]], &mut visited, &directions, &grid, &mut max_path_value, &mut max_path_list);
        }
    }
    return (max_path_value, max_path_list);
}
```
The primary differences are related to the memory ownership and the static typing enforced by Rust. Rust doesn't allow dynamic typing or modifying the memory directly. So we need to declare and initialize variables in an alternate way. Furthermore, Rust doesn't have an equivalent to Python's nonlocal keyword, so we have to pass those variables as mutable references into the dfs function.
<|end|>


