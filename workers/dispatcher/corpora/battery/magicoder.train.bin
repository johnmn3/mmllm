## Code: main.py
```python
## main.py
from flask import Flask, request, jsonify
from ab_test import ABTest

app = Flask(__name__)

ab_test = None

@app.route('/start', methods=['POST'])
def start():
    global ab_test
    data = request.get_json()
    api_service_1 = data.get('api_service_1')
    api_service_2 = data.get('api_service_2')
    ab_test = ABTest(api_service_1, api_service_2)
    ab_test.start_test()
    return jsonify({'message': 'AB testing started successfully'}), 200

@app.route('/stop', methods=['POST'])
def stop():
    global ab_test
    if ab_test is not None:
        ab_test.stop_test()
        return jsonify({'message': 'AB testing stopped successfully'}), 200
    else:
        return jsonify({'message': 'No AB testing in progress'}), 400

@app.route('/results', methods=['GET'])
def results():
    global ab_test
    if ab_test is not None:
        results = ab_test.get_results()
        return jsonify(results), 200
    else:
        return jsonify({'message': 'No AB testing in progress'}), 400

if __name__ == '__main__':
    app.run(debug=True)
```
Note: The actual implementation of the ABTest class and its methods is not provided in this file. It should be implemented in 'ab_test.py' as per the project structure.
