Swift currently doesn't have a direct package to interact with Google BigQuery as Python does. Therefore, you'd need to make API requests using URLSession or Alamofire instead. Here's an example how to do this. I also translated the formatting and the date handling parts:

```swift
import Foundation

let dateFormatter = DateFormatter()
dateFormatter.dateFormat = "yyyyMMdd"

let current_date = Date()
let formatted_current_date = dateFormatter.string(from: current_date)

let seven_days_ago = Calendar.current.date(byAdding: .day, value: -7, to: current_date)!
let formatted_seven_days_ago = dateFormatter.string(from: seven_days_ago)

let query = """
    SELECT * 
    FROM `project.dataset.user_logs_*` 
    WHERE _TABLE_SUFFIX BETWEEN '\(formatted_seven_days_ago)' AND '\(formatted_current_date)'
"""

let url = URL(string: "https://bigquery.googleapis.com/bigquery/v2/projects/projectId/queries")!
var request = URLRequest(url: url)
request.httpMethod = "POST"

let params: [String: Any] = ["query": query, "useLegacySql": false]
let jsonData = try? JSONSerialization.data(withJSONObject: params)

request.httpBody = jsonData
request.addValue("Bearer YOUR_AUTH_TOKEN", forHTTPHeaderField: "Authorization") //you need to replace YOUR_AUTH_TOKEN with your actual token
request.addValue("application/json", forHTTPHeaderField: "Content-Type")

let task = URLSession.shared.dataTask(with: request) { (data, response, error) in
    guard let data = data else {
        print(String(describing: error))
        return
    }
    
    do {
        if let json = try JSONSerialization.jsonObject(with: data, options: .mutableContainers) as? [String: Any] {
            print(json)
        }
    } catch let error {
        print(error.localizedDescription)
    }
}

task.resume()
```

This example may need to be refined for your particular use case. And again, Swift currently lacks official support for BigQuery services. You will need to manage the authentication part on your own - replacing `YOUR_AUTH_TOKEN` with your actual token.

Don't forget to replace `projectId` part with your actual project id in URL.
<|end|>


