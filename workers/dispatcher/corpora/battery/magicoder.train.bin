Sure, I can enhance the system as per your requirements. Here is an updated version of the given classes.

```java
import java.util.ArrayList;
import java.util.HashMap;

class Player {
    String name;
    int age;
    String club; 
    String position;
    int performanceScore;

    public Player(String name, int age, String club, String position, int performanceScore) {
        this.name = name;
        this.age = age;
        this.club = club;
        this.position = position;
        this.performanceScore = performanceScore;
    }
    
    public void updateScore(int score) {
        this.performanceScore += score;
    }

    public void displayPlayerInfo() {
        System.out.println("Name: " + name + ", Age: " + age + ", Club: " + club + ", Position: " + position + ", Performance Score: " + performanceScore);
    }
}

class Club {
    String clubName;
    String location;
    ArrayList<Player> players;
    int totalScore;

    public Club(String clubName, String location) {
        this.clubName = clubName;
        this.location = location;
        this.players = new ArrayList<Player>();
    }

    public void addPlayer(Player player) {
        players.add(player);
    }
    
    public int calculateTotalScore() {
        for(Player player : players) {
            totalScore += player.performanceScore;
        }
        return totalScore;
    }
    
    public void removePlayer(String playerName) {
        players.removeIf(player -> player.name.equals(playerName));
    }

    public void transferPlayer(Player player, Club toClub) {
        this.removePlayer(player.name);
        toClub.addPlayer(player);
    }

    public void displayClubInfo() {
        System.out.println("Club: " + clubName + ", Location: " + location);
        System.out.println("Players:");
        for (Player player : players) {
            player.displayPlayerInfo();
        }
    }
}

class PremierLeague {
    HashMap<String, Club> clubs;

    public PremierLeague() {
        clubs = new HashMap<String, Club>();
    }

    public void addClub(Club club) {
        clubs.put(club.clubName, club);
    }

    public void removeClub(String clubName) {
        clubs.remove(clubName);
    }

    public void displayPremierLeagueInfo() {
        System.out.println("Premier League Clubs:");
        for (Club club : clubs.values()) {
            club.displayClubInfo();
        }
    }
    
    public Club getClubByName(String name) {
        return clubs.get(name);
    }
    
    public void searchPlayerByAge(int age) {
        for (Club club : clubs.values()) {
            club.players.stream()
                    .filter(player -> player.age == age)
                    .forEach(Player::displayPlayerInfo);
        }
    }
    
    public void searchPlayerByPosition(String position) {
        for (Club club : clubs.values()) {
            club.players.stream()
                    .filter(player -> playerposition.equalsIgnoreCase(position))
                    .forEach(Player::displayPlayerInfo);
        }
    }
}
```
As per your requirement, I have added the implementation of transfer of a player from one club to another, calculating club's total score and ability to search players based on age as well as their playing position.
<|end|>


