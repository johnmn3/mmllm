Enhance the given coding challenge:

Complete the code below:

def advanced_sort(l: list, n: int):
    """
    This function accepts a list l and an integer n and returns a new list l' with the following conditions:
    l' matches l at indices not divisible by n, while its values at indices divisible by n are equal to the corresponding indices of l multiplied by 2, but sorted in reverse.

    >>> advanced_sort([1, 2, 3], 2)
    [1, 2, 3]
    >>> advanced_sort([5, 6, 3, 4, 8, 9, 2], 3)
    [5, 6, 3, 2, 8, 9, 1]
    >>> advanced_sort([8, 7, 4, 1, 3, 6, 5], 3)
    [8, 7, 4, 5, 3, 6, 1]
    """
<|end|>
<|asst|>
def advanced_sort(l: list, n: int):
    modified_indices = [i for i in range(len(l)) if i % n == 0]
    modified_values = sorted([l[i] * 2 for i in modified_indices], reverse=True)
    
    result = l[:]
    for idx, val in zip(modified_indices, modified_values):
        result[idx] = val
    return result

print(advanced_sort([1, 2, 3], 2))
print(advanced_sort([5, 6, 3, 4, 8, 9, 2], 3))
print(advanced_sort([8, 7, 4, 1, 3, 6, 5], 3))
<|end|>


