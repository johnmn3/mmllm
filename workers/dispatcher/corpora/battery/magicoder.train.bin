from typing import List

def below_zero(operations: List[int]) -> bool:
    """You are given a sequence of deposit and withdrawal activities on a bank account initialized with
    zero balance. Your mission is to identify if at any juncture the balance of the account descends below zero, and
    at that instance, the function should yield True. Otherwise, it should produce False.
    
    Examples:
    >>> below_zero([1, 2, 3])
    False
    >>> below_zero([1, 2, -4, 5])
    True
    """

    balance = 0
    for op in operations:
        balance += op
        if balance < 0:
            return True
    return False
