```python
from bs4 import BeautifulSoup
import requests
import hashlib
from PIL import Image
import io

def get_image_links(site):
    response = requests.get(site)
    soup = BeautifulSoup(response.text, 'html.parser')
    img_tags = soup.find_all('img')
    urls = [img['src'] for img in img_tags]
    return urls

def remove_duplicate_images(urls):
    hashed_images = {}
    for url in urls:
        response = requests.get(url)
        image = Image.open(io.BytesIO(response.content))
        image_hash_str = hashlib.md5(image.tobytes()).hexdigest()
        if image_hash_str not in hashed_images:
            hashed_images[image_hash_str] = url 
    return list(hashed_images.values()) # return unique images' urls
```


