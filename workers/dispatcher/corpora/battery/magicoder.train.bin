        Vector3D crossResult = v1.cross(v2);
        System.out.println("Vector cross product: (" + crossResult.x + ", " + crossResult.y + ", " + crossResult.z + ")");
        
        double magnitudeResult = v1.magnitude();
        System.out.println("Vector magnitude: " + magnitudeResult);
        
        double angleResult = v1.angle(v2);
        System.out.println("Angle between vectors: " + Math.toDegrees(angleResult) + " degrees");
    }
}
```

