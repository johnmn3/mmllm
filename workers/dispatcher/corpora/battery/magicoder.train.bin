Some example values:

advanced_sort([1, 2, 3], 2) => [1, 2, 3]
advanced_sort([5, 6, 3, 4, 8, 9, 2], 3) => [5, 6, 3, 2, 8, 9, 1]
advanced_sort([8, 7, 4, 1, 3, 6, 5], 3) => [8, 7, 4, 5, 3, 6, 1] 

