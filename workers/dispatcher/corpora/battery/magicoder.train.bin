def min_element_and_index(lis):
    if not lis:
        return "List is empty"

    minimum = lis[0]
    index = 0
    for i in range(1, len(lis)):
        if lis[i] < minimum:
            minimum = lis[i]
            index = i
    return index, minimum

print(min_element_and_index([3, 9, 2, 6, 1, 8]))  # output: (4, 1)
print(min_element_and_index([]))  # output: "List is empty"
