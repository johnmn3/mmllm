<|asst|>
In order to refactor Python code to C++, you would need to convert the concept of Python list comprehensions, generator expressions and some built-in functions to their equivalents in C++. Here is an equivalent C++ code for your Python function:

```cpp
#include <bits/stdc++.h>
using namespace std;

// Check if a number is prime or not
bool isPrime(int n) {
    if (n <= 1)  return false;
    if (n == 2 || n == 3) return true;
    if (n % 2 == 0 || n % 3 == 0) return false;
    for (int i = 5; i * i <= n; i = i + 6) {
        if (n % i == 0 || n % (i + 2) == 0)  return false;
    }      
    return true;
}

// Check if the sum of digits in a number is odd
bool isOddSum(int n) {
    int sum = 0;
    while (n != 0) {
        sum += n % 10;
        n = n / 10;
    }
    return (sum % 2 != 0);
}

// Main function
vector<int> oddSumPrimeIndexElements(vector<int> arr) {
    vector<int> primes, digits_odds;
    int n = arr.size();
    
    // Get all indices for which arr[i] is prime
    for(int i = 0; i < n; ++i) if(isPrime(i)) primes.push_back(i);

    // Get values inside arr for which the sum of their digits is odd
    for(auto idx : primes) if(isOddSum(arr[idx])) digits_odds.push_back(arr[idx]);
    
    // Sort and remove duplicates from the resultant array
    sort(digits_odds.begin(), digits_odds.end());
    digits_odds.erase(unique(digits_odds.begin(), digits_odds.end()), digits_odds.end());
    
    return digits_odds;
}

int main(){
    // Test our function
    vector<int> arr = {11, 22, 33, 44, 55, 66, 77, 88, 99, 101};
    vector<int> res = oddSumPrimeIndexElements(arr);
    
    for(auto val : res){
        cout << val << " ";
    }

    return 0;
}
```

This program does the following: 

- It checks the list for prime indices
- Then it checks if the sum of digits for each prime index value is odd
- After that, it sorts and removes duplicates from resultant elements
- Finally, it prints the sorted, unique list of values for which both conditions (prime index and odd sum of digits) are met.
