Here's the program code written in JavaScript along with an explanation:

```JavaScript
// Function that calculates the expression result
function calculateExpression(expression) {
    // Removing spaces
    expression = expression.replace(/\s+/g, '');
    // Replacing 'x' with '*' for multiplication
    expression = expression.replace(/x/g, '*');
    
    try {
        /* 
        Using JavaScript's built-in eval() function which takes
        a string argument and interprets it as JavaScript code.
        */
        var result = eval(expression);
        return result;
    } catch (error) {
        console.warn("Error while calculating the expression", error);
        return null;
    }
}

// Function that prints the result
