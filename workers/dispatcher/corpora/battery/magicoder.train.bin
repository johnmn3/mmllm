Here's the corrected code:

```python
# Python code
from typing import List

def how_many_times(string: str, substring: str) -> int:
    count = start = 0
    while start < len(string):
        pos = string.find(substring, start)
        if pos != -1:
            start = pos + 1
            count += 1
        else:
            break
    return count

def count_subsequences(string: str, substring: str) -> int:
    m, n = len(substring), len(string)
    lookup = [[0] * (n + 1) for _ in range(m + 1)]
    for i in range(n + 1):
        lookup[0][i] = 1
    for i in range(1, m + 1):
        for j in range(1, n + 1):
            if substring[i - 1] == string[j - 1]:
                lookup[i][j] = lookup[i - 1][j - 1] + lookup[i][j - 1]
            else:
                lookup[i][j] = lookup[i][j - 1]
    return lookup[m][n]

def find_substrings_with_x_distinct_chars(string: str, k: int) -> List[str]:
    n = len(string)
    result = []
    count = [0] * 27
    for i in range(0, n):
        dist_count = 0
        count = [0] * 27
        for j in range(i, n):
            if((count[ord(string[j]) - 97]) == 0):
                dist_count += 1
            count[ord(string[j]) - 97] += 1
            if(dist_count == k):
                result.append(string[i:j+1])
    return result
```
Please note that in Python, the two built-in functions `ord()` and `range()` are being used. The `ord()` function returns the number representing the unicode character, and `range()` generates a sequence of numbers.
