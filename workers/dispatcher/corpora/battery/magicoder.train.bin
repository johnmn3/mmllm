            int max_index = i;
            for(int j = i+1; j < nums.length; j++) {
                if(sum_of_digits(nums[j]) > sum_of_digits(nums[max_index])) {
                    max_index = j;
                }
            }
            int temp = nums[i];
            nums[i] = nums[max_index];
            nums[max_index] = temp;
        }
    }
}
