```python
from flask import Flask, request, render_template, redirect, url_for
from flask_sqlalchemy import SQLAlchemy
from math import ceil

app = Flask(__name__)

# Assuming you have configured SQLALCHEMY_DATABASE_URI in config.py
app.config.from_pyfile('config.py')
db = SQLAlchemy(app)

# Assuming you have a DataModel representing your data in the database
class DataModel(db.Model):
    __tablename__ = 'DATA_TABLE'

    id = db.Column(db.Integer, primary_key=True)
    data = db.Column(db.String())

@app.route("/search", methods=["GET", "POST"])
def search():
    if request.method == "POST":
        query = request.form['query']
        return redirect(url_for('search_results', query=query, page=1))
    else:
        return render_template('search_form.html')

@app.route("/search_results")
def search_results():
    results_per_page = request.args.get('limit', 10, type=int)
    page = request.args.get('page', 1, type=int)
    start = (page - 1) * results_per_page

    #Parse query from url parameters
    query = request.args.get('query') 

    # Fetch the total number of results from the database
    total_results = DataModel.query.filter(DataModel.data.like(f"%{query}%")).count()
    total_pages = ceil(total_results / results_per_page)

    # Fetch data for the current page
    results = DataModel.query.filter(DataModel.data.like(f"%{query}%")).slice(start, start + results_per_page).all()

    # Store additional data (like the current page number and total number of pages) 
    # to help populate the links and allow the user to navigate through the search results.
    pagination_info = {
        "current_page": page,
        "total_pages": total_pages,
        "results_per_page": results_per_page,
        "query": query
    }
    
    return render_template('search_results.html', results=results, info=pagination_info)

if __name__ == "__main__":
    app.run(debug=True)

```

For pagination navigation, you can use `pagination_info` to display links in your HTML template file. You could implement a feature to break down the list of page links into smaller groups for better navigation in larger datasets. 

Note that the above script assumes SQLAlchemy and a database have been set up as well as Jinja2 HTML templates.
Persistence library used can vary based on coding standards followed by your team and the database you are using. 

Also remember to use prepared statements or parameterized queries to prevent SQL Injection attacks when using user provided data in SQL queries. SQLAlchemy ORM takes care of this.
<|end|>


