import Foundation

class Solution {
   func swapOdd(lst1: [Int], lst2: [Int]) -> String {
       var countOddLst1 = 0
       var countEvenLst2 = 0

       // count odd numbers in lst1
       for i in lst1 {
           if i % 2 != 0 {
               countOddLst1 += 1
           }
       }

       // count even numbers in lst2
       for i in lst2 {
           if i % 2 == 0 {
               countEvenLst2 += 1
           }
       }

       // If there are at least as many odd numbers in lst1 as there are even numbers in lst2, 
       // we can make lst2 consist solely of odd numbers by swapping
       if countOddLst1 >= countEvenLst2 {
               return "SUCCESS"
           } else {
               return "FAIL"
           }
       }
}
