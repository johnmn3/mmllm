Write a Mongoose query to remove all documents that have an 'isActive' field set to true and a 'dateModified' field that falls within the range of January to March of 2021. In addition, create a log of all deleted items, complete with a timestamp of the deletion and the reason as "Deletion of outdated data".
<|end|>
<|asst|>
Here is a NodeJS script that utilizes Mongoose to solve your problem. I have assumed the Schema of your collection, especially for the 'dateModified' Field, and please adjust it according to your schema.

In this script, I am first finding all documents according to your conditions, then logging them into another collection before deleting them from the original collection. 

```javascript
const mongoose = require('mongoose');

mongoose.connect('mongodb://localhost/yourDatabaseName', {useNewUrlParser: true, useUnifiedTopology: true});

const originalSchema = new mongoose.Schema({
    // your original schema
});

const logSchema = new mongoose.Schema({
    originalId: mongoose.Schema.Types.ObjectId,
    deletedObject: Object,
    timeStamp: { type: Date, default: Date.now },
    reason: String,
});

const OriginalCollection = mongoose.model('OriginalCollection', originalSchema);
const LogCollection = mongoose.model('LogCollection', logSchema);

const deleteDocuments = async () => {
    const startDate = new Date('2021-01-01T00:00:00.000Z');
    const endDate = new Date('2021-04-01T00:00:00.000Z');

    const docsToDelete = await OriginalCollection
        .find({
            isActive: true,
            dateModified: { $gte: startDate, $lt: endDate }
        });

    const promises = docsToDelete.map(doc => {
        return new LogCollection({
             originalId: doc._id,
             deletedObject: doc,
             reason: 'Deletion of outdated data'
        }).save();
    });

    await Promise.all(promises);

    return OriginalCollection.deleteMany({
        isActive: true,
        dateModified: { $gte: startDate, $lt: endDate }
    });
};

deleteDocuments()
    .then(() => console.log('Deletion completed'))
    .catch(err => console.error(err))
    .finally(() => mongoose.disconnect());
```

Note: Do replace `'mongodb://localhost/yourDatabaseName'`, `'OriginalCollection'`, `'LogCollection'`, and the schema with your own configuration and schema. Also, always take a backup before running delete operations.
<|end|>


