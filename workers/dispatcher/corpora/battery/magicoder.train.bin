    modification = 0
    while i < j:
        if arr[i] != arr[j]:
            if min(arr[i], arr[j]) < limit[0] or max(arr[i], arr[j]) > limit[1]:
                raise InvalidModification("Modification not possible within the given limit")
            elif arr[i] < arr[j]:
