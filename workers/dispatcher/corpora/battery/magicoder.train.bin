translate and explain this code to python
#include<bits/stdc++.h>
using namespace std;

// Function to calculate factorial
int factorial(int num){
    int result = 1;
    for(int i=num; i>=1; i--){
        result *= i;
    }
    return result;
}

// Function to calculate summation
int summation(int num){
    return num*(num+1)/2;
}

vector<vector<int>> f(int n) {
    vector<vector<int>> mat(n, vector<int>(n));
    for(int i=0; i<n; i++) {
        for(int j=0; j<n; j++) {
            int sum = i+j+2; // Index starts from 1
            if(sum % 2 == 0){
                mat[i][j] = factorial(sum); // Factorial if sum is an even number.
            } else {
                mat[i][j] = summation(sum); // Summation if sum is an odd number.
            }
        }
    }

    return mat;
}
<|end|>
<|asst|>
Here is the Python translation of the C++ code:

```Python
import math

# Function to calculate factorial
def factorial(num):
    return math.factorial(num)

# Function to calculate summation
def summation(num):
    return num*(num+1)/2

def f(n):
    mat = [[0 for _ in range(n)] for _ in range(n)]
    for i in range(n):
        for j in range(n):
            sum = i + j + 2  # Index starts from 1
            if sum % 2 == 0:
                mat[i][j] = factorial(sum)  # Factorial if sum is an even number.
            else:
                mat[i][j] = summation(sum)  # Summation if sum is an odd number.
    return mat
```

Explanation:

1. The `factorial` function calculates the factorial of a number. The `math.factorial` Python standard library function does this, and so we use it directly.
2. The `summation` function calculates the summation of all numbers up to a given number.
3. The `f` function creates an `n` x `n` matrix (represented as a list of lists in Python). For each cell in the matrix, it checks the sum of the cell's row and column indices plus two (because the original C++ code is 1-indexed). It writes the factorial of this sum to the cell if the sum is even, and the summation of this sum if it is odd. Finally, it returns the filled matrix.
