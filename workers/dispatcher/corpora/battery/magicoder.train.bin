Please complete the following code with an efficient implementation that also handles negative indices:

def fibfib(n: int):
    """
    The FibFib number sequence is a sequence similar to the Fibbonacci sequence that's defined as follows:
    fibfib(0) == 0
    fibfib(1) == 0
    fibfib(2) == 1
    fibfib(n) == fibfib(n-1) + fibfib(n-2) + fibfib(n-3) for n > 2
    fibfib(n) == fibfib(n+3) - fibfib(n+2) - fibfib(n+1) for n < 0
    Please write a function to efficiently compute the n-th element of the fibfib number sequence using dynamic programming and memoization.
    >>> fibfib(1)
    0
    >>> fibfib(5)
    4
    >>> fibfib(8)
    24
    >>> fibfib(-1)
    1
    >>> fibfib(-5)
    -4
    """
    # Your code here
<|end|>
<|asst|>
def fibfib(n: int):
    memo = {}

    def fibfib_helper(n: int):
        if n == 0:
            return 0
        elif n == 1:
            return 0
        elif n == 2:
            return 1
        elif n > 2:
            if n-1 not in memo:
                memo[n-1] = fibfib_helper(n-1)
            if n-2 not in memo:
                memo[n-2] = fibfib_helper(n-2)
            if n-3 not in memo:
                memo[n-3] = fibfib_helper(n-3)
            return memo[n-1] + memo[n-2] + memo[n-3]
        else:  # n < 0
            if n+1 not in memo:
                memo[n+1] = fibfib_helper(n+1)
            if n+2 not in memo:
                memo[n+2] = fibfib_helper(n+2)
            if n+3 not in memo:
                memo[n+3] = fibfib_helper(n+3)
            return memo[n+3] - memo[n+2] - memo[n+1]

    return fibfib_helper(n)

print(fibfib(1))
print(fibfib(5))
print(fibfib(8))
print(fibfib(-1))
print(fibfib(-5))
<|end|>


