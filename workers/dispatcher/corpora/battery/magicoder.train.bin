// Function to check if array is a palindrome
bool palindrome(const vector<vector<float>>& l) {
    // Flatten the multidimensional array
    vector<float> flat = flatten(l);
    // Compare the original array with its reverse
    return flat == vector<float>(flat.rbegin(), flat.rend()); 
}

int main() {
    cout << (palindrome({{1, 2}, {3, 2, 1}}) ? "true" : "false") << endl;
    cout << (palindrome({{1, 20, 4}, {10}}) ? "true" : "false") << endl;
    cout << (palindrome({{4, 4, 2}, {2, 4, 4}}) ? "true" : "false") << endl;
