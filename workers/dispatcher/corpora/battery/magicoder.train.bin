How would this be implemented in Go?
def complex_shape_area(coordinates):
    """Using input values representing the coordinates of the vertices of the shape, accurately calculate the shape's area.
    """

    def triangle_area(x1, y1, x2, y2, x3, y3):
        """Helper function to calculate an area of a triangle."""
        return abs((x1*(y2-y3) + x2*(y3-y1) + x3*(y1-y2))) / 2.0

    area = 0.0
    n = len(coordinates)  # number of vertices
    for i in range(n):
        x1, y1 = coordinates[i]
        x2, y2 = coordinates[(i+1) % n]  # the "% n" wraps index around
        x3, y3 = coordinates[(i+2) % n]
        area += triangle_area(x1, y1, x2, y2, x3, y3)
    return area
<|end|>
<|asst|>
Here's how you can implement the above Python function in Golang:

```go
package main

import (
	"fmt"
	"math"
)

type Coordinate struct {
	X float64
	Y float64
}

// Helper function to calculate Area of a triangle
func triangleArea(x1, y1, x2, y2, x3, y3 float64) float64 {
	return math.Abs((x1*(y2-y3) + x2*(y3-y1) + x3*(y1-y2))) / 2.0
}

// Function to calculate Area of a complex shape
func complexShapeArea(coordinates []Coordinate) float64 {
	area := 0.0
	n := len(coordinates)  // number of vertices

	for i := 0; i < n; i++ {
		x1, y1 := coordinates[i].X, coordinates[i].Y
		x2, y2 := coordinates[(i+1)%n].X, coordinates[(i+1)%n].Y // the "% n" wraps index around
		x3, y3 := coordinates[(i+2)%n].X, coordinates[(i+2)%n].Y
		area += triangleArea(x1, y1, x2, y2, x3, y3)
	}
	return area
}

func main() {
	// Provide input coordinates here
	coordinates := []Coordinate{{2,3}, {4,6}, {6,9}, {8,12}}
	fmt.Println(complexShapeArea(coordinates))  // Print area of the shape
}
```
In the above code, each `Coordinate` struct represents a vertex of the shape. The `complexShapeArea` function computes the area of the shape by breaking it down into triangles and summing up their areas. Area of individual triangle is computed by `triangleArea` function.
<|end|>


