    console.log("The result of the arithmetic operation is: " + result);
}

// Defining the complex operation
var complexOperation = "(((7 * 8 - 9 / 3) * 2) + 10 - 5) / 5";

// Calculating the result 
var result = calculateExpression(complexOperation);

// Checking if operation executed successfully
if (result !== null) {
    // Finally, print the result
    printResult(result);
}
```

