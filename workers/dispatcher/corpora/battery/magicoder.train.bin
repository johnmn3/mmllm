import sqlite3
conn = sqlite3.connect('my_database.db')

def update_status(table, key, value, status):
    c = conn.cursor()
    t = (status, value)
    c.execute(f"UPDATE {table} SET status = ? WHERE {key} = ?", t)
    conn.commit()

update_status('contacts', 'contact_id', 42, 'inactive')
