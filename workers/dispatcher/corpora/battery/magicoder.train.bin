def move_three_balls(arr):
    if len(arr) == 0:
        return True
    
    swaps = [0]*len(arr)
    temp = arr.copy()
    temp.sort()
    for i in range(len(arr)):
        if arr[i] != temp[i]:
            swaps[i] = 1

