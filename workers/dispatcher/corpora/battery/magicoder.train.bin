render the following in c#:
import java.util.*;
import java.lang.*;

class Solution {
    public List<List<String>> listSort(List<String> lst) {
        // Deleting strings of odd lengths
        lst.removeIf(s -> s.length() % 2 != 0);

        // Sorting the list of strings first by their lengths and then alphabetically
        lst.sort(Comparator.comparing(String::length).thenComparing(String::compareTo));

        // Using LinkedHashMap to maintain the order of insertion
        Map<Integer, List<String>> map = new LinkedHashMap<>();

        for (String s : lst) {
            // Grouping the strings by their lengths and eliminating duplicates
            map.putIfAbsent(s.length(), new ArrayList<>());
            if (!map.get(s.length()).contains(s))
                map.get(s.length()).add(s);
        }

        // Returning the list of grouped strings
        return new ArrayList<>(map.values());
    }
}
<|end|>
<|asst|>
Here is the equivalent C# implementation of your Java code:

```csharp
using System;
using System.Collections.Generic;
using System.Linq;

public class Solution {
    public List<List<string>> ListSort(List<string> lst) {
        // Deleting strings of odd lengths
        lst.RemoveAll(s => s.Length % 2 != 0);

        // Sorting the list of strings first by their lengths and then alphabetically
        lst.Sort( (a, b) => a.Length != b.Length ? a.Length.CompareTo(b.Length) : String.Compare(a, b));

        // Using Dictionary to maintain the order of insertion
        Dictionary<int, List<string>> map = new Dictionary<int, list<string>>();

        foreach (string s in lst) {

            // Grouping the strings by their lengths and eliminating duplicates
            if (!map.ContainsKey(s.Length))
                map[s.Length] = new List<string>();

            if (!map[s.Length].Contains(s))
                map[s.Length].Add(s);
        }

        // Returning the list of grouped strings
        return new List<List<string>>(map.Values);
    }
}
```

This version uses C# List and Dictionary classes in place of Java's ArrayList and LinkedHashMap, along with RemoveAll method to delete strings of odd lengths. It also uses Sort with lambda expression to sort the list of strings first by their lengths and then alphabetically.
