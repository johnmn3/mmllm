show me how to write this in swift:
def extract_integer(number: float, precision: int) -> float:
    split_num = str(number).split('.')
    integer = int(split_num[0])
    decimal = split_num[1][:precision]

    if len(decimal) < precision:
        decimal += '0'*(precision-len(decimal))
    
    if integer < 0:
        number_out = float(str(integer) + '.' + decimal)
    else:
        number_out = float(str(integer) + '.' + decimal)

    return round(number_out, precision)
i'd love some insight into how the translated code works.
<|end|>
<|asst|>
Here's your Python code translated into Swift:

```swift
import Foundation

func extractInteger(number: Double, precision: Int) -> Double {
    let numberAsStr = String(format: "%.\(precision)f", number)
    let splitNum = numberAsStr.split(separator: ".")
    guard let integer = Int(splitNum[0]),
          let decimal = Int(splitNum[1]) else {
      return 0
   }

    let numberOut: Double
    if integer < 0 {
        numberOut = Double("\(integer).\(decimal)") ?? 0
    } else {
        numberOut = Double("\(integer).\(decimal)") ?? 0
    }

    return Double(String(format: "%.\(precision)f", numberOut)) ?? 0
}
```

In Swift, there is no need for additional logic to add trailing zeros when the number of decimal digits is less than the required precision. The "%.\(precision)f" format string in the String initializer handles this automatically.

Explanations:

1. `String(format: "%.\(precision)f", number)` - This is used to format the double number into a string with the desired precision.

2. `split(separator: ".")` - This is used to split the string into two parts [integer, decimal] at the decimal point.

3. `Int(splitNum[0])` and `Int(splitNum[1])` - These are used to convert the split strings back to integer.

4. `Double("\(integer).\(decimal)") ?? 0` - This is used to assemble the integer and decimal back into a Double value.

5. `Double(String(format: "%.\(precision)f", numberOut)) ?? 0` - This is used to round the final output to the desired precision.

The entire function is enclosed in a `guard let` statement to ensure the conversion from `String` to `Int` or `Double` doesn't fail (in case of invalid input). If any of these conversions fails, `0` will be returned as a fallback.
<|end|>


