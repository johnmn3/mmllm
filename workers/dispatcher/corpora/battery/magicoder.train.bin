{% block content %}
<div class="jumbotron">
    <h1 class="display-4">Welcome to Agri Export Management Dashboard!</h1>
    <hr class="my-4">
    <p class="lead">Manage your agriculture exports efficiently and effectively.</p>
</div>
<div class="row">
    <div class="col-md-4">
        <div class="card text-white bg-primary mb-3" style="max-width: 18rem;">
            <div class="card-header">Inventory</div>
            <div class="card-body">
                <h5 class="card-title">Manage your inventory</h5>
                <p class="card-text">Keep track of your stock and ensure you never run out of products.</p>
                <a href="{{ url_for('inventory') }}" class="btn btn-light">Go to Inventory</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card text-white bg-success mb-3" style="max-width: 18rem;">
            <div class="card-header">Orders</div>
            <div class="card-body">
                <h5 class="card-title">Manage your orders</h5>
                <p class="card-text">Ensure timely delivery and keep your customers happy.</p>
                <a href="{{ url_for('orders') }}" class="btn btn-light">Go to Orders</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card text-white bg-info mb-3" style="max-width: 18rem;">
            <div class="card-header">Customers</div>
            <div class="card-body">
                <h5 class="card-title">Manage your customers</h5>
                <p class="card-text">Maintain good relationships with your customers.</p>
                <a href="{{ url_for('customers') }}" class="btn btn-light">Go to Customers</a>
            </div>
        </div>
    </div>
</div>
<div class="row">
    <div class="col-md-4">
        <div class="card text-white bg-warning mb-3" style="max-width: 18rem;">
            <div class="card-header">Suppliers</div>
            <div class="card-body">
                <h5 class="card-title">Manage your suppliers</h5>
                <p class="card-text">Ensure a steady supply of products from your suppliers.</p>
                <a href="{{ url_for('suppliers') }}" class="btn btn-light">Go to Suppliers</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card text-white bg-danger mb-3" style="max-width: 18rem;">
            <div class="card-header">Reports</div>
            <div class="card-body">
                <h5 class="card-title">Generate reports</h5>
                <p class="card-text">Make informed business decisions based on your reports.</p>
                <a href="{{ url_for('reports') }}" class="btn btn-light">Go to Reports</a>
            </div>
        </div>
    </div>
</div>
{% endblock %}
