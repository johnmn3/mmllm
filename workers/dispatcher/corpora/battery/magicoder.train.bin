can you rework this code into php?
from typing import List

def isolate_balanced_bracket_groups(bracket_sequence: str, manage_syntax_errors: bool) -> List[str]:
    stack = []  # Stack to keep track of brackets level
    result = []  # Resultant list of groups
    curr_group = ""  # Current group of brackets

    for bracket in bracket_sequence:
        # Ignore white spaces
        if bracket.isspace():
            continue
        # Push to stack if it's an opening bracket
        elif bracket == '(':
            if curr_group:
                stack.append(curr_group)
                curr_group = ""
            stack.append(bracket)
        # Pop from stack if it's a closing bracket
        elif bracket == ')':
            if not stack or stack[-1] != '(':
                if manage_syntax_errors:
                    print("Syntax error: unbalanced closing bracket.")
                    continue
                else:
                    raise SyntaxError("Unbalanced closing bracket.")
            else:
                stack.pop()
                curr_group += bracket
                if not stack or stack[-1] != '(':
                    # If the stack becomes empty or the top of stack is not opening bracket,
                    # It means we have a balance group of brackets
                    result.append(curr_group)
                    curr_group = ""
                    if stack:
                        curr_group = stack.pop()
        else:
            raise ValueError("Invalid character: expected brackets or white space.")
    # If there are still remaining brackets in the stack, then it's an error
    if stack:
        if manage_syntax_errors:
            print("Syntax error: unbalanced opening bracket.")
        else:
            raise SyntaxError("Unbalanced opening bracket.")

    return result
<|end|>
<|asst|>
Below is the equivalent PHP code:

```php
function isolate_balanced_bracket_groups($bracket_sequence, $manage_syntax_errors) {
    $stack = [];
    $result = [];
    $curr_group = "";

    for ($i = 0; $i < strlen($bracket_sequence); $i++) {
        $bracket = $bracket_sequence[$i];
        
        if ($bracket == ' ')
            continue;
        elseif ($bracket == '(') {
            if ($curr_group != "") {
                array_push($stack, $curr_group);
                $curr_group = "";
            }
            array_push($stack, $bracket);
        }
        elseif ($bracket == ')') {
            if (empty($stack) || end($stack) != '(') {
                if ($manage_syntax_errors) {
                    echo ("Syntax error: unbalanced closing bracket.\n");
                    continue;
                }
                else 
                    throw new Exception("Unbalanced closing bracket.");
            } 
            else {
                array_pop($stack);
                $curr_group .= $bracket;
                if (empty($stack) || end($stack) != '(') {
                    array_push($result, $curr_group);
                    $curr_group = "";
                    if (!empty($stack))
                        $curr_group = array_pop($stack);
                }
            }
        } 
        else {
            throw new Exception("Invalid character: expected brackets or white space.");
        }
    }

    if (!empty($stack)) {
        if ($manage_syntax_errors)
            echo("Syntax error: unbalanced opening bracket.\n");
        else
            throw new Exception("Unbalanced opening bracket.");
    }
    
    return $result;
}
```

This function can be used in PHP in the same way as the original Python function. Note the use of `array_push()` and `array_pop()` for PHP stack operations, and `end()` to get the element at the top of the stack. Also note how errors are handled using PHP's Exception mechanism.
<|end|>


