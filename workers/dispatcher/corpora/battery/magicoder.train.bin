* sortArray([5]) => [5]
* sortArray([1, 8, 7, 0, 2, 6]) => a sorted array
* sortArray([2, 4, 3, 0, 1, 5, 6]) => a sorted array

Consider this faulty code as your basis:
const sortArray = (array) => {
<|end|>
<|asst|>
The problem can be solved by copying the original input array so it doesn't get modified, then checking the sum of the first and last elements of the array. If their sum is odd, the copy of the array is sorted in ascending order. If the sum is even, it's sorted in descending order. If the sum is a prime number, we intersperse the values in ascending and descending order.

A code for this problem may look like this:

    function checkPrime(num) {
        for(let i = 2; i < num; i++)
            if(num % i === 0) return false;
        return num > 1;
    }

    const sortArray = (array) => {
        // create a copy of the array
        let newArray = [...array];

        // check if array is empty or has only 1 element
        if(newArray.length <= 1) return newArray;

        // calculate the sum of first and last elements
        let sum = newArray[0] + newArray[newArray.length - 1];

        // check if sum is prime number
        if(checkPrime(sum)){
            // intersperse sorting
            let sortedArray = newArray.sort((a,b) => a - b);
            let resultArray = [];
            for (let i = 0; i < sortedArray.length/2; i++) {
                // Push element from start
                resultArray.push(sortedArray[i]);
                if(sortedArray[sortedArray.length-1-i]) {
                  // Push element from end
                  resultArray.push(sortedArray[sortedArray.length-1-i]);
                }
            }
            return resultArray;
        }

        // if sum is an odd number, sort array in increasing order otherwise sort the array in decreasing order
        return (sum % 2 !== 0) ? newArray.sort((a, b) => a - b) : newArray.sort((a, b) => b - a);
    };
