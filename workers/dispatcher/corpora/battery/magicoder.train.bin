Step 3:
Now, let's write some code. Inside your `App.js` file:

```jsx
import React from 'react';
import { View, Text, StyleSheet, ScrollView } from 'react-native';
import { Card } from 'react-native-elements';
import Swiper from 'react-native-swiper';

export default function App() {
  const data = [
    {
        "title": "React Native - A Guide For Beginners",
        "author": "John Doe",
        "content": "Task for this instructions..."
    },
    {
        "title": "Getting Started With React Navigation in React Native",
        "author": "John Smith",
        "content": "Task for this instructions..."
    }
  ];

  return (
    <Swiper style={styles.wrapper}>
      {data.map((item, index) => (
        <View style={styles.slide} key={index}>
          <ScrollView>
            <Card>
              <Card.Title>{item.title}</Card.Title>
              <Card.Divider/>
              <Text style={styles.author}>Author: {item.author}</Text>
              <Text style={styles.text}>{item.content}</Text>
            </Card>
          </ScrollView>
        </View>
      ))}
    </Swiper>
  );
}

const styles = StyleSheet.create({
  wrapper: {},
  slide: {
    flex: 1,
    justifyContent: 'center',
    alignItems: 'center',
    backgroundColor: '#ffffff'
  },
  text: {
    color: '#000',
    fontSize: 14,
    padding: 10
  },
  author: {
    fontSize: 16,
    fontWeight: 'bold',
    padding: 10
  }
});
```

This application fetches the "articles" from the given data array, and displays the title, author and content of each article on a separate swipeable page.

