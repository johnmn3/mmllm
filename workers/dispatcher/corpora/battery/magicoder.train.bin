```
<|end|>
<|asst|>
def find_max(words):
    """The function takes a list of distinct strings as input.
    It returns the word with the highest count of unique characters.
    If there are ties, return the lexicographically earliest word.

    >>> find_max(["name", "of", "string"])
    "string"
    >>> find_max(["name", "enam", "game"])
    "enam"
    >>> find_max(["aaaaaaa", "bb" ,"cc"])
    "aaaaaaa"
    """
    words.sort() # Sorting the list of words
    return max(words, key=lambda word: len(set(word))) # Returning the word with the max unique characters

# Test cases
print(find_max(["name", "of", "string"]))
print(find_max(["name", "enam", "game"]))
print(find_max(["aaaaaaa", "bb" ,"cc"]))
