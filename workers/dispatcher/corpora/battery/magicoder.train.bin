```javascript
function OddBypass(arr){
    arr.sort(function(a, b){return a - b});
    var index = 0;
    while(index < arr.length){
        if(arr[index] % 2 == 1 && (arr[index] < 10 || arr[index] > 20)){
            console.log(arr[index]);
