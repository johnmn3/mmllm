    # Swap isn't necessary as we're using Python's built in list sort, which uses Timsort, an efficient, stable sort

    result = {}
    for key, values in d.items():
        # We want to keep track of all positive nums, not just return the first
        # Also, sort the positive numbers to match function's docstring
        positive_nums = sorted([value for value in values if value > 0])
        result[key] = positive_nums
    return result

print(get_positive_and_sort_dict({'a': [-1, 2, -4], 'b': [5, 6]}))  # {'a': [2], 'b': [5, 6]}
print(get_positive_and_sort_dict({'x': [5, 3, -5, 2, -3, 3, 9, 123, 1, -10], 'y': [-1, 0, -3]})) # {'x': [1, 2, 3, 3, 5, 9, 123], 'y': []}
```
