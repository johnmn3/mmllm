Sure, Here is the equivalent code in C.

```c
#include<stdio.h>
#include<math.h>

int is_prime(int n) {
    if (n == 0 || n == 1) {
        return 0;
    }
    for (int i = 2; i <= sqrt(n); i++) {
        if (n % i == 0) {
            return 0;
        }
    }
    return 1;
}

int is_fibonacci(int num) {
    int a = 0, b = 1, temp;
    while (a < num) {
        temp = a;
        a = b;
        b = temp + b;
    }
    return a == num;
}

int is_followed_by_fibonacci(int lst[], int index) {
    if (index < 1) {
        return 0;
    }
    return is_fibonacci(lst[index - 1]);
}

long long int multiply(int lst[], int size) {
    long long int result = 1;
    for (int index = 0; index < size; index++) {
        if (lst[index] % 2 != 0 && lst[index] % 5 == 0 && is_prime(index) && is_followed_by_fibonacci(lst, index)) {
            result *= lst[index];
        }
    }
    return (result != 1) ? result : 0;
}

int main() {
    int lst[] = {15, 1, 2, 3, 5, 8, 13, 21, 34};
    int size = sizeof(lst) / sizeof(lst[0]);
    printf("%lld", multiply(lst, size));
    return 0;
}
```

