Generate a Node.js script that makes an API request to the GitHub API to get the list of followers for a specific user.
The username: johndoe
<|end|>
<|asst|>
Here is your Node.js script:

```javascript
const https = require('https');

function getFollowers(username) {
  const options = {
    hostname: 'api.github.com',
    path: `/users/${username}/followers`,
    method: 'GET',
    headers: {
      'user-agent': 'node.js',
    }
  };

  https.request(options, (res) => {
    let body = '';
    res.on('data', (chunk) => body += chunk);
    res.on('end', () => {
      try {
        let json = JSON.parse(body);
        console.log(`List of followers for ${username}:`, json.map(follower => follower.login));
      } catch (error) {
        console.error('Unable to parse response as JSON', error);
      }
    });
  })
  .on('error', (error) => console.error(`Got an error: ${error.message}`))
  .end();
}

getFollowers('johndoe');
```

Before you run the code, ensure that Node.js and `https` module is installed in your machine.
You can run this script using `node filename.js`.

This script will output the list of followers' usernames of the specified GitHub user.

Note: For better performance and avoiding rate limits, consider using OAuth or Personal Access Tokens when working with the GitHub API on larger scales.
