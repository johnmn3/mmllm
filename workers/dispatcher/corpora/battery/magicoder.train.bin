Finish the following code with improved difficulty:

def largest_smallest_integers(lst):
    '''
    Create a function that returns a tuple (a, b, c, d), where 'a' is
    the largest of negative even integers, 'b' is the smallest
    of positive even integers, 'c' is the largest of negative odd integers,
    and 'd' is the smallest of positive odd integers in a list.
    If there is no integer for the given condition, return it as None.

    Examples:
    largest_smallest_integers([2, -4, 1, 3, 5, 7]) == (-4, 2, None, 1)
    largest_smallest_integers([]) == (None, None, None, None)
    largest_smallest_integers([0]) == (None, None, None, None)
    '''
<|end|>
<|asst|>
def largest_smallest_integers(lst):

    neg_even = []
    pos_even = []
    neg_odd = []
    pos_odd = []

    for each in lst:

        if each < 0:
            if each % 2 == 0:
                neg_even.append(each)
            else:
                neg_odd.append(each)

        elif each > 0:
            if each % 2 == 0:
                pos_even.append(each)
            else:
                pos_odd.append(each)

    return (None if not neg_even else max(neg_even), 
            None if not pos_even else min(pos_even), 
            None if not neg_odd else max(neg_odd), 
            None if not pos_odd else min(pos_odd))

print(largest_smallest_integers([2, -4, 1, 3, 5, 7]))
print(largest_smallest_integers([]))
print(largest_smallest_integers([0]))
print(largest_smallest_integers([-3, -5, 2, 5, 8, -10]))
print(largest_smallest_integers([1, 3, 7]))
<|end|>


