def find_repeating_substring(s, sub):
    sub_len = len(sub)
    if s.endswith(sub):  
        indices = [i for i in range(len(s)) if s.startswith(sub, i)]
        if len(indices) < 2:
            return False
        diff = indices[1] - indices[0]
        for i in range(1, len(indices)-1):
            if indices[i+1] - indices[i] != diff:
                return False
        return True
    return False
