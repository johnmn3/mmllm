```python
    def advanced_sort(l: list, n: int) -> list:
        new_list = []
        multiple_list = []
        for i in range(len(l)):
            if (i+1) % n == 0:
                multiple_list.append(l[i]*2)
            else:
                new_list.append(l[i])
        multiple_list.sort(reverse=True)
        for i in range(len(new_list)):
            if (i+1) % n == 0:
                new_list[i] = multiple_list.pop(0)
