JavaScript:
```javascript
function rearrangeMixedString(s) {
    const uppercase = s.split('').filter(c => c === c.toUpperCase()).sort().join('');
    const lowercase = s.split('').filter(c => c === c.toLowerCase()).sort().join('');
    return uppercase + lowercase;
}

const s = "rELiabLeDAtA";
const result = rearrangeMixedString(s);
console.log(result);
