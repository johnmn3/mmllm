Rewrite the below code in Java syntax:
def prod_signs(arr):
    if len(arr) == 0 or 0 in arr:
        return None

    arr = list(set(arr)) # removing duplicates
    prod = 1
    sgn_prod = 1
    for num in arr:
        prod *= abs(num)
        sgn_prod *= (1 if num > 0 else -1)
    return prod * sgn_prod
<|end|>
<|asst|>
Here is the equivalent Java code for the one provided:

import java.util.Arrays;
import java.util.HashSet;

public class Main {
    public static void main(String[] args) {
        int[] arr = {1, -2, 3};
        Integer result = prodSigns(arr);
        if(result == null) {
            System.out.println("Result is null");
        } else {
            System.out.println("Result: " + result);
        }
    }
  
    public static Integer prodSigns(int[] arr) {
        if(arr.length == 0) {
            return null;
        }

        for(int i = 0; i < arr.length; i++) {
            if(arr[i] == 0) {
                return null;
            }
        }

        HashSet<Integer> set = new HashSet<>(); // removing duplicates
        for(int num : arr) {
            set.add(num);
        }
  
        int prod = 1;
        int sgnProd = 1;
        for(int num : set) {
            prod *= Math.abs(num);
            sgnProd *= (num > 0 ? 1 : -1);
        }
  
        return prod * sgnProd;
    }
}
