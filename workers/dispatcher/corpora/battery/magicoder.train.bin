I want to convert this to Lua, can you help?
def is_prime(n):
    """ checks if a number is a prime """
    if n < 2:
        return False
    for i in range(2, int(n**0.5) + 1):
        if n % i == 0:
            return False
    return True

def is_fibonacci(sequence):
    """ checks if a sequence is an increasing ordered Fibonacci sequence """
    length = len(sequence)
    if length < 3:
        return False
    for i in range(2,length):
        if sequence[i] != sequence[i-1] + sequence[i-2]:
             return False
    return True

def distinctive_elements(sequence):
    """ calculates the frequency of each number and checks it against the conditions """
    if not is_fibonacci(sequence):
        return []
    from collections import Counter
    frequency = Counter(sequence)
    result = []
    for item in frequency:
        if frequency[item] > item/2 and is_prime(frequency[item]):
            result.append(item)
    return result
<|end|>
<|asst|>
Here's how to convert the code you provided into Lua:

```lua
function is_prime(n)
    -- checks if a number is a prime
    if n < 2 then
        return false
    end
    for i=2, math.floor(math.sqrt(n)) + 1 do
        if n % i == 0 then
            return false
        end
    end
    return true
end

function is_fibonacci(sequence)
    -- checks if a sequence is an increasing ordered Fibonacci sequence
    local length = #sequence
    if length < 3 then
        return false
    end
    for i = 3,length do
        if sequence[i] ~= sequence[i-1] + sequence[i-2] then
             return false
        end
    end
    return true
end

function count_freq(sequence)
    -- count frequency of each element in sequence
    local frequency = {}
    for _, v in pairs(sequence) do
        if frequency[v] then
            frequency[v] = frequency[v] + 1
        else
            frequency[v] = 1
        end
    end
    return frequency
end

function distinctive_elements(sequence)
    -- calculates the frequency of each number and checks it against the conditions
    if not is_fibonacci(sequence) then
        return {}
    end
    local frequency = count_freq(sequence)
    local result = {}
    for item, count in pairs(frequency) do
        if count > item/2 and is_prime(count) then
            table.insert(result, item)
        end
    end
    return result
end
```

Please note that Lua does not have a built-in function for counting occurrences like Python's `collections.Counter`. Therefore, I wrote a simple function `count_freq` to manually calculate the frequency of each element.
Similarly, Lua lacks Python's list comprehension capabilities, therefore I used a traditional `for` loop combined with `table.insert` to build the `result` table.
<|end|>


