normal_df = df[df['Outlier'] != -1]

# Analyzing Outliers
print("Outliers:\n", outliers_df.describe())
print("Normal Data:\n", normal_df.describe())

# Data normalization using scaler
scaler = StandardScaler()

# inplace replacement of the original dataframe
df[df.columns] = scaler.fit_transform(df[df.columns])
```

