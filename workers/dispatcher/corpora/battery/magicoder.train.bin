function convert_morse_to_units(morse_code)
    local units = {}
    for i = 1, #morse_code do
        local c = morse_code:sub(i,i)
        if c == '-' then
            table.insert(units, 3)
        elseif c == '.' then
            table.insert(units, 1)
        elseif c == ' ' then
            table.insert(units, 1)
        elseif c == '/' then
            table.insert(units, 2)
        else
            error("Unsupported character: " .. c)
        end
    end
    return units
end

