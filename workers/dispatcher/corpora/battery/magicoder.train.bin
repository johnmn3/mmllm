using System;
using NUnit.Framework;

[TestFixture]
public class PatternMakerTest
{
    [Test]
    public void GeneratePattern_SizeIsOne_PrintsOneAsterisk()
    {
        PatternMaker patternMaker = new PatternMaker();

        using (StringWriter stringWriter = new StringWriter())
        {
            Console.SetOut(stringWriter);

            patternMaker.GeneratePattern(1);

            Assert.AreEqual("*\n", stringWriter.ToString());
        }
    }

    [Test]
    public void GeneratePattern_SizeIsThree_PrintsSquareOfAsterisks()
    {
        PatternMaker patternMaker = new PatternMaker();

        using (StringWriter stringWriter = new StringWriter())
        {
            Console.SetOut(stringWriter);

            patternMaker.GeneratePattern(3);

            Assert.AreEqual("***\n***\n***\n", stringWriter.ToString());
        }
    }

    [Test]
    public void GeneratePattern_SizeIsZero_ThrowsArgumentException()
    {
        PatternMaker patternMaker = new PatternMaker();

        Assert.Throws<ArgumentException>(() => patternMaker.GeneratePattern(0));
    }

    [Test]
    public void GeneratePattern_SizeIsNegative_ThrowsArgumentException()
    {
        PatternMaker patternMaker = new PatternMaker();

        Assert.Throws<ArgumentException>(() => patternMaker.GeneratePattern(-1));
    }
}
```

In the `GeneratePattern` method, we validate that the input is greater than 0, then generate the pattern by iterating `size` times and each time writing a line of `size` asterisks.

The test cases cover different scenarios:

1. When the size is 1, it checks the generated pattern is a single line with a single asterisk.
2. When the size is 3, it checks the generated pattern is a 3x3 square of asterisks.
3. When the size is 0 or less, it checks that an `ArgumentException` is thrown.
