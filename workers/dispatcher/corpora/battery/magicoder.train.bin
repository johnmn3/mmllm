This is the corrected version of the provided code:

def modify_lists(list1, list2, k):
  new_list1 = []
  new_list2 = []

  # round to nearest integer if k is a floating point
  if type(k) == float:
    k = round(k)

  length1 = len(list1)
  length2 = len(list2)

  # if list1 or list2 is empty, return k
  if not list1 and not list2:
    return [k]
  # if k is greater than or equal to the length of either list, return the reversing list
  elif k >= length1 or k >= length2:
    new_list1 = list1[::-1]
    new_list2 = list2[::-1]
  # if k is a negative integer, remove the k'th element from the end of the list
  elif k < 0:
    new_list1 = list1[:k] + list1[k+1:]
    new_list2 = list2[:k] + list2[k+1:]
  # if k is zero, return the original lists
  elif k == 0:
    new_list1 = list1
    new_list2 = list2
  # otherwise, except the k'th element from both lists
  else:
    new_list1 = list1[:k] + list1[k+1:]
    new_list2 = list2[:k] + list2[k+1:]

  return new_list1, new_list2
