import psycopg2
from psycopg2 import sql, extensions, Error

def execute_sql_queries(aws_cred, database, queries):
    conn_string = "dbname='{}' port='5439' user='{}' password='{}' host='{}'".format(database,
                                                                                      aws_cred['user'],
                                                                                      aws_cred['password'],
                                                                                      aws_cred['host'])
