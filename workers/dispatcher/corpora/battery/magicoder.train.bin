import java.util.*;

public class Main {
    private static List<Integer> shared_elements(List<Integer> list1, List<Integer> list2) {
        Set<Integer> set1 = new HashSet<>(list1);
        Set<Integer> set2 = new HashSet<>(list2);

        set1.retainAll(set2); // finds the intersection of sets

        List<Integer> output = new ArrayList<>(set1);
        Collections.sort(output);
        
        return output;
    }

    public static void main(String[] args) {
        List<Integer> list1 = new ArrayList<>(Arrays.asList(1, 2, 3, 4, 5));
        List<Integer> list2 = new ArrayList<>(Arrays.asList(4, 5, 6, 7, 8));
        List<Integer> result = shared_elements(list1, list2);
        System.out.println(result);
    }
}
```

