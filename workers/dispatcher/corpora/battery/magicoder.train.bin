Show me the C++ adaptation of this:
def is_prime(n):
    """
    Checks if the number is prime.
    """
    if n < 2 or (n % 2 == 0 and n > 2): 
        return False
    return all(n % i for i in range(3, int(n**0.5) + 1, 2))

def prime_digit_sum(n):
    """
    Checks if the digit sum of the number is a prime number and not divisible by 5.
    """
    digit_sum = sum(int(digit) for digit in str(n))
    return is_prime(digit_sum) and digit_sum % 5 != 0

def prime_advanced_sum(n, k):
    """
    Assumes n and k are positive integers, n-digit prime numbers are computed
    the cumulative sum of whose individual digit sum is also a prime number, not capable of
    being evenly divided by the number 5
    """
    start = 10**(n - 1)
    end = 10**n
    prime_sum = 0

    for num in range(start, end):
        if n % 2 == 0:
            continue
        if is_prime(num) and prime_digit_sum(num) and num % k != 0:
            prime_sum += num
    return prime_sum
<|end|>
<|asst|>
Here it the C++ adaptation of the python functions:

```cpp
#include <cmath>
#include <vector>
#include <iostream>

bool is_prime(int n) {
    if (n < 2 || (n % 2 == 0 && n > 2)) return false;
    for (int i = 3; i <= sqrt(n); i += 2)
        if (n % i == 0) return false;
    return true;
}

int digit_sum(int n) {
    int sum = 0;
    while (n) {
        sum += n % 10;
        n /= 10;
    }
    return sum;
}

bool prime_digit_sum(int n) {
    int digit_sum = digit_sum(n);
    return (is_prime(digit_sum) && (digit_sum % 5 != 0));
}

int prime_advanced_sum(int n, int k) {
    int start = pow(10, n - 1);
    int end = pow(10, n);
    int prime_sum = 0;

    for (int num = start; num < end; num++) {
        if (num % 2 == 0) continue;
        if (is_prime(num) && prime_digit_sum(num) && num % k != 0) prime_sum += num;
    }
    return prime_sum;
}

int main() {
    int n = 3, k = 2;
    std::cout << "The advanced prime sum is: " << prime_advanced_sum(n, k) << std::endl;
    return 0;
}
```

Please note that checking primes is expensive specially for large numbers, you might want to use other methods instead of the normal trial division above to check if a number is a prime in the `is_prime` function.
