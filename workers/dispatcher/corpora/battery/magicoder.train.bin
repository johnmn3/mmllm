@router.post("/trades/", response_model=Trade)
def create_trade(
    symbol: str,
    price: float,
    quantity: int,
    strategy: str,
    db: Session = Depends(get_db),
    trading_service: TradingService = Depends(),
):
    trade = trading_service.create_trade(symbol, price, quantity, strategy)
    if not trade:
        raise HTTPException(status_code=400, detail="Error creating trade")
    return trade

@router.get("/trades/{trade_id}", response_model=Trade)
def read_trade(
    trade_id: int,
    db: Session = Depends(get_db),
):
    trade = db.query(Trade).filter(Trade.id == trade_id).first()
    if trade is None:
        raise HTTPException(status_code=404, detail="Trade not found")
    return trade
