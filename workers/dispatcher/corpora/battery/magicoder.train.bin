# Test Cases
print(atmospheric_ascent([1, 2], 5, 2, 0)) # ➞ False 
print(atmospheric_ascent([3, 2, 3], 1, 2, 1)) # ➞ False
print(atmospheric_ascent([3, 2, 3], 9, 2, 1)) # ➞ True
print(atmospheric_ascent([3], 5, 1, 1)) # ➞ True
