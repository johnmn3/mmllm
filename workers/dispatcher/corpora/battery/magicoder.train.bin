Certainly, I can help. The code you have provided contains a lot of OCR errors. Here is a correct version of this code:

```python
def roman_number_operations(first_number, operation=None, second_number=None, conversion_type='int_to_roman'):
    numerals = {1: "I", 4: "IV", 5: "V", 9: "IX",
                10: "X", 40: "XL", 50: "L", 90: "XC",
               100: "C", 400: "CD", 500: "D", 900: "CM", 1000: "M"}
    values = {v: k for k, v in numerals.items()}

    def int_to_roman(num):
        result = ""
        for value, numeral in sorted(numerals.items(), reverse=True):
            while num >= value:
                result += numeral
                num -= value
        return result

    def roman_to_int(roman):
        result = 0
        i = 0
        while i < len(roman):
            if i + 1 < len(roman) and roman[i:i+2] in values:
                result += values[roman[i:i+2]]
                i += 2
            else:
                result += values[roman[i]]
                i += 1
        return result

    if isinstance(first_number, str):
        first_number = roman_to_int(first_number.lower())
    if isinstance(second_number, str):
        second_number = roman_to_int(second_number.lower())
    
    if operation:
        try:
            if operation == '+':
                result = first_number + second_number
            elif operation == '-':
                result = first_number - second_number
            elif operation == '*':
                result = first_number * second_number
            elif operation == '/':
                result = first_number / second_number
            else:
                raise ValueError('Invalid Operation')
        except ZeroDivisionError:
            raise ValueError('Cannot divide by zero')
    else:
        result = first_number

    if conversion_type == 'int_to_roman':
        return int_to_roman(result)
    elif conversion_type == 'roman_to_int':
        return result
    else:
        raise ValueError('Invalid Conversion Type')

print(roman_number_operations(100, '+', 50, 'int_to_roman'))  # CL
print(roman_number_operations('MM', '-', 'D', 'roman_to_int'))  # 1500
```

This code contains two helper functions `roman_to_int` and `int_to_roman` which convert roman numerals to integers and vice versa, respectively. The main function `roman_number_operations` calculates the result based on the operation provided, and converts the result to roman numerals or an integer based on the `conversion_type` parameter.
<|end|>


