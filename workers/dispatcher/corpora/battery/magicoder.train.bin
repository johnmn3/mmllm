What I am doing wrong in the following code:

import dis


def count_operations(f):
    operations = 0
    for op in dis.get_instructions(f):
        if op.opname in ('ADD', 'SUB', 'MULT', 'DIV', 'MOD'):
            operations += 1
    return operations

def solve_system(A, b):
    x = np.linalg.solve(A, b)
    return x

A = np.array([[2, 3],
