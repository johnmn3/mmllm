Complete the subsequent code snippet:

def even_odd_count(num):
    """Provided an integer, return a tuple containing the quantity of even and odd digits respectively.

     Example:
        even_odd_count(-12) ==> (1, 1)
        even_odd_count(123) ==> (1, 2)
    """
<|end|>
<|asst|>
def even_odd_count(num):
    even = 0
    odd = 0
    for i in str(abs(num)):
        if int(i) % 2 == 0:
            even += 1
        else:
            odd += 1
    return (even, odd)
