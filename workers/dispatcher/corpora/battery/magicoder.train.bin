from collections import Counter

def filter_and_group_chars(text):
    consonants = "bcdfghjklmnpqrstvwxyz"
    filtered_text = [char.lower() for char in text if char.lower() in consonants]
    char_freq_dict = Counter(filtered_text) 
    sorted_chars = sorted(char_freq_dict.items(), key=lambda x: (-x[1], x[0]))# sort by frequency in descending order and if frequency are equal, sort by alphabetical order
    return ''.join([char * freq for char, freq in sorted_chars])
