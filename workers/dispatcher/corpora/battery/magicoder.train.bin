using namespace std;

class Product {
    private:
        string productName;
        double price;
        int quantity;

    public:
        // Constructor
        Product(string name, double price, int quantity){
            this -> productName = name;
            this -> price = price;
            this -> quantity = quantity;
        }

        // Getters
        string getProductName() {
            return this -> productName;
        }

        double getPrice() {
            return this -> price;
        }

        int getQuantity() {
            return this -> quantity;
        }

        // Setters
        void setProductName(string name) {
            this -> productName = name;
        }

        void setPrice(double price) {
            if (price < 0) {
                cout << "Price cannot be negative." << endl;
                return;
            }
            this -> price = price;
        }

        void setQuantity(int quantity) {
            if (quantity < 0) {
                cout << "Quantity cannot be negative." << endl;
                return;
            }
            this -> quantity = quantity;
        }
};
```

This class defines a "Product" with three properties: a string `productName`, a double `price`, and an integer `quantity`. The class includes a constructor, which initializes the properties, as well as "getter" and "setter" methods, which allow you to retrieve and modify the properties. In the setter methods, there are if conditions to prevent setting negative price or quantity.
