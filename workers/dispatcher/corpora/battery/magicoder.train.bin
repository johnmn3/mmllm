Write a C++ program for sorting a single linked list in ascending order.
List Size: 5
Linked List: 50 -> 20 -> 30 -> 5 -> 10
<|end|>
<|asst|>
Sure, Here is a C++ code snippet representing the sorting of a linked list in ascending order.

```c++
#include<iostream>
using namespace std;

struct Node{
    int data;
    Node* next;
};

void insert(Node** head_ref, int new_data){
    Node* new_node = new Node();
    Node* last = *head_ref;
    new_node->data = new_data;
    new_node->next = NULL;
    if(*head_ref == NULL){
        *head_ref = new_node;
        return;
    }
    while(last->next!=NULL)
        last = last->next;
    last->next = new_node;
    return;
}

void printList(Node* node){
    while(node!=NULL){
        cout<<node->data<<" ";
        node = node->next;
    }
}

void sortList(Node** head_ref){
    Node* current = *head_ref;
    Node* index = NULL;
    int temp;
    if(*head_ref == NULL)
        return;
    else{
        while(current!=NULL){
            index = current->next;
            while(index!=NULL){
                if(current->data > index->data){
                    temp = current->data;
                    current->data = index->data;
                    index->data = temp;
                }
                index = index->next;
            }
            current = current->next;
        }
    }
}

int main(){
    Node* head = NULL; 
    insert(&head, 50);
    insert(&head, 20);
    insert(&head, 30);
    insert(&head, 5);
    insert(&head, 10);

    cout<<"Original List: ";
    printList(head);
    cout<<endl;

    sortList(&head);
    
    cout<<"Sorted List: ";
    printList(head);
    cout<<endl;

    return 0;
}
```

There are three functions in the code:

1. `insert()`: It will insert nodes into the linked list.
2. `printList()`: It will print all the nodes present in the list.
3. `sortList()`: It will sort the nodes of linked list in ascending order.

In the `main` function, we are creating nodes, sorting the list and then printing the sorted list. 

Remember, it's an example of Bubble sort for linked list with the Time Complexity of O(n^2).
<|end|>


