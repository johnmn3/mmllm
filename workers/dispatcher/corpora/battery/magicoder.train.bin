import requests
from bs4 import BeautifulSoup

def get_image_dimension(image_url):
    soup = BeautifulSoup(requests.get(image_url).content, "html.parser")
    img = soup.find('img')
    return img['width'], img['height']

print(get_image_dimension("https://www.example.com/image.jpg"))
