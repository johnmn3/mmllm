Construct a C++ function to solve a conceptual problem using real-world applications. Your function should consume a vector composed of decimal numerical values alongside its corresponding size as duo parameters. The function should then evaluate the median and the mode from the provided dataset. Additionally, you are required to troubleshoot a malfunctioning version of the function provided below and identify the errors within. 

```cpp
#include<iostream>
#include<vector>
#include<algorithm>
using namespace std;

double findMedian(vector<double>& nums, int size) {
    if(size%2 == 0) 
        return (nums[size/2 - 1] + nums[size/2]) /2 ;
    else
        return nums[(size-1)/2];
}

int main() {
    vector<double> nums = {1.5, 3.0, 4.5, 2.5, 5.0};
    int size = 6; // Size of vector is incorrect here, should be 5
    double median = findMedian(nums, size);
    cout << "Median is: " << median << endl;
    return 0;
}
```
Note: The dataset is:

vector = {1.5, 3.0, 4.5, 2.5, 5.0}
length = 5
and the vector is not sorted, which is required before finding the median.
<|end|>
<|asst|>
Here is the corrected code:

```cpp
#include<iostream>
#include<vector>
#include<algorithm>
#include<map>
using namespace std;

double findMedian(vector<double>& nums, int size) {
    sort(nums.begin(), nums.end());
    if(size%2 == 0) 
        return (nums[size/2 - 1] + nums[size/2]) /2.0 ;
    else
        return nums[size/2];
}

vector<double> findMode(vector<double>& nums, int size) {
    map<double, int> freq;
    
    for(int i = 0; i < size; i++)
        freq[nums[i]]++;
    
    vector<double> mode;
    int max_count = 0;
    for(auto i = freq.begin(); i != freq.end(); i++) {
        if(i->second > max_count) {
            mode.clear();
            mode.push_back(i->first);
            max_count = i->second;
        }
        else if(i->second == max_count)
            mode.push_back(i->first);
    }
    
    return mode;
}

int main() {
    vector<double> nums = {1.5, 3.0, 4.5, 2.5, 5.0};
    int size = nums.size();
    double median = findMedian(nums, size);
    vector<double> mode = findMode(nums, size);
    cout << "Median is: " << median << endl;
    cout << "Modes are: ";
    for(int i = 0; i < mode.size(); i++)
        cout << mode[i] << " ";
    return 0;
}
```
Changes made:
- Size of the vector is correctly set as the vector's actual length using nums.size().
- I've added a sort function before calculating the median because the median of a data set can only be found if the data set is ordered.
- To calculate the mode, I've added a function `findMode()` which calculates the frequency of each number in the data set and returns the number(s) with the maximum frequency.
- Mode is calculated and printed in `main()` function.
<|end|>


