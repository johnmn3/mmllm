Here's a JavaScript function that visually renders a 3D array on the console. This function recursively loops through each dimension of the array and constructs a string representation. 

The function, named "display3DArray", accepts a 3D array as an input and logs the array in a 3D format.

```javascript
function display3DArray(arr) {
    console.log('['); // open the outermost dimension
    for (let i = 0; i < arr.length; i++) {
        console.log('  ['); // open the second dimension
        for (let j = 0; j < arr[i].length; j++) {
            // print each third-dimension array on its own line
            console.log('    [' + arr[i][j].join(', ') + ']'); 
        }
        console.log('  ]'); // close the second dimension
    }
    console.log(']'); // close the outermost dimension
}

// example usage:
var arr = [[[1, 2], [3, 4]], [[5, 6], [7, 8]]];
display3DArray(arr);
```

