```python
def sort_complex_list(n, lsts, weights = {'<class \'int\'>': 1, '<class \'str\'>': 2, '<class \'dict\'>': 3, '<class \'set\'>': 4, '<class \'list\'>': 5}):
    if type(lsts) is dict: #If a dictionary of lists is provided, merge them into one list
        lst = [item for sublist in list(lsts.values()) for item in sublist]
    elif type(lsts) in [list, tuple]: #If a list or tuple of lists is provided, merge them into one list
        lst = [item for sublist in lsts for item in sublist]
    else: #If a single list is provided, use it as is
        lst = lsts
    try:
        lst = lst[n:] + lst[:n] #Split the list at the nth element and add the first part to the end
    except IndexError: #Handle invalid input for the nth element
        print("The index provided is larger than the length of the list.")
        return []
    try:
        lst.sort(key = lambda x: sum(x.values()) if type(x) is dict #Sort based on the sum of key-value pairs if the element is a dictionary
                else sum(x) if type(x) in [set, list] #Sort based on the sum of elements if the element is a set or list
                else weights[str(type(x))]*x if type(x) is int #Handle elements that are integers, strings, etc. using the weights provided
                else weights[str(type(x))]*sum(map(ord, str(x))) if type(x) is str #Map the string to its Unicode sum and apply weights
                ) 
    except TypeError: #Handle invalid elements in the list
        print("The list contains elements that cannot be handled.")
        return []
    return lst

