list1 = ["stack", "queue", "array"]
list2 = ["stacc", "queve", "arrey"]

def compare_strings(list1, list2):

  assert len(list1) == len(list2), "Both lists should have the same length."

  for i in range(len(list1)):
    str1 = list1[i]
    str2 = list2[i]
    min_length = min(len(str1), len(str2))

    for j in range(min_length):
      if str1[j] != str2[j]:
        print("Mismatch in pair {}: First non-matching index is {}".format(i, j))
        break

compare_strings(list1, list2)
```

When you run this program, it compares each pair of strings in `list1` and `list2`. For each pair, it iteratively checks each index until it finds a mismatch. When a mismatch is found, it prints which pair and which index the mismatch occurs at.

