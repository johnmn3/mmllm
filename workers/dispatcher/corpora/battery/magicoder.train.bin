Finish the code below, containing a function to process an input string illustrating musical notes in a distinctive ASCII form. The aim is to decode the string and generate a list of integers displaying the duration of each note in beats, adhering to the provided key: 'o' denotes a whole note (4 beats), 'o|' signifies a half note (2 beats), and '.|' implies a quarter note (1 beat).

from typing import List

def parse_music(music_string: str) -> List[int]:
    """ Input to this function is a string representing musical notes in a specialized ASCII style.
    Your objective is to interpret this string and return list of integers reflecting the number of beats each
    note endures.

    Refer to this legend:
    'o' - whole note, endures four beats
    'o|' - half note, endures two beats
    '.|' - quarter note, endures one beat

    >>> parse_music('o o| .| o| o| .| .| .| .| o o')
    [4, 2, 1, 2, 2, 1, 1, 1, 1, 4, 4]
    """
<|end|>
<|asst|>
from typing import List

def parse_music(music_string: str) -> List[int]:
    music_list = music_string.split()
    duration_list = []
    
    for note in music_list:
        if note == 'o':
            duration_list.append(4)
        elif note == 'o|':
            duration_list.append(2)
        elif note == '.|':
            duration_list.append(1)
    
    return duration_list

print(parse_music('o o| .| o| o| .| .| .| .| o o')) # [4, 2, 1, 2, 2, 1, 1, 1, 1, 4, 4]
<|end|>


