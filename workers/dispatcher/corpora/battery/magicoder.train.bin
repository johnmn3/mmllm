<|asst|>
Here's your requested port to Javascript:

```javascript
function selectWords(s, n, l) {
    if (!s || !l.some(letter => s.includes(letter))) {
        return [];
    }
    let vowels = new Set(l);
    let words = s.split(' ');
    let result = [];
    for (let word of words) {
        let vowelCount = Array.from(word).filter(ch => vowels.has(ch)).length;
        if (vowelCount === n) {
            if (result.length !== 0) {
                let last = Array.from(result[result.length - 1]);
                let lastVowelCount = last.filter(ch => vowels.has(ch)).length;
                if (lastVowelCount === n) {
                    let vowelArray = last.filter(ch => vowels.has(ch));
                    let removedVowel = vowelArray[Math.floor(Math.random() * vowelArray.length)];
                    let idx = last.indexOf(removedVowel);
                    if (idx !== -1) last.splice(idx, 1);
                    result[result.length - 1] = last.join('') + word;
                } 
            } else {
                result.push(word);
            }
        }
    }
    return result;
}
```

This Javascript code simulates the working of the Python one. It does the same operations such as splitting the input string into words, counting the vowels in each word, selecting random vowels from the previous word when a new valid word is found, and combining this new word with the previous one (after the removal of a vowel from it).
<|end|>


