def smallest_change(arr, limit):
    left = 0 
    right = len(arr) - 1
    changes = 0
    while left <= right:
        if arr[left] != arr[right]:
            limit -= 1
            if arr[left] < arr[right]:
                arr[left] = arr[right]
            else:
                arr[right] = arr[left]
                
            if limit < 0:
                changes += 1
        left += 1
        right -= 1
    return changes
Please add some explanatory comments in the C code.
<|end|>
<|asst|>
Here is how you can write this Python Function to C Function:

```C
#include <stdio.h>
#include <stdlib.h>

int smallest_change(int* arr, int limit, int size) {
    int left = 0; // Start of the array
    int right = size - 1; // End of the array
    int changes = 0; // Counter for changes made

    while (left <= right) {
        // Check if current left and right elements are not equal
        if (arr[left] != arr[right]) {
            limit--; // decrement the limit

            // Update elements to make them equal, choose larger one to minimize changes.
            if (arr[left] < arr[right]) {
                arr[left] = arr[right];
            } 
            else {
                arr[right] = arr[left];
            }

            // if limit drops below zero, increment the changes counter.
            if (limit < 0) {
                changes++;
            }
        }
        left++; // move left pointer to right
        right--; // move right pointer to left
    }
    return changes; // returns number of changes made after limit is exhausted
}

int main() {
    int arr[] = {1,2,3,2,1}; // Your array here
    int size = sizeof(arr)/sizeof(arr[0]); // size calculation
    int limit = 2; // Your limit
    int changes = smallest_change(arr, limit, size);
    
    printf("Number of changes: %d\n", changes);

    return 0; 
}
```
This C function does exactly the same as your Python function. First, it checks if the values at both ends of the array are the same. If they aren't, it decrements the limit and makes the values the same (using the larger of the two values to minimize total changes). The limit can be understood as the number of changes you're allowed to make before you start counting changes. Once the limit is used up, each necessary change increments the change counter. The whole process continues moving inwards from both ends of the array, until all pairs of values have been checked. Finally, it returns the total number of changes made once the limit was used up.
<|end|>


