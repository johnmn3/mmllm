How to say this in C?
from typing import List

def validate_input(a: str, b: str) -> bool:
    """Validate that the strings contain only 0s and 1s and that their lengths 
    are between 10^3 and 10^5"""
    valid_chars = {'0', '1'}
    return all(c in valid_chars for c in a) and all(c in valid_chars for c in b) and \
        10**3 <= len(a) <= 10**5 and 10**3 <= len(b) <= 10**5

def string_xor(a: str, b: str) -> str:
    """Inputs: two distinct string parameters a and b, only from binary digits i.e. 1s and 0s, of length between 10^3 and 10^5. 
    Perform XOR operation on these inputs, validate strings are formatted correctly in binary and output the result as a string.
    >>> string_xor('010', '110')
    '100'
    """
    # Validate inputs
    if not validate_input(a, b):
        raise ValueError("Both inputs should be binary strings of length between 10^3 and 10^5")

    # Perform XOR operation
    return ''.join(str(int(x) ^ int(y)) for x, y in zip(a, b))

print(string_xor('010', '110'))  # Expected output: '100'
Could you also provide some commentary on what the C code is doing?
