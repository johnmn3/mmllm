def count_nums(arr):
    """
    >>> count_nums([]) == 0
    >>> count_nums([-4, 15, -12]) == 2
    >>> count_nums([2, 5, -1]) == 0
    """
    count = 0
    for num in arr:
        total = 0
        num_str = str(num)
        # if num is negative, start from 2nd character, and subtract the 1st digit (considered as negative)
        start = 0
        if num < 0: 
            start = 1
            total -= int(num_str[1])
        for digit in num_str[start:]:
            total += int(digit)
        if total > 0 and total % 4 == 0:
            count += 1
    return count
