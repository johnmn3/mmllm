Help me translate it to Perl
<|end|>
<|asst|>
```perl
use strict;
use warnings;

sub get_even_prime_and_merge {
    my (@l1, @l2) = @_;

    my @even_prime_numbers = ();

    foreach my $num (@l1) {
        if ($num % 2 == 0 && is_prime($num)) {
            push @even_prime_numbers, $num;
        }
    }

    foreach my $num (@l2) {
        if ($num % 2 == 0 && is_prime($num)) {
            push @even_prime_numbers, $num;
        }
    }

    # sort in descending order
    @even_prime_numbers = sort { $b <=> $a } @even_prime_numbers;

    return @even_prime_numbers;
}

sub is_prime {
    my $n = shift;

    if($n < 2){
        return 0;
    }

    for(my $i = 2; $i <= sqrt($n); $i++){
        if ($n % $i == 0) {
            return 0;
        }
    }
    return 1;
}

print join ', ', get_even_prime_and_merge((-1, 2, -4, 5, 6), (5, 3, -5, 2, -3, 3, 8, 0, 14, 4, -10)), "\n";
```

Please note that I've merged two second loops into one for both $num of @l1 and @l2 lists.
