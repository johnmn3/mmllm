        this.clubName = clubName;
        this.location = location;
        this.players = new ArrayList<Player>();
    }

    public void addPlayer(Player player) {
        players.add(player);
    }

    public void removePlayer(String playerName) {
        players.removeIf(player -> player.name.equals(playerName));
    }

    public void displayClubInfo() {
        System.out.println("Club: " + clubName + ", Location: " + location);
        System.out.println("Players:");
        for (Player player : players) {
            player.displayPlayerInfo();
        }
    }
}

class PremierLeague {
    HashMap<String, Club> clubs;

    public PremierLeague() {
        clubs = new HashMap<String, Club>();
    }

    public void addClub(Club club) {
        clubs.put(club.clubName, club);
    }

    public void removeClub(String clubName) {
        clubs.remove(clubName);
    }

    public void displayPremierLeagueInfo() {
        System.out.println("Premier League Clubs:");
        for (Club club : clubs.values()) {
            club.displayClubInfo();
        }
    }
}

