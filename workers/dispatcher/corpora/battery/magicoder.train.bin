can you transpile this to swift?
def pairs_sum_with_k_difference(l: list, k: int):
    l.sort() # Sort the list first. Time complexity: O(n log n)
    for i in range(len(l)):
        target = l[i] + k
        # Perform binary search for the target. Time complexity: O(log n)
        left, right = 0, len(l) - 1
        while left <= right:
            mid = (left + right) // 2
            if l[mid] == target and mid != i:
                return True
            elif l[mid] < target:
                left = mid + 1
            else:
                right = mid - 1
    return False
<|end|>
<|asst|>
Swift:

```swift
func pairsSumWithKDifference(_ arr: [Int], _ k: Int) -> Bool {
    let sortedArr = arr.sorted() // Sort the list first. Time complexity: O(n log n)
    for i in 0..<sortedArr.count {
        let target = sortedArr[i] + k
        // Perform binary search for the target. Time complexity: O(log n)
        var left = 0
        var right = sortedArr.count - 1
        while left <= right {
            let mid = (left + right) / 2
            if sortedArr[mid] == target && mid != i {
                return true
            } else if sortedArr[mid] < target {
                left = mid + 1
            } else {
                right = mid - 1
            }
        }
    }
    return false
}
```

Note:
Swift uses 0-based index for arrays, so the indexes should start from 0. The function parameters and return types need to be explicitly defined in Swift. The sort and binary search operations have been adapted to Swift syntax. The function name and variable names have been changed to follow Swift naming conventions. The colon ':' operator is used for type declaration in Python but in Swift it is used to denote the start of the type declaration.
<|end|>


