how to say this in lua?
def can_arrange(arr):
    last_checked_index = -1
    total_swaps = 0
    for i in range(1, len(arr)):
        if arr[i] < arr[i - 1]:
            last_checked_index = i - 1
            break
    if last_checked_index == -1:
        return {'index': -1, 'swap_with': -1, 'total_swaps': 0}
    swap_with_index = -1
    for i in range(last_checked_index + 1, len(arr)):
        if arr[i] > arr[last_checked_index]:
            swap_with_index = i
            break
    if swap_with_index != -1:
        total_swaps += 1
    return {'index': last_checked_index, 'swap_with': swap_with_index, 'total_swaps': total_swaps}
<|end|>
<|asst|>
Here is how you can translate the Python code to Lua:

```Lua
function can_arrange(arr)
    local last_checked_index = -1
    local total_swaps = 0
    for i = 2, #arr do
        if arr[i] < arr[i - 1] then
            last_checked_index = i - 1
            break
        end
    end
    if last_checked_index == -1 then
        return {index = -1, swap_with = -1, total_swaps = 0}
    end
    local swap_with_index = -1
    for i = last_checked_index + 2, #arr do
        if arr[i] > arr[last_checked_index] then
            swap_with_index = i
            break
        end
    end
    if swap_with_index ~= -1 then
        total_swaps = total_swaps + 1
    end
    return {index = last_checked_index, swap_with = swap_with_index, total_swaps = total_swaps}
end
```

Please note that in Lua, array index starts from 1, not 0 like in Python. So I had to adjust the range of the loops accordingly. Also, the '!=' operator does not exist in Lua. The equivalent is '~='.
<|end|>


