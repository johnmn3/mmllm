i'd like this translated to php:
def statistics(l):
    if not isinstance(l,list):
        return 'Invalid input'
    else:
        if not all(isinstance(i, int) for i in l):
            return "List must only contain integers"
        size = len(l)
        list_sum = sum(l)
        mean = list_sum/size
        l.sort()

        # when length of list is even
        if size % 2 == 0:
            median1 = l[size//2]
            median2 = l[size//2 - 1]
            median = (median1 + median2) / 2
        # when length of list is odd
        else:
            median = l[size//2]
        return round(median, 4), round(mean, 4)
please include remarks in the php translation to help me follow along.
