Create a function in JavaScript that displays an alert with a given message. Yet, rather than a simple string message, this function is supposed to handle multiple types such as String, Array, Object, and JSON string. 

Depending on the message type, it should either display it directly (String), join array elements into a single string (Array), convert the object to a JSON string (Object), or parse the JSON string to a readable format (JSON string). The function must also handle cases where the input is undefined or null. 

Write unit tests for your function to demonstrate that it works as expected for all different types of input.
<|end|>
<|asst|>
```JavaScript
function alertMessage(message){
    if(message === null || message === undefined){
        alert('The input is undefined or null');
    } else if(typeof message === 'string'){
        // If string is a valid JSON, parse it
        if(isValidJSON(message)){
            alert(JSON.stringify(JSON.parse(message), undefined, 4));
        } else {
            alert(message);
        }
    } else if(Array.isArray(message)){
        alert(message.join(" "));
    } else if(typeof message === 'object'){
        alert(JSON.stringify(message, undefined, 4));
    } else {
        alert('Invalid input');
    }
}

function isValidJSON(string){
    try{
        JSON.parse(string);
    } catch (e){
        return false;
    }
    return true;
}

// Unit Tests
console.log(alertMessage("Hi"));                             // Should alert "Hi"
console.log(alertMessage(null));                             // Should alert "The input is undefined or null"
console.log(alertMessage(undefined));                        // Should alert "The input is undefined or null"
console.log(alertMessage([1, 2, 3]));                        // Should alert "1 2 3"
console.log(alertMessage({name: "John", age: 30}));          // Should alert '{ "name": "John", "age": 30 }'
console.log(alertMessage('{"name": "John", "age": 30}'));    // Should alert '{ "name": "John", "age": 30 }'
```

Note: The function `alert()` is used for browser environments to pop up an alert box on the screen. The function `console.log()` is used instead here to show the output in the console, as text environments like this one do not support alert boxes.

Also, your test environment should support some kind of unit testing framework that captures these alert calls, as alert boxes are not designed to be automatically testable in this way. We substituted it with "console.log()" for demonstration purposes here.
