The corrected code should look like this:

```python
from collections.abc import Iterable

def shift_and_sort(lst, shift):
    if len(lst) <= shift:
        return lst

def sum_nested(val):
    if isinstance(val, Iterable):
        return sum(sum_nested(x) for x in val)
    else:
        return val

def sort_order(val):
    if isinstance(val, int):
        return (0, val)
    elif isinstance(val, float):
        return (1, val)
    elif isinstance(val, complex):
        return (2, val)
    elif isinstance(val, str):
        return (3, val)
    elif isinstance(val, list):
        return (4, sum_nested(val))
    elif isinstance(val, dict):
        return (5, sum_nested(val.values()))
    elif isinstance(val, tuple):
        return (6, val[0] if val else None)
    elif isinstance(val, set):
        return (7, len(val))
    elif isinstance(val, frozenset):
        return (8, len(val))
    else:  # custom object or unrecognized type
        return (9, str(val))

shift %= len(lst)
lst[:] = lst[shift:] + lst[:shift]
lst[shift:] = sorted(lst[shift:], key=sort_order)
return lst
```

