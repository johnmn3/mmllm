def categorized_counter(case):
    count = {'alphabet': {}, 'number': {}, 'punctuation': {}}
    for char in case:
        if char == ' ':
            continue
        elif char.isalpha():
            char = char.lower()
            if char in count['alphabet']:
                count['alphabet'][char] += 1
            else:
                count['alphabet'][char] = 1
        elif char.isdigit():
            if char in count['number']:
                count['number'][char] += 1
            else:
                count['number'][char] = 1
        else:
            if char in count['punctuation']:
                count['punctuation'][char] += 1
            else:
                count['punctuation'][char] = 1

    max_alpha_count = max(count['alphabet'].values()) if count['alphabet'] else 0
    max_num_count = max(count['number'].values()) if count['number'] else 0
    max_punct_count = max(count['punctuation'].values()) if count['punctuation'] else 0

    count['alphabet'] = {key: value for key, value in count['alphabet'].items() if value == max_alpha_count}
    count['number'] = {key: value for key, value in count['number'].items() if value == max_num_count}
    count['punctuation'] = {key: value for key, value in count['punctuation'].items() if value == max_punct_count}

    return count
<|end|>
<|asst|>
Here's the equivalent of your Python code in JavaScript:

```javascript
function categorizedCounter(case_) {
    let count = {'alphabet': {}, 'number': {}, 'punctuation': {}};
    for (let char of case_) {
        if (char === ' ')
            continue;
        else if (isNaN(parseInt(char))) {
            if (isNaN(char.charCodeAt(0))) {
                if (count['punctuation'][char])
                    count['punctuation'][char]++;
                else
                    count['punctuation'][char] = 1;
            }
            else {
                char = char.toLowerCase();
                if (count['alphabet'][char])
                    count['alphabet'][char]++;
                else
                    count['alphabet'][char] = 1;
            }
        }
        else {
            if (count['number'][char])
                count['number'][char]++;
            else
                count['number'][char] = 1;
        }
    }

    let maxAlphaCount = Math.max(...Object.values(count['alphabet'])) || 0;
    let maxNumCount = Math.max(...Object.values(count['number'])) || 0;
    let maxPunctCount = Math.max(...Object.values(count['punctuation'])) || 0;

    count['alphabet'] = Object.entries(count['alphabet']).reduce((a, [k, v]) => (v === maxAlphaCount ? {...a, [k]: v} : a), {});
    count['number'] = Object.entries(count['number']).reduce((a, [k, v]) => (v === maxNumCount ? {...a, [k]: v} : a), {});
    count['punctuation'] = Object.entries(count['punctuation']).reduce((a, [k, v]) => (v === maxPunctCount ? {...a, [k]: v} : a), {});

    return count;
}
```

This JavaScript snippet works similarly to the Python one, but it makes use of the built-in JavaScript functions like `isNaN`, `charCodeAt`, `Object.values`, `Object.entries`, and `Object.fromEntries`, along with a functional style reduce to create new dictionaries(or as they're called in JavaScript, objects) from the original 'alphabet', 'number', and 'punctuation' objects. 

Python and JavaScript handle string and object manipulation slightly differently. While JavaScript doesn't have built-in dictionary comprehension like Python, you can achieve the same effect with `Object.entries`, `Array.prototype.reduce`, and the spread syntax.

The categorization logic has been slightly adjusted due to the nature of Python's built-in `isalpha` and `isdigit`, which is slightly different from the way JavaScript determines alphanumeric characters and digits.
<|end|>


