Enhance the given programming test question by handling duplicates, tuples with even and odd number of elements, computing the median without sorting the list or using built-in functions, and creating a custom comparison function.

Complete the code:

def median(l: list, cmp_func: callable):
    """Return median of elements in the list l without sorting it or using built-in functions.
    Handles tuples with even and odd number of elements, duplicates, and uses cmp_func for comparisons.
    """
#Examples:
# median([3, 1, 2, 4, 5], lambda a, b: a - b) => 3
# median([-10, 4, 6, 1000, 10, 20], lambda a, b: a - b) => 15.0
# median([1, 2, 2, 4, 5], lambda a, b: a - b) => 2
<|end|>
<|asst|>
def median(l: list, cmp_func: callable):
    n = len(l)
    
    # Helper function find_kth: find k-th smallest element (0-based)
    def find_kth(k: int) -> int:
        if not l:
            return None
        
        # Partition the list around the pivot
        pivot = l[0]
        less = [x for x in l if cmp_func(x, pivot) < 0]
        equal = [x for x in l if cmp_func(x, pivot) == 0]
        greater = [x for x in l if cmp_func(x, pivot) > 0]
        
        if k < len(less):
            return find_kth(k)
        elif k < len(less) + len(equal):
            return pivot
        else:
            return find_kth(k - len(less) - len(equal))
    
    # If the length of the list is even, return the average of the two middle elements
    if n % 2 == 0:
        return (find_kth(n // 2 - 1) + find_kth(n // 2)) / 2
    else:
        return find_kth(n // 2)


# Test cases
print(median([3, 1, 2, 4, 5], lambda a, b: a - b))  # => 3
print(median([-10, 4, 6, 1000, 10, 20], lambda a, b: a - b))  # => 15.0
print(median([1, 2, 2, 4, 5], lambda a, b: a - b))  # => 2
