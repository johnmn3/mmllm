Please complete the following code:

def move_one_ball(arr):
    """
    We have an array 'arr' of N integers arr[1], arr[2], ..., arr[N].The
    numbers in the array will be randomly ordered. Your task is to determine if
    it is possible to get an array sorted in non-decreasing order by performing
    the following operation on the given array:
        You are allowed to perform right shift operation any number of times.
        Additionally, you are allowed to swap exactly two elements once in the
        given array.

    If it is possible to obtain the sorted array by performing the above operations
    then return True else return False.
    If the given array is empty then return True.

    Note: The given list may or may not have unique elements.

    For Example:

    move_one_ball([3, 4, 5, 1, 2])==>True
    move_one_ball([3, 5, 4, 1, 2])==>True
    move_one_ball([1, 2, 3, 5, 4])==>True
    move_one_ball([5, 4, 3, 1, 2])==>False

    """
    # Your code here
<|end|>
<|asst|>
def move_one_ball(arr):
    if len(arr) == 0:
        return True
    
    sorted_arr = sorted(arr)
    for i in range(len(arr)):
        if arr == sorted_arr:
            return True
        arr.insert(0, arr.pop()) # right shift operation
        
    # if array is still not sorted after rotating, try swapping two elements
    for i in range(len(arr)):
        for j in range(i+1, len(arr)):
            arr[i], arr[j] = arr[j], arr[i] # swap elements
            if arr == sorted_arr:
                return True
            arr[i], arr[j] = arr[j], arr[i] # swap back if not sorted
    
    return False

print(move_one_ball([3, 4, 5, 1, 2])) # True
print(move_one_ball([3, 5, 4, 1, 2])) # True
print(move_one_ball([1, 2, 3, 5, 4])) # True
print(move_one_ball([5, 4, 3, 1, 2])) # False
<|end|>


