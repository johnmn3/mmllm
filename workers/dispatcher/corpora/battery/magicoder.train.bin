can you make this code c#-compliant?
import java.util.*;
import java.lang.*;

class Solution {

    public static Pair<String, List<Integer>> swapOdd(List<Integer> lst1, List<Integer> lst2, int n) {
        PriorityQueue<Pair<Integer, Integer>> heap
                = new PriorityQueue<>(Comparator.comparing((Pair<Integer, Integer> p) -> p.getValue()).reversed());
        Map<Integer, Integer> map = new HashMap<>();
        List<Integer> evenList = new ArrayList<>();
        int oddInFirst = 0;

        for (int num : lst2) {
            if (num % 2 == 0) {
                evenList.add(num);
            } else {
                map.put(num, map.getOrDefault(num, 0) + 1);
            }
        }

        for (int num : lst1) {
            if (num % 2 != 0) {
                oddInFirst++;
            }
        }

        if (oddInFirst < evenList.size()) {
            return new Pair<>("Failure", new ArrayList<>());
        }

        for (Map.Entry<Integer, Integer> entry : map.entrySet()) {
            heap.add(new Pair<>(entry.getKey(), entry.getValue()));
        }

        List<Integer> result = new ArrayList<>();
        while (n-- > 0 && !heap.isEmpty()) {
            result.add(heap.poll().getKey());
        }
        return new Pair<>("Success", result);
    }

    public static void main(String[] args) {
        Pair<String, List<Integer>> result = Solution.swapOdd(Arrays.asList(1, 2, 3, 4), Arrays.asList(1, 2, 3, 4), 2);
        System.out.println(result.getKey() + " " + result.getValue());

        result = Solution.swapOdd(Arrays.asList(1, 2, 3, 4), Arrays.asList(1, 6, 3, 4), 3);
        System.out.println(result.getKey() + " " + result.getValue());
    }
}
<|end|>
<|asst|>
Here's the closest I could get to fully converting your Java code into equivalent C# code. I utilized the `KeyValuePair` structure in the .NET Framework to replace the `Pair` class from Java, and the `SortedDictionary` for sorting dictionary entries. 

```csharp
using System;
using System.Collections.Generic;
using System.Linq;

public class Solution
{
    public static KeyValuePair<string, List<int>> SwapOdd(List<int> lst1, List<int> lst2, int n)
    {
        var heap = new SortedDictionary<int, int>();
        var map = new Dictionary<int, int>();
        var evenList = new List<int>();
        int oddInFirst = 0;

        foreach (var num in lst2)
        {
            if (num % 2 == 0)
            {
                evenList.Add(num);
            }
            else
            {
                if (map.ContainsKey(num))
                {
                    map[num]++;
                }
                else
                {
                    map.Add(num, 1);
                }
            }
        }

        foreach (var num in lst1)
        {
            if (num % 2 != 0)
            {
                oddInFirst++;
            }
        }

        if (oddInFirst < evenList.Count)
        {
            return new KeyValuePair<string, List<int>>("Failure", new List<int>());
        }

        foreach (var entry in map)
        {
            heap.Add(entry.Value, entry.Key);
        }

        var result = new List<int>();
        while (n-- > 0 && heap.Count != 0)
        {
            var lastKey = heap.Keys.Last();
            result.Add(heap[lastKey]);
            heap.Remove(lastKey);
        }
        return new KeyValuePair<string, List<int>>("Success", result);
    }
 
    public static void Main(string[] args)
    {
        var result = SwapOdd(new List<int> { 1, 2, 3, 4 }, new List<int> { 1, 2, 3, 4 }, 2);
        Console.WriteLine(result.Key + " " + string.Join(", ", result.Value));

        result = SwapOdd(new List<int> { 1, 2, 3, 4 }, new List<int> { 1, 6, 3, 4 }, 3);
        Console.WriteLine(result.Key + " " + string.Join(", ", result.Value));
    }
}
``` 

Please note that SortedDictionary works in such a way that if two entries have the same key, the latter one will replace the former, which differs from the behavior in Java's PriorityQueue distinct to its PriorityQueue. If you need this functionality you may need to use a SortedSet with a custom IComparer or build your own heap structure.
<|end|>


