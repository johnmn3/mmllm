Rewrite the below code in Swift syntax:
from typing import List, Optional

def all_substrings(input_string):
    length = len(input_string)
    return [input_string[i: j] for i in range(length) for j in range(i + 1, length + 1)]

def longest_substring(strings: List[str], k: int) -> Optional[str]:
    if len(strings) == 0:
        return None
    longest_str = ''
    for s in strings:
        for substr in all_substrings(s):
            count = sum(substr in string for string in strings)
            if count >= k and len(substr) > len(longest_str):
                longest_str = substr
    return longest_str if longest_str != '' else None
I'd love some insight into how the translated code works.
<|end|>
<|asst|>
Here is the Python code translated to Swift:

```swift
import Foundation

func allSubstrings(inputString: String) -> [String] {
    return Array(0..<inputString.count).flatMap { i in
        (i...inputString.count).map { j in
            String(inputString[inputString.index(inputString.startIndex, offsetBy: i)..<inputString.index(inputString.startIndex, offsetBy: j)])
        }
    }
}

func longestSubstring(strings: [String], k: Int) -> String? {
    guard !strings.isEmpty else {
        return nil
    }
    var longestStr = ""
    for s in strings {
        for substr in allSubstrings(inputString: s) {
            let count = strings.filter { $0.contains(substr) }.count
            if count >= k && substr.count > longestStr.count {
                longestStr = substr
            }
        }
    }
    return longestStr != "" ? longestStr : nil
}
```

Swift translation insight:
- Swift does not have list comprehension as in Python, so the equivalent for getting all substrings in Swift uses `flatMap` and `map`. 
- `flatMap` is a combination of `map` and `flatten`. This means, it first applies a function to all elements in a collection, just like `map`, and then combines all the results into a single, flat array.
- The `contains` method is used instead of `in` keyword for checking if a string contains a substring.
- The ternary operator (`?:`) is used as a shorthand for the `if-else` statement.
- Swift uses `count` on a `String` object to get the number of letters in a `String`, whereas Python uses `len` function.
- Also notice that in Swift, function names are usually verbs and variable names are usually nouns.
- Lastly, Swift uses camel case hence `all_substrings` becomes `allSubstrings`, `input_string` becomes `inputString`, and `longest_str` becomes `longestStr`.
<|end|>


