        Vector3D v1 = new Vector3D(1, 2, 3);
        Vector3D v2 = new Vector3D(4, 5, 6);

        Vector3D addResult = v1.add(v2);
        System.out.println("Vector addition: (" + addResult.x + ", " + addResult.y + ", " + addResult.z + ")");

        Vector3D subtractResult = v1.subtract(v2);
        System.out.println("Vector subtraction: (" + subtractResult.x + ", " + subtractResult.y + ", " + subtractResult.z + ")");

        double dotResult = v1.dot(v2);
