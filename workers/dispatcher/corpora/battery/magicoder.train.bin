To perform unit testing, you first need to convert your Python function into C# format. Below is a potential equivalent implementation.

C# Implementation

```csharp
public Dictionary<string,int> BookDistribution(string[] s, int n, string[] books, Dictionary<string,int> bookPrices, Dictionary<string,int> demand)
{
    var bookCounts = new Dictionary<string, int>();
    foreach (var b in s)
    {
        var split = b.Split(' ');
        bookCounts[split[0]] = int.Parse(split[1]);
    }

    var totalBookCosts = books.Where(book => demand.ContainsKey(book))
                              .Sum(book => bookPrices[book] * demand[book]);
    if (totalBookCosts != n)
        throw new Exception("Total cost is mismatching with given cost");

    var result = new Dictionary<string, int>();
    foreach (var book in books)
    {
        if (bookCounts.ContainsKey(book) && bookCounts[book] > (demand.ContainsKey(book) ? demand[book] : 0))
        {
            result[book] = bookCounts[book] - (demand.ContainsKey(book) ? demand[book] : 0);
        }
    }

    return result;
}
```

