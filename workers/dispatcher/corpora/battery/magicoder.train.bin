using namespace std;

string triangle_type(float a, float b, float c) {

    // Check triangle inequality theorem
    if (a + b <= c || a + c <= b || b + c <= a)
        return "Not a triangle";

    // Check for equilateral triangle
    else if(a == b && b == c)
        return "Equilateral";

    // Check for isosceles triangle
    else if(a == b || a == c || b == c)
        return "Isosceles";

