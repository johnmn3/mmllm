    try:
        if region is None:
            s3.Bucket(bucket_name).create()
        else:
            s3.Bucket(bucket_name).create(CreateBucketConfiguration={'LocationConstraint': region})
        logger.info(f"Bucket {bucket_name} created successfully")
    except BotoCoreError as e:
        logger.error(f"Error in creating Bucket {bucket_name}: {e}")

def list_buckets():
    return [bucket.name for bucket in s3.buckets.all()]

def list_files(bucket_name):
    bucket = s3.Bucket(bucket_name)
    return [obj.key for obj in bucket.objects.all()]

def upload_file(file_name, bucket_name, object_name=None):
    if object_name is None:
        object_name = file_name
    try:
        response = s3.Bucket(bucket_name).upload_file(file_name, object_name)
        logger.info(f"{file_name} uploaded successfully to {bucket_name} as {object_name}")
    except BotoCoreError as e:
        logger.error(f"Error in uploading {file_name} to {bucket_name}: {e}")

def download_file(bucket_name, file_name, save_as=None):
    if save_as is None:
        save_as = file_name
    try:
        s3.Bucket(bucket_name).download_file(file_name, save_as)
        logger.info(f"{file_name} downloaded successfully from {bucket_name}")
    except BotoCoreError as e:
        logger.error(f"Error in downloading {file_name} from {bucket_name}: {e}")

def delete_file(bucket_name, file_name):
    try:
        s3.Object(bucket_name, file_name).delete()
        logger.info(f"{file_name} deleted successfully from {bucket_name}")
    except BotoCoreError as e:
        logger.error(f"Error in deleting {file_name} from {bucket_name}: {e}")
<|end|>
<|asst|>
Here's how you might perform these functions in Perl using the Amazon::S3 module.

```perl
use strict;
use warnings;
use Log::Log4perl;
use Amazon::S3;
use Try::Tiny;

# Setting up logging
my $logger = Log::Log4perl->get_logger();

my $s3 = Amazon::S3->new(
    {   aws_access_key_id     => 'your_access_key_here',
        aws_secret_access_key => 'your_secret_access_key',
        retry                 => 1,
    }
);

sub create_bucket {
    my ($bucket_name, $region) = @_;
    try {
        $s3->add_bucket( { bucket => $bucket_name, location_constraint => $region } );
        $logger->info("Bucket $bucket_name created successfully");
    } catch {
        $logger->error("Error in creating Bucket $bucket_name: $_");
    };
}

sub list_buckets {
    return map { $_->bucket } $s3->buckets;
}

sub list_files {
    my $bucket_name = shift;
    my $bucket = $s3->bucket($bucket_name);
    return map { $_->key } $bucket->list_all;
}

sub upload_file {
    my ($file_name, $bucket_name, $object_name) = @_;
    $object_name ||= $file_name;
    my $bucket = $s3->bucket($bucket_name);
    try {
        $bucket->add_key_filename($object_name, $file_name, {acl_short => 'public-read'} );
        $logger->info("$file_name uploaded successfully to $bucket_name as $object_name");
    } catch {
        $logger->error("Error in uploading $file_name to $bucket_name: $_");
    };
}

sub download_file {
    my ($bucket_name, $file_name, $save_as) = @_;
    $save_as ||= $file_name;
    my $bucket = $s3->bucket($bucket_name);
    try {
        $bucket->get_key_filename($file_name, 'GET', $save_as);
        $logger->info("$file_name downloaded successfully from $bucket_name");
    } catch {
        $logger->error("Error in downloading $file_name from $bucket_name: $_");
    };
}

sub delete_file {
    my ($bucket_name, $file_name) = @_;
    my $bucket = $s3->bucket($bucket_name);
    try {
        $bucket->delete_key($file_name);
        $logger->info("$file_name deleted successfully from $bucket_name");
    } catch {
        $logger->error("Error in deleting $file_name from $bucket_name: $_");
    };
}
```

Please note that above Perl code snippet uses the packages Amazon::S3 for S3 related operations and Try::Tiny for error handling. You need to replace `'your_access_key_here'` and `'your_secret_access_key'` with your own AWS access and secret keys.

Make sure you have installed these packages before running the program. You can install them using cpan:

```terminal
cpan Amazon::S3
cpan Try::Tiny
cpan Log::Log4perl
```
