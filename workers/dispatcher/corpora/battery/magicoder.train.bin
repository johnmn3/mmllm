Help me migrate this code to Rust:
import apache_beam as beam
from apache_beam.options.pipeline_options import PipelineOptions
from apache_beam.io.gcp.bigquery import BigQueryDisposition, WriteToBigQuery
from apache_beam.io import ReadFromKafka
from apache_beam.io.gcp.bigquery import parse_table_schema_from_json
from confluent_kafka import avro
from apache_beam.io.gcp.pubsub import WriteToPubSub, PubsubMessage

table_schema = parse_table_schema_from_json("""
{
  "fields": [
    {
      "name": "userId",
      "type": "STRING",
      "mode": "REQUIRED"
    },
    {
      "name": "songName",
      "type": "STRING",
      "mode": "REQUIRED"
    },
    {
      "name": "artistName",
      "type": "STRING",
      "mode": "REQUIRED"
    },
    {
      "name": "listeningTime",
      "type": "FLOAT",
      "mode": "REQUIRED"
    }
  ]
}
""")

def decode_kafka_message(msg):
    """Decode the Kafka message."""
    key_schema = avro.load("key_schema.avsc")
    value_schema = avro.load("value_schema.avsc")
    key = avro.loads(msg.key(), key_schema)
    value = avro.loads(msg.value(), value_schema)
    return {"userId": key["userId"],
            "songName": value["songName"],
            "artistName": value["artistName"],
            "listeningTime": value["listeningTime"]}

options = PipelineOptions([
    "--project=<PROJECT-ID>",
    "--runner=DataflowRunner",
    "--temp_location=gs://<TEMP-LOCATION>",
    "--region=<LOCATION>",
])

p = beam.Pipeline(options=options)

result = (p | "ReadFromKafka" >> ReadFromKafka(consumer_config={"bootstrap.servers": "<KAFKA-SERVERS>"},
                                                topics=["<KAFKA-TOPIC>"])
            | "DecodeKafkaMessage" >> beam.Map(decode_kafka_message)
            | "WriteToBigQuery" >> WriteToBigQuery(
                "projectId:datasetId.tableId",
                schema=table_schema,
                write_disposition=BigQueryDisposition.WRITE_APPEND,
            )
          )

result = p.run()
result.wait_until_finish()
It would be great if you could include comments to clarify the Rust code.
<|end|>
<|asst|>
Rust does not have equivalent libraries to Apache Beam and Confluent Kafka's Python libraries and hence a direct translation isn't possible. Also, unlike Python, Apache Beam does not support Rust. Furthermore, while Rust does have BigQuery and Kafka client libraries, they don't have the same APIs as the Python libraries used in your code. The GCP BigQuery Rust client library is under development and incomplete.

If you want a rough equivalent that interacts with Kafka in Rust, you could use the 'rust-rdkafka' library. However, for parsing Avro data, BigQuery and the streaming data job you would need to roll your own solution or use different technology.

Here is an example of a Rust Kafka consumer using 'rust-rdkafka'. However, note that this is a vastly simplified version which does not parse Avro data nor does it interact with BigQuery:

```rust
use rdkafka::config::ClientConfig;
use rdkafka::consumer::stream_consumer::StreamConsumer;
use rdkafka::consumer::Consumer;
use futures::stream::StreamExt;

async fn consume_kafka() {
    // Create a Kafka consumer.
    let consumer: StreamConsumer = ClientConfig::new()
        .set("bootstrap.servers", "<KAFKA-SERVERS>")
        .set("group.id", "<GROUP-ID>")
        .create()
        .unwrap();

    // Subscribe to the Kafka topic.
    consumer.subscribe(&["<KAFKA-TOPIC>"]).unwrap();

    // Continuously read from the Kafka topic in a loop.
    let mut message_stream = consumer.stream();
    while let Some(message) = message_stream.next().await {
        match message {
            Err(e) => println!("Error consuming from Kafka: {}", e),
            Ok(m) => {
                let key = match m.key_view::<str>() {
                    None => "".to_string(),
                    Some(Ok(s)) => s.to_string(),
                    Some(Err(_)) => "".to_string(),
                };
                let payload = match m.payload_view::<str>() {
                    None => "".to_string(),
                    Some(Ok(s)) => s.to_string(),
                    Some(Err(_)) => "".to_string(),
                };
                println!("Key: {}, Value: {}", key, payload);
            }
        };
    }
}
```

As for BigQuery, while there is a 'google-bigquery2' Rust client library, it's not feature complete and has a very different API from the Python client you are using.

Without the support of Apache Beam in Rust, it will be a significant amount of work to achieve the same functionality, and Rust may not currently be the best choice for this task.
<|end|>


