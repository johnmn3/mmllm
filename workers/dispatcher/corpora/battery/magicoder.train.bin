Enhance the difficulty of the given programming test question.

In the code, replace the common sorting method with a heap-based implementation.

Finish the following code:

def strange_sort_list_heap(lst):
    '''
    Given a list of integers and decimals, return the list in a strange order using a heap-based implementation.
    The strange sorting should follow these steps:
    - Start with the minimum value.
    - Then find the maximum of the remaining values.
    - Then find the minimum of the remaining values not already in the output, and so on.
    
    Examples:
    strange_sort_list_heap([1, 2, 3, 4]) == [1, 4, 2, 3]
    strange_sort_list_heap([5, 5, 5, 5]) == [5, 5, 5, 5]
    strange_sort_list_heap([]) == []
    strange_sort_list_heap([-2, 1.5, 3.5, -1]) == [-2, 3.5, -1, 1.5]
    '''
    
    # Your heap-based code goes here.
<|end|>
<|asst|>
import heapq

def strange_sort_list_heap(lst):
    if not lst:
        return []

    min_heap = []
    max_heap = []

    for num in lst:
        heapq.heappush(min_heap, num)
        heapq.heappush(max_heap, -num)

    result = []

    while min_heap:
        min_num = heapq.heappop(min_heap)
        result.append(min_num)

        while min_heap and min_heap[0] == min_num:
            heapq.heappop(min_heap)

        if max_heap:
            max_num = -heapq.heappop(max_heap)
            while max_heap and max_heap[0] == -(max_num):
                heapq.heappop(max_heap)

            if max_num not in result:
                result.append(max_num)

    return result

# Examples
print(strange_sort_list_heap([1, 2, 3, 4]))
print(strange_sort_list_heap([5, 5, 5, 5]))
print(strange_sort_list_heap([]))
print(strange_sort_list_heap([-2, 1.5, 3.5, -1]))
<|end|>


