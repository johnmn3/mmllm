Here's the corrected code. Besides syntax errors, there were several typos and invalid characters:

```python
import boto3
import pandas as pd
from sqlalchemy import create_engine

class AwsAuroraProcessor:
    def __init__(self, host, port, dbname, user, password):
        self.engine = self._create_engine(host, port, dbname, user, password)

    def _create_engine(self, host, port, dbname, user, password):
        conn_str = f"mysql+pymysql://{user}:{password}@{host}:{port}/{dbname}"
        engine = create_engine(conn_str)
        return engine

    def execute_query(self, query):
        result = None
        try:
            with self.engine.connect() as connection:
                result_df = pd.read_sql_query(query, connection)
                result = result_df.copy()
        except Exception as e:
            print("An error occurred:", e)
        return result

    def handle_missing_data(self, df):
        if df is None:
            return None

        # Fill missing values with mean column values in the dataframe
        df.fillna(df.mean(), inplace=True)
        return df

    def normalize_data(self, df, numeric_columns):
        if df is None:
            return None

        # Apply normalization techniques to numeric columns
        for column in numeric_columns:
            df[column] = (df[column] - df[column].min()) / (df[column].max() - df[column].min())
        
        return df
```

Make sure the details provided to the `__init__` method during instantiation of the `AwsAuroraProcessor` class (host, port, dbname, user, password) are valid.
