write this code in c, please:
def fibfib(n: int, m: int) -> int:
    fib = [0] * max(3, n + 1)
    fib[2] = 1

    for i in range(3, n + 1):
        fib[i] = fib[i - 1] + fib[i - 2] + fib[i - 3]
        if i >= m:
            fib[i] -= fib[i - m]

    return fib[n]

# Tests
