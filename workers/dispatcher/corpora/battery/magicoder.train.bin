  <input type="text" id="idFilter" placeholder="Filter by ID..">
  <button id="sortPrice">Sort by Price</button>
  <table>
  <thead>
    <tr>
      <th>ID</th>
      <th>Name</th>
      <th>Price</th>
      <th>Description</th>
      <th>Quantity in Stock</th>
      <th>Last Restock Date</th>
    </tr>
  </thead>
  <tbody id="products">
    <!-- Rows of Product will go here -->
  </tbody>
  </table>
<script src="main.js"></script> 
</body>
</html>
```

JavaScript (main.js):

```
var products = [
  // Here should go your products data
  { id: 1, name: 'Product 1', price: 14.99, description: 'Description', qty: 10, lastRestock: '2020-01-01'},
  { id: 2, name: 'Product 2', price: 19.99, description: 'Description', qty: 8, lastRestock: '2020-02-01'},
  // etc...
];

function renderProducts(products) {
  var tbody = document.getElementById('products');
  tbody.innerHTML = '';
  for (var i = 0; i < products.length; i++) {
    var tr = "<tr>"
    tr += "<td>" + products[i].id + "</td>"
    tr += "<td>" + products[i].name + "</td>"
    tr += "<td>" + products[i].price + "</td>"
    tr += "<td>" + products[i].description + "</td>"
    tr += "<td>" + products[i].qty + "</td>"
    tr += "<td>" + products[i].lastRestock + "</td></tr>"
    tbody.innerHTML += tr;
  }
}

document.getElementById('sortPrice').addEventListener('click', function() {
  products.sort(function(a, b) {
    return a.price - b.price; // for ascending order
  });
  renderProducts(products);
});

document.getElementById('idFilter').addEventListener('input', function(e) {
  var filteredProducts = products.filter(function(product) {
    return product.id === parseInt(e.target.value, 10);
  });
  renderProducts(filteredProducts);
});

renderProducts(products);
```

To see the generated table and apply sorting/filtering, save the HTML to a .html file, JavaScript code to main.js file, put these two files in the same directory. Then open the .html file with a browser.
