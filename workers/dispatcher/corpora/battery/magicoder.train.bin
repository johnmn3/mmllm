Design a JavaScript function that ascertains if every individual integer within a provided multidimensional array is a prime number. Create a second function to measure and return the number of prime integers in the array. The function should account for varying sizes of sub-arrays within the main array. The prime identification function should also be optimized for handling large prime numbers.
<|end|>
<|asst|>
In Javascript, you can achieve this using the two functions described below:

```javascript
// Function to check if a number is prime
function isPrime(num) {
    if (num <= 1) return false; // numbers less than or equal to 1 are not prime
    if (num === 2) return true; // 2 is a prime number
    if (num % 2 === 0) return false; // even numbers greater than 2 are not prime
    let sqrt = Math.sqrt(num);
    for (let i = 3; i <= sqrt; i += 2) { 
        if (num % i === 0) return false; 
    }
    return true;
}

// Function to  check if all numbers in array are prime and count the total number of prime numbers
function primeChecker(arr) {
    let count = 0;
    function checkSubArray(subArr) {
        for (let i = 0; i < subArr.length; i++) {
            if (Array.isArray(subArr[i])) {
                count += checkSubArray(subArr[i])
            } else {
                if (isPrime(subArr[i])) {
                    count++
                } else {
                    return false;
                }
            }
        }
        return count;
    }

    let isAllPrime = checkSubArray(arr) === count;
    console.log(`All numbers are prime: ${isAllPrime}`);
    console.log(`Total number of prime numbers: ${count}`);
}

// Example usage
let arr = [[2, 3, 5], [7, 11, 13], [17, 19, 23]];
primeChecker(arr);
```

This implementation offers a significant amount of optimization for large numbers by only checking divisibility up to the square root of a given number. It also efficiently processes nested arrays by using a recursive approach. 

The `isPrime(num)` function determines whether a single value is a prime number.

The `primeChecker(arr)` function processes a nested array and utilizes the `isPrime(num)` function to determine primality for each value. It keeps track of the number of prime numbers found, and also whether every number processed is a prime number.

It then logs whether all numbers are prime and the total number of prime numbers to the console.
<|end|>


