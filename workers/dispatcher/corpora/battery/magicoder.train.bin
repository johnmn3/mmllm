Here is a possible solution:

```python
import pandas as pd
from sklearn.model_selection import train_test_split
from sklearn.feature_extraction.text import CountVectorizer
from sklearn import metrics
from sklearn.naive_bayes import MultinomialNB
from nltk.corpus import stopwords 
from nltk.tokenize import word_tokenize 
import nltk
nltk.download('punkt')
nltk.download('stopwords')

# Load data
url = 'https://raw.githubusercontent.com/emmanueliarussi/DataScienceCapstone/master/3_MidtermProjects/ProjectRTS/data/train.csv'
df = pd.read_csv(url)

# Preprocessing data
# Lower case, remove punctuation, remove stopwords
# Not taking into account punctuation can help generalizing better
df['text'] = df['text'].str.lower().str.replace('[^\w\s]','')
stop = stopwords.words('english')
df['text'] = df['text'].apply(lambda x: ' '.join([word for word in x.split() if word not in (stop)]))

X = df['text']
y = df['target']

# Split data to train and test
X_train, X_test, y_train, y_test = train_test_split(X, y, test_size=0.3, random_state=42)

# Converting text data into numerical data
vectorizer = CountVectorizer()
X_train_dtm = vectorizer.fit_transform(X_train)
X_test_dtm = vectorizer.transform(X_test)

# Building Naive Bayes model 
naive_bayes = MultinomialNB()
naive_bayes.fit(X_train_dtm, y_train)
predictions = naive_bayes.predict(X_test_dtm)

# Measure accuracy of the model
accuracy = metrics.accuracy_score(y_test, predictions)
print('Accuracy: %f' % accuracy)
```
