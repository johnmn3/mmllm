lst = [
    {"score": 1, "age": 22}, 
    {"score": 5, "age":20, "extra_credit": 3}, 
    {"score": 5, "age":25}, 
    {"score": 5, "age": 20}, 
    {"score": 8, "age": 30}
]

for dic in lst:
    if 'extra_credit' in dic:
        dic['score'] += dic['extra_credit']

lst.sort(key=lambda x: (x.get('score', 0), x.get('age', 0)))

