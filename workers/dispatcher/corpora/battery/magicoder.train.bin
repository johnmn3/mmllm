```python
import nltk
from nltk.corpus import stopwords
from nltk.tokenize import word_tokenize
from nltk.stem import WordNetLemmatizer
import spacy

# NLTK
def nltk_preprocess(data):
    nltk.download('punkt')
    nltk.download('wordnet')
    nltk.download('stopwords')
    stop_words = set(stopwords.words('english')) 
    word_tokens = word_tokenize(data) 
    lemmatizer = WordNetLemmatizer()
    filtered_sentence = [lemmatizer.lemmatize(w) for w in word_tokens if not w in stop_words]
    return filtered_sentence

# SpaCy
def spacy_preprocess(data):
    sp = spacy.load('en_core_web_sm')
    all_stopwords = sp.Defaults.stop_words
    text = sp(data)
    tokens = [token.lemma_ for token in text if not token.is_stop]
    return tokens

data = "This is a sentence for preprocessing using NLTK and SpaCy."

print(nltk_preprocess(data))
print(spacy_preprocess(data))

# For HuggingFace Transformers, you can use tokenizer provided by the library
from transformers import AutoTokenizer

tokenizer = AutoTokenizer.from_pretrained('bert-base-uncased')
     
def transformers_preprocess(data):
    inputs = tokenizer(data, truncation=True, padding=True, return_tensors='pt')
    return inputs

print(transformers_preprocess(data))
```

