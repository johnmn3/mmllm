import java.util.PriorityQueue;

public class GridPath {
    private static class Node implements Comparable<Node> {
        int x, y, cost;
        StringBuilder path;
        Node(int x, int y, int cost, StringBuilder path) {
            this.x = x;
            this.y = y;
            this.cost = cost;
            this.path = path;
        }
        public int compareTo(Node otherNode) {
            return this.path.toString().compareTo(otherNode.path.toString());
        }
    }

    public String[] getMinimalPaths(int n, int m, int k) {
        String[] result = new String[m];
        PriorityQueue<Node> queue = new PriorityQueue<>();
        queue.offer(new Node(0, 0, 1, new StringBuilder()));
        boolean[][] visited = new boolean[n][n];
        while (!queue.isEmpty() && m > 0) {
            Node currentNode = queue.poll();
            if (currentNode.cost > k || visited[currentNode.x][currentNode.y]) {
                continue;
            }
            if (currentNode.x == n - 1 && currentNode.y == n - 1) {
                result[--m] = currentNode.path.toString();
                continue;
            }
            visited[currentNode.x][currentNode.y] = true;
            if (currentNode.x + 1 < n) {
                queue.offer(new Node(
                        currentNode.x + 1,
                        currentNode.y,
                        currentNode.cost + 1,
                        new StringBuilder(currentNode.path).append('D')
                ));
            }
            if (currentNode.y + 1 < n) {
                queue.offer(new Node(
                        currentNode.x,
                        currentNode.y + 1,
                        currentNode.cost + 1,
                        new StringBuilder(currentNode.path).append('R')
                ));
            }
        }
        return result;
    }
}
<|end|>
<|asst|>
Here's the implementation of the above Java code in JavaScript:

```javascript
class Node {
    constructor(x, y, cost, path) {
        this.x = x;
        this.y = y;
        this.cost = cost;
        this.path = path;
    }
    compareTo(otherNode) {
        return this.path.localeCompare(otherNode.path);
    }
}

const GridPath = {
    getMinimalPaths(n, m, k) {
        let queue = new PriorityQueue((a, b) => a.compareTo(b));
        let result = new Array(m);
        let visited = Array(n).fill().map(() => Array(n).fill(false));
        
        queue.enqueue(new Node(0, 0, 1, ''));
        
        while (!queue.isEmpty() && m > 0) {
            let currentNode = queue.dequeue();
            if (currentNode.cost > k || visited[currentNode.x][currentNode.y])
                continue;
            if (currentNode.x === n - 1 && currentNode.y === n - 1) {
                result[--m] = currentNode.path;
                continue;
            }
            visited[currentNode.x][currentNode.y] = true;
            if (currentNode.x + 1 < n) {
                queue.enqueue(new Node(
                    currentNode.x + 1, 
                    currentNode.y, 
                    currentNode.cost + 1, 
                    currentNode.path + 'D'));
            }
            if (currentNode.y + 1 < n) {
                queue.enqueue(new Node(
                    currentNode.x,
                    currentNode.y + 1,
                    currentNode.cost + 1,
                    currentNode.path + 'R'));
            }
        }
        return result;
    }
}

class PriorityQueue {
    constructor(comparator = PriorityQueue.defaultComparator) {
        this._heap = [];
        this._comparator = comparator;
    }
    
    static defaultComparator(a, b) {
        return a < b;
    }
    
    size() {
        return this._heap.length;
    }
    
    isEmpty() {
        return this.size() == 0;
    }
    
    peek() {
        return this._heap[0];
    }
    
    enqueue(value) {
        this._heap.push(value);
        this._siftUp();
        return this.size();
    }
    
    dequeue() {
        const poppedValue = this.peek();
        const bottom = this.size() - 1;
        if (bottom > 0) {
            this._swap(0, bottom);
        }
        this._heap.pop();
        this._siftDown();
        return poppedValue;
    }
    
    _doSwap(parent, i) {
        return this._comparator(this._heap[parent], this._heap[i]);
    }
    
    _siftUp() {
        let node = this.size() - 1;
        while (node > 0 && this._doSwap((node - 1) >> 1, node)) {
            node = this._swap(node, (node - 1) >> 1);
        }
    }
    
    _siftDown() {
        let node = 0;
        while ((node << 1) + 1 < this.size() && (
            this._doSwap(node, (node << 1) + 1) ||
            (node << 1) + 2 < this.size() && this._doSwap(node, (node << 1) + 2)
        )) {
            node = this._swap(node, this._heap[(node << 1) + 1] < this._heap[(node << 1) + 2] ? (node << 1) + 1 : (node << 1) + 2);
        }
    }
    _swap(i, j) {
        [this._heap[i], this._heap[j]] = [this._heap[j], this._heap[i]];
        return j;
    }
} 
```
This includes a simple PriorityQueue implementation since there is no native JavaScript PriorityQueue. The ability to pass a custom comparator function allows us to ensure the order in queue is determined based on the Node's path value which is important for the problem we're trying to solve.
<|end|>


