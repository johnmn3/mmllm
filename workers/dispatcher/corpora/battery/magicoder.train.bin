Sure, here's the edited version. I've made some assumptions but the main point was to remove all typos and non-standard Python syntax. Here's the correct version:

```python
def will_it_fly(g, w, n):
    # Input Validation
    if not isinstance(g, list) or not all(isinstance(i, int) for i in g):
        raise ValueError("g should be a list of integers")
    if not isinstance(w, int) or w < 0:
        raise ValueError("w should be a positive integer representing the maximum allowable weight")
    if not isinstance(n, int) or n < 0:
        raise ValueError("n should be a positive integer representing the number of smallest unique numbers")

    # Check if g is a palindrome
    if g != g[::-1]:
        return False

    # Check the sum
    if sum(g) > w:
        return False

    # Check unique smallest integers
    if len(set(sorted(g)[:n])) != n:
        return False

    return True


# Test Cases

# Unique numbers are 1 and 2, and sum is 3 which is less than 5. But it's not a palindrome.
assert not will_it_fly([1, 2], 5, 2)

# Unique numbers are 2 and 3, and it's a palindrome. But, sum is 8 which is greater than 1.
assert not will_it_fly([3, 2, 3], 1, 2)

# It's a palindrome, sum is 8 which is less than 9 and it has 2 unique numbers which are 2 and 3.
assert will_it_fly([3, 2, 3], 9, 2)

# It's a single number so it's a palindrome and it has one unique number that is 3 and sum is also 3 which is less than 5.
assert will_it_fly([3], 5, 1)

# Larger test case
# It's a palindrome, sum is 2000000 which is less than 10000000 and it has 200000 unique numbers.
assert will_it_fly(list(range(200000)) + list(range(199999, -1, -1)), 10000000, 200000)

print("All test cases passed.")
```
