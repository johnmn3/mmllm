Generate a JavaScript object which includes properties representing specific individuals' names and their corresponding chronological ages. 

In addition to this, add two functions within the object: 

1. A function that updates the age of a specific individual.
2. A function that finds the individual with the highest age and returns their name. 

Lastly, create these functions using JavaScript prototypes rather than including them in the initial object creation. 

Make sure that your code handles potential errors such as trying to update the age of an individual who does not exist in the object.
<|end|>
<|asst|>
Here is how you can define the object and the corresponding methods in JavaScript:

```javascript
function AgeRecord() {
    this.records = {};
}

AgeRecord.prototype.updateAge = function(name, age) {
    if(this.records.hasOwnProperty(name)) {
        this.records[name] = age;
    } else {
        throw new Error('The provided name does not exist in the records');
    }
}

AgeRecord.prototype.findOldest = function() {
    let oldestName = null;
    let oldestAge = -Infinity;

    for(let name in this.records) {
        if(this.records[name] > oldestAge) {
            oldestAge = this.records[name];
            oldestName = name;
        }
    }

    if(oldestName === null) {
       throw new Error('No records available'); 
    }

    return oldestName;
}

let record = new AgeRecord();
record.records['John'] = 28;
record.records['Sally'] = 24;
record.records['Bob'] = 32;

try {
    record.updateAge('Mike', 30); // Throws an error
} catch(e) {
    console.error(e.message);
}

try {
    console.log(record.findOldest()); // Outputs: Bob
} catch(e) {
    console.error(e.message);
}
```
In this code, properties of `records` object represents an individual's name while their corresponding value represent their chronological ages. `updateAge` function updates the age of an specific individual and `findOldest` function finds and returns the name of the individual with the highest age. 

We handle potential errors by raising them when attempting to update the age of an individual who does not exist, and when finding the oldest individual if no records are available.
<|end|>


