i need to see how this would be in swift:
def get_positive_and_sort(l: list):
    def swap_elements(n: list, index1: int, index2: int):
        """Swap two elements in a list based on their indices."""
        n[index1], n[index2] = n[index2], n[index1]

    def bubble_sort(n: list):
        """Sort a list in place using the bubble sort algorithm."""
        for i in range(len(n)):
            for j in range(len(n) - 1):
                if n[j] > n[j + 1]:
                    swap_elements(n, j, j + 1)

    positive_nums = [num for num in l if num > 0]
    bubble_sort(positive_nums)
    return positive_nums
<|end|>
<|asst|>
Here is the Swift version of your Python code:

```swift
func getPositiveAndSort(l: [Int]) -> [Int] {
    func swapElements(n: inout [Int], index1: Int, index2: Int) {
        let temp = n[index1]
        n[index1] = n[index2]
        n[index2] = temp
    }
    
    func bubbleSort(n: inout [Int]) {
        for _ in 0..<n.count {
            for j in 0..<n.count - 1 {
                if n[j] > n[j + 1] {
                    swapElements(n: &n, index1: j, index2: j + 1)
                }
            }
        }
    }
    var positiveNums = l.filter { $0 > 0 }
    bubbleSort(n: &positiveNums)
    return positiveNums
}
```

NOTE: Whereas Python can use a swapping syntax like `a, b = b, a` swift does not support this syntax directly. This is why a temporary variable `temp` is used to exchange the two values in the `swapElements` function. 

Also note that Swift arrays are not mutable by default so we need to pass the positiveNums array to the `swapElements` function as an `inout` parameter to mutate it. Similarly for `bubbleSort` function.

Lastly, to filter the list for the positive integers, we use the `filter` function.
