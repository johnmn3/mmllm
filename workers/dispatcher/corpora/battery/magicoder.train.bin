Translating your Python code to Go language would involve some changes, since unlike Python, Go doesn't support named arguments in function definitions, and connection process differs because Go has different libraries for SQL server connections. Also, module "github.com/denisenkom/go-mssqldb" should be downloaded using "go get github.com/denisenkom/go-mssqldb" command.

Here is the Go version of your code:

```go
package main

import (
	"database/sql"
	"fmt"
	"log"
	"os"

	_ "github.com/denisenkom/go-mssqldb"
)

// This function connects to the DB using the given credentials.
func connectToDB(server string, database string, username string, password string) (*sql.DB, error) {
	connString := fmt.Sprintf("server=%s;database=%s;user id=%s;password=%s;", server, database, username, password)
	db, err := sql.Open("mssql", connString)
	return db, err
}

// This function executes SQL tasks using given DB connection.
func executeSQLTasks(db *sql.DB) error {
	// create a new table
	_, err := db.Exec(`CREATE TABLE test_table (
            id INT PRIMARY KEY,
            name VARCHAR(50),
            age INT
		)`)
	if err != nil {
		return err
	}
	// insert data into the table
	_, err = db.Exec(`
		INSERT INTO test_table (id, name, age)
		VALUES (1, 'John Doe', 30),
		       (2, 'Jane Doe', 25);`)
	if err != nil {
		return err
	}
	// select and print the data from the table
	rows, err := db.Query("SELECT * FROM test_table;")
	if err != nil {
		return err
	}
	defer rows.Close()

	var id int
	var name string
	var age int
	for rows.Next() {
		err = rows.Scan(&id, &name, &age)
		if err != nil {
			return err
		}
		fmt.Printf("id %d, name %s, age %d\n", id, name, age)
	}
	return nil
}

func main() {
	fmt.Print("Enter server: ")
	var server string
	fmt.Scanln(&server)

	fmt.Print("Enter database: ")
	var database string
	fmt.Scanln(&database)

	fmt.Print("Enter username: ")
	var username string
	fmt.Scanln(&username)

	fmt.Print("Enter password: ")
	var password string
	fmt.Scanln(&password)

	db, err := connectToDB(server, database, username, password)
	// if there is an error connecting, handle it
	if err != nil {
		log.Fatal("Error creating connection: ", err)
	}
	// make sure connection gets closed later
	defer db.Close()

	err = executeSQLTasks(db)
	if err != nil {
		log.Fatal("DB tasks execution failed: ", err)
	}
}
```

Note: For a secure password input, Go doesn't have a built-in cross-platform solution as simple as getpass. You would need to use more complex code or a third party library, often with platform specific solutions. Alternatively, you can store password as an environment variable and obtain it using `os.Getenv("password")` function. You can set the environment variable before running the code using `export password=PASSWORD` on Unix or `set password=PASSWORD` on Windows.
<|end|>


