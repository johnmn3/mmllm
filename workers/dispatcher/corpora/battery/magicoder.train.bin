Sure, here is how you can write that function in Swift:

```swift
import Foundation

func isStringHappy(_ string: String) -> Bool {
    let containsDigit = string.rangeOfCharacter(from: CharacterSet.decimalDigits) != nil
    if containsDigit {
        return false
    } 
    else {
        let firstChar = string.first
        for char in string {
            if char != firstChar {
                return false
            }
        }
        return true
    }
}
```
