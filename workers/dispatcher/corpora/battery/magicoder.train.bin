from main import db
from flask_login import UserMixin

class User(UserMixin, db.Model):
    """User model."""
    __tablename__ = 'users'

    id = db.Column(db.Integer, primary_key=True)
    username = db.Column(db.String(64), unique=True, nullable=False)
    password_hash = db.Column(db.String(128), nullable=False)
    role = db.Column(db.String(64), nullable=False)

    def __init__(self, username: str, password_hash: str, role: str):
        self.username = username
        self.password_hash = password_hash
        self.role = role

class Patient(db.Model):
    """Patient model."""
    __tablename__ = 'patients'

    id = db.Column(db.Integer, primary_key=True)
    name = db.Column(db.String(64), nullable=False)
    age = db.Column(db.Integer, nullable=False)
    gender = db.Column(db.String(10), nullable=False)
    disease_history = db.Column(db.Text, nullable=True)
    current_disease = db.Column(db.String(64), nullable=True)
    treatment_plan = db.Column(db.Text, nullable=True)
    user_id = db.Column(db.Integer, db.ForeignKey('users.id'))

    def __init__(self, name: str, age: int, gender: str, disease_history: str, current_disease: str, treatment_plan: str, user_id: int):
        self.name = name
        self.age = age
        self.gender = gender
        self.disease_history = disease_history
        self.current_disease = current_disease
        self.treatment_plan = treatment_plan
        self.user_id = user_id
