Sure, here is the PHP code with detailed explanations:

```php
<?php
// Function to check whether a number is prime or not
function isPrime($num) {
    if($num <= 1) {
        return false;  // Returns false if the number is less than or equal to 1
    }
    for($i = 2; $i <= sqrt($num); $i++) {
        if($num % $i == 0) {
            return false;  // Returns false if the number is divisible by any number other than 1 and itself
        }
    }
    return true;  // Returns true if the number is only divisible by 1 and itself
}

// Function to check whether a number is composite or not
function isComposite($num) {
    if($num <= 1) {
        return false;  // Returns false if the number is less than or equal to 1
    }
    for($i = 2; $i <= sqrt($num); $i++) {
        if($num % $i == 0) {
            return true;  // Returns true if the number is divisible by any number other than 1 and itself
        }
    }
    return false;  // Returns false if the number is a prime number
}

function primeCompositeAsciiSum($str1, $str2){
    $sum1 = 0; $sum2 = 0;
    for($i = 0; $i < strlen($str1); $i++) {
        $sum1 += ord($str1[$i]);  // Adds the ASCII value of each character in str1 to the sum
    }
    for($i = 0; $i < strlen($str2); $i++) {
        $sum2 += ord($str2[$i]);  // Adds the ASCII value of each character in str2 to the sum
    }
    
    // Checks if the ASCII sum of str1 is prime and the ASCII sum of str2 is composite. If so, return true. Otherwise, return false.
    if(isPrime($sum1) && isComposite($sum2)) {
        return true;
    } else {
        return false;
    }
}
?>
```
