def vowels_count(s):
    """Design an operation termed vowels_count, which accepts a string symbolising
    a term as input and generates the sum of vowels found in the string.
    Vowels entail 'a', 'e', 'i', 'o', 'u', together with 'y' SOLELY when unveiled
    at the closing of the provided term. Overlook the letter casing and consider
    unique characters within the term.

    Example:
    >>> vowels_count("abcde")
    2
    >>> vowels_count("ACEDY")
    3
    >>> vowels_count("éxamplë")
    3
    """
