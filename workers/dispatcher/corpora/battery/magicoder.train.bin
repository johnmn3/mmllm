I'd like a C++-specific version of this code:
def hexadecimal_to_binary(x: str) -> str:
    return bin(int(x, 16))[2:]

# Test cases
print(hexadecimal_to_binary('A'))  # Should print: 1010
print(hexadecimal_to_binary('F'))  # Should print: 1111
print(hexadecimal_to_binary('13'))  # Should print: 10011
<|end|>
<|asst|>
Here is your Python code translated into C++:

```cpp
#include <iostream>
#include <bitset>
#include <sstream>

std::string hexadecimalToBinary(std::string hex) {
    std::stringstream ss;
    ss << std::hex << hex; 
    unsigned n;
    ss >> n;
    std::bitset<32> b(n); // change 32 to change the number of bits 
    return b.to_string();
}

int main() {
    std::cout << hexadecimalToBinary("A") << std::endl;  // Should print: 00000000000000000000000000001010
    std::cout << hexadecimalToBinary("F") << std::endl;  // Should print: 00000000000000000000000000001111
    std::cout << hexadecimalToBinary("13") << std::endl; // Should print: 00000000000000000000000000010011
    return 0;
}
```

Please note that the C++ version can't guarantee to print the binary representation without any leading zeros as the python version does. This can be easily done with an additional function that removes these leading zeros.

```cpp
std::string removeLeadingZeros(std::string bin_string){
    // find the position of the first '1'
    int pos = bin_string.find('1');
    
    // if '1' is not found, it means the string is all zeros, so return a single '0'
    if (pos == std::string::npos)
        return "0";
    
    // else, return the substring from the first '1' to the end
    else
        return bin_string.substr(pos);
}

int main() {
    std::cout << removeLeadingZeros(hexadecimalToBinary("A")) << std::endl;  // Should print: 1010
    std::cout << removeLeadingZeros(hexadecimalToBinary("F")) << std::endl;  // Should print: 1111
    std::cout << removeLeadingZeros(hexadecimalToBinary("13")) << std::endl; // Should print: 10011
    return 0;
}
```
