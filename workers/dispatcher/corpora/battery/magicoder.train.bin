migrate the following code to rust:
from typing import List, Union
from collections import Counter
import math

def is_prime(n):
    if n in (2, 3):
        return True
    if n == 1 or n % 2 == 0:
        return False
    for i in range(3, math.isqrt(n) + 1, 2):
        if n % i == 0:
            return False
    return True

def remove_duplicates(numbers: List[Union[int, str]], threshold: int) -> List[Union[int, str]]:
    count = Counter(numbers)
    output = []
    used = set()

    for num in numbers:
        if num in used:
            continue
        if isinstance(num, int) and (is_prime(num) or count[num] > threshold):
            continue
        output.append(num)
        used.add(num)

    return output
<|end|>
<|asst|>
```rust
use std::collections::HashMap;
use std::collections::HashSet;
use std::convert::TryFrom;

fn is_prime(n: &i64) -> bool {
    match *n {
        1 => false,
        2 | 3 => true,
        x if x % 2 == 0 => false,
        _ => {
            let limit = f64::sqrt(*n as f64) as i64 + 1;
            !(3..limit).step_by(2).any(|i| n % i == 0)
        }
    }
}

fn remove_duplicates(numbers: Vec<isize>, threshold: isize) -> Vec<isize> {
    let counts: HashMap<isize, isize> = numbers.iter().map(|v| (*v, 1)).collect();

    let mut used = HashSet::new();

    numbers.into_iter().filter(|num| {
        if used.contains(num) {
            false
        } else {
            let count = counts.get(num).unwrap_or(&0);
            let is_prime_or_good = match i64::try_from(*num) {
                Ok(n) => n > 0 && (is_prime(&n) || *count > threshold),
                Err(_) => *count > threshold,
            };
            if is_prime_or_good {
                false
            } else {
                used.insert(*num);
                true
            }
        }
    }).collect()
}
```

Please note that the resulting Rust function is not exactly the same as the original Python function. Due to the static typing system of Rust, it is impossible to precisely mimic the Python function:

* The input `numbers` does not accept strings. `isize` type is used instead of `int` to handle possibly negative integers, which is indicated by `TryFrom`.
* The function will only check for primality if the number is a positive integer, which is basically the same as the original Python code.
* `HashMap` and `HashSet` in Rust, which are equivalent to `Counter` and `set` in Python, are used.
* The `any` method is used instead of explicit loop construction in the `is_prime` check, which carries the function with early return functionality.
* `HashSet.contains` and `HashSet.insert` are used corresponding to the `in` operation and `add` method in Python.
* The `filter` method is used instead of explicit loop construction in the `remove_duplicates` function, which provides a more Rust-like style.
* `unwrap_or` method is used to provide a default value when the expected count is not found in `counts`, corresponding to Python's `dict.get` method used in the original code.
<|end|>


