```
public class HelloWorld {

    public static void main(String[] args) { 

        String str = "World"; 
        char[] charArray = str.toCharArray(); 
        char charPos; 
        charPos = charArray[1];
        System.out.println( charPos); 

        charPos = charArray[5]; 
        System.out.println(charPos); 

        str = "";
        charArray = str.toCharArray();
        charPos = charArray[0];
        System.out.println( charPos);
