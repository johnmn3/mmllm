```html
<!DOCTYPE html>
<html>
<head>
<style>
table, th, td {
  border: 1px solid black;
}
</style>
<script>
function sortTableByAge() {
  var table, rows, swapping, i, x, y, shouldSwap;
  table = document.getElementById("myTable");
  swapping = true;
  while (swapping) {
    swapping = false;
    rows = table.rows;
    for (i = 1; i < (rows.length - 1); i++) {
      shouldSwap = false;
      x = rows[i].getElementByTagName("TD")[1];
      y = rows[i + 1].getElementByTagName("TD")[1];
      if (x.innerHTML.toLowerCase() > y.innerHTML.toLowerCase()) {
        shouldSwap = true;
        break;
      }
    }
    if (shouldSwap) {
      rows[i].parentNode.insertBefore(rows[i + 1], rows[i]);
      swapping = true;
    }
  }
}
</script>
</head>
<body>

