<|asst|>
```csharp
using System;
using System.Collections.Generic;

class Program
{
    static void Main()
    {
        List<int> numbers = new List<int>();
        
        Console.WriteLine("Please enter integer values. Input a non-integer value to stop.");

        while (true)
        {
            string input = Console.ReadLine();
            int num;

            if (int.TryParse(input, out num))
            {
                numbers.Add(num);
            }
            else
            {
                break;
            }
        }

        Console.WriteLine("The squares of the numbers you entered are:");

        foreach (int number in numbers)
        {
            Console.WriteLine(Square(number));
        }
    }

    static int Square(int num)
    {
        return num * num;
    }
}
```
