```python
import mysql.connector
import torch
from torch.utils.data import Dataset, DataLoader
from transformers import GPT3LMHeadModel, GPT3Tokenizer, Trainer, TrainingArguments

class BinarySeqDataset(Dataset):
    def __init__(self, sequences, outcomes):
        self.sequences = sequences
        self.outcomes = outcomes

    def __len__(self):
        return len(self.sequences)

    def __getitem__(self, idx):
        sequence = self.sequences[idx]
        # Encode each binary sequence as string
        sequence_ = ' '.join(map(str, sequence))
        outcome_ = self.outcomes[idx]
        return {'sequence': sequence_, 'outcome': outcome_}


# Connect to your MySQL server
cnx = mysql.connector.connect(user='<username>', password='<password>', host='<hostname>', database='<dbname>')
cursor = cnx.cursor()

# Assume dataset table layout: id | sequence | outcome
query = ("SELECT sequence, outcome FROM dataset")
cursor.execute(query)

sequences_ = []
outcomes = []

for (sequence, outcome) in cursor:
    sequences_.append(sequence)
    outcomes.append(outcome)

cursor.close()
cnx.close()

# Preprocess sequences and outcomes
dataset = BinarySeqDataset(sequences_, outcomes)

# Initialize tokenizer and model
tokenizer = GPT3Tokenizer.from_pretrained('gpt3')
model = GPT3LMHeadModel.from_pretrained('gpt3')

# Define Training Arguments 
training_args = TrainingArguments(
    output_dir="./gpt3_binarySeq", 
    overwrite_output_dir=True, 
    num_train_epochs=3, 
    per_device_train_batch_size=2,
    save_steps=10_000,
    save_total_limit=2,
)

def encode(examples):
    return tokenizer(examples['sequence'], truncation=True, padding='max_length')

train_dataset = dataset.map(encode, batched=True, load_from_cache_file=False)

# Initialize Trainer
trainer = Trainer(
    model=model,
    args=training_args,
    train_dataset=train_dataset,
    tokenizer=tokenizer,
)

# Train model
trainer.train()
```

Please replace `<username>`, `<password>`, `<hostname>`, and `<dbname>` with your own MySQL server's actual credentials and database name. Also, be aware that `'gpt3'` might not be a valid model name in the `transformer's` pre-trained model list as the actual GPT-3 model is not publicly available. You might need to replace it with a valid `transformer's` model name like `'gpt2'`.
