Could you devise a C++ code to execute the addition of two 2-dimensional matrices with specific integer elements also considering the scenario where the matrix size differs? For non-overlapping attributes use 0.
Matrix1 = [[2, 3],  
          [4, 5]]
 
Matrix2 = [[6, 7, 10],  
          [8, 9, 11],
          [1, 2, 3]]
<|end|>
<|asst|>
Sure, you can use the following C++ code to add two matrices. This program also considers the conditions when matrices of different sizes are given.

```C++
#include<bits/stdc++.h>
using namespace std;

void addMatrices(vector<vector<int>>& matrix1, vector<vector<int>>& matrix2){
    int rows1 = matrix1.size();
    int cols1 = matrix1[0].size();
    int rows2 = matrix2.size();
    int cols2 = matrix2[0].size();
    
    int rows = max(rows1, rows2);
    int cols = max(cols1, cols2);
    
    vector<vector<int>> result(rows,vector<int>(cols));

    for(int i=0; i<rows; ++i){
        for(int j=0; j<cols; ++j){
            int first = (i < rows1 && j < cols1)? matrix1[i][j] : 0;
            int second = (i < rows2 && j < cols2) ? matrix2[i][j] : 0;
            result[i][j] = first + second;
        }
    }
    // prints the resultant matrix
    for(int i=0; i<rows; i++){
        for(int j=0; j<cols; j++){
            cout<<result[i][j]<<" ";
        }
        cout<<endl;
    }
}

int main()
{
    vector<vector<int>> matrix1 = {{2, 3}, {4, 5}};
    vector<vector<int>> matrix2 = {{6, 7, 10}, {8, 9, 11}, {1, 2, 3}};
    
    addMatrices(matrix1, matrix2);
    
    return 0;
}
```
This program initializes a result matrix with the larger size from the two input matrices, then fills in this result matrix with the sum of corresponding elements from the two matrices. For non-overlapping cells, it will use 0 to calculate the corresponding element in the resulting matrix.
<|end|>


