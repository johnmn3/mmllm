<|asst|>
Here is the equivalent version of the Python function written in JavaScript:

```javascript
function parse_string(str) {
    var count = {
        'upper': 0,
        'lower': 0,
        'digits': 0,
        'non_alpha': 0
    }

    var regex_word = /\b\w+\b/g;

    // If the string is alphabetic and uppercase...
    if (str.match(/^[A-Z]+$/)) {
        // Return the sum of ASCII values (mod 26) for all characters
        return [...str].reduce((sum, c) => sum + ((c.charCodeAt(0) - 65) % 26), 0);
    }

    // If the string contains non-digit, non-alphabetic characters...
    else if (str.match(/\W/)) {
        var words = str.match(regex_word);

        // Update the count of character types
        count['upper'] += [...str].filter(c => c.match(/[A-Z]/)).length;
        count['lower'] += [...str].filter(c => c.match(/[a-z]/)).length;
        count['digits'] += [...str].filter(c => c.match(/\d/)).length;
        count['non_alpha'] += [...str].filter(c => !c.match(/\w/)).length;

        // Check for words with consecutive duplicate characters
        var freq = words.reduce((obj, word) => {
            let matches = word.match(/(.)\1/g);
            if (matches) obj[word] = matches.length;
            return obj;
        }, {});

        if (Object.keys(freq).length > 0) return freq;
        else return count;
    }

    // Otherwise, for values separated by common delimiters...
    else {
        if (str.includes(' ')) return str.split(' ');
        else if (str.includes(';')) return str.split(';');
        else return str.split(',');
    }
}
```

Please note that using `match` in JavaScript acts similarly to the `search` and `findall` functions in Python's `re` module, and the character class `\w` includes both alphabetic and digit characters. JavaScript doesn't have an in-built method like `isalpha` or `isalnum`, so I used regular expressions to replicate the behavior.
<|end|>


