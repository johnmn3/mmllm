```python
import requests
import json

def extract_missions():
    # Specify the URL
    url = 'https://api.rocketlaunch.live/v1/launch/upcoming'

    # Send HTTP GET request and save 
    # the response from server in a response object
    response = requests.get(url)

    # Load JSON data from the response 
    data = json.loads(response.text)

    # Access 'missions' from the loaded JSON data
    if 'missions' in data:
        missions = data['missions']
        return missions
    else:
        print('No mission field found')
        return None
```
