<|end|>
<|asst|>
def compare_word_sets(phrase1: str, phrase2: str):
    """
    Determine if two entered expressions share an identical set of distinct terms.
    >>> compare_word_sets("apple banana orange", "orange apple banana")
    True
    >>> compare_word_sets("apple banana", "apple orange banana")
    False
    >>> compare_word_sets("apple", "apple apple")
    True
    >>> compare_word_sets("banana", "apple banana")
    False
    >>> compare_word_sets("apple banana orange", "orange banana grape")
    False
    """
    # Convert the phrases to sets
    set1 = set(phrase1.split(' '))
    set2 = set(phrase2.split(' '))

    # Check if the sets are equal
    return set1 == set2
<|end|>


