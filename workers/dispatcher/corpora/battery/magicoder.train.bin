```python
from google.cloud import bigquery
import time

def run_query_with_time_tracking(client, query, job_config=None):
    start_time = time.time()

    # Starts the query execution
    if job_config:
        query_job = client.query(query, job_config=job_config)
    else:
        query_job = client.query(query)

    try:
        # Wait for the query to finish
        results = query_job.result()
    except Exception as e:
        print(f"Query execution has failed: {str(e)}")
        return None

    end_time = time.time()
    print(f"Query execution time: {end_time - start_time} seconds")

    return results

# Construct a bigquery client object
client = bigquery.Client()

job_config = bigquery.QueryJobConfig(destination="your_project_id.your_dataset_id.your_table_id")

query = """
SELECT name, COUNT(*) as count
FROM `bigquery-public-data.usa_names.usa_1910_2013`
WHERE state = 'TX'
GROUP BY name, state
ORDER BY count DESC
"""

# Execute the query and print the execution time
results = run_query_with_time_tracking(client, query, job_config)

try:
    # Print the results
    for row in results:
        print(f"{row['name']}: {row['count']}")
except Exception as e:
    print(f"Something went wrong when printing the results: {str(e)}")
```

