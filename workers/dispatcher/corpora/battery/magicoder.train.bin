    elif isinstance(d, (list, tuple, set)):
        for i, v in enumerate(d):
            if v is None or v == 0 or v == '' or is_null(v) or is_empty(v):
                bad_keys.append(keys_visited + [i])
                bad_vals.append(v)
            elif isinstance(v, (dict, list, tuple, set)):
                find_bad_values(v, bad_vals, bad_keys, keys_visited + [i], d)

    return bad_vals, bad_keys

def inspect_dict(d):
    bad_vals, bad_keys = find_bad_values(d)
    if len(bad_vals) == 0:
        return "No None values, empty strings, zeros, 'null' objects, or 'empty' objects found"
