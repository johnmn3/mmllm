what is the perl-compatible version of this code?
import urllib.parse
import re

def intricate_unicode_text_modification(input_text):
    sentences = re.split('(?<=[.!?]) +', input_text)
    modified_text = ""
    for i, sentence in enumerate(sentences):
        words = sentence.split()
        words[-1] = words[-1].capitalize()
        sentence = ' '.join(words)
        sentence = sentence.replace(" ", "_")
        sentence = re.sub("__+", "-", sentence)
        modified_text += sentence
        if i < len(sentences) - 1:
            modified_text += "_"
    modified_text = urllib.parse.quote(modified_text)
    return modified_text
<|end|>
<|asst|>
Perl doesn't have a direct counterpart to urllib.parse.quote, so we're going to use URI::Escape, a module which needs to be installed manually.

```perl
use strict;
use warnings;
use URI::Escape;
use utf8;

sub intricate_unicode_text_modification {
    my ($input_text) = @_;
    my @sentences = split /(?<=\.|\!|\?)\s+/, $input_text;
    my $modified_text = "";
    for my $i (0 .. $#sentences) {
        my $sentence = $sentences[$i];
        my @words = split /\s+/, $sentence;
        $words[-1] =~ s/^(.)(.*)/\U$1\E$2/;
        $sentence = join '_', @words;
        $sentence =~ s/__+/-/g;
        $modified_text .= $sentence;
        if ($i < $#sentences) {
            $modified_text .= "_";
        }
    }
    $modified_text = uri_escape($modified_text);
    return $modified_text;
}

print intricate_unicode_text_modification("some. complex text!");
```

Note: Install URI::Escape module since it's not a core module, but it's easy to do, you may use CPAN
```shell
Run the command: cpan URI::Escape
```
<|end|>


