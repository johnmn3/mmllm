<|asst|>
Sure. Here's a rough translation of that code to Rust using the `ring` crate for SHA256. I've added comments to help you understand.

Rust doesn't have the same exact architecture as C++, so the best approach is to convert the `string_to_sha256` function into a method in the `Encryptor` struct. And we can implement `read` and `print` functions.

```rust
// You need to import these libraries.
use ring::digest::{Context, Digest, SHA256};
use std::io::{stdin, stdout, Write};

/// Structure to arrange encryption.
/// It's good to group related functions in a struct
pub struct Encryptor {}

impl Encryptor {
    pub fn read() -> String {
        let mut s = String::new();
        print!("Enter your text: ");
        let _ = stdout().flush();
        stdin().read_line(&mut s).expect("Did not enter a correct string");
        if let Some('\n') = s.chars().next_back() {
            s.pop();
        }
        if let Some('\r') = s.chars().next_back() {
            s.pop();
        }
        s
    }

    pub fn print(encrypted: String) {
        if encrypted.is_empty() {
            println!("Nothing to encrypt");
        } else {
            println!("SHA256: {}", encrypted);
        }
    }

    pub fn string_to_sha256(text: String) -> String {
        // check if the string is empty
        if text.is_empty() {
            return "".to_string();
        }
        
        // create a Context to represent a new, independent digest operation
        let mut context = Context::new(&SHA256);
        // updates the current digest with `text`
        context.update(text.as_bytes());
        // finalizes the current digest and returns the resulting Digest
        let Digest { value } = context.finish();
        
        // converts each byte into a two-digit hexadecimal number
        let output = value.iter().map(|byte| format!("{:02x}", byte)).collect::<String>();
        output
    }
}

// You can test the program with this main function.
fn main() {
    let encrypted = Encryptor::string_to_sha256(Encryptor::read());
    Encryptor::print(encrypted);
}
```

Please ensure you have installed the needed library 'ring' by adding `ring = "0.16.11"` in your dependencies in your 'Cargo.toml' file, Then run the program using `cargo run`. If the 'ring' version doesn't match, check the current version with `cargo search ring` command and update your 'Cargo.toml' file.
<|end|>


