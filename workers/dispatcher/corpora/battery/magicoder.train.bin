Given python code can be translated into C# as below:

```csharp
using System;

public class Program
{
    public static void Main()
    {
        int[] array = { -10, 20, 30, -40 };
        int n = 2;

        try
        {
            Console.WriteLine(CountSpecials(array, n));
        }
        catch(Exception e)
        {
            Console.WriteLine(e.Message);
        }

    }
    static int GetDigitSum(int num)
    {
        bool isNegative = num < 0;
        int total = 0;
        num = Math.Abs(num);
        while (num != 0)
        {
            total += num % 10;
            num /= 10;
        }
        return isNegative ? -total : total;
    }

    static int CountSpecials(int[] arr, int n)
    {
        if (n <= 0)
        {
            throw new Exception("n should be a positive number");
        }
        int specialCount = 0;
        foreach (int num in arr)
        {
            int digitSum = GetDigitSum(num);
            if (digitSum > 0 && digitSum % n == 0)
            {
                specialCount++;
            }
        }
        return specialCount;
    }
}
```
