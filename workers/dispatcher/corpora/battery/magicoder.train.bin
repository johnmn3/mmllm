Revise this code for PHP:
def evaluate_string(s):
    if ';' in s:
        return s.split(';')
    elif '::' in s:
        return s.split('::')
    else:
        return sum(ord(c) - ord('A') for i, c in enumerate(s) if i % 2 == 0 and c.isupper())
<|end|>
<|asst|>
```php
function evaluate_string($s) {
    if (strpos($s, ';') !== false) {
        return explode(';', $s);
    } elseif (strpos($s, '::') !== false) {
        return explode('::', $s);
    } else {
        $sum = 0;
        $sArray = str_split($s);
        foreach ($sArray as $i => $c) {
            if ($i % 2 === 0 && ctype_upper($c)) {
                $sum += ord($c) - ord('A');
            }
        }
        return $sum;
    }
}
```
<|end|>


