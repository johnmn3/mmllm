function mode(l)
    if next(l) == nil then
        return nil
    end

    local frequency = {}

    for _, num in ipairs(l) do
        frequency[num] = (frequency[num] or 0) + 1
    end

    local primes, non_primes = {}, {}

    for num, freq in pairs(frequency) do
        if is_prime(freq) then
            primes[num] = freq
        else
            non_primes[num] = freq
        end
    end

    if is_prime(#l) then
        if next(primes) ~= nil then
            return max_key(primes)
        end
    else
        if next(non_primes) ~= nil then
            return max_key(non_primes)
        end
    end

    return max_key(frequency)
end

function is_prime(n)
    if n < 2 then
        return false
    end
    
    for i = 2, math.floor(math.sqrt(n)) do
        if n % i == 0 then
            return false
        end
    end
    return true
end

function max_key(t)
    local key, value = next(t)
    for k, v in next, t, key do
        if v > value then
            key, value = k, v
        end
    end
    return key
end

-- Test cases:
print(mode({3, 1, 2, 2, 5}))  -- Output: 2
print(mode({-10, 4, 6, 1000, 10, 20, 20, 20, 4})) -- Output: 20
```
<|end|>


