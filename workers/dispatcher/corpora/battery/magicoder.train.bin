transform this code to php for me:
package main

import (
    "fmt"
    "strconv"
)

func RoundedAvg(n int, m int) string {
    if n > m {
        return "-1"
    }
    
    sum := 0
    count := 0
    for i := n; i <= m; i++ {
        sum += i
        count++
    }
    
    avg := float64(sum) / float64(count)
    roundedAvg := int(avg + 0.5) // adding 0.5 before conversion rounds to the nearest integer

    binaryAvg := strconv.FormatInt(int64(roundedAvg), 2)

    return "0b" + binaryAvg
}

func main() {
    fmt.Println(RoundedAvg(1, 5))  // prints "0b11"
    fmt.Println(RoundedAvg(7, 5))  // prints "-1"
    fmt.Println(RoundedAvg(10, 20))  // prints "0b1111"
    fmt.Println(RoundedAvg(20, 33))  // prints "0b11010"
}
<|end|>
<|asst|>
Sure, here is the PHP equivalent of your go code:

```php
function RoundedAvg($n, $m) {
    if ($n > $m) {
        return "-1";
    }
    
    $sum = 0;
    $count = 0;
    for ($i = $n; $i <= $m; $i++) {
        $sum += $i;
        $count ++;
    }
    
    // PHP uses automatic type casting between float and int so you don't have to explicitly do float64 conversion like in go.
    $avg = $sum / $count;

    $roundedAvg = intval($avg + 0.5); // adding 0.5 before conversion rounds to the nearest integer

    // PHP uses decbin() to convert integer to binary string
    $binaryAvg = decbin($roundedAvg);

    return "0b" . $binaryAvg;
}

echo RoundedAvg(1, 5);   // prints "0b11"
echo "\n";
echo RoundedAvg(7, 5);   // prints "-1"
echo "\n";
echo RoundedAvg(10, 20);  // prints "0b1111"
echo "\n";
echo RoundedAvg(20, 33);  // prints "0b11010"
echo "\n";
```

You can run this code with PHP CLI or put it on a webpage and then visit it (if you use a web server). Please note that each echo "\n"; is used for a new line in PHP CLI. If you use web, please put `<br>`  instead of "\n" to make a new line.
<|end|>


