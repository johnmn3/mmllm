write an equivalent for the following in rust:
def is_prime(n):
    if n < 2:
        return False
    for i in range(2, int(n**0.5) + 1):
        if n % i == 0:
            return False
    return True

def rare_elements(sequence):
    unique_elements = set(sequence)
    result = []
    for element in unique_elements:
        count = sequence.count(element)
        if count > element//2 and is_prime(count) and element%10 in [2, 3, 5, 7]:
            result.append(element)
    return result
<|end|>
<|asst|>
Here is an equivalent Rust implementation for the above Python code -

```rust
fn is_prime(n: usize) -> bool {
    if n < 2 {
        return false;
    }
    for i in 2..=((n as f64).sqrt() as usize + 1) {
        if n % i == 0 {
            return false;
        }
    }
    true
}

fn rare_elements(sequence: &Vec<usize>) -> Vec<usize> {
    let unique_elements: std::collections::HashSet<_> = sequence.iter().cloned().collect();
    let mut result: Vec<usize> = Vec::new();
    for element in unique_elements {
        let count = sequence.iter().filter(|&n| *n == element).count();
        if count > element/2 && is_prime(count) && [2, 3, 5, 7].contains(&(element % 10)) {
            result.push(element);
        }
    }
    result
}

fn main() {
    let sequence = vec![2, 2, 2, 3, 7, 3, 3, 5, 5, 5, 3, 7, 10, 10, 10];
    let result = rare_elements(&sequence);
    for num in result {
        println!("{}", num);
    }
}
```

Please make sure to place the elements of sequence in the main() function. I have added an example sequence to illustrate how you can call the function.
