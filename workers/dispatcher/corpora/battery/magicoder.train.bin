can you make this code php-compliant?
script
const overlapAndFactorial = (interval1, interval2, interval3) => {
    let start = Math.max(interval1[0], interval2[0], interval3[0]);
    let end   = Math.min(interval1[1], interval2[1], interval3[1]);

    if(start > end) { // no overlap
        return -1;
    }

    const overlappedLength = end - start + 1;
    let factorial = 1;

    for(let i = 2; i <= overlappedLength; i++){
        factorial *= i;
    }

    return factorial;
}
<|end|>
<|asst|>
Sure, here is the equivalent PHP code:

```php
function overlapAndFactorial($interval1, $interval2, $interval3) {
    $start = max($interval1[0], $interval2[0], $interval3[0]);
    $end   = min($interval1[1], $interval2[1], $interval3[1]);

    if($start > $end) { // no overlap
        return -1;
    }

    $overlappedLength = $end - $start + 1;
    $factorial = 1;

    for($i = 2; $i <= $overlappedLength; $i++){
        $factorial *= $i;
    }

    return $factorial;
}
```

Remember to call your function with an array of two numbers as input parameter like this:

```php
overlapAndFactorial(array(1,5), array(2,6), array(3,7));
```
<|end|>


