Translate and explain this code to Rust
++
#include <iostream>
#include <string>
#include <openssl/sha.h>

using namespace std;

string string_to_sha256(string text){
    if (text.empty()){
        return "";
    } else {
        unsigned char hash[SHA256_DIGEST_LENGTH];
        SHA256_CTX sha256;
        SHA256_Init(&sha256);
        SHA256_Update(&sha256, text.c_str(), text.size());
        SHA256_Final(hash, &sha256);

        string output;
        for(int i = 0; i < SHA256_DIGEST_LENGTH; i++) {
            char buf[3];
            sprintf(buf, "%02x", hash[i]);
            output += buf;
        }
        return output;
    }
}

int main(){
    string input;
    cout << "Enter your text: ";
    getline(cin, input);

    string hashed = string_to_sha256(input);

    if (hashed.empty()){
        cout << "Nothing to encrypt" << endl;
    } else {
        cout << "SHA256: " << hashed << endl;
    }

    return 0;
}
Please include comments in the translated code to help me understand it.
