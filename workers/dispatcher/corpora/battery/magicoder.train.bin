translate the following snippet to php, please:
def encrypt(s: str, sys_name: str = 'unix') -> str:
    """Encrypts a string, moves each alphabet character by 13 places in upper case and 15 places in lower case. Considers system end line characters.
    """
    def match_only_english_alpha(char):
        if (char >= 'a' and char <= 'z') or (char >= 'A' and char <= 'Z'):
            return True
        else:
            return False

    def rotate(c, offset):
        z = 'z' if c.islower() else 'Z'
        a = 'a' if c.islower() else 'A'
        return chr((ord(c) - ord(a) + offset) % 26 + ord(a))

    def new_line_handler(c):
        if c == '\n':
            if sys_name == 'unix':
                return ''
            elif sys_name == 'windows':
                return '\r\n'
        return c

    mappings = {c: (new_line_handler(c) if not match_only_english_alpha(c) else 
                    (rotate(c, 13) if c.isupper() else rotate(c, 15))) for c in set(s)}
    
    return ''.join(mappings.get(c, c) for c in s)
<|end|>
<|asst|>
Here is the requested PHP translation of the Python code:

```php
function encrypt($s, $sys_name = 'unix') {
    $new_line_handler = function($c) use ($sys_name) { 
        if ($c === "\n") {
            if ($sys_name === 'unix') {
                return "";
            } elseif ($sys_name === 'windows') {
                return "\r\n";
            }
        }
        return $c;
    };

    $rotate = function($c, $offset) {
        $z = ($c === strtolower($c)) ? 'z' : 'Z';
        $a = ($c === strtolower($c)) ? 'a' : 'A';

        return chr((ord($c) - ord($a) + $offset) % 26 + ord($a));
    };

    $match_only_english_alpha = function($char) {
        if (($char >= 'a' && $char <= 'z') || ($char >= 'A' && $char <= 'Z')) {
            return true;
        }
        return false;
    };

    $mappings = [];
    $s = str_split($s);
    foreach($s as $c) {
        if (!isset($mappings[$c])) {
            $mappings[$c] = (!$match_only_english_alpha($c)) ? $new_line_handler($c) : 
                ((ctype_upper($c)) ? $rotate($c, 13) : $rotate($c, 15));
        }
    }

    $result = '';
    foreach($s as $c) {
        $result .= isset($mappings[$c]) ? $mappings[$c] : $c;
    }
    return $result;
}
```
Please note that in PHP, all characters are considered as string unlike Python and thus direct comparison might sometimes gives unexpected results so using inbuilt PHP functions can be useful. Also, there is no direct equivalent in PHP to Python's `get()` method for arrays. Instead, PHP uses the `isset()` function to check if a particular key exists in an array.
