Using Python, design a class constructor for a quaternion and implement methods for basic quaternion arithmetic including addition, subtraction, multiplication, and division. The program should also handle exceptions for invalid operations.
<|end|>
<|asst|>
Here is a simple Python implementation for a Quaternion class with arithmetic operations:

```python
class Quaternion:
    def __init__(self, x=0, y=0, z=0, w=0):
        self.x = x
        self.y = y
        self.z = z
        self.w = w

    def __add__(self, other):
        return Quaternion(
            self.x + other.x,
            self.y + other.y,
            self.z + other.z,
            self.w + other.w
        )

    def __sub__(self, other):
        return Quaternion(
            self.x - other.x,
            self.y - other.y,
            self.z - other.z,
            self.w - other.w
        )

    def __mul__(self, other):
        return Quaternion(
            self.w * other.x + self.x * other.w + self.y * other.z - self.z * other.y,
            self.w * other.y - self.x * other.z + self.y * other.w + self.z * other.x,
            self.w * other.z + self.x * other.y - self.y * other.x + self.z * other.w,
            self.w * other.w - self.x * other.x - self.y * other.y - self.z * other.z
        )

    def __div__(self, other):
        mod_squared = other.x**2 + other.y**2 + other.z**2 + other.w**2
        if mod_squared == 0:
            raise ZeroDivisionError("Cannot divide by zero!")
        return Quaternion(
            (self.x * other.w - self.w * other.x + self.y * other.z - self.z * other.y) / mod_squared,
            (self.y * other.w - self.w * other.y + self.z * other.x - self.x * other.z) / mod_squared,
            (self.z * other.w - self.w * other.z + self.x * other.y - self.y * other.x) / mod_squared,
            (self.w * other.w + self.x * other.x + self.y * other.y + self.z * other.z) / mod_squared
        )

    def __str__(self):
        return "Quaternion [x: {}, y: {}, z: {}, w: {}]".format(self.x, self.y, self.z, self.w)

# Testing:
p = Quaternion(1,2,3,4)
q = Quaternion(2,3,4,5)

print(p+q)
print(p-q)
print(p*q)
print(p/q)
```

Please note, quaternion division here is implemented as multiplying the dividend by the conjugate of the divisor divided by the magnitude squared of the divisor (which allows us to avoid zero division). However, in some contexts it might be preferable to leave division undefined, as it is in many mathematical texts. 

Invalid operations like adding a number and a quaternion would raise a built-in python exception as the other operand wouldn't have the necessary attributes.
