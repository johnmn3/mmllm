Sure, you can convert this Python code into PHP as follows:

```php
function validate_and_xor_alternating_subseq(string $a, string $b)
{
    if (strlen($a) == strlen($b)) {
        $xor_result = '';
        for ($i = 0; $i < strlen($a); $i++) {
            $xor_result .= strval(intval($a[$i]) ^ intval($b[$i]));
        }
        $longest_alt_subseq = '';
        $curr_alt_subseq = substr($xor_result, 0, 1);
        $i = 1;
        while ($i < strlen($xor_result)) {
            if ($xor_result[$i] != substr($curr_alt_subseq, -1)) {
                $curr_alt_subseq .= $xor_result[$i];
                $i++;
            } else {
                $longest_alt_subseq = (strlen($longest_alt_subseq) > strlen($curr_alt_subseq)) ? $longest_alt_subseq : $curr_alt_subseq;
                while ($i < strlen($xor_result) && $xor_result[$i] == substr($curr_alt_subseq, -1)) {
                    $i++;
                }
                if ($i < strlen($xor_result)){
                    $curr_alt_subseq = $xor_result[$i];
                } else {
                    $curr_alt_subseq = '';
                }
            }
        }
        return (strlen($longest_alt_subseq) > strlen($curr_alt_subseq)) ? $longest_alt_subseq : $curr_alt_subseq;
    }
    return "Error: Strings are of different lengths.";
}
```

