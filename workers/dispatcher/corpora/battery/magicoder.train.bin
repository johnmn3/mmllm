Here's a more readable and correct version of your code:

```python
import re

def validate_string(s):
    vowels = set('aeiouAEIOU')
    consonants = set('bcdfghjklmnpqrstvwxyzBCDFGHJKLMNPQRSTVWXYZ')
    numerals = set('0123456789')
    special_chars = set('!@#$%^&*()-+')

    # Remove non-alphabetic characters at the beginning or end of the string
    s = re.sub(r'^[^a-zA-Z]+|[^a-zA-Z]+$', '', s)

    # Check for at least five different vowels and ten unique consonants
    s_vowels = [c for c in s if c in vowels]
    s_consonants = [c for c in s if c in consonants]
    if len(set(s_vowels)) < 5 or len(set(s_consonants)) < 10:
        raise ValueError("The string does not contain at least five different vowels and ten unique consonants.")

    # Check for at least six numerals and six special characters
    s_numerals = [c for c in s if c in numerals]
    s_special_chars = [c for c in s if c in special_chars]
    if len(s_numerals) < 6 or len(s_special_chars) < 6:
        raise ValueError("The string does not contain at least six numerals and six special characters.")

    return True
```

This function is expected to be used like this:
```python
