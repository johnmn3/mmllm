You can overwrite `_finalizeValidation()` method in your custom module. You need to locate the JS file where this function is defined (probably located in module `point_of_sale`), and extend corresponding class.

This is an example of how you can extend `PaymentScreen` class and modify `_finalizeValidation()` method:

```js
odoo.define('your_module.PaymentScreen', function(require) {
    'use strict';

    const PaymentScreen = require('point_of_sale.PaymentScreen');
    const Registries = require('point_of_sale.Registries');

    const YourPaymentScreen = (PaymentScreen) =>
        class extends PaymentScreen {
            async _finalizeValidation() {
                if (this.currentOrder.selected_paymentline.invoice) {
                    return super._finalizeValidation();
                } else {
                    return this.showPopup('ErrorPopup', {
                        title: 'Error: Invoice not selected',
                        body: 'Your error message here.',
                    });
                }
            }
        };

    Registries.Component.extend(PaymentScreen, YourPaymentScreen);

    return PaymentScreen;
});
