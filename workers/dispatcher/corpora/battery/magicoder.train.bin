import math

def dissect_float_number(number: float) -> int:
    try:
        float(number)  # try converting input to float
        return math.floor(number)  # return the integer part
    except (TypeError, ValueError):  # in case of a non-numeric input
        raise ValueError("Input should be integer or float.")

# testing 
