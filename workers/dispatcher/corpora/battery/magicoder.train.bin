import json
import statistics

def calculate_female_stats(data):
    # Filter out only females
    female_data = [d for d in data if d['gender'] == 'female']

    # If there are no females in the dataset, return a message
    if not female_data:
        return 'No females in the dataset'

    # Calculate median age
    ages = [f['age'] for f in female_data]
    median_age = statistics.median(ages)

    # Calculate average age
    average_age = sum(ages)/len(ages)

    # Write to json file
    result = {'median_age': median_age, 'average_age': average_age}
    with open('result.json', 'w') as f:
        json.dump(result, f)

    return result

# Load the data
data = [
  {
    "name": "Linda",
    "age": 30,
    "gender": "female"
  },
  {
    "name": "Tom",
    "age": 26,
    "gender": "male"
  },
