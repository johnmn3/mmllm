class Seq2SeqLightning(pl.LightningModule):
    """
    Sequence to sequence model implementation on PyTorch Lightning
    """
    def __init__(self, hparams):
        super(Seq2SeqLightning, self).__init__()
        
        self.hparams = hparams
        
        # Initialize Bert models and tokenizers
        self.bert_model = BertModel.from_pretrained(hparams.bert_model)
        self.tokenizer = BertTokenizer.from_pretrained(hparams.bert_model)

        # Define model layers
        self.decoder = nn.GRU(hparams.hidden_size, hparams.hidden_size)
        self.out = nn.Linear(hparams.hidden_size, hparams.output_size)
        self.max_length = hparams.max_length

    def forward(self, x):
        # Define forward pass
        encoder_outputs, hidden = self.bert_model(x)
        outputs, hidden = self.decoder(x, hidden)
        prediction = self.out(outputs)
        return prediction

    def training_step(self, batch, batch_nb):
        # Defines a single step during training
        x, y = batch
        y_hat = self.forward(x)
        loss = F.nll_loss(y_hat, y)
        return {'loss': loss}

     def validation_step(self, batch, batch_nb):
        # Defines a single step during validation
        x, y = batch
        y_hat = self.forward(x)
        loss = F.nll_loss(y_hat, y)
        return {'val_loss': loss}

     def validation_epoch_end(self, outputs):
        # Defines what to do at the end of validation epoch
        avg_loss = torch.stack([x['val_loss'] for x in outputs]).mean()
        return {'val_loss': avg_loss}

    def configure_optimizers(self):
        # Defines the optimizer
        optimizer = torch.optim.Adam(self.parameters(), lr=self.hparams.lr)
        return [optimizer]

    def train_dataloader(self):
        # DataLoader for training data
        train_dataset = ... # Define your dataset here
        return DataLoader(train_dataset, batch_size=self.hparams.batch_size, shuffle=True)

    def val_dataloader(self):
        # DataLoader for validation data
        val_dataset = ... # Define your dataset here
        return DataLoader(val_dataset, batch_size=self.hparams.batch_size, shuffle=False)
  
if __name__ == "__main__":
     # Parse your command line arguments here
     hparams = ...
     seq2seq = Seq2SeqLightning(hparams)
     trainer = pl.Trainer(gpus=1, distributed_backend='dp')
     trainer.fit(seq2seq)
```

Please note that you have to replace the `...` with the right code for your application, i.e. define your dataset, set the hyperparameters and BERT model, etc.

PyTorch Lightning is designed to handle GPU allocation and distributed training behind the scenes. Also, tuning the model involves selecting the appropriate learning rate, batch size, and other hyperparameters, all of which can be specified when an instance `hparams` of `argparse.Namespace` is created.

In terms of evaluation metrics, PyTorch Lightning provides comprehensive metrics for different problems in machine learning. You can select based on your task.
