Could you help me write this in C++?
def unique_pairs(lst1, lst2, lst3):
    str_dict = {1: [], 2: [], 3: []}
    str_seen = {1: set(), 2: set(), 3: set()}
    max_length = max(max(len(s) for s in lst) for lst in (lst1, lst2, lst3))
    
    for lst_num, lst in enumerate((lst1, lst2, lst3), start=1):
        for s in lst:
            lower_s = s.lower()
            if lower_s not in str_seen[lst_num]:
                str_seen[lst_num].add(lower_s)
                str_dict[lst_num].append(s)
    
    for str1 in str_dict[1]:
        for str2 in str_dict[2]:
            for str3 in str_dict[3]:
                if len(str1) + len(str2) + len(str3) <= max_length:
                    return (str1, str2, str3)
    return ()
<|end|>
<|asst|>
Here is a C++ equivalent of your python code:

```C++
#include <algorithm>
#include <string>
#include <vector>
#include <set>
#include <unordered_set>

std::tuple<std::string, std::string, std::string> unique_pairs(std::vector<std::string> lst1, std::vector<std::string> lst2, std::vector<std::string> lst3) {
    std::vector<std::vector<std::string>> str_dict = {{}, {}, {}};
    std::vector<std::unordered_set<std::string>> str_seen = {{}, {}, {}};
    auto max_length = std::max({lst1.size(), lst2.size(), lst3.size()});
    
    for(size_t i = 0; i < 3; i++) {
        auto lst = (i == 0 ? lst1 : (i == 1 ? lst2 : lst3));
        for(auto& s : lst) {
            std::transform(s.begin(), s.end(), s.begin(), ::tolower);
            if(str_seen[i].find(s) == str_seen[i].end()) {
                str_seen[i].insert(s);
                str_dict[i].push_back(s);
            }
        }
    }

    for(auto& str1 : str_dict[0])
        for(auto& str2 : str_dict[1])
            for(auto& str3 : str_dict[2])
                if(str1.size() + str2.size() + str3.size() <= max_length)
                    return std::make_tuple(str1, str2, str3);
    
    return std::make_tuple("", "", "");
}
```

Note: In this C++, an empty tuple indicates failure rather than an empty list. If you want to ensure that the empty string is distinct from a failed match, consider using `std::optional<std::tuple<std::string, std::string, std::string>>` as the return type instead, and `return std::nullopt;` to indicate a lack of match.
