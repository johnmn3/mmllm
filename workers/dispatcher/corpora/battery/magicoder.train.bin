<|asst|>
Here is how it could be done in pure C.

```C
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <stdbool.h>

#define MIN_LEN 1000
#define MAX_LEN 100000

bool validate_input(const char* a, const char* b)
{
    int len_a = strlen(a);
    int len_b = strlen(b);

    if (len_a < MIN_LEN || len_a > MAX_LEN || len_b < MIN_LEN || len_b > MAX_LEN)
        return false;

    for (int i = 0; i < len_a; i++)
        if (a[i] != '0' && a[i] != '1')
            return false;
    for (int i = 0; i < len_b; i++)
        if (b[i] != '0' && b[i] != '1')
            return false;

    return true;
}

char* string_xor(const char* a, const char* b)
{
    if (!validate_input(a, b))
    {
        printf("Inputs are not valid. Exiting.");
        exit(1);
    }

    int len = strlen(a);
    char* result = (char*) malloc(sizeof(char) * (len + 1));

    for (int i = 0; i < len; i++)
        result[i] = (a[i] == b[i] ? '0' : '1');

    result[len] = '\0';

    return result;
}

int main()
{
    const char* a = "010";
    const char* b = "110";

    char* result = string_xor(a, b);
    printf("%s\n", result); // Expected output: '100'

    free(result);

    return 0;
}
```

The C program works as follows:

- It has function `validate_input` to check that two strings only contain '1' or '0' and their length is between MIN_LEN and MAX_LEN.
- Function `string_xor` validates two strings using `validate_input` and then performs XOR operation on these two strings. If any string is invalid then the program exit with a failure.
- XOR operation `a[i] == b[i] ? '0' : '1' works as follows: If characters a[i] and b[i] are equal then XOR output will be '0', otherwise '1'.
- `main` function is the entry point of the program. It defines two strings a and b, performs XOR operation on them using `string_xor`, and prints the result. After using the result it is deallocated from memory. 

In C, memory management is mostly manual, hence we allocate memory for the result in `string_xor` function and deallocate it in `main` function.
