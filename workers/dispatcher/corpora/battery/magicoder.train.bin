def is_palindrome(lst):
    return lst == lst[::-1]

def will_it_fly_advanced(q,w,r):
    if is_palindrome(q) and sum(q) == w and w % len(r) == 0:
        avg = w // len(r)
        return (q, [avg for _ in r])
    else:
