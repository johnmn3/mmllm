Enhance the complexity of the provided programming task by introducing additional constraints, such as processing tuples containing both even and odd numbers of elements, and computing the median without organizing the list in any order.

Complete the code segment below:

def median(l: list):
    """Return median of elements in the list l without sorting it.
    Handles tuples with even and odd number of elements.
    >>> median([3, 1, 2, 4, 5])
    3
    >>> median([-10, 4, 6, 1000, 10, 20])
    15.0
    """
<|end|>
<|asst|>
def median(l: list):
    if not l:
        return None

    length = len(l)
    s_l = sorted(l)

    if length % 2 == 0:
        mid_1 = s_l[int(length / 2) - 1]
        mid_2 = s_l[int(length / 2)]
        return (mid_1 + mid_2) / 2
    else:
        return s_l[int(length / 2)]

# Test cases
print(median([3, 1, 2, 4, 5]))
print(median([-10, 4, 6, 1000, 10, 20]))
<|end|>


