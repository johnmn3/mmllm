```java
public class MyClass {
    private int num1;
    private int num2;

    // Constructor 
    public MyClass(int num1, int num2) throws IllegalArgumentException {
        // Step 1: Initial value assignment
        this.num1 = num1;
        this.num2 = num2;
        
        // Step 2: Value verification
        validateValues();
    }
    
    // Validates values based on constraints
    private void validateValues() throws IllegalArgumentException {
        if (num1 <= 0 || num2 <= 0) {
            throw new IllegalArgumentException("Both num1 and num2 must be positive.");
        }
    }
    
    // Methods to get the values of num1 and num2
    public int getNum1() {
        return num1;
    }

    public int getNum2() {
        return num2;
    }
}
