Here is the equivalent Swift code:

```swift
func second_smallest_odd_and_second_largest_even(_ l: [Int]) -> (Int?, Int?) {
    var min1, min2, max1, max2 = Int.max, Int.max, Int.min, Int.min
    var odd_count, even_count = 0, 0

    for x in l {
        if x % 2 != 0 {
            odd_count += 1
            if x < min1 {
                min2 = min1
                min1 = x
            } else if x < min2 {
                min2 = x
            }
        } else {
            even_count += 1
            if x > max1 {
                max2 = max1
                max1 = x
            } else if x > max2 {
                max2 = x
            }
        }
    }
    
    let res : (Int?, Int?) = (odd_count > 1 ? min2 : nil, even_count > 1 ? max2 : nil)
    return res
}

// Test Scenarios:
// Instance 1: second_smallest_odd_and_second_largest_even([1, 2, 3, 4]) should return (3, 2)
print(second_smallest_odd_and_second_largest_even([1, 2, 3, 4]))

// Instance 2: second_smallest_odd_and_second_largest_even([5, -2, -7, 0, -1, 3, 8, -8, -9, 2, -11]) should return (-7, 2)
print(second_smallest_odd_and_second_largest_even([5, -2, -7, 0, -1, 3, 8, -8, -9, 2, -11]))
```

Both your Python code and this Swift code do the same thing: they find the second smallest odd number and second largest even number in an array. If there is no second smallest odd or second largest even number, they return `nil`.

The Swift equivalent uses conditional binding (`odd_count > 1 ? min2 : nil`) to handle the case where there is no second smallest odd or second largest even number.
