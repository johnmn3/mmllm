Design a Python function that calculates the average of all elements in a list of integers and verifies if it falls within a specific interval:

def average_in_interval(l: list, lower_limit: int, upper_limit: int):
    """Return True if the average of all numbers in the list l is within the interval of lower_limit and upper_limit, inclusive.
    >>> average_in_interval([1, 2, 4, 10], 3, 7)
    True
    >>> average_in_interval([1, 5, 4, 10], 4, 6)
    False
    """
<|end|>
<|asst|>
def average_in_interval(l: list, lower_limit: int, upper_limit: int):
    avg = sum(l) / len(l)
    return lower_limit <= avg <= upper_limit

print(average_in_interval([1, 2, 4, 10], 3, 7))
print(average_in_interval([1, 5, 4, 10], 4, 6))
<|end|>


