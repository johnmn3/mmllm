Sure, here is a version written in C that will accomplish the same thing:

```c
#include <ctype.h>
#include <string.h>

void encrypt(char* s) {
    int shiftUpper = 5;
    int shiftLower = 8;
    int length = strlen(s);
    for(int i = 0; i < length; i++){
        if(isupper(s[i])){
            s[i] = (s[i] - 'A' + shiftUpper) % 26 + 'A';
        }else if(islower(s[i])){
            s[i] = (s[i] - 'a' + shiftLower) % 26 + 'a';
        }
    }
}
```

