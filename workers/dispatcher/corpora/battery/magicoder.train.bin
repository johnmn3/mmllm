i need the rust equivalent for this:
def is_palindrome(string: str) -> bool:
    return string == string[::-1]

def remove_special_characters(string: str) -> str:
    return ''.join(e for e in string if e.isalnum())

def make_palindrome(string: str) -> str:
    string = string.lower()
    cleaned_string = remove_special_characters(string)

    for i in range(len(cleaned_string)):
        if is_palindrome(cleaned_string[i:]):
            prefix = cleaned_string[:i]
            return string + prefix[::-1]

print(make_palindrome(''))  # Returns: ''
print(make_palindrome('@cat$'))  # Returns: 'catac'
print(make_palindrome('race , car!'))  # Returns: 'racecar'
print(make_palindrome('A man!!in a plan, a Canal: Panama'))  # Returns: 'Amaninaplanacanalpanama'
<|end|>
<|asst|>
Here is a direct conversion of your Python code to Rust:

```rust
fn is_palindrome(s: &str) -> bool {
    s == s.chars().rev().collect::<String>()
}

fn remove_special_characters(s: &str) -> String {
    s.chars().filter(|c| c.is_alphanumeric()).collect()
}

fn make_palindrome(s: &str) -> String {
    let s = s.to_lowercase();
    let cleaned_string = remove_special_characters(&s);

    for i in 0..cleaned_string.len() {
        let suffix = &cleaned_string[i..];
        if is_palindrome(suffix) {
            let prefix = &cleaned_string[0..i];
            let reversed_prefix: String = prefix.chars().rev().collect();
            return s.clone() + &reversed_prefix;
        }
    }

    s
}

fn main() {
    println!("{}", make_palindrome(""));  // Returns: ''
    println!("{}", make_palindrome("@cat$"));  // Returns: 'catac'
    println!("{}", make_palindrome("race , car!"));  // Returns: 'racecar'
    println!("{}", make_palindrome("A man, in a plan, a Canal: Panama"));  // Returns: 'amaninaplanacanalpanama'
}
```

Please note - Rust's `to_lowercase()` function will allocates a new string and returns it, instead of modifying the existing string like Python's `lower()`. 
Using `clone()` to make a copy of `s` before we output the final palindrome string. This is because Rust enforces strict ownership and lifetime rules, which prevent us from reusing or modifying `s` directly.
<|end|>


