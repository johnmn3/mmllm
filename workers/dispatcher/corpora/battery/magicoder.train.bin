```python
import collections

def maxCandies(status, candies, keys, containedBoxes, initialBoxes):
    r = len(status)
    queue = collections.deque(initialBoxes)
    unopened = set()
    collected = 0
    for box in queue:
        if status[box] == 1:
            collected += candies[box]
            for key in keys[box]:
                if key in unopened:
                    unopened.remove(key)
                    queue.append(key)
                else:
                    status[key] = 1
            for box2 in containedBoxes[box]:
