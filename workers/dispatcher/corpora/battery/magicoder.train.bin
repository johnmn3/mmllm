angular.module('networkModule', [])
.directive('networkActivity', function($http) {
  return {
    restrict: 'E',
    scope: {},
    templateUrl: 'network-activity.html',
    link: function(scope, elem, attrs) {

      scope.activities = [];

      scope.getNetworkData = function() {
        // logic to get network data e.g. $http call to back-end.
        $http.get('path/to/your/api')
        .then(function(response){
          // handle successful response
          scope.activities = response.data;
        }, function(error){
          // handle error
          console.log(error);
        });
      };

      scope.getNetworkData();

      // Re-fetch data every second for real-time display (using $interval service)
      var intervalPromise = $interval(scope.getNetworkData, 1000);

      // Clean up interval on scope destroy
      scope.$on('$destroy', function () {
        $interval.cancel(intervalPromise);
      });

    }
  };
});
```
