<|asst|>
Here is the translated GoLang code for your python code:
```go
package main

import (
  "strconv"
  "fmt"
)

func get_prime_factors(n int) map[int]bool {
  primes := make(map[int]bool)
  i := 2
  for i * i <= n {
    if n % i != 0 {
      i += 1
    } else {
      n /= i
      primes[i] = true
    }
  }
  if n > 1 {
    primes[n] = true
  }
  return primes
}

func one_ends_divisible(n int, m int) int {
  count := 0
  start := 1
  for i := 1; i < n; i++ {
    start *= 10
  }
  end := start * 10
  for i := start; i < end; i++ {
    str := strconv.Itoa(i)
    if str[0:1] == "1" || str[len(str)-1:] == "1" {
      if len(get_prime_factors(i)) == m {
        count += 1
      }
    }
  }
  return count
}

func main() {
  fmt.Println(one_ends_divisible(2, 2)) // example usage
}
```
If you run this code and call `one_ends_divisible(2, 2)` for example, it will return count of numbers with length 2 that starts or ends with 1 and has exactly 2 prime factors.
Keep in mind that the performance of this algorithm is not great. In the section where it goes through all the numbers between "start" and "end", it can get pretty slow if "n" and "m" are big. A potential optimization would be to generate only the numbers that start or end with 1 instead of checking all the numbers.
