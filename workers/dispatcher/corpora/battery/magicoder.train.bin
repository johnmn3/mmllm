i need this code to work in c#:
def get_digit_sum(num):
    # Returns sum of signed digits of num
    is_negative = num < 0
    total = 0
    num = abs(num)  # convert to positive
    while num > 0:
        total += num % 10
        num //= 10
    return -total if is_negative else total

def count_specials(arr, n):
    if n <= 0:
        raise ValueError("n should be a positive number")
    special_count = 0
    for num in arr:
        digit_sum = get_digit_sum(num)
        if digit_sum > 0 and digit_sum % n == 0:
            special_count += 1
    return special_count
