import java.util.*;
import java.lang.*;

class Solution {
    /**
     This function's objective is to manufacture a compilation that harbors all the potential initiatory substrings of an input string, orderly presented in an ascending sequence of their lengths. As an example, the function allPrefixes when called with an argument "abc", should output a result in the following fashion: ["a", "ab", "abc"]
    */
    public List<String> allPrefixes(String string) {
<|end|>
<|asst|>
ArrayList<String> prefixes = new ArrayList<>();
for(int i = 1; i <= string.length(); i++) {
    prefixes.add(string.substring(0, i));
}
return prefixes;
}                           
}
