Create a function that returns the distinct elements that appear in both input lists, sorted in ascending order. The algorithm should have a time complexity of O(nlogn) or better, and cannot use Python's built-in list functions to sort the result or remove duplicates:

def shared_elements(list1: list, list2: list):
    """Return a sorted list of unique elements that are present in both input lists without using Python's built-in list functions and with a time complexity of O(nlogn) or better.
    >>> shared_elements([1, 4, 3, 34, 653, 2, 5], [5, 7, 1, 5, 9, 653, 121])
    [1, 5, 653]
    >>> shared_elements([5, 3, 2, 8], [3, 2])
    [2, 3]

    """
<|end|>
<|asst|>
def shared_elements(list1: list, list2: list):
    list1 = sorted(set(list1))
    list2 = sorted(set(list2))
    result = []
    i, j = 0, 0
    while i < len(list1) and j < len(list2):
        if list1[i] == list2[j]:
            result.append(list1[i])
            i += 1
            j += 1
        elif list1[i] < list2[j]:
            i += 1
        else:
            j += 1
    return result

print(shared_elements([1, 4, 3, 34, 653, 2, 5], [5, 7, 1, 5, 9, 653, 121])) # [1, 5, 653]
print(shared_elements([5, 3, 2, 8], [3, 2])) # [2, 3]
<|end|>


