how would this be implemented in swift?
script
const isPalindrome = (text) => {
    // Convert text to lowercase and remove non-alphanumeric characters and spaces
    text = text.toLowerCase().replace(/[^a-z0-9]/gi, '');
  
    // Reverse the processed text
    let reversedText = text.split("").reverse().join("");
  
    // Check if processed text and its reversed form are same
    return text === reversedText;
}

console.log(isPalindrome('Able was I ere I saw Elba'));  // Returns true
console.log(isPalindrome('Was it a car or a cat I saw?'));  // Returns true
console.log(isPalindrome('Red roses'));  // Returns false
<|end|>
<|asst|>
The following is how you would implement the JavaScript function in Swift:

```swift
import Foundation

func isPalindrome(_ text: String) -> Bool {
    // Convert text to lowercase and remove non-alphanumeric characters and spaces
    let processedText = text.lowercased().components(separatedBy: CharacterSet.alphanumerics.inverted).joined()
    
    // Reverse the processed text
    let reversedText = String(processedText.reversed())
    
    // Check if processed text and its reversed form are the same
    return processedText == reversedText
}

print(isPalindrome("Able was I ere I saw Elba"))  // Returns true
print(isPalindrome("Was it a car or a cat I saw?"))  // Returns true
print(isPalindrome("Red roses"))  // Returns false
```

The `CharacterSet.alphanumerics.inverted` is used to remove non-alphanumeric characters from the processedText. It works by finding and removing everything that isn't a number or letter. The rest of the logic is the same, check if the processed string equals its reversed form or not.
<|end|>


