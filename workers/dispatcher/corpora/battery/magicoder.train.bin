      <div class="jumbotron">
        <h1>Login</h1>
        <input type="text" v-model="user.username">
        <input type="password" v-model="user.password">
        <button @click="login" :disabled="!isLoginFormValid">Log in</button>
      </div>
    </div>
  </div>
