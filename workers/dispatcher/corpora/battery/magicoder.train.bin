Create a Python class to manage the information of multiple library patrons. This class should not just store the information but should also have the ability to add, delete, and search for patrons using their ID or name. Additionally, it should keep a record of patrons’ borrowing history including book title, borrowing date and return date. It should also be able to check if a patron currently has any overdue books and calculate fines based on how overdue the book is. Fines should be a set rate per day that the book is overdue. The class should also handle exceptions for invalid inputs.
<|end|>
<|asst|>
Below is a python script which creates a class named `Library` managing the patron's information.

Please note that:

1. This code only handles exceptions for invalid patron's id and patron's name. Dates are expected to follow the formatting yyyy-mm-dd.
2. The fine is set to 1 unit per day a book is overdue.

```python
from datetime import datetime

class Library:
    def __init__(self):
        self.patrons = {}

    def add_patron(self, name, patron_id):
        if not isinstance(name, str) or not isinstance(patron_id, int):
            raise Exception("Invalid input. Patron's name must be a string and patron id must be an integer.")
        self.patrons[patron_id] = {"name": name, "borrowed_books": {}}

    def delete_patron(self, patron_id):
        if patron_id in self.patrons:
            del self.patrons[patron_id]
        else:
            print("Patron not found.")

    def search_patron(self, patron_id=None, name=None):
        if patron_id:
            if patron_id in self.patrons:
                return self.patrons[patron_id]
            else:
                return "Patron not found."
        elif name:
            for patron in self.patrons.values():
                if patron["name"] == name:
                    return patron
            return "Patron not found."
        else:
            return "Please provide patron id or name."

    def borrow_book(self, patron_id, book_title, borrow_date):
        self.patrons[patron_id]["borrowed_books"][book_title] = {"borrow_date": borrow_date, "return_date": None}

    def return_book(self, patron_id, book_title, return_date):
        if book_title in self.patrons[patron_id]["borrowed_books"]:
            self.patrons[patron_id]["borrowed_books"][book_title]["return_date"] = return_date

    def check_overdue_books(self, patron_id):
        overdue_books = []
        for book, dates in self.patrons[patron_id]["borrowed_books"].items():
            if dates["return_date"] is None:
                overdue_books.append(book)
            else:
                borrow_date = datetime.strptime(dates["borrow_date"], "%Y-%m-%d")
                return_date = datetime.strptime(dates["return_date"], "%Y-%m-%d")
                if return_date < borrow_date:
                    overdue_books.append(book)
        return overdue_books

    def calculate_fines(self, patron_id):
        fines = 0
        for book, dates in self.patrons[patron_id]["borrowed_books"].items():
            if dates["return_date"] is not None:
                borrow_date = datetime.strptime(dates["borrow_date"], "%Y-%m-%d")
                return_date = datetime.strptime(dates["return_date"], "%Y-%m-%d")
                overdue_days = (return_date - borrow_date).days
                if overdue_days > 0:
                    fines += overdue_days
        return fines
```
You can now use this class to create library object and manage your library patrons.

Remember to handle the exceptions when you use the functions of class so your program doesn't crash.
<|end|>


