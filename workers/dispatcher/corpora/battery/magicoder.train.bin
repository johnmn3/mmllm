Please complete the code for an efficient implementation of the function:

def fibfib(n: int):
    """
    The FibFib series resembles the Fibonacci sequence with the following properties:
    fibfib(0) == 0, fibfib(1) == 0, fibfib(2) == 1, and fibfib(n) == fibfib(n-1) + fibfib(n-2) + fibfib(n-3).
    Compose a function, utilizing dynamic programming, to effectively compute the n-th element of this series.
    >>> fibfib(1)
    0
    >>> fibfib(5)
    4
    >>> fibfib(8)
    24
    """
    # Your code here
<|end|>
<|asst|>
def fibfib(n: int):
    if n == 0:
        return 0
    elif n == 1:
        return 0
    elif n == 2:
        return 1
    
    fibfib_series = [0, 0, 1]
    
    for i in range(3, n+1):
        fibfib_series.append(fibfib_series[-1] + fibfib_series[-2] + fibfib_series[-3])
    
    return fibfib_series[-1]

# Test cases
print(fibfib(1)) # 0
print(fibfib(5)) # 4
print(fibfib(8)) # 24
<|end|>


