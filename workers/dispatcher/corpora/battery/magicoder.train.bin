Create a function to sort a list of numbers:

def custom_sort(numbers):
    """
    We have a list 'numbers' of N integers numbers[1], numbers[2], ..., numbers[N]. The
    numbers in the list will be randomly ordered. Your task is to determine if
    it is possible to get a list sorted in non-decreasing order by performing
    the following operations on the given list:
        You can perform reverse operation on any sublist any number of times.
        Additionally, you are allowed to remove one element from the list.

    If it is possible to obtain the sorted list by performing the above operations
    then return True, else return False.
    If the given list is empty, then return True.

    Note: The given list may or may not have unique elements.

    For Example:

    custom_sort([3, 4, 5, 1, 2]) ==> True
    custom_sort([3, 5, 4, 1, 2]) ==> True
    custom_sort([1, 2, 3, 5, 4]) ==> True
    custom_sort([5, 4, 3, 1, 2]) ==> False

    """
    # Your code here
<|end|>
<|asst|>
def custom_sort(numbers):
    if len(numbers) == 0:
        return True
    for i in range(len(numbers)):
        new_list = numbers[:i] + numbers[i+1:]
        sorted_list = sorted(new_list)
        if new_list == sorted_list:
            return True
        if numbers[i:] == sorted(numbers[i:])[::-1]:
            return True
    return False

# Test cases
print(custom_sort([3, 4, 5, 1, 2])) # ==> True
print(custom_sort([3, 5, 4, 1, 2])) # ==> True
print(custom_sort([1, 2, 3, 5, 4])) # ==> True
print(custom_sort([5, 4, 3, 1, 2])) # ==> False
print(custom_sort([])) # ==> True
print(custom_sort([1, 3, 2, 5, 4])) # ==> True
<|end|>


