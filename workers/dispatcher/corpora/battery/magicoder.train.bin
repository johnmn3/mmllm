The code you shared contains many OCR-output errors. Here is a corrected version:

```python
from typing import List

def rolling_max(numbers: List[int]) -> List[int]:
  """ From the provided sequence of integers, manufacture a list of the progressively highest value at each point in the series.
  """
  max_num = numbers[0]
  result = [max_num]

  for i in numbers[1:]:
    if i > max_num:
      max_num = i
    result.append(max_num)

  return result

# Test scenarios to verify correct operation
numbers = [1, 2, 3, 2, 4, 1, 5]
print(rolling_max(numbers))  # Expect: [1, 2, 3, 3, 4, 4, 5]

numbers2 = [5, 4, 3, 2, 1]
print(rolling_max(numbers2)) # Expect: [5, 5, 5, 5, 5]

numbers3 = [1, 1, 1, 1, 1]
print(rolling_max(numbers3)) # Expect: [1, 1, 1, 1, 1]

numbers4 = [-2, -1, 0, -1, 2]
print(rolling_max(numbers4)) # Expect: [-2, -1, 0, 0, 2]
```

