    std::cout << "Total collisions: " << collision_pairs.size() << std::endl;
    std::cout << "Collision Pairs are:\n";

    for (std::pair<int, int> pair : collision_pairs) {
        std::cout << "(" << pair.first << "," << pair.second << ") ";
