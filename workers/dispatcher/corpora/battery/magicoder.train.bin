function printPattern(size) {
    for(let i=1; i<=size; i++){
        let str = '';
        // for spaces
        for(let s=1; s<=size-i; s++){
            str += ' ';
        }
        // for '*'
        for(let j=1; j<=i; j++){
            str += '* ';
        }
        console.log(str);
    }
}

printPattern(5);
```

