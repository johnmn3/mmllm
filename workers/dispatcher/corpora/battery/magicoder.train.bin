<|asst|>
Here's how the Python code is translated to C#:

```C#
using System;
using System.Collections.Generic;
using System.Numerics;
using MathNet.Numerics;

public class Program
{
    private static IEnumerable<BigInteger> GenerateFibonacci()
    {
        BigInteger a = 0, b = 1;
        while (true)
        {
            yield return a;
            BigInteger temp = a;
            a = b;
            b = temp + b;
        }
    }

    private static BigInteger NthPrimeFibonacci(int n)
    {
        HashSet<BigInteger> primes = new HashSet<BigInteger>();
        foreach(var fib in GenerateFibonacci())
        {
            if(NumberTheory.IsProbablyPrime(fib, 20))  // using 20 as certainty (you can adjust it as per your requirements)
            {
                primes.Add(fib);
            }
            if(primes.Count == n)
            {
                return BigInteger.Max(primes);
            }
        }
        return -1;
    }

    public static void Main()
    {
        Console.WriteLine(NthPrimeFibonacci(100));
    }
}
```
Note: 

1) C# doesn't have a built-in function to check if a BigInteger is prime. However, MathNet.Numerics library provides an `IsProbablyPrime` method which can be used to check if a number is probably prime.

2) BigInteger.Max method is used to get the maximum prime number.

3) You'll need to install the MathNet.Numerics NuGet package. Install it from the NuGet Package Manager Console using `Install-Package MathNet.Numerics`.
