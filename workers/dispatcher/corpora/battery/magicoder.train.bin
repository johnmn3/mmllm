Show me the Rust adaptation of this:
from sqlalchemy import create_engine
from sqlalchemy.orm import sessionmaker
from sqlalchemy.exc import SQLAlchemyError

# Using reflection
from sqlalchemy.ext.automap import automap_base

# Define information needed to connect to the database
DATABASE_URI = 'mysql+pymysql://[username]:[password]@[hostname]:[port]/[database]'

# Create a base for our automap schema
Base = automap_base()

engine = create_engine(DATABASE_URI)
# Reflect the tables
Base.prepare(engine, reflect=True)

# mapped classes are now created with names by default
# matching that of the table name.
User = Base.classes.user

# Create a session
Session = sessionmaker(bind=engine)
session = Session()

# Create (Insert a record)
new_user = User(id='1', name='John Doe')
session.add(new_user)
try:
    session.commit()
except SQLAlchemyError as e:
    print(str(e))
    session.rollback()

# Retrieve (Get a record)
user = session.query(User).filter(User.name == 'John Doe').first()
print(user.id, user.name)

# Update (Modifying a record)
user.name = "Jane Doe"
try:
    session.commit()
except SQLAlchemyError as e:
    print(str(e))
    session.rollback()

# Delete (Remove a Record)
session.delete(user)
try:
    session.commit()
except SQLAlchemyError as e:
    print(str(e))
    session.rollback()

# close the session
session.close()
<|end|>
<|asst|>
Rust does not directly provide ORM (Object-relational mapping) features like Python does with the SQLAlchemy library. While there are several libraries for interacting with databases in Rust, none of them provide the same level of abstraction as SQLAlchemy. However, the Diesel library is one of the most popular libraries for interacting with databases in Rust, and offers a lot of similar concepts.

Here's a rough equivalent of your Python script using the Diesel library:

**Note:** Diesel does not support direct conversion from table to Rust structure through reflection, so a Rust struct representing the User table is declared manually.

```rust
#[macro_use]
extern crate diesel;

use diesel::prelude::*;
use diesel::mysql::MysqlConnection;
use diesel::r2d2::{ Pool, ConnectionManager };

table! {
    users (id) {
        id -> Integer,
        name -> Text,
    }
}

#[derive(Queryable, Insertable, AsChangeset, Identifiable)]
#[table_name="users"]
pub struct User {
    pub id: i32,
    pub name: String,
}

pub type DbPool = Pool<ConnectionManager<MysqlConnection>>;

fn main() {
    let manager = ConnectionManager::<MysqlConnection>::new(DATABASE_URI);
    let pool: DbPool = r2d2::Pool::builder()
        .build(manager)
        .expect("Failed to create pool.");

    let conn = pool.get().expect("Failed to get DB connection.");

    // Create (Insert a record)
    let new_user = User { id: 1, name: String::from("John Doe") };
    diesel::insert_into(users::table)
        .values(&new_user)
        .execute(&conn)
        .expect("Error inserting new user");

    // Retrieve (Get a record)
    let user: User = users::table
        .filter(users::name.eq("John Doe"))
        .first(&conn)
        .unwrap();
    println!("{} {}", user.id, user.name);

    // Update (Modifying a record)
    let modified_user = User { id: user.id, name: String::from("Jane Doe") };
    diesel::update(users::table.find(user.id))
        .set(&modified_user)
        .execute(&conn)
        .expect("Error updating user");

    // Delete (Remove a Record)
    diesel::delete(users::table.find(user.id))
        .execute(&conn)
        .expect("Error deleting user");
}
```

Include the following in your `Cargo.toml`:
```toml
[dependencies]
diesel = { version = "1.0.0", features = ["mysql"] }
r2d2 = "0.8.0"
```

**Note:** Please remember to replace `DATABASE_URI` with your actual MySQL connection URI. This code is a basic example and does not handle errors in the same way as your SQLAlchemy example, and you would need to use a more robust error handling strategy for a real-world application.
<|end|>


