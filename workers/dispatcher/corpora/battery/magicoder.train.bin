Improve the given Python function, which currently checks for the primality of a provided integer, maintaining its functionality while yielding true for prime numbers and false otherwise. Enhance the is_prime(n) function:

def is_prime(n):
    """Returns true for prime integers, false for non-prime integers.
    >>> is_prime(6)
    False
    >>> is_prime(101)
    True
    >>> is_prime(11)
    True
    >>> is_prime(13441)
    True
    >>> is_prime(61)
    True
    >>> is_prime(4)
    False
    >>> is_prime(1)
    False
    """
<|end|>
<|asst|>
def is_prime(n):
    if n < 2:
        return False
    if n == 2:
        return True
    if n % 2 == 0:
        return False
    i = 3
    while i * i <= n:
        if n % i == 0:
            return False
        i += 2
    return True

print(is_prime(6)) # False
print(is_prime(101)) # True
print(is_prime(11)) # True
print(is_prime(13441)) # True
print(is_prime(61)) # True
print(is_prime(4)) # False
print(is_prime(1)) # False
<|end|>


