```python
import os
import pickle

# File storage
FILE_NAME = "squared.pkl"


class Squared:

    def __init__(self):
        self.history = self.load_history()

    @staticmethod
    def squared(num):
        return num*num

    @staticmethod
    def valid_input(num):
        try:
            int(num)
        except ValueError:
            return False

        if num <= 0:
            return False

        return True

    def print_or_store(self, num, print_result=False):
        result = self.squared(num)
        if print_result:
            print(f'The square of {num} is {result}')
        else:
            self.history.append({'num': num, 'result': result})
            self.save_history()

    def load_history(self):
        if os.path.exists(FILE_NAME):
            with open(FILE_NAME, 'rb') as f:
                return pickle.load(f)
        else:
            return []

    def save_history(self):
        with open(FILE_NAME, 'wb') as f:
            pickle.dump(self.history, f)


# Get user input and check if it's valid
num = input('Enter a number: ')

if Squared.valid_input(int(num)):
    Squared().print_or_store(int(num), False)
else:
    print('Invalid input. Please enter a positive integer.')

```

Here, the user is asked to provide input. The input is checked and if valid it's squared and stored into the history list and the previous history is saved every time `print_or_store` function is called with `print_result` set to `False` (in case of `True` the result is just printed out without being stored). The history is loaded and saved every time the program starts and stops. The history stored remains persistent in a pickle file named "squared.pkl".

