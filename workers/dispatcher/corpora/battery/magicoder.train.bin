Enhance your C++ program:

Given a jagged array 'data' consisting of string sub-arrays of varying lengths and a string 'x', design a function that not only finds instances of 'x' in the array and returns coordinates {row, index}, but also removes 'x' after it's found, replacing it with 'y'. The function should return coordinates in ascending order as per index for multiple instances within the same row. 

Consider increasing complexity like so:
locate_str({{"apple","banana"},{"orange","apple","kiwi"},{"apple","grape"}}, "apple", "pear") == {{0, 0}, {1, 1}, {2, 0}} & Updated data is now {"pear","banana"},{"orange","pear","kiwi"},{"pear","grape"}
locate_str({{}, {"apple"}, {"banana", "apple", "kiwi"}}, "kiwi", "pear") == {{2, 2}} & Updated data is now {{}, {"apple"}, {"banana", "apple", "pear"}}.
<|end|>
<|asst|>
Here is a simple C++ program implementing your problem, you can run it with any C++ compiler:

```cpp
#include <iostream>
#include <vector>

using namespace std;

vector<pair<int, int>> locate_str(vector<vector<string>>& data, string x, string y){
    vector<pair<int, int>> coordinates;
    for(int i = 0; i < data.size(); i++){
        for(int j = 0; j < data[i].size(); j++){
            if(data[i][j]== x){
                data[i][j] = y; // replace 'x' with 'y'
                coordinates.push_back({i, j});
            }
        }
    }
    return coordinates;
}

void printData(vector<vector<string>>& data){
    for(int i = 0; i < data.size(); i++){
        for(int j = 0; j < data[i].size(); j++){
            cout << data[i][j] << " ";
        }
        cout << endl;
    }
}

int main(){
    vector<vector<string>> data = {{"apple","banana"},{"orange","apple","kiwi"},{"apple","grape"}};
    vector<pair<int, int>> result = locate_str(data, "apple", "pear");
    cout << "Coordinates: " << endl;
    for(auto& coor: result){
        cout << "{" << coor.first << ", " << coor.second << "}, ";
    }
    cout << "\nUpdated data: " << endl;
    printData(data);

    data = {{}, {"apple"}, {"banana", "apple", "kiwi"}};
    result = locate_str(data, "kiwi", "pear");
    cout << "Coordinates: " << endl;
    for(auto& coor: result){
        cout << "{" << coor.first << ", " << coor.second << "}, ";
    }
    cout << "\nUpdated data: " << endl;
    printData(data);

    return 0;
}
```

This C++ program basically implements the function "locate_str()" by looping through each sub-array of the main array. When it finds a string that matches the target string 'x', it replaces 'x' with 'y' and stores the coordinates (row and index) of 'x' in the array. This function then returns these coordinates. 

The "printData()" function is used to print the updated data after each operation.

And the "main()" function is used to run test cases.
