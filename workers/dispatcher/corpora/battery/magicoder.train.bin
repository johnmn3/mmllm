Can you transpile this to PHP?
def is_palindrome(string: str, l: int, r: int) -> bool:
    if l >= r:
        return True
    if string[l].lower() == string[r].lower():
        return is_palindrome(string, l+1, r-1)
    else:
        return False
    
def extended_palindromic_sequence(string: str) -> str:
    for i in range(len(string), -1, -1):
        if is_palindrome(string, 0, i-1):
            return string[:i]
    return ''

def make_palindrome(string: str) -> str:
    if len(string) > 200:
        raise ValueError("The input string exceeds 200 characters")
    string = ''.join(ch for ch in string if ch.isalnum())
    sequence = extended_palindromic_sequence(string)
    return string + string[:len(string)-len(sequence)][::-1]
<|end|>
<|asst|>
Sure, here is the equivalent PHP code.

```php
function is_palindrome($string, $l, $r) {
    if ($l >= $r) {
        return true;
    }
    if (strtolower($string[$l]) == strtolower($string[$r])) {
        return is_palindrome($string, $l + 1, $r - 1);
    } else {
        return false;
    }
}

function extended_palindromic_sequence($string) {
    for ($i = strlen($string); $i >= -1; $i--) {
        if (is_palindrome($string, 0, $i - 1)) {
            return substr($string, 0, $i);
        }
    }
    return '';
}

function make_palindrome($string) {
    if (strlen($string) > 200) {
        throw new Exception("The input string exceeds 200 characters");
    }
    $string = preg_replace("/[^A-Za-z0-9 ]/", '', $string);
    $sequence = extended_palindromic_sequence($string);
    return $string . strrev(substr($string, 0, strlen($string) - strlen($sequence)));
}
```
This code does the exact same thing as your Python example. Please note, in PHP we lack of list comprehension, therefore, we use `preg_replace` to remove all the non alphanumeric characters from the string.
<|end|>


