my_dict = {'a': 1, 'b': 2, 'c': 3}

def update_dict(d, k, v):
    d.update({k: v})

def filter_dict(d, f):
    return {k: v for k, v in d.items() if f(k, v)}

def sort_dict(d, key_function):
    return {k: v for k, v in sorted(d.items(), key=key_function)}

