Improve the given code:

def encode(message, shift=2):
    """
    Write a function that performs a complex encryption on a given message and an optional shift value (default is 2).
    The encryption process should involve the following steps:
    1. Swap the case of all letters.
    2. Replace all vowels with the letter that appears 'shift' places after that vowel in the alphabet, using a circular rotation if necessary.
    3. Shift all consonants 'shift' positions backward in the English alphabet, also using circular rotation when needed.
    4. Shift the index of each character in the encoded message by the product of its original index and the given shift.

    Assume only letters and spaces would be given as input. Do not apply any transformations to spaces.

    Examples:
    >>> encode('Test case')
    '>YpWsTMCfe;>>'
    >>> encode('This is a message')
    '!*dGezCzb<<x+z<q>'
    >>> encode('Example text', 3)
    'Zs!G!zkcQfP!WIM;'
    """

# Solution and additional examples:
<|end|>
<|asst|>
def encode(message, shift=2):
    result = []
    
    for i, c in enumerate(message):
        if c.isalpha():
            is_upper = c.isupper()
            c = c.lower()
            
            if c in 'aeiou':
                c = chr(((ord(c) - ord('a') + shift) % 26) + ord('a'))
                if not is_upper:
                    c = c.upper()
            else:
                c = chr(((ord(c) - ord('a') - shift) % 26) + ord('a'))
                if is_upper:
                    c = c.upper()
        
        result.append(c * (i * shift + 1))
    
    return ''.join(result)

print(encode('Test case'))
print(encode('This is a message'))
print(encode('Example text', 3))
print(encode('Programming'))
print(encode('Hello world', 4))
<|end|>


