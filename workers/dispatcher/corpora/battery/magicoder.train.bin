Below is the rectified code:

```python
class UndergroundSystem:

    def __init__(self):
        self.checked_in = {}
        self.travel_times = {}
        self.travel_times_max = {}

    def checkIn(self, id: int, stationName: str, t: int) -> None:
        self.checked_in[id] = (stationName, t)

    def checkOut(self, id: int, stationName: str, t: int) -> None:
        start_station, start_time = self.checked_in.pop(id)
        if (start_station, stationName) not in self.travel_times:
            self.travel_times[(start_station, stationName)] = [t - start_time, 1]
            self.travel_times_max[(start_station, stationName)] = t - start_time
        else:
            self.travel_times[(start_station, stationName)][0] += t - start_time
            self.travel_times[(start_station, stationName)][1] += 1
            self.travel_times_max[(start_station, stationName)] = max(self.travel_times_max[(start_station, stationName)], t - start_time)

    def getAverageTime(self, startStation: str, endStation: str) -> float:
        total_time, total_travels = self.travel_times[(startStation, endStation)]
        return total_time / total_travels

    def getMaxTime(self, startStation: str, endStation: str) -> float:
        return self.travel_times_max[(startStation, endStation)]
```

