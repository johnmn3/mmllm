Create a Python function that evaluates if the total of all elements in an array of integers is situated between two specified values, considering that the array must have an even number of elements:

def sum_within_bounds(l: list, lower_bound: int, upper_bound: int):
    """Return True if the sum of all elements in the array l falls between the lower_bound and upper_bound (both inclusive) and the array has an even length.
    >>> sum_within_bounds([1, 2, 4, 10], 15, 25)
    True
    >>> sum_within_bounds([1, 5, 10], 5, 15)
    False
    """
<|end|>
<|asst|>
def sum_within_bounds(l: list, lower_bound: int, upper_bound: int):
    if len(l) % 2 != 0:
        return False

    total = sum(l)
    return lower_bound <= total <= upper_bound

# Test cases
print(sum_within_bounds([1, 2, 4, 10], 15, 25))  # True
print(sum_within_bounds([1, 5, 10], 5, 15))  # False
