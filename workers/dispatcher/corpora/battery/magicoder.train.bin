Develop the code for the given function, accepting two integer lists, that figures out if it's possible to swap elements between these lists to transform lst1 into a list containing only even numbers, while maintaining the combined sum of both lists. With unrestricted exchanges, return "YES" if achievable and "NO" otherwise. Input lists will never be empty.

def exchange(lst1, lst2):
    """Example:
    exchange([1, 2, 3, 4], [1, 2, 3, 4]) => "YES"
    exchange([1, 2, 3, 4], [1, 5, 3, 4]) => "NO"
    """
<|end|>
<|asst|>
def exchange(lst1, lst2):
    
    sum1 = sum(lst1)
    sum2 = sum(lst2)
    odd1 = sum(x%2 for x in lst1)
    odd2 = sum(x%2 for x in lst2)
    
    if (sum1+sum2)%2==0 and (odd1+odd2)%2==0:
        return "YES"
    return "NO"

print(exchange([1, 2, 3, 4], [1, 2, 3, 4])) # => "YES"
print(exchange([1, 2, 3, 4], [1, 5, 3, 4])) # => "NO"
<|end|>


