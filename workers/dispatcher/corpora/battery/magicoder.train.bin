Help me turn this code into Swift syntax:
def median_mode(l: list):
    count_dict = {}
    l_len = len(l)
    sum = 0
    
    for i in l:
        if i in count_dict:
            count_dict[i] += 1
        else:
            count_dict[i] = 1
        sum += i
    
    median = sum / l_len
    mode = [k for k, v in count_dict.items() if v == max(count_dict.values())]
    if len(mode) == l_len:
        mode = None
    else:
        mode = mode[0]
        
    return(median, mode)

print(median_mode([3, 1, 2, 4, 5]))
print(median_mode([-10, 4, 6, 1000, 10, 20]))
<|end|>
<|asst|>
This Swift version of Python function calculates median of an integer array and mode value. Here it is:

```swift
import Foundation

func medianMode(_ l: [Int]) -> (Double, Int?) {
    var countDict = [Int: Int]()
    let l_len = l.count
    var sum = 0
    
    for i in l {
        if let oldValue = countDict[i] {
            countDict[i] = oldValue + 1
        }
        else {
            countDict[i] = 1
        }
        sum += i
    }
    
    let median = Double(sum) / Double(l_len)
    
    let maxCount = countDict.values.max()
    let modeList = countDict.filter { $1 == maxCount }.keys
    
    let mode: Int? = modeList.count == l_len ? nil : modeList.first
    
    return (median, mode)
}
print(medianMode([3, 1, 2, 4, 5]))
print(medianMode([-10, 4, 6, 1000, 10, 20]))
```

Please, note however, that this version works flawlessly for arrays with integer values. If you'd like it to accommodate arrays of floating point numbers (like Double or Float), you just need to change the type declaration for array elements and the sum variable accordingly.
<|end|>


