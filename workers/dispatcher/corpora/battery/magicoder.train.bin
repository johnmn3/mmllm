    checkb = beg_of_cyc(a, b)
    for i in a:
        cnta[ord(i) - 97] += 1
    for i in b:
        cntb[ord(i) - 97] += 1
    checkcnt = all(i >= j for i, j in zip(cnta, cntb))
    checks = any(beg_of_cyc(a, s) for s in swaps(b, 3)) if checkcnt else False
    return checkb or checks
