import re

# North American Numbering Plan (NANP) area codes
MOBILE_CODES = ['201', '202', '203', '205', '207', '208', '209', '210', '212', '213', '214', '215', '216', '217', '218',
                '219', '224', '225', '227', '228', '229', '231', '234', '239', '240', '242', '246', '248', '251', '252',
