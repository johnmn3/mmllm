import re
from typing import List

def non_overlapping_subsequences(string: str, substring: str) -> int:
    n = len(string)
    m = len(substring)
    if m > n:
        return 0

    count_table = [[0]*(n+1) for _ in range(m+1)]
    for j in range(n+1):
        count_table[0][j] = 1

    for i in range(1, m+1):
        for j in range(1, n+1):
            if string[j-1] == substring[i-1]:
                count_table[i][j] = count_table[i][j-1] + count_table[i-1][j-1]
            else:
                count_table[i][j] = count_table[i][j-1]

    return count_table[m][n]

def find_substrings_with_k_distinct_chars(string: str, k: int) -> List[str]:
    substrings = set()
    n = len(string)
 
    for i in range(n):
        dist_count = 0
        temp = [0] * 27
        for j in range(i, n):
            if temp[ord(string[j]) - 97] == 0:
                dist_count += 1
            temp[ord(string[j]) - 97] += 1
