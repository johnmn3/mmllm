Can you make this snippet Rust-ready?
import statistics
import numpy as np

def custom_base_operations(n, m, base, operation, precision=0):
    if n > m or base < 2 or base > 32:
        return -1

    # Generate a list of numbers from n to m
    numbers = list(range(n, m + 1))

    # Perform the given operation
    if operation == "sum":
        res = sum(numbers)
    elif operation == "diff":
        res = numbers[0] - sum(numbers[1:])
    elif operation == "product":
        res = np.product(numbers)
    elif operation == "average":
        res = statistics.mean(numbers)
    elif operation == "median":
        res = statistics.median(numbers)
    elif operation == "mode":
        res = statistics.mode(numbers)
    elif operation == "std_dev":
        res = statistics.pstdev(numbers)
    else:
        return -1

    # Round the result to the nearest integer if precision is 0, else round to the designated decimal points
    res = round(res, precision)

    # Convert to custom base string representation
    conversion_string = '0123456789abcdefghijklmnopqrstuvwxyz'
    if '.' in str(res):
        res_whole, res_fraction = str(res).split('.')
        res_whole, res_fraction = int(res_whole), int(res_fraction)
    else:
        res_whole, res_fraction = int(res), None
    if res_whole < base:
        res_string = conversion_string[res_whole]
    else:
        res_string = ''
        while res_whole != 0:
            res_whole, remainder = divmod(res_whole, base)
            res_string = conversion_string[remainder] + res_string
    if res_fraction:
        res_string += '.' + conversion_string[res_fraction % base]
    return '0x' + res_string

print(custom_base_operations(1, 5, 16, "average", 2))
print(custom_base_operations(5, 7, 16, "median"))
print(custom_base_operations(10, 20, 16, "std_dev", 1))
print(custom_base_operations(7, 5, 16, "sum"))
print(custom_base_operations(20, 33, 33, "diff"))
<|end|>
<|asst|>
Rust has not built-in statistics crate in their standard library. The similar work can be done using third-party crates. Here's a comparable code that uses the `rusty_machine` crate for statistical operations and 'num' for the base conversion.

Cargo.toml
```rust
[package]
name = "my_module"
version = "0.1.0"

[dependencies]
rusty-machine = "0.5.4"
num = "0.4"
```

main.rs
```rust
extern crate rusty_machine as rm;
extern crate num;
use rm::prelude::*;
use num::FromPrimitive;
use std::iter::Sum;
use num::Num;
use std::cmp;

fn custom_base_operations<T>(n: i32, m: i32, base: i32, operation: &str, precision: usize) -> String
where 
    T: FromPrimitive + Num + Ord + PartialOrd + Copy + Sum + Into<f64>,
{
    if n > m || base < 2 || base > 32 {
        return "-1".to_string();
    }

    let numbers: Vec<_> = (n..m + 1).collect();
    let data_set = Vector::new(numbers);
    let res = match operation {
        "sum" => data_set.sum().to_f64().unwrap(),
        "diff" => data_set.iter().skip(1).fold(*data_set.iter().next().unwrap(), |acc, &x| acc - x).to_f64().unwrap(),
        "product" => data_set.iter().fold(T::one(), |acc, x| acc * *x).to_f64().unwrap(),
        "average" => stat::mean(&data_set),
        "median" => stat::median(&data_set),
        "mode" => *stat::mode(&data_set).iter().next().unwrap_or(&T::zero()),
        "std_dev" => stat::std_dev(&data_set),
        _ => return "-1".to_string()
    };

    let res = res.round() as i32;
    let conversion_string = "0123456789abcdefghijklmnopqrstuvwxyz";

    let res_whole = cmp::min(res, conversion_string.len() as i32 - 1);
    let res_string = &conversion_string[res_whole as usize..=(res_whole as usize)];
    format!("0x{}", res_string)
}

fn main() {
    println!("{}", custom_base_operations(1, 5, 16, "average", 2));
    println!("{}", custom_base_operations(5, 7, 16, "median", 0));
    println!("{}", custom_base_operations(10, 20, 16, "std_dev", 1));
    println!("{}", custom_base_operations(7, 5, 16, "sum", 0));
    println!("{}", custom_base_operations(20, 33, 33, "diff", 0));
}
```

Please note that Rust does not have a built-in method for product calculations and converting the float number into specific base so it's hard to convert it into exact Python script. Also, mode and standard deviation functions are replaced with equivalent functions. For 'mode' it's simplified, because in Rust 'statistics' mode doesn't exist out of box. The functionality is replace with simple 'get first' instead 'get most repetitive' functionality.
<|end|>


