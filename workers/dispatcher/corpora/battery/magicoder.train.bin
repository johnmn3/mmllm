Develop a code snippet in JavaScript to discern not only the rendering engine currently utilized by the browser, but also its specific version number, requiring layered identification through user-agent strings.
<|end|>
<|asst|>
In JavaScript, the `navigator` object contains information about the browser. The `navigator.userAgent` property returns the user-agent header sent by the browser to the server. This string can be parsed to get information about the browser's rendering engine and its version number.

Below is a simple code snippet that does this:

```javascript
function getRenderingEngineInfo() {
  var userAgent = navigator.userAgent;
  var info={};

  if (userAgent.indexOf("Trident") > -1) {  // IE
    info.engine = 'Trident';
    var match = userAgent.match(/Trident\/(\d+\.\d+)/);
    if (match != null) {
        info.version = match[1];
    }
  } else if (userAgent.indexOf("Gecko") > -1) { // Firefox
    info.engine = 'Gecko';
    var match = userAgent.match(/rv:(\d+\.\d+)/);
    if (match != null) {
        info.version = match[1];
    }
  } else if (userAgent.indexOf("Presto") > -1) { // Opera
    info.engine = 'Presto';
    var match = userAgent.match(/Presto\/(\d+\.\d+)/);
    if (match != null) {
        info.version = match[1];
    }
  } else if (userAgent.indexOf("AppleWebKit") > -1) { // Chrome/Safari
    info.engine = 'WebKit';
    var match = userAgent.match(/AppleWebKit\/(\S+)/);
    if (match != null) {
        info.version = match[1];
    }
  } else if (userAgent.indexOf("Blink") > -1) { // Newer Chrome/Opera
    info.engine = 'Blink';
    var match = userAgent.match(/Blink\/(\S+)/);
    if (match != null) {
        info.version = match[1];
    }
  } else {
    info.engine = 'unknown';
  }

  return info;
}

console.log(getRenderingEngineInfo());
```

Please note that relying on the user-agent to determine the browser's rendering engine and version is generally not recommended. It's better to use feature detection or progressive enhancement whenever possible. The user-agent can be spoofed or manipulated, and different browsers can report false or misleading information.
<|end|>


