What's the Perl version of this code?
def modify_alphabet_case_and_change_symbols(string: str) -> str:
    ALPHABET= 'abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ'
    numbers= '123456789'
    output = ''
    unique_symbols = set()

    word_list = string.split(' ')

    for word_index,word in enumerate(word_list):
        for char_index,s in enumerate(word):
            if s in ALPHABET:
                output += s.upper() if s.islower() else s.lower()
            elif s in numbers:
                output += str(int(s) - 1) if int(s) % 2 != 0 else s
            elif s not in unique_symbols:
                output += s * 2
                unique_symbols.add(s)
            else:
                output += s

        output += ' ' if word_index != len(word_list) - 1 else ''

        if (word_index + 1) % 2 == 0:
            output = output[:-len(word)][::-1] + output[-len(word):]

    return output
<|end|>
<|asst|>
Below is the Perl version of your Pyhton code:

```perl
sub modify_alphabet_case_and_change_symbols {
    my ($string) = @_;
    my $ALPHABET= 'abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ';
    my $numbers= '123456789';
    my $output = '';
    my %unique_symbols;

    my @word_list = split ' ', $string;

    for my $word_index (0..$#word_list) {
        my @word = split //, $word_list[$word_index];
        for my $char_index (0..$#word) {
            my $s = $word[$char_index];
            if ($s =~/[$ALPHABET]/){
                $output .= $s =~/[a-z]/ ? uc($s) : lc($s);
            }
            elsif ($s =~/[$numbers]/){
                $output .= $s % 2 != 0 ? $s - 1 : $s;
            }
            elsif (!$unique_symbols{$s}){
                $output .= $s x 2;
                $unique_symbols{$s} = 1;
            }
            else {
                $output .= $s;
            }
        }

        $output .= ' ' if $word_index != $#word_list;

        if (($word_index + 1) % 2 == 0){
            $output = reverse(substr($output,0,-scalar(@word))) . substr($output,-scalar(@word));
        }
    }
    return $output;
}
```
One thing to note is that in Perl, strings declared using double quotes (`"`) allow escape sequences and variable interpolation, while strings declared using single quotes (`'`) don't. This is why `$ALPHABET` and `$numbers` are wrapped in single quotes `'` in the Perl version, instead of double quotes `"`.
<|end|>


