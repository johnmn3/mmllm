from datetime import datetime, timedelta

def fruit_distribution(s, n, fruits, servings, exp_dates, time_in_basket):
    # initialize solution dict
    soln_dict = {}
    # set maximum time for fresh fruits
    max_time = timedelta(hours=2) 

    # loop over every fruit
    for fruit in fruits:
        quantity, name = fruit.split(' ')
        quantity = int(quantity)
        
        # validate if fruit is in the servings and expiration date dictionaries
        if (name in servings and name in exp_dates):
            # calculate the number of servings for current fruit
            serving_number = servings[name] * quantity

            # check if the fruit's expiration date is later than the current date and time spent in the basket is less than 2 hours.
            if datetime.strptime(exp_dates[name], '%Y-%m-%d') > datetime.now() and time_in_basket[name] <= max_time:
                soln_dict[name] = serving_number
    
    return soln_dict
Would you mind providing a brief explanation for each part of the Perl code?
