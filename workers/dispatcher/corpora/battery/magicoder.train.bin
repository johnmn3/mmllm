    if n < 2:
        return False
    for i in range(2, int(n**0.5) + 1):
        if n % i == 0:
            return False
    return True

def sum_primes(n):
    return sum([i for i in range(2, n) if is_prime(i)])

# 验证函数的正确性
print(sum_primes(5))  # 5
print(sum_primes(11)) # 17
print(sum_primes(0))  # 0
print(sum_primes(20)) # 77
print(sum_primes(1))  # 0
print(sum_primes(18)) # 58
please include remarks in the c# translation to help me follow along.
<|end|>
<|asst|>
Here's the equivalent C# code for the Python program you provided:

```csharp
using System;

class Program
{
    static void Main()
    {
        Console.WriteLine(SumPrimes(5));  // Outputs: 5
        Console.WriteLine(SumPrimes(11)); // Outputs: 17
        Console.WriteLine(SumPrimes(0));  // Outputs: 0
        Console.WriteLine(SumPrimes(20)); // Outputs: 77
        Console.WriteLine(SumPrimes(1));  // Outputs: 0
        Console.WriteLine(SumPrimes(18)); // Outputs: 58
    }

    // This function checks if a number is a prime
    static bool IsPrime(int n)
    {
        // If n is less than 2, it is not a prime
        if (n < 2)
        {
            return false;
        }

        // Check if n has any factors other than 1 and itself
        // Start at 2 up to the square root of n, inclusive
        // If a factor is found, n is not a prime
        for (int i = 2; i * i <= n; i++)
        {
            if (n % i == 0)
                return false;
        }

        // If no factors other than 1 and itself, n is a prime
        return true;
    }

    // This function sums all prime numbers up to n, exclusive
    static int SumPrimes(int n)
    {
        int sum = 0;

        // Iterate through all numbers from 2 up to n, exclusive
        // If a number is prime, add it to the sum
        for (int i = 2; i < n; i++)
        {
            if (IsPrime(i))
                sum += i;
        }

        return sum;
    }
}
```
Just like the python function, this C# program checks for prime numbers and sums all prime numbers up to the input number (exclusive) then prints the result. It first checks if a number is less than two and if a number has any factors other than itself. If none of these conditions are met, it sums the prime number.
