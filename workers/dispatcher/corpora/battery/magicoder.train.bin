Make this PHP-compatible:
def quickselect_median(l, pivot_fn):
    if len(l) % 2 == 1:
        return quickselect(l, len(l) // 2, pivot_fn)
    else:
        return 0.5 * (quickselect(l, len(l) // 2 - 1, pivot_fn) +
                      quickselect(l, len(l) // 2, pivot_fn))


def quickselect(l, k, pivot_fn):
    if len(l) == 1:
        return l[0]

    pivot = pivot_fn(l)

    lows = [el for el in l if el < pivot]
    highs = [el for el in l if el > pivot]
    pivots = [el for el in l if el == pivot]

    if k < len(lows):
        return quickselect(lows, k, pivot_fn)
    elif k < len(lows) + len(pivots):
        return pivots[0]
    else:
        return quickselect(highs, k - len(lows) - len(pivots), pivot_fn)


def median(l):
    return quickselect_median(l, pivot_fn=lambda x: x[len(x) // 2])


# testing the function
print(median([3, 1, 2, 4, 5]))
print(median([-10, 4, 6, 1000, 10, 20]))
print(median([10, -20, -30, 40, 50, -60]))
print(median([1, 2]))
<|end|>
<|asst|>
Here is the PHP version of your Python code:

```php
function quickselect_median($l, $pivot_fn){
    if(count($l) % 2 == 1){
        return quickselect($l, intdiv(count($l), 2), $pivot_fn);
    } else {
        return 0.5 * (quickselect($l, intdiv(count($l), 2) - 1, $pivot_fn) + 
                      quickselect($l, intdiv(count($l), 2), $pivot_fn));
    }
}

function quickselect($l, $k, $pivot_fn){
    if(count($l) == 1){
        return $l[0];
    }

    $pivot = $pivot_fn($l);
    $lows = array_filter($l, function($el) use ($pivot) { return $el < $pivot; });
    $highs = array_filter($l, function($el) use ($pivot) { return $el > $pivot; });
    $pivots = array_filter($l, function($el) use ($pivot) { return $el == $pivot; });

    if($k < count($lows)){
        return quickselect($lows, $k, $pivot_fn);
    } elseif($k < count($lows) + count($pivots)){
        return reset($pivots);
    } else {
        return quickselect($highs, $k - count($lows) - count($pivots), $pivot_fn);
    }
}

function median($l){
    return quickselect_median($l, function($x){ return $x[intdiv(count($x), 2)]; });
}

// testing the function
echo median([3, 1, 2, 4, 5]);
echo "\n";

echo median([-10, 4, 6, 1000, 10, 20]);
echo "\n";

echo median([10, -20, -30, 40, 50, -60]);
echo "\n";

echo median([1, 2]);
echo "\n";
```
Please note:
- We must use `intdiv` function for integer division in PHP, since `/` operator will always return a float.
- Array comprehension like in Python doesn't exist in PHP. So we use `array_filter` to replicate the behavior.
- In the anonymous functions (`function($el) use ($pivot) {...}`), we have to use `use` keyword to import `$pivot` from the parent scope.
<|end|>


