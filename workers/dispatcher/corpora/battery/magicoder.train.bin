Translate this code to C#
import numpy as np
import gmpy2


def generate_fibonacci():
    a, b = 0, 1
    while True:
        yield a
        a, b = b, a + b


def nth_prime_fibonacci(n):
    primes = set()
    for fib in generate_fibonacci():
        if gmpy2.is_prime(fib): 
            primes.add(fib)
        if len(primes) == n:
            return max(primes)


print(nth_prime_fibonacci(100))
