please convert this into c++:
import boto3
import psycopg2
from psycopg2 import pool
import threading

class AwsAurora:
    def __init__(self, minconn, maxconn, host, database, user, password):
        self.minconn = minconn
        self.maxconn = maxconn
        self.host = host
        self.database = database
        self.user = user
        self.password = password
        self.conn_pool = None
        self.create_pool()

    def create_pool(self):
        self.conn_pool = psycopg2.pool.SimpleConnectionPool(self.minconn, 
                                                            self.maxconn, 
                                                            user = self.user, 
                                                            password = self.password, 
                                                            host = self.host, 
                                                            database = self.database)

    def query(self, query_str):
        conn = self.conn_pool.getconn()
        cursor = conn.cursor()
        cursor.execute(query_str)
        result = cursor.fetchall()
        cursor.close()
        self.conn_pool.putconn(conn)
        return result

    def update(self, update_str):
        conn = self.conn_pool.getconn()
        cursor = conn.cursor()
        cursor.execute(update_str)
        conn.commit()
        cursor.close()
        self.conn_pool.putconn(conn)

    def handle_requests(self, requests):
        threads = []
        for request in requests:
            if 'query' in request:
                thread = threading.Thread(target=self.query, args=(request['query'],))
            else:
                thread = threading.Thread(target=self.update, args=(request['update'],))
            threads.append(thread)
            thread.start()

        for thread in threads:
            thread.join()
could you also break down what's happening in the c++ version?
<|end|>
<|asst|>
Direct translation of Python scripts into C++ may not be possible because Python supports some features out-of-the-box that C++ doesn't. For example, PostgreSQL connection in Python is handled by psycopg2 library but in C++ we use libpq-fe.h library. Threading and Exception handling are also handled differently in both languages. Nevertheless, here's an example of how you could structure your C++ code based on the given Python code:

```cpp
#include <libpq-fe.h>
#include <pthread.h>
#include <stdexcept>
#include <string>
#include <vector>

class AwsAurora {
public:
    AwsAurora(std::string host, std::string database,
              std::string user, std::string password)
        : host_(host), database_(database), user_(user), password_(password) {
        CreatePool();
    }

    // Destructor to clean up connections
    ~AwsAurora() {
        PQfinish(conn_);
    }

    void Query(std::string query_str) {
        PGresult *res = PQexec(conn_, query_str.c_str());
        if (PQresultStatus(res) != PGRES_TUPLES_OK) {
            throw std::runtime_error(PQerrorMessage(conn_));
        }
        // Retrieve result here..
        PQclear(res);
    }

    void Update(std::string update_str) {
        PGresult *res = PQexec(conn_, update_str.c_str());
        if (PQresultStatus(res) != PGRES_COMMAND_OK) {
            throw std::runtime_error(PQerrorMessage(conn_));
        }
        PQclear(res);
    }

    void HandleRequests(std::vector<std::string> requests) {
        pthread_t threads[requests.size()];
        int i = 0;
        for (auto &request : requests) {
            if (request.find("query") != std::string::npos) {
                // Create thread for Query operation
                pthread_create(&threads[i], nullptr, &AwsAurora::Query, (void *)&request);
            } else {
                // Create thread for Update operation
                pthread_create(&threads[i], nullptr, &AwsAurora::Update, (void *)&request);
            }
            i++;
        }

        for (i = 0; i < requests.size(); i++) {
            pthread_join(threads[i], nullptr);
        }
    }

private:
    void CreatePool() {
        std::string conninfo = "dbname = " + database_ + 
                               " user = " + user_ + 
                               " password = " + password_ + 
                               " hostaddr = " + host_ + " port = 5432";
        conn_ = PQconnectdb(conninfo.c_str());

        if (PQstatus(conn_) != CONNECTION_OK) {
            throw std::runtime_error(PQerrorMessage(conn_));
        }
    }

    PGconn *conn_;
    std::string host_, database_, user_, password_;
};
```
This C++ version doesn't have connection pooling support because libpq doesn't support it natively unlike psycopg2 in Python. You could use an external library to handle this. Error handling is also a little more complicated in C++ because you need to check the state after every operation.

The threading part simply runs each request (query/update) in a new thread just like the Python version. Please be aware that as it is, the threads don't have access to any class data, they would have to be given explicit access depending on your exact requirements.  

Make sure you have the PostgreSQL library for C++ installed, you might need to adjust the includes or linkages depending on your setup. Also the error handling and usage of libpq might need adjustments based on how you want to handle errors and get data from the results.
<|end|>


