Sure, here is your Python code converted into C#. This equivalent C# function uses similar logic with very similar steps. But a note of caution, Python and C# handle some things differently (like Regex, handling of alphanumeric strings, etc.):

```csharp
using System;
using System.Collections.Generic;
using System.Linq;
using System.Text.RegularExpressions;

public class Program
{
    public static void Main()
    {
        Console.WriteLine(IsHappy("123321456765"));
    }

    static string IsHappy(string s)
    {
        // Check if the string contains only alphanumeric characters
        if (!s.All(Char.IsLetterOrDigit))
        {
            return "Invalid input string! Only alphanumeric characters are allowed.";
        }

        int n = s.Length;

        // The string must have at least a length of 3 for it to be happy
        if (n < 3) return "False";

        // Check that every group of three successive characters are distinct
        for (int i = 0; i < n - 2; i++)
        {
            if (s.Substring(i, 3).Distinct().Count() != 3)
            {
                return "False";
            }
        }

        // Check that each discrete character appears not less than twice
        Dictionary<char, int> charCount = new Dictionary<char, int>();
        foreach(var c in s)
        {
            if (charCount.ContainsKey(c)) charCount[c]++;
            else charCount[c] = 1;
        }

        if (charCount.Values.Min() < 2)
        {
            return "False";
        }

        // Check that no character appears three times consecutively
        if (new Regex(@"(.)\1{2}").IsMatch(s))
        {
            return "False";
        }

        return "True";
    }
}
```
