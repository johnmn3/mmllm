```go
package main

import "fmt"

func sumArray(numbers []int) int {
   sum := 0
   for _, number := range numbers {
       sum += number
   }
   return sum
}

func main() {
   numbers := []int{1, 2, 3, 4, 5}
   result := sumArray(numbers)
   fmt.Println("The sum of the given array is:", result)
}
```
