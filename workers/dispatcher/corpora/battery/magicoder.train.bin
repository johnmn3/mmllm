Then, we add JavaScript to handle the logic:

```javascript
let countries = ["China", "United States", "United Kingdom", "India", "Australia"];

let dropdown = document.getElementById('dropdown-content');

let maxLenCountries = getMaxLenCountries(countries);

maxLenCountries.forEach(country => {
    let a = document.createElement('a');
    a.textContent = country;
    dropdown.appendChild(a);
});

// function to find countries with maximum length
function getMaxLenCountries(countries) {
  let maxLength = Math.max(...(countries.map(el => el.length)));
  let maxLenCountries = countries.filter(country => country.length === maxLength);
  return maxLenCountries.sort();  // sort in alphabetical order
}
```

