```python
import statistics
import numpy as np

def process_lists(list_1, list_2, ops):
    if not list_1 and not list_2:
        return "Error: input lists can't be empty."

    if not isinstance(list_1, list) or not isinstance(list_2, list) or not isinstance(ops, list):
        return "Error: all inputs need to be lists."

    output = []
    for op in ops:
        if op == 'merge':
            output.append(sorted(list_1 + list_2, reverse=True)) 

        elif op == 'common_elements':
            temp = [value for value in list_1 if value in list_2]
            output.append(sorted(temp, reverse=True)) 

        elif op == 'unique_elements':
            temp = list(set(list_1) ^ set(list_2))
            output.append(sorted(temp, reverse=True)) 

        elif op == 'sort_in_descending':
            output.append(sorted(list_1 + list_2, reverse=True)) 

        else:
            return f"Error: operation '{op}' not recognized."

    return output

# example usage:
list1 = [1, 2, 3, 4]
list2 = [3, 4, 5, 6]
ops = ['merge', 'common_elements', 'unique_elements', 'sort_in_descending']
print(process_lists(list1, list2, ops)) 

# output:
# [[6, 5, 4, 3, 2, 1], [4, 3], [6, 5, 2, 1], [6, 5, 4, 3, 2, 1]]
```

