```python
def convert_time_12_to_24(time_str):
    if time_str[-2:] == "AM" and time_str[:2] == "12":
        return "00" + time_str[2:-2]
    elif time_str[-2:] == "AM":
        return time_str[:-2]
    elif time_str[-2:] == "PM" and time_str[:2] == "12":
