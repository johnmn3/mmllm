Revise this code for C:
def digit_product_sum(n):
    """
    Calculate the sum and the product of the digits of a number.

    Args:
    n (int): A positive integer.

    Returns:
    Tuple: A tuple containing the product and the sum of the digits.
    """
    product = 1
    digit_sum = 0
    for digit in str(n):
        product *= int(digit)
        digit_sum += int(digit)
    return product, digit_sum, n


def sort_by_digit_product(arr):
    """
    Sort an array of positive integers primarily based on the product 
    of their digits. If the product is similar, sort them based on the 
    sum of the digits and if the sum is also equal, arrange them in 
    ascending order.

    Args:
    arr (list): A list of positive integers.

    Returns:
    list: The list sorted based on the criteria.
    """
    arr = sorted(arr, key=digit_product_sum, reverse=True)

    return arr
<|end|>
<|asst|>
Here is the revised C code:

```C
#include <stdio.h>
#include <stdlib.h>

typedef struct 
{
    int value;
    int product;
    int digit_sum;
} Number;

int digit_product_sum(int n, int *product, int *digit_sum) 
{
    *product = 1;
    *digit_sum = 0;

    while (n != 0) 
    {
        int digit = n % 10;
        *product *= digit;
        *digit_sum += digit;
        n /= 10;
    }
} 

int compare(const void *a, const void *b) 
{
    Number *num1 = (Number *)a;
    Number *num2 = (Number *)b;

    if (num1->product > num2->product) 
        return -1;
    else if (num1->product < num2->product) 
        return 1;
    else 
    {
        if (num1->digit_sum > num2->digit_sum) 
            return -1;
        else if (num1->digit_sum < num2->digit_sum) 
            return 1;
        else 
        {
            if (num1->value > num2->value) 
                return -1;
            else if (num1->value < num2->value) 
                return 1;
            else 
                return 0;
        }
    }
}

void sort_by_digit_product(int *arr, int size) 
{
    Number numbers[size];

    for (int i = 0; i < size; i++) 
    {
        numbers[i].value = arr[i];
        digit_product_sum(arr[i], &numbers[i].product, &numbers[i].digit_sum);
    }

    qsort(numbers, size, sizeof(Number), compare);

    for (int i = 0; i < size; i++) 
        arr[i] = numbers[i].value;
}
```
This C code first calculates the product and sum of digits for each number in the array. Then it sorts the array in decreasing order prioritizing the digit product, then digit sum and then the number itself. The sorted array is then copied back to the input array where it can be used as needed.
<|end|>


