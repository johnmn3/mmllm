<|asst|>
First, change `getElementByTagName` to `getElementsByTagName`. Also, instead of using `innerHTML.toLowerCase()`, we should use `parseInt()` to properly compare ages as numbers, not as strings.

Here is the corrected code:

```html
<!DOCTYPE html>
<html>
<head>
<style>
table, th, td {
  border: 1px solid black;
}
</style>
<script>
function sortTableByAge() {
  var table, rows, swapping, i, x, y, shouldSwap;
  table = document.getElementById("myTable");
  swapping = true;
  while (swapping) {
    swapping = false;
    rows = table.rows;
    for (i = 1; i < (rows.length - 1); i++) {
      shouldSwap = false;
      x = rows[i].getElementsByTagName("TD")[1];
      y = rows[i + 1].getElementsByTagName("TD")[1];
      if (parseInt(x.innerHTML) > parseInt(y.innerHTML)) {
        shouldSwap = true;
        break;
      }
    }
    if (shouldSwap) {
      rows[i].parentNode.insertBefore(rows[i + 1], rows[i]);
      swapping = true;
    }
  }
}
</script>
</head>
<body>

<table id="myTable">
  <tr>
    <th>Name</th>
    <th>Age</th>
    <th>Occupation</th>
  </tr>
  <tr>
    <td>John</td>
    <td>35</td>
    <td>Engineer</td>
  </tr>
  <tr>
    <td>Jane</td>
    <td>29</td>
    <td>Doctor</td>
  </tr>
  <tr>
    <td>Bob</td>
    <td>42</td>
    <td>Teacher</td>
  </tr>
</table>
<br>
<button onclick="sortTableByAge()">Sort by Age</button>

</body>
</html>
```
