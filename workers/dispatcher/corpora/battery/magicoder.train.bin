In Swift, you can write the above Python code as follows:

```swift
func complexDigitCount(num: Int) -> (evenCount: Int, oddCount: Int, threeCount: Int) {
    var evenCount = 0
    var oddCount = 0
    var threeCount = 0

    for digitChar in String(abs(num)) {
        if let digit = Int(String(digitChar)) {
            if digit % 2 == 0 {
                evenCount += 1
            }
            if digit % 2 != 0 {
                oddCount += 1
            }
            if digit % 3 == 0 {
                threeCount += 1
            }
        }
    }

    return (evenCount, oddCount, threeCount)
}

print(complexDigitCount(num: -123))
print(complexDigitCount(num: 456))
```

