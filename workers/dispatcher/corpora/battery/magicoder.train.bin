Here is a simple example of a JavaScript class that manages employee records. This class has methods to add, edit, delete, and search for employee information. Employee information includes employee ID, full name, role, department and joining date. The class also includes methods to validate the data entered for each field.

Please note that this is a simple implementation and does not cover all possible corner cases. It's always essential to add error checking and handling which fits your specific use case.

```javascript
class Employees {
    constructor() {
        this.employees = [];
    }

    addEmployee(employee) {
        if(this.validateEmployee(employee)) {
            this.employees.push(employee);
            console.log('Employee added successfully.');
        } else {
            console.log('Failed to add employee. Invalid data.');
        }
    }

    editEmployee(id, updatedInfo) {
        let index = this.employees.findIndex(emp => emp.id === id);
        if(index !== -1) {
            if(this.validateEmployee(updatedInfo)) {
                this.employees[index] = {...this.employees[index], ...updatedInfo};
                console.log('Employee updated successfully.');
            } else {
                console.log('Failed to update employee. Invalid data.');
            }
        } else {
            console.log('Employee not found.');
        }
    }

    deleteEmployee(id) {
        let index = this.employees.findIndex(emp => emp.id === id);
        if(index !== -1) {
            this.employees.splice(index, 1);
            console.log('Employee deleted successfully.');
        } else {
            console.log('Employee not found.');
        }
    }

    searchEmployee(id) {
        let index = this.employees.findIndex(emp => emp.id === id);
        if(index !== -1) {
            console.log('Employee found: ', this.employees[index]);
        } else {
            console.log('Employee not found.');
        }
    }

    validateEmployee(employee) {
        if(!employee.id || !employee.fullName || !employee.role || !employee.department || !employee.joiningDate) {
            return false;
        }

        // additional validation logic
        
        return true;
    }
}
```
This Employees class can be used as follows:

```javascript
let empManager = new Employees();
empManager.addEmployee({id: 1, fullName: 'John Doe', role: 'Developer', department: 'Engineering', joiningDate: '2020-01-01'});
empManager.searchEmployee(1);  // Outputs: Employee found:  {id: 1, fullName: 'John Doe', role: 'Developer', department: 'Engineering', joiningDate: '2020-01-01'}
empManager.editEmployee(1, {fullName: 'Jane Doe'});
empManager.searchEmployee(1);  // Outputs: Employee found:  {id: 1, fullName: 'Jane Doe', role: 'Developer', department: 'Engineering', joiningDate: '2020-01-01'}
empManager.deleteEmployee(1);
empManager.searchEmployee(1);  // Outputs: Employee not found.
```
