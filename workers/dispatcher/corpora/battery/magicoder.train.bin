    return r.text

def parse(html):
    content = BeautifulSoup(html, 'lxml')
    data = content.find_all("div") # searching for div elements (change this according to your needs)
    for div in data:
        print(div) # Replace this with your logic to process the elements

def run_scraper():
    html = start_requests()
    parse(html)

run_scraper()
