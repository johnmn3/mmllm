<|asst|>
def make_a_pile(n, pattern, offset=0):
    stones = [n + offset]
    for i in range(n-1):
        if pattern == 'odd':
            stones.append(stones[-1] + 2*i + 1)
        elif pattern == 'even':
            stones.append(stones[-1] + 2*(i + 1))
    return stones

print(make_a_pile(3, 'odd'))
print(make_a_pile(3, 'even'))
