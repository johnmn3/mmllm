using System;
using System.Collections.Generic;

class Program
{
    static void Main(string[] args)
    {
        object[] array = {0, "Apple", 1, "Orange", 2, "Banana", 3, "Mango"};

        List<object> numericList = new List<object>();

        foreach (var item in array)
        {
            // Type test at runtime using 'is' keyword
            if (item is int || item is double || item is float || item is decimal)
            {
                numericList.Add(item);
            }
        }

        Console.WriteLine("Numeric items in the array:");

        foreach (var item in numericList)
        {
            Console.WriteLine(item);
        }
    }
}
