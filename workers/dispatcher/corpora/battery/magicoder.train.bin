I have corrected the entire code. The task seems to be a function that can convert Roman numerals to integers, integers to Roman numerals, integers to hexadecimal and hexadecimal to integers.

```python
def convert_number(number, conversion_type):
    # define dict for integer to Roman conversion
    dict_int_to_roman = {
        1: 'I', 4: 'IV', 5: 'V', 9: 'IX', 10: 'X', 40: 'XL', 50: 'L', 90: 'XC',
        100: 'C', 400: 'CD', 500: 'D', 900: 'CM', 1000: 'M'
    }

    # create reverse dict for Roman to integer conversion
    dict_roman_to_int = {v: k for k, v in dict_int_to_roman.items()}

    def int_to_roman(num):
        res = ''
        for i in sorted(dict_int_to_roman.keys(), reverse=True):
            while num >= i:
                res += dict_int_to_roman[i]
                num -= i
        return res

    def roman_to_int(s):
        i = res = 0
        while i < len(s):
            if i + 1 < len(s) and dict_roman_to_int[s[i:i+2]] > dict_roman_to_int[s[i]]:
                res += dict_roman_to_int[s[i:i+2]]
                i += 2
            else:
                res += dict_roman_to_int[s[i]]
                i += 1
        return res 

    if conversion_type == 'int_to_roman':
        return int_to_roman(int(number))
    elif conversion_type == 'roman_to_int':
        return roman_to_int(str(number))
    elif conversion_type == 'int_to_hex':
        return hex(int(number))[2:]
    elif conversion_type == 'hex_to_int':
        return int(str(number), 16)
    else:
        raise ValueError("Invalid conversion type")


# Tests
print(convert_number(25, 'int_to_hex'))  # '19'
print(convert_number('19', 'hex_to_int'))  # 25
print(convert_number('CDLXVI', 'roman_to_int'))  # 466
print(convert_number(466, 'int_to_roman'))  # 'CDLXVI'
```
