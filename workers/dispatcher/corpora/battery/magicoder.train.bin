```python
# Imported Libraries
import numpy as np
import pandas as pd
from scipy import stats
from sklearn import preprocessing
from sklearn.neighbors import LocalOutlierFactor
from sklearn.preprocessing import StandardScaler
import matplotlib.pyplot as plt

#Data Loading
