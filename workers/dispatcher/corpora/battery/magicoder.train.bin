A:
&lt;code&gt;
import pandas as pd
df = pd.DataFrame({&#39;A_Name&#39;: [&#39;AA&#39;, &#39;BB&#39;, &#39;CC&#39;, &#39;DD&#39;, &#39;EE&#39;, &#39;FF&#39;, &#39;GG&#39;],
                   &#39;B_Detail&#39;: [&#39;X1&#39;, &#39;Y1&#39;, &#39;Z1&#39;, &#39;L1&#39;, &#39;M1&#39;, &#39;N1&#39;, &#39;K1&#39;],
