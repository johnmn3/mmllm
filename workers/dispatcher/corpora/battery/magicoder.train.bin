Here's your implementation in C. I tried to provide comments to help understand the code:

```c
#include <stdio.h>

// Function to get the maximum between two integers
int max(int a, int b) {
    return a > b ? a : b;
}

// Fibfib function
int fibfib(int n, int m) {
    // Initialize fib array with length max(3, n+1) and all values as 0
    int fib[max(3, n+1)];
    for(int i=0; i<max(3, n+1); i++) {
        fib[i] = 0;
    }

    // Sets the third position of the array as 1(i.e., fib[2] = 1)
    fib[2] = 1;

    // Calculate fib[n] for n>2
    for(int i=3; i<=n; i++) {
        fib[i] = fib[i-1] + fib[i-2] + fib[i-3];
        if(i >= m) {
            fib[i] -= fib[i - m];
        }
    }

    // Return last position of fib array
    return fib[n];
}

int main() {
    // Tests
    printf("%d\n", fibfib(10, 4));  // Returns 11
    printf("%d\n", fibfib(20, 7));  // Returns 43

    return 0;
}
```
This C code does exactly the same as the python code you provided. It creates an array `fib` of size `max(3, n+1)` initialised to 0, then it sets `fib[2] to 1`. Afterwards, it populates the `fib` sequence according to the rule given in the loop inside the `fibfib` function and finally returns `fib[n]`. The `max` function is used because of the condition in initiated array could be at least of size `3` or `n+1` in any case.
