                    queue.append(box2)
                else:
                    unopened.add(box2)
        else:
            unopened.add(box)
    while unopened:
        found = False
        for box in list(unopened):
            if status[box] == 1:
                found = True
                collected += candies[box]
                unopened.remove(box)
                for key in keys[box]:
                    if key in unopened:
                        unopened.remove(key)
                        queue.append(key)
                    else:
                        status[key] = 1
                for box2 in containedBoxes[box]:
                    if status[box2] == 1:
                        queue.append(box2)
                    else:
                        unopened.add(box2)
            if not found:
                break
    return collected
```

