Below is the Swift equivalent of your Python code:

```swift
import Darwin

let operatorsDict: [String : (Double, Double) -> Double] = [
    "+" : { $0 + $1 },
    "-" : { $0 - $1 },
    "*" : { $0 * $1 },
    "/" : { $0 / $1 }, 
    "**": { pow($0, $1) }, 
    "log": { log($0) / log($1) }, 
    "exp": { $0 * exp($1) }, 
    "sin": { $0 * sin($1 * .pi / 180) },
    "cos": { $0 * cos($1 * .pi / 180) },
    "tan": { $0 * tan($1 * .pi / 180) }
]

func doCalculations(operators: [String], operands: [Double]) -> Double {
    return round( zip(operators, operands.dropFirst()).reduce( operands.first ?? 0) { result, operation in
        operatorsDict[operation.0]!(result, operation.1)
        } * 1000
    ) / 1000
}

// Test case
print(doCalculations(operators: ["+", "*", "-", "log", "exp", "sin"], operands: [2, 3, 4, 10, 5, 45])) // Output: -2.558
```

This Swift version replicates the functionality of your Python code. However, it will crash if you pass an operator that is not available in `operatorsDict` or when the first operand is nil due to a force-unwrap. For a safer version, you should first validate your operators and operands.
