transform this code to perl for me:
def smallest_change(arr, limit):
    l = 0
    r = len(arr) - 1
    changes = 0
    freq = [0] * 2001  # Assuming the maximal element value in array is 2000

    while l <= r:
        # Increment the frequency count for min and max element in current sub-array
        freq[max(arr[l], arr[r])] += 1
        changes += max(arr[l], arr[r]) - min(arr[l], arr[r])
        l += 1
        if l <= r:
            r -= 1

    total = 0
    for i in range(2000, 0, -1):
        total += freq[i]
        if total >= limit:
            # Reduce the change count by the difference of elements exceeding limit
            changes -= (total - limit) * (i - 1)
            break

    return changes
would be helpful to have comments explaining the perl code.
<|end|>
<|asst|>
Here is the translated code in Perl with inline comments:

```perl
# Perl implementation of smallest_change function
sub smallest_change {
    # Input parameters:
    
    # @arr the input array in Perl (equivalent of arr in Python)
    # $limit is the number representing the limit (equivalent of limit in Python)

    # Declare Perl equivalents for Python variables
    my ($arr_ref, $limit) = @_;  # Input array is passed as a reference
    my @arr = @{$arr_ref};       # Dereference the array reference
    
    my $l = 0;                   # Left pointer
    my $r = $#arr;               # Right pointer, set at last index of the array
    my $changes = 0;             # Changes counter
    my @freq = (0) x 2001;       # Frequency array, assuming the maximal array element is 2000

    # Loop while the left pointer is less than or equal to the right pointer
    while ($l <= $r) {
        # Increment the frequency count for min and max element in current sub-array
        $freq[max($arr[$l], $arr[$r])]++;
        $changes += max($arr[$l], $arr[$r]) - min($arr[$l], $arr[$r]);
        $l++;
        
        # Decrement the right pointer if left pointer is still less than or equal to the right pointer
        $r-- if $l <= $r;
    }

    my $total = 0;
    for (my $i = 2000; $i > 0; $i--) {
        $total += $freq[$i];
        if ($total >= $limit) {
            # Reduce the change count by the difference of elements exceeding limit
            $changes -= ($total - $limit) * ($i - 1);
            last;
        }
    }

    return $changes;  # Return the number of changes
}
```

Note: As Python has inbuilt min() and max() functions for lists, where Perl requires List::Util module to use inbuilt min() and max(). If this module is not available, you have to manually find the minimum and maximum in the Perl code.
