```python
# Given data
data = [
    {
        'pet': {
            'species': 'canine',
            'properName': 'Fortunate',
            'lifespanInYears': 5
        }
    },
    {
    'pet': {
            'species': 'feline',
            'properName': 'Lucky',
            'lifespanInYears': 10
        }
    },
    {
    'pet': {
            'species': 'rabbit',
            'properName': 'Bouncy',
