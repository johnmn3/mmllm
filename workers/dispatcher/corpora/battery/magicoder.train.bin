Enhance the given code for a more complex function:

def multiply_abs_values_v2(lst):
    """
    Provided a list of numerical values, return the multiplication result
    of the absolute values of these numbers, considering only their
    closest rounded-down integers.

    Additionally, filter out elements that are divisible by any prime number less than or equal to 5.
    
    e.g:
    lst = [2, -3, 4], answer: 4
    lst = [1.5, 4.8, -2.2], answer: 6
    lst = [1, -5, 9, -3], answer: 27
    lst = [3.2, -2.7, 0], answer: 0
    lst = [-1.7, 2, 2], answer: 2
    """
<|end|>
<|asst|>
def multiply_abs_values_v2(lst):
    # Import the math module to use floor function
    import math

    # Function to check if a number is divisible by any prime number less than or equal to 5
    def is_divisible_by_prime(n):
        primes = [2, 3, 5]
        for prime in primes:
            if n % prime == 0:
                return True
        return False

    # Initialize result
    result = 1

    # Iterate through the list
    for num in lst:
        # Get the closest rounded-down integer
        int_num = math.floor(abs(num))
        
        # Check if the number is not divisible by a prime less than or equal to 5
        if not is_divisible_by_prime(int_num):
            # Multiply the result by the integer
            result *= int_num

    return result

# Test cases
print(multiply_abs_values_v2([2, -3, 4])) # 4
print(multiply_abs_values_v2([1.5, 4.8, -2.2])) # 6
print(multiply_abs_values_v2([1, -5, 9, -3])) # 27
print(multiply_abs_values_v2([3.2, -2.7, 0])) # 0
print(multiply_abs_values_v2([-1.7, 2, 2])) # 2
<|end|>


