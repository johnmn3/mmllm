<|asst|>
Sure, here it is in C:

```c
#include <stdio.h>
#include <stdlib.h>

int count_nums(int arr[], int n) {
    int count = 0;
    for (int i = 0; i < n; i++) {
        int total = 0;
        char num_str[12]; // assuming the maximum size of int to be 10 digits.
        sprintf(num_str, "%d", arr[i]);
        int start = 0;
        if (arr[i] < 0) { 
            start = 1;
            total -= num_str[1] - '0';
        }
        for (int j = start; num_str[j] != '\0'; j++){
            total += num_str[j] - '0';
        }
        if (total > 0 && total % 4 == 0){
            count += 1;
        }
    }
    return count;
}

int main() {
    int arr[] = {-4, 15, -12}; // use your array here
    int n = sizeof(arr) / sizeof(arr[0]);
    printf("%d", count_nums(arr, n));
    return 0;
}
```
Please note that this C version lacks the ability to handle variable arguments like its Python version you provided. 

