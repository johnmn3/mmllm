Here is a Python program that can solve this problem:

```python
def hex_to_ascii(hex_values):
    return ''.join(chr(int(hex_value, 16)) for hex_value in hex_values)

def ascii_to_hex(ascii_values):
    return ' '.join(hex(ord(char)).split('x')[-1] for char in ascii_values)

while True:
    print("\nMenu:")
    print("1. Hex to ASCII")
    print("2. ASCII to Hex")
    print("3. Quit")
    option = input("Enter your option: ")

    if option == '1':
        hex_values = input("Enter hexadecimal values (space-separated): ").split()
        try:
            result = hex_to_ascii(hex_values)
            print("ASCII characters: ", result)
        except ValueError:
            print("Invalid input!")

    elif option == '2':
        ascii_values = input("Enter ASCII characters: ")
        try:
            result = ascii_to_hex(ascii_values)
            print("Hexadecimal values: ", result)
        except ValueError:
            print("Invalid input!")

    elif option == '3':
        print("Exiting...")
        break

    else:
        print("Invalid Option!")
```

