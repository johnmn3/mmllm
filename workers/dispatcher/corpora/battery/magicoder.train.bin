Craft a function in code format that takes in a string as input, inverses the characters situated at even indices, and retains the characters in odd index positions unchanged.

def reverse_even(s: str):
    """This function takes a string s and produces a modified string s' such that
    s' maintains the characters at odd index positions unmodified, whereas the characters positioned
    at even indices are inverted with respect to their positions in the initial string s.
    >>> reverse_even("abcde")
    "edcba"
    >>> reverse_even("hello world")
    "hloolelwrd"
    """
<|end|>
<|asst|>
def reverse_even(s: str):
    even_chars = s[::2][::-1]
    output = ''
    even_index = 0
    
    for i in range(len(s)):
        if i % 2 == 0:
            output += even_chars[even_index]
            even_index += 1
        else:
            output += s[i]
            
    return output

# Test the function with the provided examples
print(reverse_even("abcde"))  # Output: "edcba"
print(reverse_even("hello world"))  # Output: "hloolelwrd"
<|end|>


