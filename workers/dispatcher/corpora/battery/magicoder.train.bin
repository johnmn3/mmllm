Write a C++ program that creates a doubly linked list of length n. Incorporate methods for adding and deleting nodes from the linked list, and ensure these methods maintain the integrity of the linked list. The start of the list will always be an empty node.
<|end|>
<|asst|>
Here's a simple version of a C++ program that creates a doubly linked list:

```cpp
#include<iostream>

using namespace std;

// Define the node structure
struct Node {
    int value;
    Node* next;
    Node* prev;
};

class DoublyLinkedList {
    private:
        Node* head;

    public:
        //constructor
        DoublyLinkedList() {
            head = NULL;
        }

        //method to add node
        void addNode(int val) {
            Node* newNode = new Node();
            newNode->value = val;
            newNode->next = NULL;
            newNode->prev = NULL;

            // If head is null, assign the new node address to head
            if (head == NULL) {
                head = newNode;
            } else {
                Node* temp = head;
                while (temp->next != NULL) {
                    temp = temp->next; // Go To last Node
                }
                temp->next = newNode;
                newNode->prev = temp;
            }
        }

        //method to delete node
        void deleteNode(int val) {
            Node* temp = head;
            while (temp != NULL) {
                if (temp->value == val) {
                    if(temp == head) { // Node to be deleted is head
                        head = head->next;
                        head->prev = NULL;
                    } else {
                        if(temp->next != NULL) { 
                            temp->prev->next = temp->next;
                            temp->next->prev = temp->prev;
                        } else { 
                            temp->prev->next = NULL;
                        }
                    }
                }
                temp = temp->next;
            }
        }

        //method to display values in the linked list
        void display() {
            if (head == NULL) {
                cout<<"Linked list is empty"<<endl;
                return;  
            }
            Node* temp = head;
            while (temp != NULL) {
                cout<<temp->value<<endl;
                temp = temp->next;
            }
        }
};

int main() {
    DoublyLinkedList dl;
    dl.addNode(1);
    dl.addNode(2);
    dl.addNode(3);
    dl.addNode(4);
    dl.addNode(5);
    cout<<"Initial Doubly Linked List: "<<endl;
    dl.display();
    cout<<"Doubly Linked List After Deleting 3: "<<endl;
    dl.deleteNode(3);
    dl.display();
}
```

Notice in the `addNode` function, we traverse the list to find the last node, then append the new node. In the `deleteNode` function, we similarly traverse the list, but when we find the node to delete, we adjust the `next` and `prev` pointers of the adjacent nodes before removing our target node.
<|end|>


