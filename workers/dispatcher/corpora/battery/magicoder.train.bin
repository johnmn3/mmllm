Can you rework this code into Rust?
from typing import List, Tuple

def binary_and_shortest_subseq(a: List[int], b: List[int]) -> Tuple[int, int, List[int]]:
    # bitwise AND operation
    res = [a[i] & b[i] for i in range(len(a))]
    
    # initialization
    min_len_subseq = res
    min_start, min_end = 0, len(res) - 1
    
    # find shortest continuous subsequence
    i = 0
    while i < len(res):
        j = i
        while j < len(res) and res[j] == res[i]:
            j += 1
        if j - i < len(min_len_subseq):
            min_len_subseq = res[i:j]
            min_start, min_end = i, j - 1
        i = j
    
    return min_start, min_end, min_len_subseq
Please add some explanatory comments in the Rust code.
<|end|>
<|asst|>
Sure, here's the equivalent function in Rust:

```rust
fn binary_and_shortest_subseq(a: &Vec<i32>, b: &Vec<i32>) -> (usize, usize, Vec<i32>) {
    // bitwise AND operation on corresponding elements of input vectors
    let res: Vec<i32> = a.iter().zip(b.iter()).map(|(&x, &y)| x & y).collect();

    // initial setup, assuming min seq is the entire list
    let (mut min_start, mut min_end) = (0, res.len() - 1);
    let mut min_len_subseq = res.clone();
    
    // i starts from 0, we're going to go through each element
    let mut i = 0;
    while i < res.len() {
        // j is where our exploring starts, it equals i initially
        let mut j = i;
        while j < res.len() && res[j] == res[i] {
            // as long as same elements continues, move forward
            j += 1;
        }
        // check if the sequence we found is shorter than our current shortest
        if j - i < min_len_subseq.len() {
            // if it is, then update our shortest sequence
            min_len_subseq = res[i..j].to_vec();
            // as well as our start and end indices
            min_start = i;
            min_end = j - 1;
        }
        // move our exploration index to where our last found same element sequence ended
        i = j;
    }
   
    return (min_start, min_end, min_len_subseq);
}
```
This Rust function basically does the same bitwise AND operation on the corresponding elements of the input vectors, then finds the shortest continuous subsequence of the same elements in the result list. It returns the start and end indices of that sequence, as well as the sequence itself, as a tuple. Please take note of the borrowing (`&`) and ownership in rust when trying to understand this function.
<|end|>


