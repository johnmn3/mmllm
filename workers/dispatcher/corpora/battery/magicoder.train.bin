for file in file_names:
    try:
        df = pd.read_csv(file)
        dfs.append(df)
    except FileNotFoundError:
        print(f"The file {file} does not exist.")
    except pd.errors.ParserError:
        print(f"Cannot parse the file {file}. It might be corrupted.")

# appending/concatenating the dataframes
df = pd.concat(dfs, ignore_index=True)

# handling missing data - remove rows with any missing data
df = df.dropna()

# assuming the data in csv files have unwanted inconsistencies like white spaces and lower/upper case mix in 'Area' names
df['Area'] = df['Area'].str.strip()  # removing white spaces
df['Area'] = df['Area'].str.lower()  # converting to lowercase

# handling inconsistencies in numeric data - convert them to appropriate data type (float for temperatures)
df['Temperature'] = pd.to_numeric(df['Temperature'], errors='coerce')  # this converts non-numeric values to NaN

# calculate mean temperature for each month of each year for each area
mean_temperature_df = df.groupby(['Year', 'Month', 'Area'])['Temperature'].mean().reset_index()

# find the hottest and chilliest months
hottest_month_df = mean_temperature_df.loc[mean_temperature_df.groupby(['Year', 'Area'])['Temperature'].idxmax()]
chilliest_month_df = mean_temperature_df.loc[mean_temperature_df.groupby(['Year', 'Area'])['Temperature'].idxmin()]
```

The dataframes `hottest_month_df` and `chilliest_month_df` will contain information about the hottest and chilliest months for each year in each area, respectively. 

