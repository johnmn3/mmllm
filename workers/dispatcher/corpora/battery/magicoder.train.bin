Here is the Swift equivalent for your JavaScript code:

```swift
func longest(strings: [String]) -> [String] {
    var maxLength = 0
    var longestStrings = [String]()

    for string in strings {
        if string.count > maxLength {
            maxLength = string.count
            longestStrings = [string] // Reset the longestStrings array
        } else if string.count == maxLength {
            longestStrings.append(string) // Add to the longestStrings array
        }
    }

    return longestStrings
}
```
