def variance(num1, num2):
    # calculate the absolute value of the variance
    variance_value = abs(num1 - num2)
    return variance_value

# define the two specific numeric quantities
num1, num2 = 15, 10

# calculate the variance
print(f"Variance between {num1} and {num2}: {variance(num1, num2)}")
```
