from django.views import View
from .models import Ad
from users.models import User

class AdView(View):
    """
    AdView handles the creation and retrieval of ads.
    """

    def post(self, request):
        """
        Handle POST requests.
        """
        data = request.POST
        title = data.get('title')
        description = data.get('description')
        target_audience = data.get('target_audience')
        advertiser_username = data.get('advertiser')

        if not all([title, description, target_audience, advertiser_username]):
            return JsonResponse({'error': 'Missing required information.'}, status=400)

        try:
            advertiser = User.objects.get(username=advertiser_username)
        except User.DoesNotExist:
            return JsonResponse({'error': 'User does not exist.'}, status=404)

        ad = Ad(title=title, description=description, target_audience=target_audience, advertiser=advertiser)
        ad.save()

        return JsonResponse({'message': 'Ad created successfully.'}, status=201)

    def get(self, request):
        """
        Handle GET requests.
        """
        ad_id = request.GET.get('id')

        if not ad_id:
            return JsonResponse({'error': 'Missing required information.'}, status=400)

        try:
            ad = Ad.objects.get(id=ad_id)
        except Ad.DoesNotExist:
            return JsonResponse({'error': 'Ad does not exist.'}, status=404)

        return JsonResponse({
            'title': ad.title,
            'description': ad.description,
            'target_audience': ad.target_audience,
            'advertiser': ad.advertiser.username
        }, status=200)
