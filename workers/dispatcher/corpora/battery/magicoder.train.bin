i'm looking to rewrite this in swift:
def below_zero(operations: List[Tuple[str, int]], case_insensitive: bool = False) -> Union[bool, str]:
    balance = 0
    for op, val in operations:
        if case_insensitive:
            op = op.lower()
        if op == 'deposit':
            balance += val
        elif op == 'withdrawal':
            balance -= val
        else:
            return 'Invalid operation encountered.'
        if balance < 0:
            return True
    return False
would be helpful to have comments explaining the swift code.
<|end|>
<|asst|>
Here is the Swift version of your Python function. It's very similar but Swift doesn't have Union type like Python so I use optional `String` or `Bool` for the return type. If the function returns a `String`, it means that invalid operation is encountered, otherwise it returns optional `Bool` to indicate if the balance is below zero.

```swift
// Define a function belowZero with two parameters
// - operations: a list of tuples, where each tuple contains a string and an integer
// - caseInsensitive: a boolean value that indicates whether string comparison should be case-sensitive or not
func belowZero(operations: [(String, Int)], caseInsensitive: Bool = false) -> String? {

    // Initialize the balance to zero
    var balance = 0
    
    // Iterate over all the provided operations
    for operation in operations {
        
        // Get the operation type and amount
        var op = operation.0
        let val = operation.1
        
        // If caseInsensitive is set to True, convert operation to lower case
        if caseInsensitive {
            op = op.lowercased()
        }
        
        // Perform the corresponding operation based on the operation type
        // If the operation type is neither 'deposit' nor 'withdrawal, return 'Invalid operation encountered.'
        if op == "deposit" {
            balance += val
        } else if op == "withdrawal" {
            balance -= val
        } else {
            return "Invalid operation encountered."
        }
        
        // If the balance becomes negative, return that the balance is below zero
        if balance < 0 {
            return nil
        }
    }
    
    // If none of the operations result in a negative balance, return false
    return "False"
}
```

To use this function, simply call it with the operations you want to perform:

```swift
print(belowZero(operations: [("deposit", 100), ("withdrawal", 200)])) // Should print nil (means 'balance is below zero')
print(belowZero(operations: [("deposit", 200), ("withdrawal", 100)])) // Should print "False"
print(belowZero(operations: [("deposit", 200), ("INVALID OP", 100)])) // Should print 'Invalid operation encountered.'
```
<|end|>


