Write a JavaScript function that converts a string to title case with an additional feature of ignoring specified words.

The function should take two parameters:
1. A string to be converted to title case.
2. An array of lowercase words that must be ignored in the title case conversion.

Example:
string = "This is a sample sentence."
ignore_words = ['a', 'is']

Output: "This is A Sample Sentence."

Note: The first word of the string should always be capitalized, even if it is an ignored word.
<|end|>
<|asst|>
function titleCase(str, ignore_words) {
    let words = str.split(' ')
    let result = []

    for (let i = 0; i < words.length; i++) {
        if (i === 0 || !ignore_words.includes(words[i].toLowerCase())) {
            result.push(words[i].charAt(0).toUpperCase() + words[i].slice(1).toLowerCase())
        } else {
            result.push(words[i].toLowerCase())
        }
    }

    return result.join(' ')
}

let string = "This is a sample sentence."
let ignore_words = ['a', 'is']
console.log(titleCase(string, ignore_words))
// Output: "This is A Sample Sentence."
<|end|>


