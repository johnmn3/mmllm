result = ... # put solution in this variable
BEGIN SOLUTION
<code>
<|end|>
<|asst|>
import numpy as np

# Convert 4d to 1d
c_maxes = np.max(np.max(np.max(c, axis=-1), axis=-1), axis=-1)

# Sorting indices based on max values
sort_indices = np.argsort(c_maxes)

# Apply those indices to d
result = d[sort_indices]
