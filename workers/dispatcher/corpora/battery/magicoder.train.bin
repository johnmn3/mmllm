Create a C++ program that requests the user to input their age and the current date. Use this information to calculate the year they were born, taking into account if they already had their birthday this year or not. The program should print out an appropriate message to the user that includes their calculated birth year. Additionally, implement error checking to ensure the user inputs a valid age (a non-negative number less than 150) and a valid date.
<|end|>
<|asst|>
Here is a simple solution:

```cpp
#include <iostream>
#include <ctime>
using namespace std;

int main() {
    int age;
    int day, month, year;
    time_t now = time(0);
    tm *ltm = localtime(&now);
    int currentYear = 1900 + ltm->tm_year;
    int currentMonth = 1 + ltm->tm_mon;
    int currentDay = ltm->tm_mday;

    cout << "Please enter your age: ";
    cin >> age;

    cout << "Please enter the current month (1-12): ";
    cin >> month;

    cout << "Please enter the current day (1-31): ";
    cin >> day;

    if(age < 0 || age > 150){
      cout << "Invalid age! Age should be between 0 and 150." << endl;
      return 0;
    }

    if(month < 1 || month > 12){
      cout << "Invalid month! Month should be between 1 and 12." << endl;
      return 0;
    }

    if(day < 1 || day > 31){
      cout << "Invalid day! Day should be between 1 and 31." << endl;
      return 0;
    }

    int birthYear = currentYear - age;

    if(month < currentMonth || (month == currentMonth && day < currentDay)){
      birthYear++;
    }

    cout << "You were born in " << birthYear << " or " << birthYear-1 << " ("<<age<<" years old)."<<endl;

    return 0;
}
```

This program requests the user's age and the current date (broken down into month and day). It calculates the present year using the time library and subtracts the user's age from this. 

Error checking is in place for the user's entered age (should be 0-150) and date (month should be 1-12, day should be 1-31). If the user has already had their birthday this year, the birth year does not change. If they haven't had their birthday yet, we increment the birth year by one. Note that this program may produce two possible birth years if the user's birthday is today.
<|end|>


