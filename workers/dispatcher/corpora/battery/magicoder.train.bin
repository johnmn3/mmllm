Show me how to write this in Go:
import boto3

def move_data(source_bucket, target_bucket, file_name):
    s3 = boto3.resource('s3')
    copy_source = {
        'Bucket': source_bucket,
        'Key': file_name
    }

    try:
        s3.Bucket(target_bucket).copy(copy_source, file_name)
        print(f"{file_name} has been copied to {target_bucket}")

        s3.Object(source_bucket, file_name).delete()
        print(f"{file_name} has been deleted from {source_bucket}")

    except Exception as e:
        print(e)
        
# 使用函數
move_data('source-bucket-name', 'target-bucket-name', 'file-to-move')
Could you also break down what's happening in the Go version?
<|end|>
<|asst|>
Here is the Go version:

```go
package main

import (
    "fmt"

    "github.com/aws/aws-sdk-go/aws"
    "github.com/aws/aws-sdk-go/aws/session"
    "github.com/aws/aws-sdk-go/service/s3"
)

func moveData(sourceBucket, targetBucket, fileName string) {
    sess := session.Must(session.NewSession(&aws.Config{
        Region: aws.String("us-west-2"),
    }))

    svc := s3.New(sess)

    _, err := svc.CopyObject(&s3.CopyObjectInput{
        Bucket:     aws.String(targetBucket),
        CopySource: aws.String(sourceBucket + "/" + fileName),
        Key:        aws.String(fileName),
    })
    if err != nil {
        fmt.Println("Error while copying the object", err)
        return
    }

    _, err = svc.DeleteObject(&s3.DeleteObjectInput{
        Bucket: aws.String(sourceBucket),
        Key:    aws.String(fileName),
    })
    if err != nil {
        fmt.Println("Error while deleting the object:", err)
        return
    }

    fmt.Println(fileName, "has been moved from", sourceBucket, "to", targetBucket)
}

func main() {
    moveData("source-bucket-name", "target-bucket-name", "file-to-move")
}
```

Here's what the Go version does:

1. `moveData()` function accepts `sourceBucket`, `targetBucket` and `fileName` as arguments. 
2. A session with the AWS SDK is established using `session.NewSession()`. This allows Go application to make service API calls. The AWS Region us-west-2 is specified to the session configuration. 
3. AWS S3 service client is created using `s3.New()`, which gives us the ability to access methods to perform operations on S3.
4. The `CopyObject()` method is used to copy an object (file in this case) from the source bucket to the destination bucket. If there's an error, it's printed and the program returns.
5. The `DeleteObject()` method is used to delete the file from the source bucket after it has successfully copied. If there's an error, it's printed and the program returns. 
6. If the file is successfully copied and then deleted, a success message is printed.  
7. In `main()`, we call `moveData()` with bucket names and the file name.
