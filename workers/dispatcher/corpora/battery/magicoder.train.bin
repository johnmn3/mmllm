func sumSquareCubeProduct(numbers: [Int]) -> [Int] {
    var sumSquares = 0
    var productCubes = 1

    for num in numbers {
        sumSquares += num * num
        productCubes *= num * num * num
    }

    return [sumSquares, productCubes]
