<|asst|>
Here is a simple implementation of a game of Noughts and Crosses (Tic Tac Toe) where you can play against a computer opponent. We will use the minimax algorithm for the AI.

```python
# Tic Tac Toe game against the computer where

import random

# The game board
board = [' ' for _ in range(9)]

# Function to insert a letter to the board at a specific position
def insert_letter(letter,pos):
    board[pos] = letter

# Function to check if a space is free
def is_space_free(pos):
    return board[pos] == ' '

# Function to print the board
def print_board():
    print()
    print(' ' + board[0] + ' | ' + board[1] + ' | ' + board[2])
    print('-----------')
    print(' ' + board[3] + ' | ' + board[4] + ' | ' + board[5])
    print('-----------')
    print(' ' + board[6] + ' | ' + board[7] + ' | ' + board[8])
    print()

# Function to check if the board is full
def is_board_full():
    return board.count(' ') == 0

# Function to check for a win
def check_for_win():
    winning_combinations = [(0,1,2), (3,4,5), (6,7,8), (0,3,6), (1,4,7), (2,5,8), (0,4,8), (2,4,6)]
    for combination in winning_combinations:
        if board[combination[0]] == board[combination[1]] == board[combination[2]] != ' ':
            return True
    return False

# Function to handle the player's move
def player_move():
    run = True
    while run:
        move = input('Please select a position to place an \'X\' (0-8): ')
        try:
            move = int(move)
            if move >= 0 and move <= 8:
                if is_space_free(move):
                    run = False
                    insert_letter('X', move)
                else:
                    print('Sorry, this space is occupied!')
            else:
                print('Please type a number within the range!')
        except:
            print('Please type a number!')

# Function to handle the computer's move
def computer_move():
    best_score = -float('inf')
    best_move = None
    for i in range(len(board)):
        if is_space_free(i):
            # Try this move for the current iteration
            board[i] = 'O'
            score = minimax(board, 0, False)
            # Undo move
            board[i] = ' '
            if score > best_score:
                best_score = score
                best_move = i
    insert_letter('O', best_move)

# Minimax algorithm for AI decision making
def minimax(board, depth, is_maximizing):
    if check_for_win():
        if is_maximizing:
            return -1
        else:
            return 1
    elif is_board_full():
        return 0

    if is_maximizing:
        best_score = -float('inf')
        for i in range(len(board)):
            if is_space_free(i):
                board[i] = 'O'
                score = minimax(board, depth + 1, False)
                board[i] = ' '
                best_score = max(score, best_score)
        return best_score
    else:
        best_score = float('inf')
        for i in range(len(board)):
            if is_space_free(i):
                board[i] = 'X'
                score = minimax(board, depth + 1, True)
                board[i] = ' '
                best_score = min(score, best_score)
        return best_score

# Main game loop
def play_game():
    print_board()
    while not check_for_win():
        if not is_board_full():
            player_move()
            print_board()
        else:
            break
        if not is_board_full():
            computer_move()
            print_board()
        else:
            break
    if check_for_win():
        print('Game over.')
    else:
        print('It\'s a tie!')

play_game()
```

This is a simplified version of AI for a tic tac toe game and includes room for you to expand on this basic idea.

