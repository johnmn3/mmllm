Rewrite this in Rust:
from sqlalchemy import create_engine, MetaData, Table
from sqlalchemy.orm import sessionmaker

def modify_record(db_string, table_name, record_id, new_data):
    # Create an engine that stores data in the db_string URL
    engine = create_engine(db_string)

    # Connect to the database
    connection = engine.connect()
    metadata = MetaData()

    # Wrap the connection in a MetaData instance
    metadata.create_all(engine)
    
    # Get table
    table = Table(table_name, metadata, autoload_with=engine)

    # Create a configured "Session" class
    Session = sessionmaker(bind=engine)

    # Create a Session
    session = Session()

    # Begin a new transaction
    session.begin()
    
    # Query the record you want to modify
    record = session.query(table).filter(table.c.id == record_id).first()
    
    # Modify the record
    for key, value in new_data.items():
        setattr(record, key, value)

    # Commit the transaction
    session.commit()

    # Close the session
    session.close()
<|end|>
<|asst|>
In Rust, you would typically use the `diesel` crate to handle database interactions. However, Rust does not have a direct equivalent to SQLAlchemy's sophisticated ORM (Object-Relational Mapping) features. And Rust being statically typed, the equivalent function would also need to know the type of the table instead of taking it as a string. For the purpose of this translation, we will use a simple case of updating a record in a Users table.

```rust
#[macro_use]
extern crate diesel;

use diesel::prelude::*;
use diesel::pg::PgConnection;
use dotenv::dotenv;
use std::env;

pub mod schema;
pub mod models;

use self::models::{User, NewUser};

pub fn establish_connection() -> PgConnection {
    dotenv().ok();

    let database_url = env::var("DATABASE_URL").expect("DATABASE_URL must be set");
    PgConnection::establish(&database_url).expect(&format!("Error connecting to {}", database_url))
}

pub fn modify_user(id: i32, new_user: NewUser) {
    use schema::users::dsl::*;

    let connection = establish_connection();

    let _ = diesel::update(users.find(id))
        .set(&new_user)
        .get_result::<User>(&connection)
        .expect("Error updating user");
}
```

This example assumes you have a `DATABASE_URL` environment variable set for your database connection string. The `users` table is represented by the `users` module imported from `schema`. The `User` and `NewUser` structs represent the structure of your existing users and new user data respectively.

Note: This won't work out of the box as you need to define your database schema and models, which is not covered in your Python code.
<|end|>


