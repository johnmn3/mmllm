Here is the corrected code:

```python
import math

def gcd(a, b):
    if a == 0:
        return b
    return gcd(b, a % b)

def find_maximum_sum(arr):
    n = len(arr)
    incl = arr[0]
    excl = 0

    for i in range(1, n):
        incl_new = excl + arr[i]
        excl_new = max(excl, incl)

        # Updating variables
        incl = incl_new
        excl = excl_new

    return max(excl, incl)

def pairwise_coprime(array, start, end):
    for i in range(start, end):
        for j in range(i + 1, end):
            if math.gcd(array[i], array[j]) > 1:
                return False
    return True

def no_adjacent_elements(array, start, end):
    index_dict = {val:idx for idx, val in enumerate(array)}
    subset = array[start:end + 1]
    for num in subset:
        if num + 1 in index_dict or num - 1 in index_dict:
            return False
    return True

def main(arr):
    max_sum = 0
    for i in range(len(arr)):
        for j in range(i, len(arr)):
            if no_adjacent_elements(arr, i, j) and pairwise_coprime(arr, i, j):
                max_sum = max(max_sum, find_maximum_sum(arr[i:j + 1]))
    return max_sum
```
