        if num == 2:  # 2 is the only even prime number
            even_prime_numbers.append(num)

    return even_prime_numbers

print(get_even_prime_and_merge([-1, 2, -4, 5, 6], [5, 3, -5, 2, -3, 3, 8, 0, 14, 4, -10]))
