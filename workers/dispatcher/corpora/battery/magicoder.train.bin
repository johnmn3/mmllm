def translate_to_spanish(word):
    translations = {
        "Hello": "Hola",
        "Thank You": "Gracias",
        "Goodbye": "Adios"
    }
    return translations.get(word, "Translation not found")

print(translate_to_spanish("Hello"))  # Output: Hola
