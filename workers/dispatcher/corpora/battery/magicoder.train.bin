def largest_prime_factor(n: int): 
    if n == 0:
        raise ValueError('The prime factor of zero is undefined.')
    n = abs(n)
    i = 2
    factors = []
    while i * i <= n:
        if n % i:
            i += 1
        else:
            n //= i
            factors.append(i)
    if n > 1:
        factors.append(n)
    return max(factors)
