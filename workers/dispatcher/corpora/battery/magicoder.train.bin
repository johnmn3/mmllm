Write this code in C#, please:
def is_prime(n):
    '''Check if a number is prime. 0, 1, and numbers less than 0 are not prime'''
    if n < 2:
        return False
    for i in range(2, int(n**0.5) + 1):
        if n % i == 0:
            return False
    return True

def odd_sum_prime_index_elements(x, l):
    '''Given a list of positive integers x and a limit l, return a sorted list that contains all unique elements with an odd sum, an index that is a prime number, and values greater than the limit l.'''

    output = []

    # Iterate over the elements of x
    for i in range(len(x)):
        # The element is not greater than the limit l
        if x[i] <= l:
            continue
        # Sum of digits is not odd
        elif sum(int(num) for num in str(x[i])) % 2 == 0:
            continue
        # Index is not prime
        elif not is_prime(i):
            continue
        # If the element passes all three conditions, append it to output
        else:
            output.append(x[i])

    # Remove duplicates and return a sorted list
    return sorted(list(set(output)))
<|end|>
<|asst|>
Here's the equivalent code in C#

```csharp
using System;
using System.Collections.Generic;
using System.Linq;

public class Program
{
    public static void Main()
    {
        List<int> x = new List<int> {10, 20, 30, 40, 50};
        int l = 20;
        var result = OddSumPrimeIndexElements(x,l);

        foreach (var item in result)
        {
            Console.WriteLine(item); 
        }
    }

    static bool IsPrime(int n)
    {
        if (n < 2)
            return false;
            
        for(int i = 2; i <= Math.Sqrt(n); i++)
        {
            if(n % i == 0)
                return false;
        }
        return true;
    }

    static List<int> OddSumPrimeIndexElements(List<int> x, int l)
    {
        List<int> output = new List<int>();

        for (int i = 0; i < x.Count; i++)
        {
            if (x[i] <= l)
                continue;
                
            if (SumOfDigits(x[i]) % 2 == 0)
                continue;
                
            if (!IsPrime(i))
                continue;
                
            output.Append(x[i]);
        }

        return output.Distinct().OrderBy(z => z).ToList();
    }

    static int SumOfDigits(int n)
    {
        int sum = 0;
        while(n != 0)
        {
            sum += n % 10;
            n /= 10;
        }
        return sum;
    }
}
```
This C# code does exactly the same as your Python code. It has a main function that declares a list of integers and a limit, it calls the `OddSumPrimeIndexElements` function and then outputs the result. The `OddSumPrimeIndexElements` function iterates over the elements in the list, checks that they meet the conditions, and adds them to the output list. The `IsPrime` and `SumOfDigits` are the helper functions used to check if the index is a prime number and to calculate the sum of digits of a number respectively.
