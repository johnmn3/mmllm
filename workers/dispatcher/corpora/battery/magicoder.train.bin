def get_positive_and_sort(l: list):
    """Returns only unique positive numbers from the list, sorted in ascending order."""

    def swap_elements(n: list, index1: int, index2: int):
        """Swap the elements at index1 and index2 in list n."""
        n[index1], n[index2] = n[index2], n[index1]
        
    # Create a new empty list to store the unique positive numbers.
    unique_positives = list(set([num for num in l if num > 0]))
    
    # Implement bubble sort to sort the unique positive numbers in ascending order.
    for i in range(len(unique_positives) - 1):
        for j in range(len(unique_positives) - 1 - i):
            if unique_positives[j] > unique_positives[j + 1]:
                swap_elements(unique_positives, j, j + 1)
                
    return unique_positives

print(get_positive_and_sort([-1, 2, -4, 5, 6])) # Expected: [2, 5, 6]
print(get_positive_and_sort([5, 3, -5, 2, -3, 3, 9, 0, 123, 1, -10])) # Expected: [1, 2, 3, 5, 9, 123]
would you mind providing a brief explanation for each part of the php code?
