<|asst|>
import psycopg2
from psycopg2 import sql, extras, Error

def connect_and_execute_query(host, dbname, port, user, password, query):
    """
    Connects to an AWS Redshift cluster, execute SQL queries, manages transactions and close connections properly. 

    Parameters: 
    host (str): The hostname of your Amazon Redshift cluster.
    dbname (str): The database name to connect with.
    port (str): The port number on which your Amazon Redshift cluster is listening.
    user (str): The username that you want to connect as.
    password (str): The password for the user.
    query (str): The SQL query to execute.

    Returns:
    None
    """
    try:
        # establish a connection
        conn = psycopg2.connect(host=host, dbname=dbname, port=port, user=user, password=password)
        
        # create a cursor
        cur = conn.cursor()

        # execute SQL query
        cur.execute(query)

        # commit the transaction
        conn.commit()

        # fetch all rows from the last command
        rows = cur.fetchall()
        for row in rows:
            print(row)

    except (Exception, Error) as error:
        print("Error while connecting to Redshift", error)

    finally:
        # close the cursor and connection
        if (conn):
            cur.close()
            conn.close()
            print("Redshift connection is closed.")
<|end|>


