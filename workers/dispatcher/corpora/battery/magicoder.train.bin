Here is a compliant solution with additional functionality according to your assignment requirements:

```python
def calculate_statistics(num_list):
    if not num_list:
        raise ValueError("List cannot be empty.")
    if not all(isinstance(num, (int, float)) for num in num_list):
        raise ValueError("All elements in the list must be numeric.")
    
    mean = sum(num_list) / len(num_list)
    
    sorted_list = sorted(num_list)
    len_list = len(sorted_list)
    if len_list % 2 == 0:
        median = (sorted_list[(len_list)//2] + sorted_list[(len_list)//2-1]) / 2
    else:
        median = sorted_list[(len_list)//2]
    
    return {"mean": mean, "median": median}


nums = [1, 2, 3, 4]
print(calculate_statistics(nums))
```

