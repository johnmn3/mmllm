Then execute following python script

```python
import psycopg2
import pandas as pd
from datetime import datetime

def get_last_quarter():
    current_month = datetime.now().month
    if current_month < 4:
        return 4, datetime.now().year - 1
    elif current_month < 7:
        return 1, datetime.now().year
    elif current_month < 10:
        return 2, datetime.now().year
    else:
        return 3, datetime.now().year

def sanitize_data(df):
    # Add your data sanitization code here
    return df

def get_data(host, port, database, user, password):
    conn = None
    try:
        conn = psycopg2.connect(host=host, port=port, dbname=database, user=user, password=password)
        cur = conn.cursor()
        qtr, year = get_last_quarter()
        sql = f"""
        SELECT * 
        FROM marketing_data
        WHERE date_part('quarter', date_column) = {qtr} AND date_part('year', date_column) = {year}
        """  # Assuming date_column is the column having date

        df = pd.read_sql_query(sql, conn)

        df = sanitize_data(df)
        return df

    except Exception as error:
        print(f"An error occurred: {error}")
    finally:
        if conn is not None:
            conn.close()

# Example usage:
host = 'your_host'
port = 'your_port'
database = 'your_database'
user = 'your_username'
password = 'your_password'

data = get_data(host, port, database, user, password)
```

