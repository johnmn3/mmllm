import secrets

def generate_base32_string(length):
    #   Alphanumeric characters A-Z, 2-7
    alphanumeric = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ234567'
    result = ''.join(secrets.choice(alphanumeric) for i in range(length))
