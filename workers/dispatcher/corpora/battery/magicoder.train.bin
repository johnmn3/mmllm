DataStream<String> clickstreamLogs = env.addSource(new FlinkKafkaConsumer<>("clickstream-topic", new SimpleStringSchema(), properties));
DataStream<String> productDetails = env.addSource(new FlinkKafkaConsumer<>("product-topic", new SimpleStringSchema(), properties));
