could you give me a go version of this code?
def prod_signs_optimized(arr):
    distinct_non_zero_arr = list(set(arr))
    if 0 in distinct_non_zero_arr: 
        distinct_non_zero_arr.remove(0)
    return distinct_non_zero_arr
<|end|>
<|asst|>
Sure, Here's the equivalent go version of the code you provided:

```go
package main

import (
	"fmt"
)

func prod_signs_optimized(arr []int) []int {
	var distinct_non_zero_arr = removeDuplicates(arr)
	distinct_non_zero_arr = removeZero(distinct_non_zero_arr)
	return distinct_non_zero_arr
}

func removeDuplicates(arr []int) []int {
	newArray := make([]int, 0)
	keys := map[int]bool{}
	for _, entry := range arr {
		if _, value := keys[entry]; !value {
			keys[entry] = true
			newArray = append(newArray, entry)
		}
	}
	return newArray
}

func removeZero(arr []int) []int {
	newArray := []int{}
	for _, v := range arr {
		if v != 0 {
			newArray = append(newArray, v)
		}
	}
	return newArray
}

func main() {
	var arr []int = []int{0, 2, 2, 3, 3}
	result := prod_signs_optimized(arr)
	fmt.Println(result)
}
```

This code does following:
1. removeDuplicates function removes the duplicates from the given slice.
2. removeZero function removes the zero value from the given slice.
3. prod_signs_optimized function calls these two functions and returns the distinct_non_zero_arr as result.
<|end|>


