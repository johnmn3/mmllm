Complete the following code:
/*
Given a vector of positive integers, return a sorted copy of the vector.
Sort the vector in ascending order if the sum of the first and last elements is odd.
If the sum is even, sort in descending order. Additionally, check if all elements in the vector are unique, if not, remove duplicates.

Note:
* Do not change the given vector.

Example:
* sort_vector({}) => {}
* sort_vector({5}) => {5}
* sort_vector({2, 4, 3, 0, 1, 5}) => {0, 1, 2, 3, 4, 5}
* sort_vector({2, 4, 3, 0, 1, 5, 6}) => {6, 5, 4, 3, 2, 1, 0}
*/
#include<stdio.h>
#include<vector>
#include<algorithm>
using namespace std;
vector<int> sort_array(vector<int> array){
<|end|>
<|asst|>
Sure, here is the implementation in C++:

```cpp
#include <set>
#include <vector>
#include <algorithm>
using namespace std;

vector<int> sort_vector(const vector<int>& input){
    if(input.size() == 0) {
        return {};
    }
    // Create a set from the input vector to remove duplicates and sort in ascending order
    set<int> sortedSet(input.begin(), input.end());
    
    // Create a vector from the set
    vector<int> sortedVector(sortedSet.begin(), sortedSet.end());
    
    // If the sum of first and last elements of the sorted vector is even, reverse the order
    if((sortedVector[0] + sortedVector.back()) % 2 == 0) {
        reverse(sortedVector.begin(), sortedVector.end());
    }
    return sortedVector;
}
```
You can test it with:
```cpp
int main() {
    vector<int> result = sort_vector({2, 4, 3, 0, 1, 5, 6});
    for(int num: result) {
        printf("%d ", num);
    }
    return 0;
}
```
