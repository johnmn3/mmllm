    def try_convert(value, default, typer=float):
        try:
            return typer(value)
        except ValueError:
            return default
    
    # Implement filtering and sorting
    valid_students = []
    for name, data in student_dict.items():
        try:
            if len(data) != 4:
                raise ValueError(f"The student {name} has invalid number of data! The data: {data}")

            height, weight, age, gpa = try_convert(data[0], data[0]), try_convert(data[1], data[1]), \
                                        try_convert(data[2], data[2]), try_convert(data[3], data[3])

            if height >= min_height and weight >= min_weight and age >= min_age and gpa >= min_gpa:
                valid_students.append((name, height, weight, age, gpa))
                
        except TypeError:
            raise TypeError(f"The student {name} has non-numeric value! The data: {data}")
            
    # Sorting students 
