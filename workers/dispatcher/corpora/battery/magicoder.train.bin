I have code written in X, can you translate it to C?
#include<iostream>
#include<vector>
using namespace std;

vector<pair<int, int>> locate_str(vector<vector<string>> data, string x) {
    vector<pair<int, int>> occurrences;
    for (int i = 0; i < data.size(); i++) {
        for (int j = 0; j < data[i].size(); j++) {
            if (data[i][j] == x) {
                occurrences.push_back(make_pair(i, j));
            }
        }
    }
    return occurrences;
}

int main() {
    vector<vector<string>> data = {{"apple","banana"},{"orange","apple","kiwi"},{"apple","grape"}};
    string x = "apple";
    vector<pair<int, int>> result = locate_str(data, x);
    for(int i = 0; i < result.size(); i++){
        cout << "{" << result[i].first << ", " << result[i].second << "} ";
    }
    return 0; 
}
<|end|>
<|asst|>
Sure, here is your code translated into C:

    #include <stdio.h>
    #include <string.h>

    typedef struct {
        int x;
        int y;
    } pair;

    typedef struct {
        pair pairs[100];
        int size;
    } pair_list;

    typedef struct {
        char value[100];
        int size;
    } string_list;

    void locate_str(string_list data[], const char* x, pair_list* result) {
        result->size = 0;

        for (int i = 0; i < 3; i++) { // Assume there are 3 rows
            for (int j = 0; j < data[i].size; j++) {
                if (strcmp(data[i].value[j], x) == 0) {
                    result->pairs[result->size].x = i;
                    result->pairs[result->size].y = j;
                    result->size++;
                }
            }
        }
    }

    int main() {
        string_list data[3] = { {{ "apple", "banana" }, 2}, { {"orange", "apple", "kiwi" }, 3}, { {"apple", "grape" }, 2}};
        char x[] = "apple";
        pair_list result;

        locate_str(data, x, &result);

        for(int i = 0; i < result.size; i++){
            printf("{%d, %d} ", result.pairs[i].x, result.pairs[i].y);
        }

        return 0;
    }

Note that in C there is no standard library providing dynamic array and string, hence I fixed the size of array to 100 and 3, you might need to adjust them according to your needs. Also, it is required to manage the size of your array manually. Moreover, there's no `push_back` equivalent in C so adding elements to the `pair_list` is more tedious than in C++.
<|end|>


