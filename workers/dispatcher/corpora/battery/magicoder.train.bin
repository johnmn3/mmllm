Sure, here is a C translation for the given code. This assumes that you are fine with creating a dynamic sized array in C.

```c
#include<stdio.h>
#include<stdlib.h>

// Function to make a pile, accepts number of stones (n), pattern and offset
int* make_a_pile(int n, char* pattern, int offset){
    
    // Dynamically allocating array of size n
    int* stones = (int*)malloc(n * sizeof(int));
    stones[0] = n;

    // Loop to generate pattern of stones
    for(int i=1; i<n; i++){
        // If pattern is odd
        if(strcmp(pattern, "odd") == 0){
            stones[i] = n + 2*i + offset;
        } 
        // If pattern is even
        else if(strcmp(pattern, "even") == 0){
            stones[i] = n + 2*i - 1 + offset;
        }
    }

    return stones;
}

int main(){
    // Making a pile with pattern as odd and offset as 0
    int* pile1 = make_a_pile(5, "odd", 0);

    // Printing the created pile of stones
    for(int i=0; i<5; i++){
        printf("%d ", pile1[i]);
    }

    free(pile1); // do not forget to free dynamically allocated memory

    return 0;
}
```
This C code does the same thing as the python code. It dynamically creates an array to hold the number of stones and populates the array depending on the input pattern. The memory for the array is dynamically allocated, so it's crucial to call free() to deallocate memory, particularly if you allocate a large amount of memory or call the function many times.
