def suffixes(input_string):
    results = []
    for i in range(len(input_string), 0, -1):
        suffix = input_string[i-1:]
        results.append(suffix)
        if suffix == suffix[::-1]:  # If the suffix is a palindrome
            results.append(suffix*2)  # Append the palindrome of the suffix
    return results
print(suffixes("abc"))
