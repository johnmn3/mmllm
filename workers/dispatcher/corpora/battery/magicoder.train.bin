def perform_operation(arr1, arr2, operation):
    if operation == "merge":
        return sorted(arr1 + arr2 , reverse = True)
    elif operation == "find_common_elements":
        common = [value for value in arr1 if value in arr2]
        return sorted(list(set(common)), reverse = True)
    else:
        return "Invalid operation!"

print(perform_operation([1,2,3,4,5],[4,5,6,7,8],"merge"))
print(perform_operation([1,2,3,4,5],[4,5,6,7,8],"find_common_elements"))
