import java.util.Arrays;

class Solution {

    public static boolean sameChars(String s0, String s1) {
        // Convert strings into char arrays and sort
        char[] s0Arr = s0.toCharArray();
        char[] s1Arr = s1.toCharArray();
        Arrays.sort(s0Arr);
        Arrays.sort(s1Arr);
        
        // Compare sorted char arrays
