    msg['To'] = "RECEIVER EMAIL"
    msg.set_content(f'A new stable release of Ruby is out: {release}')

    with smtplib.SMTP_SSL('smtp.gmail.com', 465) as smtp:
        smtp.login("YOUR EMAIL", "YOUR PASSWORD")
        smtp.send_message(msg)

def fetch_latest_ruby_release():
    headers = {"Authorization": f"Bearer {TOKEN}"}
    query = """
    {
      repository(owner:"ruby", name:"ruby") {
        releases(last: 1) {
          nodes {
            name
            isLatest
          }
        }
      }
    }
    """
    try:
        response = requests.post(URL, json={'query': query}, headers=headers)
        return response.json()["data"]["repository"]["releases"]["nodes"][0]["name"]
    except Exception as e:
        print(f"An error occurred: {str(e)}")
        return None


while True:
    latest_release = fetch_latest_ruby_release()
    
    if latest_release != OLD_RELEASE:
        send_email(latest_release)
        OLD_RELEASE = latest_release
```

For the actual unit tests, you would write tests to check that the functions behave as expected when given certain inputs. This would be dependent on the language you are writing in - most languages have testing frameworks readily available.

For example, you might test that `fetch_latest_ruby_release` successfully returns the latest Ruby release, or that it fails gracefully when given invalid input or when the API is down.

Hope this helps!

