#include <iostream>
#include <string>
#include <cctype>

bool validateName(std::string name) {
    if(name.empty()) {
        std::cout << "Error: Name cannot be empty.\n";
        return false;
    }
    for(char c : name) {
        if(!(std::isalpha(c) || std::isspace(c))) {
            std::cout << "Error: Name should only contain alphabets and space.\n";
            return false;
        }
    }
    return true;
}

void greetUser(std::string name = "World") {
    if(validateName(name)) {
        std::cout << "Hello, " << name << "!\n";
    }
}

int main() {
    greetUser();

    std::string name;
    std::cout << "Please enter your name: ";
    std::getline(std::cin, name);
    
    greetUser(name);

    return 0;
}
```
In this program, greetUser is a function which prints "Hello, 'given name'!". If no name is given, it defaults to "World". This function calls the helper function validateName before outputting the greeting. validateName checks if the input name is valid. If the name is empty or contains anything other than alphabets and spaces, it outputs an error message and returns false, thereby causing greetUser not to print the greeting. If the name is valid, it returns true and the greeting is printed by greetUser.

