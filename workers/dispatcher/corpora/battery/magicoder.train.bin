    <td>Jane</td>
    <td>29</td>
    <td>Doctor</td>
  </tr>
  <tr>
    <td>Bob</td>
    <td>42</td>
    <td>Teacher</td>
  </tr>
</table>
<br>
<button onclick="sortTableByAge()">Sort by Age</button>

</body>
</html>
```
