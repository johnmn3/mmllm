ar = [7, 4, 8, 9, 10, 3]

def find_max(arr, max_val=0, i=0): 
    if i == len(arr): 
        return max_val 
    else:
        if arr[i] > max_val: 
            max_val = arr[i]
        return find_max(arr, max_val, i + 1)

