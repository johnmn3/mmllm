How would this algorithm look in Go?
from typing import List

def monotonic_deep(nl: List[List[int]], strict: bool = False):
    for i, l in enumerate(nl):
        if len(set(l)) != len(l) and strict:
            print(f"Sublist at {i} is not strictly monotonic")
            return False
        if sorted(l) != l and sorted(l, reverse=True) != l:
            print(f"Sublist at {i} is not monotonic")
            return False
    if sorted(nl, key=lambda x: x[0]) != nl \
            and sorted(nl, key=lambda x: x[0], reverse=True) != nl:
        print("Overall list is not monotonic")
        return False
    return True
Please include remarks in the Go translation to help me follow along.
<|end|>
<|asst|>
Here is how the algorithm would look like in Go. Note that Go doesn't have a built-in set type like Python, but we can use a map with empty struct as value to achieve a similar effect of uniqueness for the strict monotonic check. For the sorting comparison, we'll need to use a custom sort function.

```Go
package main

import (
	"fmt"
	"sort"
)

// Function to check if a list is strictly monotonic
func isStrictlyMonotonic(list []int) bool {
	// Initialization of a map as a substitute for a set in Python
	set := make(map[int]struct{})
	for _, v := range list {
		if _, ok := set[v]; ok {
			// If the list contains duplicates, it's not strictly monotonic
			return false
		}
		set[v] = struct{}{}
	}
	return true
}

// Function to check if a list is fit into non-decreasing or non-increasing order
func isMonotonic(list []int) bool {
	increasing := sort.IntsAreSorted(list)
	decreasing := sort.SliceIsSorted(list, func(i, j int) bool { return list[i] > list[j] })
	// If list is neither non-decreasing nor non-increasing, it's not monotonic
	if !increasing && !decreasing {
		return false
	}
	return true
}

// Function to perform deep check on the given list of lists
func monotonicDeep(list [][]int, strict bool) bool {
	for i, sublist := range list {
		if strict && !isStrictlyMonotonic(sublist) {
			// If strict is true and the sublist isn't strictly monotonic, return false
			fmt.Printf("Sublist at %d is not strictly monotonic\n", i)
			return false
		}
		if !isMonotonic(sublist) {
			// If the sublist isn't monotonic, return false
			fmt.Printf("Sublist at %d is not monotonic\n", i)
			return false
		}
	}

	// Check whether the overall list is non-decreasing or non-increasing using the first number of each sublist
	increasing := sort.SliceIsSorted(list, func(i, j int) bool { return list[i][0] < list[j][0] })
	decreasing := sort.SliceIsSorted(list, func(i, j int) bool { return list[i][0] > list[j][0] })
	if !increasing && !decreasing {
		// If overall list is not non-decreasing nor non-increasing, it's not monotonic
		fmt.Println("Overall list is not monotonic")
		return false
	}
	return true
}

func main() {
	// Test the algorithm with an input
	input := [][]int{{1, 2, 3}, {5, 6, 7}, {9, 10, 11}}
	fmt.Println(monotonicDeep(input, true))
}
```

Please note this important behavior of the function: in Go by default slices are sorted in non-decreasing order. Since Python sorted() sorting is stable, we can't ignore this fact.
<|end|>


