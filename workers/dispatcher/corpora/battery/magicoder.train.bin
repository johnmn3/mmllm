Can you parse this RSS feed https://rss.art19.com/the-daily using the feedparser library in Python, then use it to construct a data model with a date-time key that is timezone aware, parse author details into separate classes and identify entries with duplicate content?

Also, implement exception handling to tackle HTTP errors, timeouts and feedparser exceptions, ensuring the script is robust against potential errors. Write your solution with a focus on code clarity, optimal memory usage, and efficiency. 

In addition, can you create a function that periodically (every 12 hours) updates the data model, ensure outdated or removed items from the feed get deleted from the data model and new entries from the RSS feed get properly added to your data model. 

Finally, test your script with edge cases such as empty feeds, invalid URL and invalid date format in the feed.
<|end|>
<|asst|>
Here is an example of how you can achieve this:

```python
import requests
import feedparser
from datetime import datetime, timedelta
from pytz import timezone
import pytz
import os
import time
import threading
import hashlib

class Author:
    def __init__(self, name):
        self.name = name

class Entry:
    def __init__(self, title, summary, published, author):
        self.title = title
        self.summary = summary
        self.published = published
        self.author = author

class DataModel:
    def __init__(self):
        self.entries = {}

    def add_entry(self, entry):
        entry_hash = hashlib.md5(entry.title.encode()).hexdigest()
        self.entries[entry_hash] = entry

    def remove_entry(self, entry_hash):
        if entry_hash in self.entries:
            del self.entries[entry_hash]

def get_feed(feed_url):
    try:
        response = requests.get(feed_url, timeout=10)
        response.raise_for_status()
    except requests.exceptions.RequestException as err:
        print ("OOps: Something Wrong",err)
    except requests.exceptions.HTTPError as errh:
        print ("Http Error:",errh)
    except requests.exceptions.ConnectionError as errc:
        print ("Error Connecting:",errc)
    except requests.exceptions.Timeout as errt:
        print ("Timeout Error:",errt)

    feed_content = feedparser.parse(response.content)

    if 'bozo_exception' in feed_content:
        raise feed_content['bozo_exception']

    return feed_content

def construct_data_model(feed_content):
    data_model = DataModel()

    for entry in feed_content.entries:
        title = entry.title
        summary = entry.summary

        dt = datetime.strptime(entry.published, "%a, %d %b %Y %H:%M:%S %Z")
        published = timezone('US/Eastern').localize(dt)

        author = Author(entry.author)

        data_model.add_entry(Entry(title, summary, published, author))

    return data_model

def update_data_model(data_model):
    while True:
        time.sleep(12 * 60 * 60)
        feed_content = get_feed('https://rss.art19.com/the-daily')

        current_entries = set(data_model.entries.keys())

        for entry in feed_content.entries:
            entry_hash = hashlib.md5(entry.title.encode()).hexdigest()

            if entry_hash not in current_entries:
                title = entry.title
                summary = entry.summary

                dt = datetime.strptime(entry.published, "%a, %d %b %Y %H:%M:%S %Z")
                published = timezone('US/Eastern').localize(dt)

                author = Author(entry.author)

                data_model.add_entry(Entry(title, summary, published, author))

        for entry_hash in current_entries:
            if entry_hash not in feed_content.entries:
                data_model.remove_entry(entry_hash)

def main():
    feed_content = get_feed('https://rss.art19.com/the-daily')
    data_model = construct_data_model(feed_content)

    update_data_model_thread = threading.Thread(target=update_data_model, args=(data_model,))
    update_data_model_thread.start()

    update_data_model_thread.join()

if __name__ == "__main__":
    main()
```
This script does the following:
- Defines classes for authors and entries
- Defines a DataModel class that stores entries
- Fetches and parses the feed
- Constructs the data model
- Updates the data model every 12 hours
- Begins the update process in the main function

Please note that running it directly would result in an infinite loop at the update_data_model part. You might want to reconsider the design if you're planning to integrate this into some application. However, I provide this solution based on your requirements.
