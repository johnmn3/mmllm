It looks like your OCR software struggled a bit with this Python code. Let's clean it up:

```python
def advanced_median(lst: list, cmp_func: callable):
    """Return median of elements in the multi-dimensional list lst without sorting it or using built-in functions.
    Handles different data types including tuples with even and odd number of elements, duplicates, float numbers, nested lists and uses cmp_func for comparisons. Raises error for non-numeric elements.
    """
    def flatten(lst):
        """Flatten the multidimensional list."""
        for el in lst:
            if isinstance(el, list) or isinstance(el, tuple):
                yield from flatten(el)
            else:
                yield el

    def partition(lst, low, high):
        """Partition the list using Lomuto partition scheme."""
        pivot = lst[high]
        i = low
        for j in range(low, high):
            try:
                if cmp_func(lst[j], pivot) < 0:  # cmp_func handled
                    lst[i], lst[j] = lst[j], lst[i]
                    i += 1
            except TypeError:
                raise TypeError('Non-numeric element encountered.')
        lst[i], lst[high] = lst[high], lst[i]
        return i

    def quickselect(lst, k):
        """Select the kth element in list in linear time."""
        if len(lst) == 1:
            return lst[0]
        pivot_index = partition(lst, 0, len(lst) - 1)
        if pivot_index == k:
            return lst[k]
        elif pivot_index > k:
            return quickselect(lst[:pivot_index], k)
        else:
            return quickselect(lst[pivot_index + 1:], k - pivot_index - 1)

    flat = list(flatten(lst))
    n = len(flat)
    if n % 2 == 1:
        return quickselect(flat, n // 2)
    else:
        return (quickselect(flat, n // 2 - 1) + quickselect(flat, n // 2)) / 2
```
Please note that I reconstructed this code based on your scrambled OCR output, so there may be some differences from the original code. Also, the `cmp_func` was not clearly understandable in the OCR scrambled code, so you might need to customize it based on your requirement.
<|end|>


