Yes, there are quite a few issues due to OCR scan in this code. Here is the corrected version of the code:

```python
from google.cloud import bigtable
from google.cloud.bigtable import column_family, row_filters
import numpy as np
import tensorflow as tf

def get_data_from_bigtable(table_id):
    client = bigtable.Client(project='your-project-id', admin=True)
    instance = client.instance('your-instance-id')
    table = instance.table(table_id)

    # You need to specify your own way to read data
    rows = table.read_rows()
    rows.consume_all()

    data = []
    for row_key, row in rows.rows.items():
        for column_family_id, column_family in row.cells.items():
            for column, cell_list in column_family.items():
                for cell in cell_list:
                    # Assuming the cell contains a string that can be converted to a list for np.array
                    numpy_arr = np.array(eval(cell.value.decode('utf-8')))
                    data.append(numpy_arr)

    return data

def preprocess_data(data):
    # Add your own data preprocessing logic
    return np.array(data)

def main():
    raw_data = get_data_from_bigtable('your-table-id')
    processed_data, labels = preprocess_data(raw_data)

    # Define your own Convolution Neural Network model.
    model = tf.keras.models.Sequential()
    model.add(tf.keras.layers.Conv2D(32, (3, 3), activation='relu', input_shape=(64, 64, 3)))
    model.add(tf.keras.layers.MaxPooling2D((2, 2)))
    model.add(tf.keras.layers.Flatten())
    model.add(tf.keras.layers.Dense(64, activation='relu'))
    model.add(tf.keras.layers.Dense(10))

    # Compile and fit data
    model.compile(optimizer='adam', loss=tf.keras.losses.SparseCategoricalCrossentropy(from_logits=True), metrics=['accuracy'])
    model.fit(processed_data, labels, epochs=10)

if __name__ == "__main__":
    main()
```

Please make sure to replace 'your-project-id', 'your-instance-id', 'your-table-id' with the project ID, instance ID and table ID of the BigTable you're interacting with. Also, the list value extracted from a cell should be a string that can be evaluated as a list. The `preprocess_data` function requires your own data preprocessing logic as it is not defined in the original code.
