int get_matrix_triples(int n){
<|end|>
<|asst|>
Here is a refined code in C++ that solves the problem:

```c++
#include <iostream>
#include <vector>
using namespace std;
int get_matrix_triples(int n) {
    vector<int> a(n), count(3, 0), pairs(3,0);
    int triples = 0;
    for (int i = 0; i < n; ++i) {
        a[i] = i * i - i + 1;
        count[a[i] % 3]++;
    }
    for (int j = 0; j < 3; ++j) {
    	for(int k = j+1; k < 3; ++k) {
    		pairs[k] += count[j]*count[k];
    	}
   		triples += (count[j]*(count[j]-1)*(count[j]-2))/6;
   	}
   	triples += pairs[0] + 2*(pairs[1]+pairs[2]);

    return triples;
}
int main(int argc, const char * argv[]) {
    int n = 5;
    int result = get_matrix_triples(n);
    cout << result << endl;
    return 0;
}
```
This program first calculates all the `a[i]` values and counts how many of these values modulo 3 is equal to 0, 1, and 2. It then computes the pairs and triples which the sum is divisible by 3. The result is the total count of such triples. The complexity is O(n).
<|end|>


