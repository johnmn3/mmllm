Here's a simple Python script that calculates what you're asking for:

```python
import math

r = 5  # defined radius

def calculate_area_circle(r):
    if isinstance(r, int):
        return math.pi * r * r
    else:
        return "The radius must be an integer."

def calculate_area_square(r):
    if isinstance(r, int):
        return 4 * r * r
    else:
        return "The radius must be an integer."
        
circle_area = calculate_area_circle(r)
square_area = calculate_area_square(r)

print("The area of the circle is: ", circle_area)
print("The area of the square is: ", square_area)
