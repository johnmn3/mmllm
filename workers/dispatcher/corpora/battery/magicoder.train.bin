    @login_required
    def deploy_ml_model(self, data: Dict[str, Any], target: str) -> Dict[str, Any]:
        """Deploy a machine learning model on the provided data."""
        if not user_has_permission('DataScientist', 'deploy_ml_model'):
            raise PermissionError(f"User {self.username} does not have permission to deploy machine learning models.")

