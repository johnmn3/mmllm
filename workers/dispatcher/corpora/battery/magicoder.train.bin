Create a JavaScript function that not only takes in two arrays of numbers and returns an array containing only the numbers that appear in both arrays, but also sorts the output in descending order and removes duplicate values. Further, each element in output array should be both the product of the number and its frequency in both arrays.

For instance, if input arrays are arr1 = [1, 2, 4, 4, 5, 5] and arr2 = [3, 4, 4, 5, 6, 7, 7] the returned array should be [20, 16] because the common numbers are 4 and 5, occurring twice in each array thus 4*2=8 & 5*2=10.
<|end|>
<|asst|>
Here is the JavaScript function that meets the requirements:

```javascript
function commonValuesWithProduct(arr1, arr2) {
    let frequency1 = {}
    let frequency2 = {}
  
    // count each element in the first array
    arr1.forEach(function(value) {
        frequency1[value] = frequency1[value] ? frequency1[value] + 1 : 1;
    });
  
    // count each element in the second array
    arr2.forEach(function(value) {
        frequency2[value] = frequency2[value] ? frequency2[value] + 1 : 1;
    });
  
    let commonValues = []
  
    // create array with common elements multiplied by its frequency
    for (let key in frequency1) {
        if (frequency2[key]) {
            commonValues.push(key * frequency1[key] * 2);
        }
    }
  
    // sorting in descending order
    commonValues.sort(function(a, b){return b-a});
  
    return commonValues;
}
```

For example, `commonValuesWithProduct([1, 2, 4, 4, 5, 5], [3, 4, 4, 5, 6, 7, 7])` returns `[20, 16]` and `commonValuesWithProduct([2, 2, 3, 3], [2, 2, 2, 2, 3, 3])` returns `[12, 12]`.
<|end|>


