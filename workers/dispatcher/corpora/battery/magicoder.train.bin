Ex:
evaluateStringCharDiff("apple pi f", "dolphin") ➞ true
evaluateStringCharDiff("apple pie", "rhapsody") ➞ false
evaluateStringCharDiff("apple pi f", "123") ➞ false
evaluateStringCharDiff("", " dolphin") ➞ false
*/
const evaluateStringCharDiff = (txt1, txt2) => {
<|end|>
<|asst|>
if(txt1.length == 0 || txt2.length == 0 || !(/[a-z]/i.test(txt1.slice(-1))) || !(/[a-z]/i.test(txt2.charAt(0)))) return false;
  if(txt1.split(' ').some(w => w.endsWith(txt1.slice(-1))) || txt2.split(' ').some(w => w.startsWith(txt2.charAt(0)))) return false;
  return Math.abs(txt1.charCodeAt(txt1.length-1) - txt2.charCodeAt(0)) <= 2;
}

console.log(evaluateStringCharDiff("apple pi f", "dolphin")); // ➞ true
console.log(evaluateStringCharDiff("apple pie", "rhapsody")); // ➞ false
console.log(evaluateStringCharDiff("apple pi f", "123")); // ➞ false
console.log(evaluateStringCharDiff("", " dolphin")); // ➞ false

