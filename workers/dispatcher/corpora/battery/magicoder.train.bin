Construct a RESTful API by leveraging a Node.js server and MongoDB database. This API should facilitate a compilation of blog entries, each encompassing 'title', 'text', and 'author' attributes. Additionally, it should be capable of handling CRUD operations and ensure data persistence.
<|end|>
<|asst|>
This is a high-level guide to build a RESTful API using Node.js full-stack, Express framework for operation routing, MongoDB for data persistence and Mongoose as an object data modeling library to handle MongoDB.

Please use the code in an environment where Node.js and MongoDB are installed. Adhere to best practices and reusability when adjusting it to your specific requirements.

Consider a basic directory structure:
```
/blogapp
    /app
        /models
            blog.js
        /routes
            blog.js
    server.js
    package.json
```

Let's start with defining the blog schema model:

```javascript
// app/models/blog.js

var mongoose = require('mongoose');
var Schema = mongoose.Schema;

var BlogSchema = new Schema({
    title: String,
    text: String,
    author: String
});

module.exports = mongoose.model('Blog', BlogSchema);
```

Proceed by setting up routes for CRUD operations:

```javascript
// app/routes/blog.js

var express = require('express');
var router = express.Router();

var Blog = require('../models/blog');

// Creating a new blog
router.post('/', function(req, res) {
    var blog = new Blog(req.body);
    blog.save(function(err) {
        if(err) {
            res.send(err);
        }
        res.json({ message: 'Blog created!' });
    });
});

// Retrieving all blogs
router.get('/', function(req, res) {
    Blog.find(function(err, blogs) {
        if(err) {
            res.send(err);
        }
        res.json(blogs);
    });
});

// Retrieving a single blog by id
router.get('/:blog_id', function(req, res) {
    Blog.findById(req.params.blog_id, function(err, blog) {
        if(err) {
            res.send(err);
        }
        res.json(blog);
    });
});

// Updating a blog
router.put('/:blog_id', function(req, res) {
    Blog.findById(req.params.blog_id, function(err, blog) {
        if(err) {
            res.send(err);
        }
        Object.assign(blog, req.body);
        blog.save(function(err) {
            if(err) {
                res.send(err);
            }
            res.json({ message: 'Blog updated!' });
        });
    });
});

// Deleting a blog
router.delete('/:blog_id', function(req, res) {
    Blog.remove({
        _id: req.params.blog_id
    }, function(err, blog) {
        if(err) {
            res.send(err);
        }
        res.json({ message: 'Successfully deleted' });
    });
});

module.exports = router;
```

Lastly, setup the server:

```javascript
// server.js

var express = require('express');
var mongoose = require('mongoose');
var bodyParser = require('body-parser');
var morgan = require('morgan');
var blogRoutes = require('./app/routes/blog');

var app = express();

// Configure body parser
app.use(bodyParser.urlencoded({ extended: true }));
app.use(bodyParser.json());

// Configure Morgan for request logging in dev mode
app.use(morgan('dev'));

// Configure MongoDB
mongoose.connect('mongodb://localhost/blogapi', { useNewUrlParser: true });

// Setting up routing
app.use('/api/blog', blogRoutes);

var port = process.env.PORT || 8080;

app.listen(port);
console.log('Server is running on port: ' + port);
```

Remember to install required packages by running `npm install mongoose express body-parser morgan --save` in your terminal. 

You can now perform typical CRUD operations through HTTP request methods POST, GET, PUT and DELETE to your server. Make sure MongoDB service is running before starting your server with `node server.js`.
<|end|>


