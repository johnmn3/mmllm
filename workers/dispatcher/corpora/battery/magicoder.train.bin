can you make this snippet swift-ready?
def match_unique_words(sentence1: str, sentence2: str) -> bool:
    set1 = set(sentence1.split())
    set2 = set(sentence2.split())
    return set1 == set2
can you add comments to the swift code to explain its logic?
<|end|>
<|asst|>
Sure, here's the Swift code version of your Python function:

```swift
func matchUniqueWords(sentence1: String, sentence2: String) -> Bool {
    // Split the first sentence into words and store in a Set.
    // Set is a collection of unique elements.
    var set1 = Set(sentence1.split(separator: " "))
    
    // Split the second sentence into words and store in a Set.
    var set2 = Set(sentence2.split(separator: " "))
    
    // Compare the two sets. 
    // As Sets only contain unique elements, this will return true only if both sentences have exactly the same unique words.
    return set1 == set2
}
```
Comments are added in between the lines of code to explain the logic of each step.
<|end|>


