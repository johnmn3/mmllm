Here is a Python function that addresses the problem:

```python
def flatten(lst):
    """Flattens a list of lists"""
    return [item for sublist in lst for item in sublist]

def clean_data(lst):
    """Only keeps numeric and boolean (cast to int) values"""
    return [int(x) if type(x) is bool else x for x in lst if (isinstance(x, (int, float, complex)) or isinstance(x, bool))]

def find_min_disparity(arr):
    # flatten nested lists
    arr = flatten(arr)
    # remove non-numeric elements and cast boolean to int
    arr = clean_data(arr)
    # edge case: empty array
    if len(arr) == 0:
        return "Empty array. Please provide a valid input."
    # edge case: single element
    elif len(arr) == 1:
        return "Single element array. Please provide an array with at least two elements."
    else:
        arr = sorted(arr, key=abs)
        min_disparity = float(ins)
        pair = (0, 0)
        for i in range(1, len(arr)):
            if abs(arr[i]-arr[i-1]) < min_disparity:
                min_disparity = abs(arr[i]-arr[i-1])
                pair = (arr[i-1], arr[i])
        return min_disparity, pair
```

The following lines of code are a set of unit tests:

```python
assert find_min_disparity([]) == "Empty array. Please provide a valid input."
assert find_min_disparity([1]) == "Single element array. Please provide an array with at least two elements."
assert find_min_disparity([1, 2, 3, 4]) == (1, (1, 2))
assert find_min_disparity([1, 2, 3, 4, 1.5]) == (0.5, (1.5, 2))
assert find_min_disparity([1, "a", 3, 4]) == (1, (1, 2))
assert find_min_disparity([1, 2, 3, None, 4]) == (1, (1, 2))
assert find_min_disparity([1, 2, [3, 4]]) == (1, (1, 2))
assert find_min_disparity(['a', 'b']) == "Empty array. Please provide a valid input."
assert find_min_disparity([1, 2, 3, True]) == (0, (1, True))
assert find_min_disparity([1, 2, 3, 4, 1+1j, 1-1j]) == (0, (1-1j, 1+1j))
```

These test cases cover normal cases (arrays with numeric values), cases with non-numeric values, None values, nested arrays, boolean values, complex numbers, and edge cases like an empty array or an array with a single element.
