Here's a completion of your code that also includes the logic for handling invalid input, nulls, non-string types and selecting the highest frequency character(s):

```python
def robust_histogram(test):
    count = {}
    result = {}
      
    if isinstance(test, str):  # check if input is string
        for char in test:   # iterate each character in string
            if char != ' ':
                if char.lower() in count:
                    count[char.lower()] += 1
                else:
                    count[char.lower()] = 1

        max_val = max(count.values()) if count else 0  # find maximum frequency

        for key, value in count.items():  # find all keys with the maximum frequency
            if value == max_val:
                result[key] = value
    else:
        return None   # return None if test is not a string

    return result

# test cases to validate the solution

assert(robust_histogram('A B c 1 @') == {'a': 1, 'b': 1, 'c': 1, '1': 1, '@': 1})
assert(robust_histogram('a B b A 4') == {'a': 2, 'b': 2, '4': 1})
assert(robust_histogram('A b C a B 1 2 2') == {'a': 2, 'b': 2, '2': 2})
assert(robust_histogram('B B B b A ! ! ! !') == {'b': 4, '!': 4})
assert(robust_histogram('') == {})
assert(robust_histogram(123) == None)
```
