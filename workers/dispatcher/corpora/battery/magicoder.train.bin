def beg_of_cyc(a, b):
    for i in range(len(b)):
        if b[i:] + b[:i] in a:
            return True
    return False

def swaps(b, k):
    if k <= 0: return [b]
    res = {b}
    b = list(b)
    for i in range(len(b)-1):
        b[i], b[i+1] = b[i+1], b[i]
        res.update(swaps(''.join(b), k-1))
        b[i], b[i+1] = b[i+1], b[i]
    return list(res)

def cycpattern_check(a , b):
