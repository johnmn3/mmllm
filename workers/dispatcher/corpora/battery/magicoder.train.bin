import random

# List of less commonly known fruits
fruits = ["Durian", "Rambutan", "Dragon Fruit", "Soursop", "Guava", "Salak", "Cherimoya", "Jackfruit", "Feijoa", "Kiwano", "Persimmon", "Lychee", "Star Fruit", "Mangosteen", "Loquat"]

def create_recipe():
    # Select 10 random unique fruits
    selected_fruits = random.sample(fruits, 10)

    # Beginning of the recipe
    recipe = "Fruit Salad Recipe:\nIngredients:\n"

    for fruit in selected_fruits:
        # Assume 1 of each fruit is used
        recipe += "1 " + fruit + "\n"
    
    # Directions for the recipe
    recipe += "\nDirections:\n"
    recipe += "1. Wash all the fruits properly.\n"
    recipe += "2. Peel the fruits if necessary and cut them into small pieces.\n"
    recipe += "3. Mix all the pieces in a salad bowl.\n"
    recipe += "4. Refrigerate for about 1 hour before serving.\n"
    recipe += "5. Enjoy your exotic fruit salad!"

    print(recipe)

# Create the fruit salad recipe
