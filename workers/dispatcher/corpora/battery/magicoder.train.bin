    name = input("What is your name? ")
    profession = input("What is your profession? ")
    player = Character(name, profession)
    print(player.introduce())

    decision = input("You see a fork in the road. Do you go left or right? ")
    if decision.lower() == "left":
        print("You walked into a forest and found a treasure chest!")
    elif decision.lower() == "right":
        print("You walked to a riverbank and found a small boat!")
    else:
        print("You stayed in your place, not making a decision.")


if __name__ == "__main__":
    main()
```

