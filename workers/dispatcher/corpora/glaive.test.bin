import org.jsoup.Jsoup;
import org.jsoup.nodes.Document;
import org.jsoup.nodes.Element;
import org.jsoup.select.Elements;
public class HTMLTableParser {
 public static void main(String[] args) {
 String html = "Emotion Adjectives Datasettable, th, td {border: 1px solid black;border-collapse: collapse;}th, td {padding: 10px;text-align: center;}th {background-color: #f2f2f2;}Emotion Adjectives Dataset
==========================

| Adjective | Description |
| --- | --- |
| Angry | Feeling or showing anger or strong resentment |
| Sad | Feeling or showing sorrow; unhappy |
| Happy | Feeling or showing pleasure or contentment |
| Excited | Feeling or showing excitement; thrilled |
| Anxious | Feeling or showing worry, nervousness, or unease |

";
