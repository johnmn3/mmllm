 "price": 15.75,
 "category": "clothing",
 "stock": 8
 }
 ]
}
""".data(using: .utf8)!
struct ProductData: Codable {
 let products: [Product]
}
struct Product: Codable {
 let name: String
 let price: Double
 let category: String
 let stock: Int
}
let products = try! JSONDecoder().decode(ProductData.self, from: jsonData).products
let lowestStock = products.filter { $0.category == "electronics" }.min { $0.stock < $1.stock }
print(lowestStock?.name ?? "No products found")
```
This solution first creates two structs, `ProductData` and `Product`, to represent the JSON data. It then decodes the JSON data into an instance of `ProductData`. Finally, it filters the products to only include those in the electronics category and finds the product with the lowest stock using the `min` function. The result is printed to the console. <|endoftext|>
