public class MediterraneanCountries {
 public static void main(String[] args) {
 ArrayList mediterraneanCountries = new ArrayList<>(Arrays.asList("Spain", "France", "Monaco", "Italy", "Slovenia", "Croatia", "Bosnia and Herzegovina", "Montenegro", "Albania", "Greece", "Turkey", "Syria", "Lebanon", "Israel", "Egypt", "Libya", "Tunisia", "Algeria", "Morocco"));
