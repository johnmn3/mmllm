 for _, item := range itemList {
 if item.Price < 1000 {
 filteredItems = append(filteredItems, item)
 }
 }
 }
 sort.Slice(filteredItems, func(i, j int) bool {
 return filteredItems[i].Brand < filteredItems[j].Brand
 })
 tmpl := template.Must(template.New("filteredItems").Parse(`
 
Filtered Items

 table {
 border-collapse: collapse;
 width: 100%;
 }
 th, td {
 text-align: left;
 padding: 8px;
 }
 tr:nth-child(even) {
 background-color: #f2f2f2;
 }
 th {
 background-color: #4CAF50;
 color: white;
 }
 
