% Personal Finance Calculator
% Input variables
monthly_income = [5000, 5500, 6000, 6500, 7000, 7500, 8000, 8500, 9000, 9500, 10000, 10500]; % Monthly income for each month in 2021
monthly_expenses = [2000, 2200, 2400, 2600, 2800, 3000, 3200, 3400, 3600, 3800, 4000, 4200]; % Monthly expenses for each month in 2021
tax_rate = 0.2; % Tax rate for the year 2021
investment_rate = 0.1; % Investment rate for the year 2021
% Calculations
taxes_paid = monthly_income * tax_rate; % Taxes paid for each month in 2021
investments_made = monthly_income * investment_rate; % Investments made for each month in 2021
net_income = monthly_income - monthly_expenses - taxes_paid - investments_made; % Net income for each month in 2021
total_savings = cumsum(net_income); % Total savings for each month in 2021
% Output
disp("Monthly Income: ");
disp(monthly_income);
disp("Monthly Expenses: ");
disp(monthly_expenses);
disp("Taxes Paid: ");
disp(taxes_paid);
disp("Investments Made: ");
disp(investments_made);
disp("Net Income: ");
disp(net_income);
disp("Total Savings: ");
disp(total_savings);
```
