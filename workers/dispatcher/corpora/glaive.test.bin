import java.util.ArrayList;
import java.util.Arrays;
import java.util.Collections;
import java.util.List;
import java.util.Random;
public class SummerActivities {
 private static final List OUTDOOR_ACTIVITIES = Arrays.asList(
 "Go for a hike",
 "Play frisbee in the park",
 "Have a picnic",
 "Take a bike ride",
 "Go swimming",
 "Have a BBQ",
 "Go camping",
 "Play beach volleyball",
 "Go kayaking",
 "Play soccer"
 );
 private static final List INDOOR_ACTIVITIES = Arrays.asList(
 "Watch a movie",
 "Play board games",
 "Have a video game tournament",
 "Do a puzzle",
 "Bake cookies",
 "Have a craft day",
 "Read a book",
 "Do a home workout",
 "Have a karaoke night",
 "Play hide and seek"
 );
 private static final List GROUP_ACTIVITIES = Arrays.asList(
 "Go on a group bike ride",
 "Have a game night with friends",
 "Go to an amusement park",
 "Have a potluck dinner",
 "Go on a road trip",
 "Have a bonfire",
 "Go to a concert",
 "Have a water balloon fight",
 "Go to an escape room",
 "Have a talent show"
 );
 private static final List INDIVIDUAL_ACTIVITIES = Arrays.asList(
 "Start a journal",
 "Learn a new language",
 "Take an online course",
 "Practice meditation",
 "Do a solo hike",
 "Start a garden",
 "Take up photography",
 "Write a short story",
 "Learn to play an instrument",
 "Do a DIY project"
 );
 private static final List ALL_AGES_ACTIVITIES = Arrays.asList(
 "Go to a museum",
 "Visit a zoo or aquarium",
 "Have a family game night",
 "Go to a farmers market",
 "Have a movie marathon",
 "Go to a trampoline park",
 "Have a family bike ride",
 "Go on a nature walk",
 "Visit a local attraction",
 "Have a family picnic"
 );
 public static void main(String[] args) {
 List activities = new ArrayList<>();
 // Add 2 random outdoor activities
 activities.add(getRandomActivity(OUTDOOR_ACTIVITIES));
 activities.add(getRandomActivity(OUTDOOR_ACTIVITIES));
 // Add 2 random indoor activities
 activities.add(getRandomActivity(INDOOR_ACTIVITIES));
 activities.add(getRandomActivity(INDOOR_ACTIVITIES));
 // Add 2 random group activities
 activities.add(getRandomActivity(GROUP_ACTIVITIES));
 activities.add(getRandomActivity(GROUP_ACTIVITIES));
 // Add 2 random individual activities
 activities.add(getRandomActivity(INDIVIDUAL_ACTIVITIES));
 activities.add(getRandomActivity(INDIVIDUAL_ACTIVITIES));
 // Add 2 random activities for all ages
 activities.add(getRandomActivity(ALL_AGES_ACTIVITIES));
 activities.add(getRandomActivity(ALL_AGES_ACTIVITIES));
 // Shuffle the list of activities
 Collections.shuffle(activities);
 // Print the list of activities
 System.out.println("Here are 10 summer activities to try:");
 for (String activity : activities.subList(0, 10)) {
 System.out.println("- " + activity);
 }
 }
 private static String getRandomActivity(List activities) {
 Random random = new Random();
 return activities.get(random.nextInt(activities.size()));
 }
}
```
This implementation generates a list of 10 activities by adding 2 random activities from each of the following categories: outdoor activities, indoor activities, group activities, individual activities, and activities for all ages. The `getRandomActivity` method is used to select a random activity from each category. The `Collections.shuffle` method is then used to shuffle the list of activities, and the `subList` method is used to select the first 10 activities from the shuffled list. Finally, the list of activities is printed to the console. <|endoftext|>
