 "1 lime, cut into wedges",
 "10 fresh mint leaves",
 "2 tablespoons white sugar",
 "1 cup club soda",
 "crushed ice"
 ],
 "instructions": "In a tall glass, muddle the lime wedges, mint leaves, and sugar. Fill the glass with crushed ice and pour in the club soda. Stir well and garnish with a sprig of mint."
 },
 {
 "name": "Strawberry Lemonade",
 "ingredients": [
 "1 cup strawberries, hulled and halved",
 "1/2 cup freshly squeezed lemon juice",
 "1/4 cup honey",
 "4 cups water",
 "ice"
 ],
 "instructions": "In a blender, puree the strawberries until smooth. In a pitcher, combine the strawberry puree, lemon juice, honey, and water. Stir well and serve over ice."
 },
 {
 "name": "Iced Coffee",
 "ingredients": [
 "1/2 cup ground coffee",
 "4 cups water",
 "milk or cream",
 "sugar or sweetener (optional)",
 "ice"
 ],
 "instructions": "In a large jar or pitcher, combine the ground coffee and water. Stir well and let it sit at room temperature for at least 12 hours. Strain the coffee through a fine mesh strainer or cheesecloth. To serve, fill a glass with ice and pour in the coffee. Add milk or cream and sugar or sweetener to taste."
 }
 ]
}
```
