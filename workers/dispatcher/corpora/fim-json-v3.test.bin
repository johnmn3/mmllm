function is_word_valid(word)
 % Check if the word starts with "C" and ends with "T"
 if ~strcmp(word(1),'C') || ~strcmp(word(end),'T')
 disp('Word does not meet start and end conditions')
 return
 end
 
 % Check if the word contains all the letters in the alphabet
 alphabet = 'abcdefghijklmnopqrstuvwxyz';
 for i = 1:length(alphabet)
 if isempty(strfind(lower(word),alphabet(i)))
 disp('Word does not contain all letters in alphabet')
 return
 end
 end
 
 % If word passes all conditions, it is valid
 disp('Word is valid!')
end
