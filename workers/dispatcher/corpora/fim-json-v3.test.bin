)
func main() {
 db, err := sql.Open("mysql", "user:password@tcp(127.0.0.1:3306)/world_leaders")
 if err != nil {
 panic(err.Error())
 }
 defer db.Close()
 stmt, err := db.Prepare("SELECT nationality FROM world_leaders WHERE name = ?")
 if err != nil {
 panic(err.Error())
 }
 defer stmt.Close()
 leaders := []string{"Adolf Hitler", "Winston Churchill", "Franklin D. Roosevelt"}
 for _, leader := range leaders {
 var nationality string
 err :<|fim_mid|>= stmt.QueryRow(leader).Scan(&nationality)
 if err != nil {
 panic(err.Error())
