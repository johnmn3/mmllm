// Function to extract text content from a given URL
function extractContent($url) {
 $content = file_get_contents($url);
 $doc = new DOMDocument();
 libxml_use_internal_errors(true);
 $doc-loadHTML($content);
 $xpath = new DOMXPath($doc);
 $nodes = $xpath->query('//p');
 $text = '';
 foreach ($nodes as $node) {
 $text .= $node->nodeValue . ' ';
 }
 return $text;
}
